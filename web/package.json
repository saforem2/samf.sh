{
  "name": "docs",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "clean": "rm -rf dist .astro node_modules dist .turbo",
    "format": "prettier --write \"src/**/*.{ts,css,astro}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,css,astro}\" \"scripts/**/*.mjs\"",
    "lint": "eslint src/ scripts/",
    "astro": "astro",
    "og": "bun run ../scripts/generate-og-images.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^6.3.8",
    "@astrojs/mdx": "^4.1.0",
    "@astrojs/rss": "^4.0.15",
    "@astrojs/sitemap": "^3.7.3",
    "@shikijs/transformers": "^3.2.1",
    "@webtui/css": "workspace:*",
    "@webtui/plugin-nf": "workspace:*",
    "@webtui/theme-catppuccin": "workspace:*",
    "@webtui/theme-custom": "workspace:*",
    "@webtui/theme-everforest": "workspace:*",
    "@webtui/theme-gruvbox": "workspace:*",
    "@webtui/theme-nord": "workspace:*",
    "@webtui/theme-vitesse": "workspace:*",
    "astro": "^5.16.7",
    "katex": "0.16.33",
    "mermaid": "^11.12.2",
    "playwright": "^1.58.2",
    "rehype-katex": "^7.0.1",
    "rehype-mermaid": "^3.0.0",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.5",
    "shiki": "^3.13.0",
    "unist-util-visit": "^5.0.0",
    "uplot": "^1.6.32"
  }
}
