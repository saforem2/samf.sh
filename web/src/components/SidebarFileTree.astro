---
import type { CollectionEntry } from 'astro:content'
import { compareUrlPaths } from '@/utils/url'
import {
    makeSortedCategoryEntries,
    categoryLabels,
    moreSidebarGroup,
    sidebarHiddenCategories,
} from '@/utils/content'

// Current page's heading outline (table of contents), passed from Doc.astro.
// Rendered into a hidden <template> below; a client script clones it as tree
// children under the active page leaf so the TOC lives in this sidebar
// instead of a separate right-hand column.
type TocLine = {
    depth: number
    text: string
    slug: string
    treePrefix: string
}
const { tocLines = [] } = Astro.props as { tocLines?: TocLine[] }
// Headings only — drop the depth-1 page-title entry (the active leaf itself
// already represents the page). Keep depth >= 2.
const tocHeadings = tocLines.filter((h) => h.depth >= 2)

const allCategories = makeSortedCategoryEntries().filter(
    ([slug]) => !sidebarHiddenCategories.has(slug),
)
const categories = allCategories.filter(([slug]) => !moreSidebarGroup.has(slug))
const moreSubCategories = allCategories.filter(([slug]) =>
    moreSidebarGroup.has(slug),
)

const yearGroupedCategories = new Set(['posts', 'talks'])
const linkedCategorySlugs = new Set(['posts', 'talks', 'projects', 'webtui'])
const dateGroupedCategories = new Set(['posts', 'talks'])
const yearPattern = /^\d{4}$/
const datePattern = /(^|\n)(\d{4})-(\d{2})-(\d{2})\b/m

const getPageDate = (page: CollectionEntry<'docs'>) => {
    const dataDate = (page.data as { date?: string | Date }).date
    if (dataDate instanceof Date) return dataDate
    if (typeof dataDate === 'string') {
        const parsed = new Date(dataDate)
        if (!Number.isNaN(parsed.getTime())) return parsed
    }

    const body = page.body ?? ''
    const match = body.match(datePattern)
    if (match?.[2]) {
        const parsed = new Date(`${match[2]}-${match[3]}-${match[4]}`)
        if (!Number.isNaN(parsed.getTime())) return parsed
    }

    return null
}

const getPageYear = (page: CollectionEntry<'docs'>, slug: string) => {
    if (dateGroupedCategories.has(slug)) {
        const date = getPageDate(page)
        if (date) return String(date.getFullYear())
    }

    const [, year] = page.id.split('/')
    return year && yearPattern.test(year) ? year : null
}

const talkExternalLinks = [
    {
        year: '2024',
        month: '03',
        title: 'Parallel Training Techniques',
        href: 'https://github.com/saforem2/parallel-training-slides',
        event: 'AI-4-Science Training Series',
    },
    {
        year: '2024',
        month: '02',
        title: 'LLMs from Scratch',
        href: 'https://saforem2.github.io/llm-workshop-talk',
        event: 'LLM Tutorial Workshop',
    },
    {
        year: '2023',
        month: '11',
        title: 'Creating Small(-ish) LLMs',
        href: 'https://saforem2.github.io/LLM-tutorial',
        event: 'LLM Tutorial Workshop (1)',
    },
    {
        year: '2023',
        month: '10',
        title: 'Exascale Science on Aurora',
        href: 'https://saforem2.github.io/oneapi-talk',
        event: 'Intel oneAPI Workshop @ UIC',
    },
    {
        year: '2023',
        month: '10',
        title: 'LLM Lunch Talk',
        href: 'https://saforem2.github.io/llm-lunch-talk',
        event: 'ALCF Hands On HPC Workshop',
    },
    {
        year: '2023',
        month: '08',
        title: 'Scaling LLMs for Science',
        href: 'https://saforem2.github.io/scaling4science',
        event: 'Data-Intensive Computing + AI/ML at Scale',
    },
    {
        year: '2023',
        month: '07',
        title: 'MLMC: Machine Learning Monte Carlo',
        href: 'https://saforem2.github.io/lattice23',
        event: 'Lattice 2023',
    },
    {
        year: '2023',
        month: '07',
        title: 'Generative Modeling and Efficient Sampling',
        href: 'https://saforem2.github.io/lqcd-pasc23/',
        event: 'PASC23',
    },
    {
        year: '2023',
        month: '04',
        title: 'Efficient Sampling for LGT',
        href: 'https://saforem2.github.io/deep-fridays',
        event: 'Deep Fridays @ U. Bologna',
    },
    {
        year: '2022',
        month: '11',
        title: 'Large Scale Training',
        href: 'https://saforem2.github.io/ai4sci-large-scale-training',
        event: 'AI4Science on Supercomputers (ALCF)',
    },
    {
        year: '2022',
        month: '10',
        title: 'Hyperparameter Management',
        href: 'https://saforem2.github.io/hparam-management-sdl2022/',
        event: 'ALCF SDL Workshop',
    },
    {
        year: '2022',
        month: '08',
        title: 'Statistical Learning',
        href: 'https://saforem2.github.io/ATPESC-StatisticalLearning',
        event: 'ATPESC 2022',
    },
    {
        year: '2022',
        month: '05',
        title: 'Scientific Data Science: An Emerging Symbiosis',
        href: 'https://saforem2.github.io/anl-job-talk/',
        event: 'ANL',
    },
    {
        year: '2022',
        month: '03',
        title: 'Machine Learning in HEP',
        href: 'https://saforem2.github.io/physicsSeminar',
        event: 'UNC Greensboro',
    },
    {
        year: '2021',
        month: '12',
        title: 'Accelerated Sampling Methods for LGT',
        href: 'https://saforem2.github.io/l2hmc-dwq25/',
        event: 'DWQ @ 25 [BNL]',
    },
    {
        year: '2021',
        month: '09',
        title: 'Training Topological Samplers for LGT',
        href: 'https://saforem2.github.io/l2hmc_talk_ect2021',
        event: 'ML4HEP, ECT* Trento',
    },
    {
        year: '2021',
        month: '05',
        title: 'Deep Learning HMC for Improved Gauge Generation',
        href: 'https://bit.ly/mainz21',
        event: 'ML in LQCD Workshop',
    },
    {
        year: '2020',
        month: '02',
        title: 'Machine Learning for Lattice QCD',
        href: 'https://slides.com/samforeman/l2hmc-qcd/embed',
        event: 'U. Iowa',
    },
]

const talkExternalByYear = talkExternalLinks.reduce((map, link) => {
    const group = map.get(link.year) ?? []
    group.push(link)
    map.set(link.year, group)
    return map
}, new Map<string, typeof talkExternalLinks>())

const groupPagesByYear = (pages: CollectionEntry<'docs'>[], slug: string) => {
    const grouped = new Map<string, CollectionEntry<'docs'>[]>()
    const misc: CollectionEntry<'docs'>[] = []

    const addPage = (year: string, page: CollectionEntry<'docs'>) => {
        const group = grouped.get(year) ?? []
        group.push(page)
        grouped.set(year, group)
    }

    for (const page of pages) {
        const year = dateGroupedCategories.has(slug)
            ? getPageYear(page, slug)
            : page.id.split('/')[1]

        if (year && yearPattern.test(year)) {
            addPage(year, page)
        } else {
            misc.push(page)
        }
    }

    for (const [, yearPages] of grouped.entries()) {
        if (dateGroupedCategories.has(slug)) {
            yearPages.sort((a, b) => {
                const dateA = getPageDate(a)?.getTime() ?? 0
                const dateB = getPageDate(b)?.getTime() ?? 0
                if (dateA !== dateB) return dateB - dateA
                return a.id.localeCompare(b.id)
            })
        } else {
            yearPages.sort((a, b) => a.id.localeCompare(b.id))
        }
    }

    const years = Array.from(grouped.keys()).sort((a, b) => b.localeCompare(a))
    return { years, grouped, misc }
}

/** Group pages by their first sub-directory under the category slug. */
const groupPagesBySubdir = (pages: CollectionEntry<'docs'>[]) => {
    const grouped = new Map<string, CollectionEntry<'docs'>[]>()
    const misc: CollectionEntry<'docs'>[] = []

    for (const page of pages) {
        const parts = page.id.split('/')
        // parts[0] is the category slug, parts[1] may be a sub-directory
        if (parts.length > 2 && parts[1]) {
            const subdir = parts[1]
            const group = grouped.get(subdir) ?? []
            group.push(page)
            grouped.set(subdir, group)
        } else {
            misc.push(page)
        }
    }

    // Sort pages within each group alphabetically by title
    for (const [, groupPages] of grouped.entries()) {
        groupPages.sort((a, b) => a.data.title.localeCompare(b.data.title))
    }

    const subdirs = Array.from(grouped.keys()).sort()
    return { subdirs, grouped, misc }
}

const subdirLabels: Record<string, string> = {
    start: 'Start',
    installation: 'Installation',
    components: 'Components',
    plugins: 'Plugins',
    contributing: 'Contributing',
}

const categoryKeybinds: Record<string, string> = {
    about: 'a',
    posts: 'p',
    talks: 't',
    more: 'm',
    webtui: 's',
}

const labelWithKey = (slug: string) => {
    const key = categoryKeybinds[slug]
    const label = categoryLabels[slug]
    if (key === undefined) return label
    const keyIndex = label.toLowerCase().indexOf(key.toLowerCase())
    if (keyIndex === -1) return `[${key}] ${label}`
    return (
        label.slice(0, keyIndex) +
        `<span class="cat-key">[</span>${label[keyIndex]}<span class="cat-key">]</span>` +
        label.slice(keyIndex + 1)
    )
}

const { pathname: urlPath } = Astro.url

/** Strip leading emoji characters from a title string */
const stripEmoji = (text: string) =>
    text.replace(
        /^[\p{Emoji_Presentation}\p{Extended_Pictographic}\uFE0F\u200D]+\s*/gu,
        '',
    )

/* Nerd Font codepoints (folder/chevron glyphs are drawn via CSS pseudos) */
const ICON_FOLDER_OPEN = '\u{f0dcf}'
const ICON_FILE = '\u{f0224}'
const ICON_ABOUT = '\u{f1028}'
---

<nav box-="square" shear-="top" id="sidebar">
    <div id="sidebar-actions">
        <a href="/" class="sidebar-action" title="Home">&#xef85;</a>
        <button
            id="command-button-sidebar"
            class="sidebar-action"
            title="Open command menu (?)"
            aria-label="Open command menu">&#xf120;</button
        >
        <a
            href="https://github.com/saforem2/samf.sh"
            target="_blank"
            class="sidebar-action"
            title="GitHub">&#xe65b;</a
        >
        <a href="/rss.xml" target="_blank" class="sidebar-action" title="RSS"
            >&#xf09e;</a
        >
        <button id="search-button-sidebar" class="sidebar-action" title="Search"
            >&#xf002;</button
        >
        <button
            id="sidebar-toggle"
            class="sidebar-action"
            type="button"
            aria-expanded="true"
            aria-controls="sidebar-container"
            title="Collapse sidebar (zh)"
            aria-label="Collapse left sidebar (zh)">&#xf09d9;</button
        >
    </div>
    <div id="category-container">
        <div id="category-list" class="file-tree">
            <a href="/" class="tree-root" data-slug="root"
                ><span class="tree-icon root-icon">{ICON_FOLDER_OPEN}</span> samf.sh</a
            >
            {
                categories.map(([slug, pages], catIdx) => {
                    const isLastCategory = catIdx === categories.length - 1

                    /* ── landing: single file entry ── */
                    if (slug === 'landing') {
                        const landingPage =
                            pages.find(({ id }) => id === 'landing') ?? pages[0]

                        if (!landingPage) return null

                        return (
                            <a
                                href={`/${landingPage.id}`}
                                class:list={[
                                    'tree-file',
                                    'tree-entry',
                                    'depth-1',
                                    {
                                        active: compareUrlPaths(
                                            urlPath,
                                            landingPage.id,
                                        ),
                                    },
                                ]}
                                data-slug={landingPage.id}
                                data-last={isLastCategory ? '' : undefined}>
                                <span class="tree-line" />
                                <span class="tree-icon file-icon">
                                    {ICON_FILE}
                                </span>
                                <span class="tree-label">
                                    <Fragment set:html={labelWithKey(slug)} />
                                </span>
                            </a>
                        )
                    }

                    /* ── "about" standalone: render as a single flat link
                       (don't expand sub-pages of /about/ in the sidebar). */
                    if (slug === 'about') {
                        return (
                            <a
                                href="/about"
                                class:list={[
                                    'tree-file',
                                    'tree-entry',
                                    'depth-1',
                                    {
                                        active: compareUrlPaths(
                                            urlPath,
                                            'about',
                                        ),
                                    },
                                ]}
                                data-slug="about"
                                data-last={isLastCategory ? '' : undefined}>
                                <span class="tree-line" />
                                <span class="tree-icon file-icon">
                                    {ICON_ABOUT}
                                </span>
                                <span class="tree-label">
                                    <Fragment
                                        set:html={labelWithKey('about')}
                                    />
                                </span>
                            </a>
                        )
                    }

                    /* ── "more" group: expander with "index" (about/more) +
                       projects, ideas, now sub-categories ── */
                    if (slug === 'more') {
                        const isMoreActive =
                            compareUrlPaths(urlPath, 'about/more') ||
                            moreSubCategories.some(([, subPages]) =>
                                subPages.some(({ id }) =>
                                    compareUrlPaths(urlPath, id),
                                ),
                            )

                        return (
                            <details
                                open={isMoreActive}
                                class="tree-folder depth-1"
                                data-last={isLastCategory ? '' : undefined}>
                                <summary
                                    class:list={[
                                        'tree-entry',
                                        {
                                            active: compareUrlPaths(
                                                urlPath,
                                                'about/more',
                                            ),
                                        },
                                    ]}>
                                    <span class="tree-line" />
                                    <span class="tree-chevron" />
                                    <span class="tree-icon folder-icon" />
                                    <span
                                        class="tree-label sidebar-category-link"
                                        data-slug="more">
                                        <Fragment
                                            set:html={labelWithKey('more')}
                                        />
                                    </span>
                                </summary>
                                <div class="tree-children">
                                    {/* "index" sub-entry: maps to about/more (the original about page content) */}
                                    <a
                                        href="/about/more"
                                        class:list={[
                                            'tree-file',
                                            'tree-entry',
                                            'depth-2',
                                            {
                                                active: compareUrlPaths(
                                                    urlPath,
                                                    'about/more',
                                                ),
                                            },
                                        ]}
                                        data-slug="about/more">
                                        <span class="tree-line" />
                                        <span class="tree-icon file-icon">
                                            {ICON_FILE}
                                        </span>
                                        <span class="tree-label">index</span>
                                    </a>
                                    {moreSubCategories.map(
                                        ([subSlug, subPages], subIdx) => {
                                            const subIndexPage = subPages.find(
                                                ({ id }) => id === subSlug,
                                            )
                                            const isSubActive = subPages.some(
                                                ({ id }) =>
                                                    compareUrlPaths(
                                                        urlPath,
                                                        id,
                                                    ),
                                            )
                                            const subChildPages =
                                                subPages.filter(
                                                    ({ id }) => id !== subSlug,
                                                )
                                            const hasChildren =
                                                subChildPages.length > 0
                                            const isLastSub =
                                                subIdx ===
                                                moreSubCategories.length - 1

                                            if (hasChildren) {
                                                return (
                                                    <details
                                                        open={isSubActive}
                                                        class="tree-folder depth-2"
                                                        data-last={
                                                            isLastSub
                                                                ? ''
                                                                : undefined
                                                        }>
                                                        <summary
                                                            class:list={[
                                                                'tree-entry',
                                                                {
                                                                    active: compareUrlPaths(
                                                                        urlPath,
                                                                        subSlug,
                                                                    ),
                                                                },
                                                            ]}>
                                                            <span class="tree-line" />
                                                            <span class="tree-chevron" />
                                                            <span class="tree-icon folder-icon" />
                                                            <a
                                                                href={`/${subIndexPage?.id ?? subSlug}`}
                                                                class="tree-label sidebar-category-link"
                                                                onclick="event.stopPropagation()"
                                                                data-slug={
                                                                    subSlug
                                                                }>
                                                                {categoryLabels[
                                                                    subSlug
                                                                ] ?? subSlug}
                                                            </a>
                                                        </summary>
                                                        <div class="tree-children">
                                                            {subChildPages.map(
                                                                (
                                                                    {
                                                                        id,
                                                                        data: {
                                                                            title,
                                                                        },
                                                                    },
                                                                    fileIdx,
                                                                ) => (
                                                                    <a
                                                                        href={`/${id}`}
                                                                        class:list={[
                                                                            'tree-file',
                                                                            'tree-entry',
                                                                            'depth-3',
                                                                            {
                                                                                active: compareUrlPaths(
                                                                                    urlPath,
                                                                                    id,
                                                                                ),
                                                                            },
                                                                        ]}
                                                                        data-slug={
                                                                            id
                                                                        }
                                                                        data-last={
                                                                            fileIdx ===
                                                                            subChildPages.length -
                                                                                1
                                                                                ? ''
                                                                                : undefined
                                                                        }>
                                                                        <span class="tree-line" />
                                                                        <span class="tree-icon file-icon">
                                                                            {
                                                                                ICON_FILE
                                                                            }
                                                                        </span>
                                                                        <span class="tree-label">
                                                                            {stripEmoji(
                                                                                title,
                                                                            )}
                                                                        </span>
                                                                    </a>
                                                                ),
                                                            )}
                                                        </div>
                                                    </details>
                                                )
                                            }

                                            return (
                                                <a
                                                    href={`/${subIndexPage?.id ?? subSlug}`}
                                                    class:list={[
                                                        'tree-file',
                                                        'tree-entry',
                                                        'depth-2',
                                                        { active: isSubActive },
                                                    ]}
                                                    data-slug={subSlug}
                                                    data-last={
                                                        isLastSub
                                                            ? ''
                                                            : undefined
                                                    }>
                                                    <span class="tree-line" />
                                                    <span class="tree-icon file-icon">
                                                        {ICON_FILE}
                                                    </span>
                                                    <span class="tree-label">
                                                        {categoryLabels[
                                                            subSlug
                                                        ] ?? subSlug}
                                                    </span>
                                                </a>
                                            )
                                        },
                                    )}
                                </div>
                            </details>
                        )
                    }

                    /* ── Year-grouped categories (posts, talks) ── */
                    const categoryIndexPage = pages.find(
                        ({ id }) => id === slug,
                    )
                    const shouldLinkCategory =
                        linkedCategorySlugs.has(slug) &&
                        Boolean(categoryIndexPage)
                    const categoryPages = shouldLinkCategory
                        ? pages.filter(({ id }) => id !== slug)
                        : pages
                    const isCategoryActive = pages.some(({ id }) =>
                        compareUrlPaths(urlPath, id),
                    )

                    if (yearGroupedCategories.has(slug)) {
                        const { years, grouped, misc } = groupPagesByYear(
                            categoryPages,
                            slug,
                        )
                        const mergedYears =
                            slug === 'talks'
                                ? Array.from(
                                      new Set([
                                          ...years,
                                          ...talkExternalByYear.keys(),
                                      ]),
                                  ).sort((a, b) => b.localeCompare(a))
                                : years

                        return (
                            <details
                                open={isCategoryActive}
                                class="tree-folder depth-1"
                                data-last={isLastCategory ? '' : undefined}>
                                <summary
                                    class:list={[
                                        'tree-entry',
                                        {
                                            active:
                                                shouldLinkCategory &&
                                                compareUrlPaths(urlPath, slug),
                                        },
                                    ]}>
                                    <span class="tree-line" />
                                    <span class="tree-chevron" />
                                    <span class="tree-icon folder-icon" />
                                    {shouldLinkCategory ? (
                                        <a
                                            href={`/${slug}`}
                                            class="tree-label sidebar-category-link"
                                            onclick="event.stopPropagation()"
                                            data-slug={slug}>
                                            <Fragment
                                                set:html={labelWithKey(slug)}
                                            />
                                        </a>
                                    ) : (
                                        <span class="tree-label">
                                            <Fragment
                                                set:html={labelWithKey(slug)}
                                            />
                                        </span>
                                    )}
                                </summary>
                                <div class="tree-children">
                                    {mergedYears.map((year, yearIdx) => {
                                        const yearPages =
                                            grouped.get(year) ?? []
                                        const yearExternals =
                                            slug === 'talks'
                                                ? (talkExternalByYear.get(
                                                      year,
                                                  ) ?? [])
                                                : []
                                        const isYearActive = yearPages.some(
                                            ({ id }) =>
                                                compareUrlPaths(urlPath, id),
                                        )

                                        const entries = [
                                            ...yearPages
                                                .filter(
                                                    (page) =>
                                                        page.data.title &&
                                                        !page.id.match(
                                                            /\/(index|readme)\.(mdx?|md)$/i,
                                                        ),
                                                )
                                                .map((page) => ({
                                                    type: 'page',
                                                    title: page.data.title,
                                                    href: `/${page.id}`,
                                                    date: getPageDate(page),
                                                    isActive: compareUrlPaths(
                                                        urlPath,
                                                        page.id,
                                                    ),
                                                    slug: page.id,
                                                })),
                                            ...yearExternals.map(
                                                (external) => ({
                                                    type: 'external',
                                                    title: `${external.title}`,
                                                    href: external.href,
                                                    date: new Date(
                                                        `${external.year}-${external.month}-01`,
                                                    ),
                                                    isActive: false,
                                                    slug: undefined,
                                                }),
                                            ),
                                        ].sort((a, b) => {
                                            const dateA =
                                                a.date instanceof Date
                                                    ? a.date.getTime()
                                                    : 0
                                            const dateB =
                                                b.date instanceof Date
                                                    ? b.date.getTime()
                                                    : 0
                                            if (dateA !== dateB)
                                                return dateB - dateA
                                            return a.title.localeCompare(
                                                b.title,
                                            )
                                        })

                                        const isLastYear =
                                            yearIdx ===
                                                mergedYears.length - 1 &&
                                            misc.length === 0

                                        return (
                                            <details
                                                open={isYearActive}
                                                class="tree-folder depth-2"
                                                data-last={
                                                    isLastYear ? '' : undefined
                                                }>
                                                <summary class="tree-entry">
                                                    <span class="tree-line" />
                                                    <span class="tree-chevron" />
                                                    <span class="tree-icon folder-icon" />
                                                    <span class="tree-label">
                                                        {year}
                                                    </span>
                                                </summary>
                                                <div class="tree-children">
                                                    {entries.map(
                                                        (entry, entryIdx) => (
                                                            <a
                                                                href={
                                                                    entry.href
                                                                }
                                                                class:list={[
                                                                    'tree-file',
                                                                    'tree-entry',
                                                                    'depth-3',
                                                                    {
                                                                        active: entry.isActive,
                                                                    },
                                                                    {
                                                                        external:
                                                                            entry.type ===
                                                                            'external',
                                                                    },
                                                                ]}
                                                                data-slug={
                                                                    entry.type ===
                                                                    'page'
                                                                        ? entry.slug
                                                                        : undefined
                                                                }
                                                                data-last={
                                                                    entryIdx ===
                                                                    entries.length -
                                                                        1
                                                                        ? ''
                                                                        : undefined
                                                                }
                                                                target={
                                                                    entry.type ===
                                                                    'external'
                                                                        ? '_blank'
                                                                        : undefined
                                                                }
                                                                rel={
                                                                    entry.type ===
                                                                    'external'
                                                                        ? 'noreferrer'
                                                                        : undefined
                                                                }>
                                                                <span class="tree-line" />
                                                                <span class="tree-icon file-icon">
                                                                    {ICON_FILE}
                                                                </span>
                                                                <span class="tree-label">
                                                                    {stripEmoji(
                                                                        entry.title,
                                                                    )}
                                                                </span>
                                                            </a>
                                                        ),
                                                    )}
                                                </div>
                                            </details>
                                        )
                                    })}
                                    {misc.length > 0 && (
                                        <details
                                            open={misc.some(({ id }) =>
                                                compareUrlPaths(urlPath, id),
                                            )}
                                            class="tree-folder depth-2"
                                            data-last>
                                            <summary class="tree-entry">
                                                <span class="tree-line" />
                                                <span class="tree-chevron" />
                                                <span class="tree-icon folder-icon" />
                                                <span class="tree-label">
                                                    other
                                                </span>
                                            </summary>
                                            <div class="tree-children">
                                                {misc.map(
                                                    (
                                                        { id, data: { title } },
                                                        miscIdx,
                                                    ) => (
                                                        <a
                                                            href={`/${id}`}
                                                            class:list={[
                                                                'tree-file',
                                                                'tree-entry',
                                                                'depth-3',
                                                                {
                                                                    active: compareUrlPaths(
                                                                        urlPath,
                                                                        id,
                                                                    ),
                                                                },
                                                            ]}
                                                            data-slug={id}
                                                            data-last={
                                                                miscIdx ===
                                                                misc.length - 1
                                                                    ? ''
                                                                    : undefined
                                                            }>
                                                            <span class="tree-line" />
                                                            <span class="tree-icon file-icon">
                                                                {ICON_FILE}
                                                            </span>
                                                            <span class="tree-label">
                                                                {stripEmoji(
                                                                    title,
                                                                )}
                                                            </span>
                                                        </a>
                                                    ),
                                                )}
                                            </div>
                                        </details>
                                    )}
                                </div>
                            </details>
                        )
                    }

                    /* ── Single-page or no-child category: render as file ── */
                    if (shouldLinkCategory && categoryPages.length === 0) {
                        return (
                            <a
                                href={`/${slug}`}
                                class:list={[
                                    'tree-file',
                                    'tree-entry',
                                    'depth-1',
                                    { active: isCategoryActive },
                                ]}
                                data-slug={slug}
                                data-last={isLastCategory ? '' : undefined}>
                                <span class="tree-line" />
                                <span class="tree-icon file-icon">
                                    {ICON_FILE}
                                </span>
                                <span class="tree-label">
                                    <Fragment set:html={labelWithKey(slug)} />
                                </span>
                            </a>
                        )
                    }

                    if (categoryPages.length === 1) {
                        const page = categoryPages[0]
                        return (
                            <a
                                href={`/${page.id}`}
                                class:list={[
                                    'tree-file',
                                    'tree-entry',
                                    'depth-1',
                                    { active: isCategoryActive },
                                ]}
                                data-slug={page.id}
                                data-last={isLastCategory ? '' : undefined}>
                                <span class="tree-line" />
                                <span class="tree-icon file-icon">
                                    {ICON_FILE}
                                </span>
                                <span class="tree-label">
                                    <Fragment set:html={labelWithKey(slug)} />
                                </span>
                            </a>
                        )
                    }

                    /* ── Sub-directory grouped category ── */
                    const {
                        subdirs,
                        grouped: subdirGrouped,
                        misc: subdirMisc,
                    } = groupPagesBySubdir(categoryPages)
                    const hasSubdirs = subdirs.length > 0

                    return (
                        <details
                            open={isCategoryActive}
                            class="tree-folder depth-1"
                            data-last={isLastCategory ? '' : undefined}>
                            <summary
                                class:list={[
                                    'tree-entry',
                                    {
                                        active:
                                            shouldLinkCategory &&
                                            compareUrlPaths(urlPath, slug),
                                    },
                                ]}>
                                <span class="tree-line" />
                                <span class="tree-chevron" />
                                <span class="tree-icon folder-icon" />
                                {shouldLinkCategory ? (
                                    <a
                                        href={`/${slug}`}
                                        class="tree-label sidebar-category-link"
                                        onclick="event.stopPropagation()"
                                        data-slug={slug}>
                                        <Fragment
                                            set:html={labelWithKey(slug)}
                                        />
                                    </a>
                                ) : (
                                    <span class="tree-label">
                                        <Fragment
                                            set:html={labelWithKey(slug)}
                                        />
                                    </span>
                                )}
                            </summary>
                            <div class="tree-children">
                                {hasSubdirs ? (
                                    <>
                                        {subdirs.map((subdir, sdIdx) => {
                                            const subdirPages =
                                                subdirGrouped.get(subdir) ?? []
                                            const isSubdirActive =
                                                subdirPages.some(({ id }) =>
                                                    compareUrlPaths(
                                                        urlPath,
                                                        id,
                                                    ),
                                                )
                                            const isLastSubdir =
                                                sdIdx === subdirs.length - 1 &&
                                                subdirMisc.length === 0

                                            return (
                                                <details
                                                    open={isSubdirActive}
                                                    class="tree-folder depth-2"
                                                    data-last={
                                                        isLastSubdir
                                                            ? ''
                                                            : undefined
                                                    }>
                                                    <summary class="tree-entry">
                                                        <span class="tree-line" />
                                                        <span class="tree-chevron" />
                                                        <span class="tree-icon folder-icon" />
                                                        <span class="tree-label">
                                                            {subdirLabels[
                                                                subdir
                                                            ] ?? subdir}
                                                        </span>
                                                    </summary>
                                                    <div class="tree-children">
                                                        {subdirPages.map(
                                                            (
                                                                {
                                                                    id,
                                                                    data: {
                                                                        title,
                                                                    },
                                                                },
                                                                fileIdx,
                                                            ) => (
                                                                <a
                                                                    href={`/${id}`}
                                                                    class:list={[
                                                                        'tree-file',
                                                                        'tree-entry',
                                                                        'depth-3',
                                                                        {
                                                                            active: compareUrlPaths(
                                                                                urlPath,
                                                                                id,
                                                                            ),
                                                                        },
                                                                    ]}
                                                                    data-slug={
                                                                        id
                                                                    }
                                                                    data-last={
                                                                        fileIdx ===
                                                                        subdirPages.length -
                                                                            1
                                                                            ? ''
                                                                            : undefined
                                                                    }>
                                                                    <span class="tree-line" />
                                                                    <span class="tree-icon file-icon">
                                                                        {
                                                                            ICON_FILE
                                                                        }
                                                                    </span>
                                                                    <span class="tree-label">
                                                                        {stripEmoji(
                                                                            title,
                                                                        )}
                                                                    </span>
                                                                </a>
                                                            ),
                                                        )}
                                                    </div>
                                                </details>
                                            )
                                        })}
                                        {subdirMisc.map(
                                            (
                                                { id, data: { title } },
                                                miscIdx,
                                            ) => (
                                                <a
                                                    href={`/${id}`}
                                                    class:list={[
                                                        'tree-file',
                                                        'tree-entry',
                                                        'depth-2',
                                                        {
                                                            active: compareUrlPaths(
                                                                urlPath,
                                                                id,
                                                            ),
                                                        },
                                                    ]}
                                                    data-slug={id}
                                                    data-last={
                                                        miscIdx ===
                                                        subdirMisc.length - 1
                                                            ? ''
                                                            : undefined
                                                    }>
                                                    <span class="tree-line" />
                                                    <span class="tree-icon file-icon">
                                                        {ICON_FILE}
                                                    </span>
                                                    <span class="tree-label">
                                                        {stripEmoji(title)}
                                                    </span>
                                                </a>
                                            ),
                                        )}
                                    </>
                                ) : (
                                    categoryPages.map(
                                        ({ id, data: { title } }, fileIdx) => (
                                            <a
                                                href={`/${id}`}
                                                class:list={[
                                                    'tree-file',
                                                    'tree-entry',
                                                    'depth-2',
                                                    {
                                                        active: compareUrlPaths(
                                                            urlPath,
                                                            id,
                                                        ),
                                                    },
                                                ]}
                                                data-slug={id}
                                                data-last={
                                                    fileIdx ===
                                                    categoryPages.length - 1
                                                        ? ''
                                                        : undefined
                                                }>
                                                <span class="tree-line" />
                                                <span class="tree-icon file-icon">
                                                    {ICON_FILE}
                                                </span>
                                                <span class="tree-label">
                                                    {stripEmoji(title)}
                                                </span>
                                            </a>
                                        ),
                                    )
                                )}
                            </div>
                        </details>
                    )
                })
            }
        </div>
    </div>
    {
        tocHeadings.length > 0 && (
            <template id="sidebar-toc-template">
                <div class="tree-children sidebar-toc">
                    {tocHeadings.map((h) => (
                        <a
                            href={`#${h.slug}`}
                            class:list={['toc-heading', `depth-${h.depth}`]}
                            data-heading-slug={h.slug}
                            data-depth={h.depth}>
                            <span class="toc-hash" aria-hidden="true">
                                {'#'.repeat(h.depth)}
                            </span>
                            <span class="toc-text">{h.text}</span>
                        </a>
                    ))}
                </div>
            </template>
        )
    }
</nav>

<style>
    /* ================================================================
       FILE TREE SIDEBAR
       ================================================================ */

    #sidebar {
        position: relative;
        display: flex;
        flex-direction: column;
        /* overflow:visible (not hidden) so the action-row chips can
           lift on hover without getting clipped against the box-=
           border. The scrolling category list has its own
           overflow-y:auto, so removing the outer clip is safe. */
        overflow: visible;
        flex-grow: 1;
        /* Flex children default to min-width:auto, which refuses to
           shrink below intrinsic content width. Without this, when the
           #sidebar-container is narrower than the tree's natural width
           (e.g. the 18ch intermediate-viewport floor), the rows spill
           past the container edge instead of letting .tree-label's
           ellipsis engage. min-width:0 lets the column honor the
           container width. */
        min-width: 0;
        padding-inline: 1ch;
        /* shear-="top" on the nav already zeroes the top padding so
           the action chips can sit on the box-= border line (like the
           "top-left" label in webtui box examples). overflow:visible
           above lets the chips overhang above the border without
           getting clipped on hover. */
        padding-block-start: 0;
        color: var(--foreground2);
        font-family: var(--font-family);
        line-height: 1.25;

        /* (#sidebar-toggle was absolutely positioned at the bottom here when
           it was a standalone bar; it now lives in #sidebar-actions as a
           .sidebar-action and needs no special positioning.) */

        &:focus-within {
            --box-border-color: var(--focus-region-border);
        }
    }

    /* ── Sidebar action bar ── */

    #sidebar-actions {
        display: flex;
        /* Flush — chip borders touch so the action bar reads as a
           continuous key row, not five separate buttons. */
        gap: 0;
        font-size: 0.95em;
        position: relative;
        z-index: 10;
        width: fit-content;
        /* Anchor the chip row to the top-left corner of the parent
           nav's box-= border (just like the "top-left" label in webtui
           box examples). shear-="top" on the nav kills top padding, so
           a 0 top-margin sits the chips' top edge on the border line.
           Inline start 0 so the chip row sits flush at the nav's left edge. */
        margin-block-start: 0;
        margin-inline-start: 0ch;
        /* Solid background so the chip row reads as a distinct toolbar
           against the sidebar. */
        background: var(--background0);

        .sidebar-action {
            all: unset;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-sizing: border-box;
            /* Square keycap. Padding and min-width are sized for the
               Material-Design nerd-font glyphs, which are visibly wider
               than the Font-Awesome line-art icons we used before — too
               tight and they touch the chip border. Hairline border +
               opaque fill (color-mix, not alpha) so the WebTUI box-=
               border on the parent nav doesn't bleed through. No
               border-radius — matches the TUI box-drawing language
               used elsewhere. */
            padding: 0.2lh 0.75ch;
            min-width: 3ch;
            /* Full-strength icon color so the action chips read clearly
               (was --foreground2, a dim grey). */
            color: var(--foreground0);
            background-color: color-mix(
                in oklch,
                var(--background0),
                var(--foreground0) 5%
            );
            border: 1px solid
                color-mix(in oklch, var(--background0), var(--foreground0) 18%);
            cursor: pointer;
            font-family: var(--font-family);
            font-size: inherit;
            /* Collapse line-box to font-size so the glyph's vertical
               center aligns with the chip's geometric center. With
               `line-height: inherit` (~1.4) the glyph's ascent
               anchored at the line top pushes the visible ink up past
               the chip's upper border — looks bottom-heavy. */
            line-height: 1;
            text-decoration: none;
            /* Default hover-shadow tint — overridden per-button below.
               Setting the CSS var here lets the shared `:hover/:focus`
               transform/shadow rules below resolve to the right hue
               without duplicating the box-shadow line in every button
               selector. */
            --chip-accent: var(--foreground2);
            transition:
                color 0.1s linear,
                background-color 0.1s linear,
                border-color 0.1s linear,
                transform 0.1s ease-out,
                box-shadow 0.1s ease-out;
            opacity: 50%;

            /* Tactile hover: nudge 1px up-left and drop a hard-offset
               TUI-style shadow in the per-button accent color so the
               chip reads as a physical key being lifted. */
            &:hover,
            &:focus-visible,
            &[data-vim-focused='true'] {
                color: var(--foreground0);
                transform: translate(-1px, -1px);
                box-shadow: 2px 2px 0 0 var(--chip-accent);
                opacity: 100% !important;
            }

            /* Pressed: snap back to flat with a smaller shadow so the
               click reads as a key bottoming out. */
            &:active {
                transform: translate(0, 0);
                box-shadow: 1px 1px 0 0 var(--chip-accent);
            }

            /* Per-button accent tints. Background uses color-mix
               against background0 (opaque, ~18% accent) so the box-=
               border on the parent nav doesn't bleed through on
               hover/focus the way an alpha overlay would. */
            /* Per-button accent rules: extend each selector to also
               match vim-focused state ([data-vim-focused='true'])
               so j/k navigation gets the same color treatment as
               mouse hover or keyboard tab-focus. Without the vim
               selector, vim-focus fires the base hover rule (gets
               foreground0 + shadow) but the per-button color override
               doesn't apply — the chip shows the wrong color and the
               vim-cursor (which reads cs.color) inherits the default
               --chip-accent (pink) instead of the chip's family. */
            &[href='/']:hover,
            &[href='/']:focus-visible,
            &[href='/'][data-vim-focused='true'] {
                --chip-accent: var(--blue);
                /* Pin to --blue (not --accent) so the icon matches
                   the blue-mixed background. The other buttons all
                   use their named color for icon + bg + border as
                   one family; --accent floats per-theme (e.g. red on
                   catppuccin) and was clashing with the blue tint. */
                color: var(--blue);
                background-color: color-mix(
                    in srgb,
                    var(--background0),
                    var(--blue) 18%
                ) !important;
                border-color: var(--blue) !important;
            }

            &[href*='github']:hover,
            &[href*='github']:focus-visible,
            &[href*='github'][data-vim-focused='true'] {
                --chip-accent: var(--purple);
                color: var(--purple);
                background-color: color-mix(
                    in srgb,
                    var(--background0),
                    var(--purple) 18%
                ) !important;
                border-color: var(--purple) !important;
            }

            &[href*='rss']:hover,
            &[href*='rss']:focus-visible,
            &[href*='rss'][data-vim-focused='true'] {
                --chip-accent: var(--orange);
                color: var(--orange);
                background-color: color-mix(
                    in srgb,
                    var(--background0),
                    var(--orange) 18%
                ) !important;
                border-color: var(--orange) !important;
            }

            &#search-button-sidebar:hover,
            &#search-button-sidebar:focus-visible,
            &#search-button-sidebar[data-vim-focused='true'] {
                --chip-accent: var(--green);
                color: var(--green);
                background-color: color-mix(
                    in srgb,
                    var(--background0),
                    var(--green) 18%
                ) !important;
                border-color: var(--green) !important;
            }

            &#command-button-sidebar:hover,
            &#command-button-sidebar:focus-visible,
            &#command-button-sidebar[data-vim-focused='true'] {
                --chip-accent: var(--pink);
                color: var(--pink);
                background-color: color-mix(
                    in srgb,
                    var(--background0),
                    var(--pink) 18%
                ) !important;
                border-color: var(--pink) !important;
            }
        }
    }

    /* ── Category container / scrollable area ── */

    #category-container {
        position: relative;
        flex-grow: 1;
        margin-top: 0.5ch;
        /* Same flexbox min-width:auto trap as #sidebar above — let the
           tree column shrink to the container so labels truncate rather
           than overflow at narrow widths. */
        min-width: 0;
    }

    #category-list {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        gap: 0;
        overflow-y: auto;
    }

    /* ── Tree root label ── */

    .tree-root {
        color: var(--foreground1);
        padding-inline-start: 0ch;
        white-space: nowrap;
        user-select: none;
        text-decoration: none;
        display: block;
    }
    .tree-root:hover {
        color: var(--foreground0);
    }

    .root-icon {
        color: var(--accent, var(--foreground2));
    }

    /* ── Generic tree entry (summary rows and file rows) ── */

    .tree-entry {
        display: flex;
        align-items: baseline;
        white-space: nowrap;
        text-decoration: none;
        color: var(--foreground2);
        outline: none;
        cursor: pointer;
        position: relative;
        transition:
            background-color 100ms linear,
            color 100ms linear;
    }

    .tree-entry:hover {
        background-color: var(--focus-hover-bg);
    }

    .tree-entry:focus-visible,
    .tree-entry[data-vim-focused='true'] {
        /* Darkened accent tint at low alpha + a 1pt accent ring (the outline
           inherits the accent `color` set just below). The old
           --focus-bg-strong was accent at 0.025 alpha — so faint the focused
           row was nearly indistinguishable from hover; this makes keyboard /
           vim focus clearly visible. */
        background-color: oklch(from var(--accent) calc(l * 0.85) c h / 0.075);
        outline: 1pt solid;
        color: var(--focus-fg);
        text-decoration: none;
    }

    /* Active page leaf: accent TEXT color only, no filled background. The
       inline TOC headings below it are themselves colored (per heading
       level), so a filled accent band on the active leaf competed with them
       and read as busy. The accent text + the file-leaf icon is enough to
       mark the current page. */
    .tree-entry.active {
        color: var(--accent);
    }

    .tree-entry.external {
        font-style: italic;
    }

    /* ── Depth-based indentation ── */

    .depth-1 {
        padding-inline-start: 0;
    }
    .depth-2 {
        padding-inline-start: 0;
    }
    .depth-3 {
        padding-inline-start: 0;
    }

    .tree-folder.depth-1 > summary {
        padding-inline-start: 0;
    }
    .tree-folder.depth-2 > summary {
        padding-inline-start: 0;
    }
    .tree-folder.depth-3 > summary {
        padding-inline-start: 0;
    }

    /* ── Tree line characters (vertical bars + connectors) ── */

    .tree-line {
        display: inline-block;
        width: 2ch;
        flex-shrink: 0;
        color: var(--foreground3);
        user-select: none;
        text-align: left;
    }

    .tree-file > .tree-line::before,
    .tree-folder > summary > .tree-line::before {
        content: '├─';
    }

    .tree-file[data-last] > .tree-line::before,
    .tree-folder[data-last] > summary > .tree-line::before {
        content: '└─';
    }

    /* The ├─ / └─ glyphs in each row already draw the connectors;
       no CSS border needed on the children wrap. */
    .tree-children {
        position: relative;
        margin-inline-start: 0.4ch;
        padding-inline-start: 2ch;
    }

    /* ── Chevron (expand/collapse indicator) ── */

    .tree-chevron {
        display: inline-block;
        /* width: 0.5ch; */
        flex-shrink: 0;
        color: var(--foreground3);
        user-select: none;
        text-align: center;
    }

    .tree-chevron::before {
        /* right-pointing triangle: '\25b8' */
        content: '';
    }

    details[open] > summary > .tree-chevron::before {
        /* down-pointing triangle: '\25be' */
        content: '';
    }

    /* ── Folder / file icons ── */

    .tree-icon {
        display: inline-block;
        width: 1.5ch;
        flex-shrink: 0;
        text-align: center;
        user-select: none;
        margin-inline-end: 0.5ch;
    }

    .folder-icon::before {
        content: '󰉖'; /* closed folder */
        color: var(--foreground2);
    }

    details[open] > summary > .folder-icon::before {
        content: '󰷏'; /* open folder */
        color: var(--accent, var(--foreground2));
    }

    .file-icon {
        color: var(--foreground3);
    }

    /* ── Inline TOC: the current page's headings, cloned under the active
       leaf. A clean indented list (no tree connectors — those imply real
       file-tree structure and read as janky here). Each row is `## label`
       with an auto-width hash marker so 2- and 3-char markers don't overflow
       a fixed box and crash into the text. Indent steps per depth. ── */
    .sidebar-toc {
        /* Override the file-tree .tree-children connector rail + indent so the
           TOC sits as its own clean block under the active leaf. Indented one
           tree-level (~2.5ch) deeper than the active page link above it so the
           heading outline reads as nested *under* that page, not as a sibling
           sitting flush with it. */
        margin-inline-start: 0;
        /* Indent the heading hashes a modest step in from the active page
           link so the outline reads as nested under that page. */
        padding-inline-start: 2ch;
    }
    .sidebar-toc .toc-heading {
        display: flex;
        align-items: baseline;
        gap: 0.75ch;
        padding-block: 0.05lh;
        padding-inline: 0;
        /* One tier dimmer than the post-link leaves (--foreground2) so the
           inline heading outline reads as secondary to the page list. */
        color: var(--foreground3);
        text-decoration: none;
        line-height: 1.3;
    }
    .sidebar-toc .toc-hash {
        flex-shrink: 0;
        /* auto width — no fixed box to overflow; right-aligned so the deeper
           markers (##, ###) stay visually anchored to the label. */
        color: var(--foreground3);
        font-size: 0.8em;
        letter-spacing: -0.05ch;
        opacity: 0.7;
    }
    .sidebar-toc .toc-text {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    /* Depth indent: each level's `#` marker sits roughly under the first
       character of its parent's title, so the outline reads like nested
       markdown:

           ## Heading 2
           ### Heading 3
              #### Heading 4

       depth-2 is flush (the row base is 0 inset); each deeper level steps in
       by ~3ch (one `#` worth of marker + the hash→text gap), growing slightly
       at the deepest levels since each adds another `#`. */
    .sidebar-toc .toc-heading.depth-3 {
        padding-inline-start: 3ch;
    }
    .sidebar-toc .toc-heading.depth-4 {
        padding-inline-start: 6ch;
    }
    .sidebar-toc .toc-heading.depth-5 {
        padding-inline-start: 10ch;
    }
    .sidebar-toc .toc-heading.depth-6 {
        padding-inline-start: 14ch;
    }

    /* Collapse depth-3+ subheadings by default; reveal only the ones whose
       parent H2 section is currently in focus (the scrollspy in Doc.astro
       toggles .toc-section-open on those rows). Keeps the outline compact —
       you see all the H2s plus the subheadings for wherever you're reading. */
    .sidebar-toc .toc-heading:is(.depth-3, .depth-4, .depth-5, .depth-6) {
        display: none;
    }
    .sidebar-toc
        .toc-heading.toc-section-open:is(
            .depth-3,
            .depth-4,
            .depth-5,
            .depth-6
        ) {
        display: flex;
    }

    /* Active heading (set by the scrollspy) — colored by level, with the
       level-matched dim background (the heading's own color at 10% alpha),
       exactly like the in-content `## heading` hover/target highlight in
       global.css. (Was a generic accent-pink tint regardless of level.) */
    .sidebar-toc .toc-heading.depth-2.active {
        color: var(--h2);
        background-color: oklch(
            from var(--h2, var(--orange)) calc(l * var(--oklch-scale, 0.85)) c
                h / 0.1
        );
    }
    .sidebar-toc .toc-heading.depth-3.active {
        color: var(--h3);
        background-color: oklch(
            from var(--h3, var(--green)) calc(l * var(--oklch-scale, 0.85)) c
                h / 0.1
        );
    }
    .sidebar-toc .toc-heading.depth-4.active {
        color: var(--h4);
        background-color: oklch(
            from var(--h4, #50fa7b) calc(l * var(--oklch-scale, 0.85)) c h / 0.1
        );
    }
    .sidebar-toc .toc-heading.depth-5.active {
        color: var(--h5);
        background-color: oklch(
            from var(--h5, #fd971f) calc(l * var(--oklch-scale, 0.85)) c h / 0.1
        );
    }
    .sidebar-toc .toc-heading.depth-6.active {
        color: var(--h6);
        background-color: oklch(
            from var(--h6, #f44336) calc(l * var(--oklch-scale, 0.85)) c h / 0.1
        );
    }
    .sidebar-toc .toc-heading.active .toc-hash {
        color: inherit;
        opacity: 1;
    }
    .sidebar-toc .toc-heading:hover {
        background-color: var(--focus-hover-bg, var(--background1));
        color: var(--foreground0);
    }

    /* Keyboard / vim focus on an inline TOC heading. Without this the
       heading receives focus + data-vim-focused on `j`/`k` but shows no
       visible indicator (the only heading that looked focused was the
       scrollspy `.active` one, by coincidence of its tint). Mirror the
       .tree-entry focus ring above so headings are just as clearly
       selectable. outline-offset pulls the ring inside the row so it
       isn't clipped at the sidebar's edge. */
    .sidebar-toc .toc-heading:focus-visible,
    .sidebar-toc .toc-heading[data-vim-focused='true'] {
        background-color: oklch(from var(--accent) calc(l * 0.85) c h / 0.075);
        outline: 1pt solid var(--accent);
        outline-offset: -1pt;
        color: var(--focus-fg);
        text-decoration: none;
    }

    /* ── Tree label (the text) ── */

    .tree-label {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        color: inherit;
        text-decoration: none;
    }

    a.tree-label {
        color: inherit;
        text-decoration: none;
    }

    a.tree-label:hover {
        text-decoration: none;
    }

    /* ── Details / summary reset ── */

    .tree-folder {
        list-style: none;
    }

    .tree-folder > summary {
        list-style-type: '';
    }

    .tree-folder > summary::marker {
        content: '';
    }

    .tree-folder > summary::-webkit-details-marker {
        display: none;
    }

    /* ── Keybind bracket styling ── */

    .cat-key {
        opacity: 0.35;
    }

    /* ── Hidden items ── */

    details[open] a.hidden,
    details.hidden,
    .hidden {
        display: none;
    }
</style>

<script>
    import { applyVimNavigation, isUserTyping } from '@/utils/vim'

    // ── Inline TOC: clone the page's heading outline (rendered into
    //    #sidebar-toc-template by Astro) as tree children directly under the
    //    active page leaf, so the table of contents lives in this sidebar
    //    instead of a separate right-hand column. The cloned links keep their
    //    data-heading-slug so the scrollspy in Doc.astro highlights the active
    //    heading here. ──
    {
        const tocTemplate = document.getElementById(
            'sidebar-toc-template',
        ) as HTMLTemplateElement | null
        const activeLeaf = document.querySelector(
            '#category-list a.tree-entry.active',
        )
        if (tocTemplate && activeLeaf && activeLeaf.parentElement) {
            const frag = tocTemplate.content.cloneNode(true) as DocumentFragment
            // Insert the .tree-children block right after the active leaf.
            activeLeaf.after(frag)
            // Make sure every ancestor <details> is open so the headings (and
            // the active leaf) are visible on load.
            let p = activeLeaf.parentElement
            while (p) {
                if (p instanceof HTMLDetailsElement) p.open = true
                if (p.id === 'sidebar') break
                p = p.parentElement
            }
        }
    }

    // Sidebar action buttons
    document
        .getElementById('search-button-sidebar')
        ?.addEventListener('click', () => {
            const dialog = document.getElementById(
                'search-dialog',
            ) as HTMLDialogElement | null
            dialog?.showModal()
        })

    document
        .getElementById('command-button-sidebar')
        ?.addEventListener('click', () => {
            const dialog = document.getElementById(
                'command-dialog',
            ) as HTMLDialogElement | null
            dialog?.showModal()
        })

    const sidebar = document.getElementById('sidebar')

    // Single-letter shortcuts for sidebar categories.
    // Order MUST match the children of #category-list in
    // SidebarFileTree's rendered DOM (see categoryKeybinds above):
    //   0 = [a]bout, 1 = [p]osts, 2 = [t]alks, 3 = [m]ore, 4 = [s]tyle
    const categoryKeys: Record<string, number> = {
        a: 0,
        p: 1,
        t: 2,
        m: 3,
        s: 4,
    }

    const categoryList = document.getElementById('category-list')
    if (categoryList) {
        // In the file-tree layout, top-level entries are direct children
        // that are either <a> (file entries) or <details> (folder entries),
        // excluding the .tree-root label
        const entries = categoryList.querySelectorAll<HTMLElement>(
            ':scope > a.tree-entry, :scope > details.tree-folder',
        )
        window.addEventListener('keydown', (e) => {
            if (e.defaultPrevented || isUserTyping()) return
            if (e.ctrlKey || e.metaKey || e.altKey || e.shiftKey) return
            const idx = categoryKeys[e.key]
            if (idx === undefined) return
            const el = entries[idx]
            if (!el) return
            e.preventDefault()
            if (el.tagName === 'A') {
                ;(el as HTMLAnchorElement).click()
            } else if (el.tagName === 'DETAILS') {
                const details = el as HTMLDetailsElement
                details.open = true
                const link = details.querySelector<HTMLAnchorElement>(
                    'summary a.sidebar-category-link',
                )
                if (link) {
                    link.click()
                } else {
                    details.querySelector('summary')?.focus()
                }
            }
        })
    }
    let lastInteractionWasPointer = false

    const revealFocusedElement = (element: HTMLElement) => {
        let parent = element.parentElement

        while (parent) {
            if (parent instanceof HTMLDetailsElement) {
                parent.open = true
            }

            if (parent.id === 'sidebar') break
            parent = parent.parentElement
        }
    }

    if (sidebar) {
        sidebar.addEventListener('pointerdown', () => {
            lastInteractionWasPointer = true
        })

        sidebar.addEventListener('keydown', () => {
            lastInteractionWasPointer = false
        })

        applyVimNavigation(
            sidebar,
            // The action-row buttons (Home / command / GitHub / RSS / Search /
            // collapse) come FIRST so j/k step through them before the tree —
            // they live in #sidebar-actions, above #category-list in the DOM,
            // so they're naturally first in the flat nav list. Without them in
            // the query, focusing a toolbar button left j/k with no index in
            // the list, so it reset to the first tree item (sam.onl) instead of
            // moving to the next button.
            // The inline TOC heading links (.sidebar-toc a.toc-heading, cloned
            // in after the active page leaf above) must be in the query too, or
            // j/k jumps from the active leaf straight to the next tree folder,
            // skipping every heading. They sit inside the .sidebar-toc div (not
            // a direct `#category-list > a` child) and aren't in a <details>, so
            // the other clauses miss them. querySelectorAll returns DOM order,
            // so headings interleave between the active leaf and the next entry;
            // collapsed depth-3+ headings are display:none and get filtered out
            // by applyVimNavigation's visibility check.
            '#sidebar-actions a[href]:not([disabled]), #sidebar-actions button:not([disabled]), #category-list > a:not(.hidden), #category-list .sidebar-toc a.toc-heading, details:not(.hidden)[open] a:not(.hidden), details:not(.hidden) summary',
            (element) => {
                if (lastInteractionWasPointer) {
                    return
                }

                if (element.tagName === 'SUMMARY') {
                    return
                }

                revealFocusedElement(element)
            },
        )
    }

    // Theme management (moved from NavbarMinimal)
    const root = document.documentElement
    const themeStorageKey = 'webtui-theme'
    const themeButtons = Array.from(
        document.querySelectorAll('[data-theme-option]'),
    ) as HTMLButtonElement[]
    const colorSchemeQuery = window.matchMedia('(prefers-color-scheme: dark)')

    const resolveTheme = (theme: string) =>
        theme === 'auto'
            ? colorSchemeQuery.matches
                ? 'custom-dark'
                : 'custom-light'
            : theme

    const setTheme = (theme: string) => {
        // Apply the resolved theme to the DOM (so CSS selectors keep
        // working) but remember the user's literal choice in storage —
        // including 'auto' — so the picker can show the right active
        // pill and live-follow OS preference flips.
        const resolved = resolveTheme(theme)
        if (root.getAttribute('data-webtui-theme') !== resolved) {
            root.setAttribute('data-webtui-theme', resolved)
        }
        themeButtons.forEach((button) => {
            const value = button.getAttribute('data-theme-option')
            const isActive = value === theme
            button.setAttribute('aria-selected', String(isActive))
            button.setAttribute('variant-', 'background1')
            button.setAttribute('data-active', String(isActive))
        })
        localStorage.setItem(themeStorageKey, theme)
    }

    const storedTheme = localStorage.getItem(themeStorageKey)
    if (storedTheme) {
        setTheme(storedTheme)
    }

    // If the user is on 'auto', re-resolve when the OS preference flips.
    colorSchemeQuery.addEventListener('change', () => {
        if (localStorage.getItem(themeStorageKey) === 'auto') {
            setTheme('auto')
        }
    })

    themeButtons.forEach((button) => {
        button.addEventListener('click', () => {
            const value = button.getAttribute('data-theme-option')
            if (!value) return
            setTheme(value)
            const themeDialog = document.getElementById(
                'theme-dialog',
            ) as HTMLDialogElement | null
            themeDialog?.close()
        })
    })

    document
        .getElementById('search-button-sidebar')
        ?.addEventListener('click', () => {
            const searchDialog = document.getElementById(
                'search-dialog',
            ) as HTMLDialogElement | null
            searchDialog?.showModal()
        })
</script>
