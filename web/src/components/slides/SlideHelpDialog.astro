---
/**
 * Slide-deck help dialog. Triggered by `?` or the status-bar `?` button.
 * Contains:
 *  - mini-navbar (home/theme/github/rss/search) matching the root page
 *  - Theme picker (mirrors Filter.astro themeOptions)
 *  - Table of Contents — populated at runtime from each <Slide>'s first
 *    heading; clicking a TOC entry jumps to that slide
 *  - Keybinds reference
 */
const themeOptions = {
    // `auto` was missing here while Filter.astro (which this claims to
    // mirror) has had it all along -- and the runtime below already
    // handles it, including the prefers-color-scheme listener that
    // re-applies on system change. Only the chip was absent.
    auto: 'Auto (system)',
    'custom-light': 'Light',
    'custom-dark': 'Dark',
    catppuccin: 'Catppuccin Mocha',
    'catppuccin-latte': 'Catppuccin Latte',
    doe: 'DOE',
    alcf: 'ALCF',
}
const fontOptions = {
    iosevka: 'Iosevka',
    'victor-mono': 'Victor Mono',
    'miosevka-term': 'mIosevka-Term',
    'miosevka-qp': 'mIosevka-QP',
    system: 'System',
}
// Code font: true-monospace only — no QP (it breaks ASCII / column
// alignment). Mirrors the code axis in Filter.astro's command dialog.
const codeFontOptions = {
    'miosevka-term': 'mIosevka-Term',
    iosevka: 'Iosevka',
    'victor-mono': 'Victor Mono',
    system: 'System',
}
---

<dialog id="slide-help-dialog" class="slide-help-dialog">
    <div box-="square" shear-="top" class="slide-help-content">
        <row align-="between">
            <span is-="badge" variant-="green">&#xf120; Slides</span>
            <button id="slide-help-close" variant-="foreground0" size-="small"
                >x</button
            >
        </row>

        <!-- Mini navbar (matches root page) -->
        <nav class="slide-help-navbar">
            <a href="/" class="shn-link" title="Home">&#xef85;</a>
            <button id="slide-help-theme-btn" class="shn-link" title="Theme">
                &#xf1fc;
            </button>
            <a
                href="https://github.com/saforem2/samf.sh"
                target="_blank"
                class="shn-link"
                title="GitHub">&#xea84;</a
            >
            <a href="/rss.xml" target="_blank" class="shn-link" title="RSS"
                >&#xf09e;</a
            >
            <a href="/" class="shn-link" title="Search">&#xea6d;</a>
        </nav>

        <section class="slide-help-section">
            <span is-="badge" class="shs-title shs-title-green"
                >&#xf1fc; <u>T</u>heme</span
            >
            <row class="shn-theme-buttons" gap-="0">
                {
                    Object.entries(themeOptions).map(([key, value]) => (
                        <button
                            data-theme-dropdown="true"
                            data-theme-option={key}
                            aria-selected="false"
                            class="shn-theme-chip">
                            {value}
                        </button>
                    ))
                }
            </row>
        </section>

        <section class="slide-help-section">
            <span is-="badge" class="shs-title shs-title-blue"
                >&#xf031; Font</span
            >
            <row class="shn-theme-buttons" gap-="0">
                {
                    Object.entries(fontOptions).map(([key, value]) => (
                        <button
                            data-font-option={key}
                            aria-selected="false"
                            class="shn-theme-chip shn-font-chip">
                            {value}
                        </button>
                    ))
                }
            </row>
        </section>

        <section class="slide-help-section">
            <span is-="badge" class="shs-title shs-title-blue"
                >&#xf121; Code Font</span
            >
            <row class="shn-theme-buttons" gap-="0">
                {
                    Object.entries(codeFontOptions).map(([key, value]) => (
                        <button
                            data-code-font-option={key}
                            aria-selected="false"
                            class="shn-theme-chip shn-code-font-chip">
                            {value}
                        </button>
                    ))
                }
            </row>
        </section>

        <section class="slide-help-section">
            <span is-="badge" class="shs-title shs-title-purple"
                >&#xf03a; Table of Contents</span
            >
            <ol id="slide-help-toc" class="slide-help-toc"></ol>
        </section>

        <section class="slide-help-section">
            <span is-="badge" class="shs-title shs-title-orange"
                >&#xf11c; <u>K</u>eybinds</span
            >
            <div class="slide-help-keybinds">
                <code>j / →</code><span>Next slide / fragment</span>
                <code>k / ←</code><span>Previous slide / fragment</span>
                <code>Space</code><span>Advance (fragments first)</span>
                <code>g / G</code><span>First / last slide</span>
                <code>Ctrl+.</code><span>Open speaker notes window</span>
                <code>Esc</code><span>Toggle overview / close dialog</span>
                <code>f</code><span>Fullscreen</span>
                <code>p</code><span>Print / export to PDF</span>
                <code>? / : / m</code><span>This dialog</span>
            </div>
        </section>
    </div>
</dialog>

<style>
    .slide-help-dialog {
        margin: auto;
        padding: 0;
        background: transparent;
        border: none;
        color: var(--foreground1);
        max-width: min(86vw, 80ch);
        max-height: 86vh;

        &::backdrop {
            background-color: oklch(from var(--background0) l c h / 0.7);
            backdrop-filter: blur(4px);
        }
    }

    .slide-help-content {
        display: flex;
        flex-direction: column;
        gap: 0.5lh;
        /* WebTUI `box-=` reserves 1lh / 1ch for the border; the extra
           padding here gives content breathing room from that border. */
        padding: 1lh 2ch;
        background-color: var(--background0);
        max-height: 86vh;
        overflow-y: auto;
        scrollbar-width: thin;
    }

    /* Mobile (≤ 768px): take more of the viewport, shrink TOC entries
       so long slide titles don't wrap into towering 4-line blocks
       that hog vertical space, and tuck the navbar icons under the
       Slides badge in a tighter row. */
    @media (max-width: 768px) {
        .slide-help-dialog {
            /* <dialog> default is shrink-to-fit. Force the full width
               so the panel actually fills the viewport instead of
               sitting at the intrinsic width of the inner content
               (which was ~50vw because the navbar + TOC items are
               narrow on their own). */
            width: 95vw;
            max-width: 95vw;
            max-height: 92vh;
        }
        .slide-help-content {
            padding: 0.5lh 1ch;
            gap: 0.25lh;
            max-height: 92vh;
            font-size: 0.95em;
            box-sizing: border-box;
            width: 100%;
        }
        /* Tighter TOC entries on mobile: smaller font + tighter
           line-height so each item is a single line where possible. */
        .slide-help-toc {
            font-size: 0.85em;
            line-height: 1.25;
        }
        .slide-help-toc li {
            margin-block: 0.1lh;
        }
    }

    .slide-help-navbar {
        display: flex;
        gap: 0;
        background-color: var(--background1);
        border: 1px solid var(--background2);
        align-self: flex-start;
    }
    .shn-link {
        all: unset;
        display: inline-flex;
        align-items: center;
        padding: 0 1ch;
        height: 1lh;
        color: var(--foreground3);
        cursor: pointer;
        font-family: var(--font-family);
        text-decoration: none;
        border-right: 1px solid var(--background2);
        transition:
            background-color 100ms linear,
            color 100ms linear;
        &:last-child {
            border-right: none;
        }
        &:hover,
        &:focus-visible {
            color: var(--foreground0);
            background-color: oklch(
                from var(--blue) calc(l * var(--oklch-scale, 0.85)) c h / 0.15
            );
        }
    }

    .slide-help-section {
        display: flex;
        flex-direction: column;
        gap: 0.5lh;
        margin-block-start: 0.5lh;
    }
    .shs-title {
        background-image: none;
        --badge-text: none;
        --badge-color: none;
        --color: var(--accent, var(--blue));
        color: var(--color);
        background-color: oklch(
            from var(--color) calc(l * var(--oklch-scale, 0.85)) c h / 0.1
        );
        font-weight: bold;
        align-self: flex-start;
        u {
            text-decoration: underline;
        }
    }
    .shs-title-green {
        --color: var(--green);
    }
    .shs-title-blue {
        --color: var(--blue);
    }
    .shs-title-orange {
        --color: var(--orange);
    }
    .shs-title-purple {
        --color: var(--purple, var(--pink));
    }

    .shn-theme-buttons {
        gap: 0;
        flex-wrap: wrap;
    }
    .shn-theme-chip {
        all: unset;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        height: 1lh;
        padding: 0 1ch;
        color: var(--foreground2);
        border: 1px solid var(--background2);
        border-right-width: 0;
        background-color: var(--background0);
        transition:
            background-color 100ms linear,
            color 100ms linear;
        &:last-of-type {
            border-right-width: 1px;
        }
        &:hover,
        &:focus-visible {
            color: var(--foreground0);
            background-color: oklch(
                from var(--blue) calc(l * var(--oklch-scale, 0.85)) c h / 0.1
            );
        }
        &[aria-selected='true'] {
            color: var(--foreground0);
            background-color: oklch(
                from var(--green) calc(l * var(--oklch-scale, 0.85)) c h / 0.15
            );
            font-weight: bold;
        }
    }
    /* Font picker: match the blue accent used by the section title above. */
    .shn-font-chip[aria-selected='true'] {
        background-color: oklch(
            from var(--blue) calc(l * var(--oklch-scale, 0.85)) c h / 0.15
        ) !important;
    }

    .slide-help-toc {
        list-style: none;
        padding: 0;
        margin: 0;
        /* Cap TOC at a fraction of the viewport so it never pushes the
           keybinds section off the bottom of the dialog. */
        max-height: min(40vh, 14lh);
        overflow-y: auto;
        scrollbar-width: thin;
    }
    .slide-help-toc li {
        margin: 0;
    }
    .slide-help-toc a {
        display: flex;
        gap: 1ch;
        align-items: baseline;
        padding: 0 1ch;
        color: var(--foreground1);
        text-decoration: none;
        line-height: 1.25;
        &:hover,
        &:focus-visible {
            background-color: oklch(
                from var(--blue) calc(l * var(--oklch-scale, 0.85)) c h / 0.1
            );
        }
        &[data-current] {
            color: var(--accent, var(--blue));
            font-weight: bold;
        }
    }
    .slide-help-toc .toc-num {
        color: var(--foreground3);
        flex-shrink: 0;
        width: 4ch;
        text-align: right;
    }

    .slide-help-keybinds {
        display: grid;
        /* Two pairs of (key, description). Use 1fr for both description
           columns so they share remaining width equally — and `minmax(0, 1fr)`
           so they can shrink+wrap instead of forcing the grid wider than
           the dialog. */
        grid-template-columns: max-content minmax(0, 1fr) max-content minmax(
                0,
                1fr
            );
        column-gap: 1ch;
        row-gap: 0.25lh;
        align-items: baseline;
        width: 100%;
        code {
            justify-self: end;
            color: var(--foreground0);
            background-color: var(--background2);
            border: 1px solid var(--foreground2);
            border-radius: 3px;
            padding: 0 0.5ch;
            font-family: var(--font-family);
            font-size: 0.9em;
            white-space: nowrap;
        }
        span {
            color: var(--foreground2);
            min-width: 0;
            /* Allow the description text to wrap if needed instead of
               pushing the column wider than its grid track. */
            white-space: normal;
            overflow-wrap: break-word;
        }
    }
    /* Collapse the 4-column desktop grid (two (key, description) pairs
       side by side) to a single 2-column stack on mobile. Breakpoint
       matches the dialog's own mobile breakpoint (768px) — at 600-768px
       the dialog was already in mobile mode while the keybind grid
       still tried to fit 4 columns, pushing the second pair past the
       right edge. */
    @media (max-width: 768px) {
        .slide-help-keybinds {
            grid-template-columns: max-content minmax(0, 1fr);
        }
    }
</style>

<script>
    const dlg = document.getElementById(
        'slide-help-dialog',
    ) as HTMLDialogElement | null
    if (dlg) {
        document
            .getElementById('slide-help-close')
            ?.addEventListener('click', () => dlg.close())
        // Click outside content to close
        dlg.addEventListener('click', (e) => {
            if (e.target === dlg) dlg.close()
        })

        // Build the TOC from slide titles
        const buildToc = () => {
            const tocEl = document.getElementById('slide-help-toc')
            if (!tocEl) return
            const slides = Array.from(
                document.querySelectorAll<HTMLElement>('[is-~="slide"]'),
            )
            tocEl.innerHTML = ''
            slides.forEach((s, i) => {
                const h = s.querySelector('h1, h2, h3')
                const title = h?.textContent?.trim() ?? `Slide ${i + 1}`
                const li = document.createElement('li')
                const a = document.createElement('a')
                a.href = `#${i + 1}`
                a.innerHTML = `<span class="toc-num">${i + 1}.</span> <span class="toc-title">${title}</span>`
                if (s.hasAttribute('data-current')) {
                    a.setAttribute('data-current', '')
                }
                a.addEventListener('click', () => dlg.close())
                li.appendChild(a)
                tocEl.appendChild(li)
            })
        }
        // Build TOC every time the dialog opens. <dialog>'s native
        // toggle event isn't reliable for modal mode, so we observe the
        // `open` attribute instead.
        const onOpen = () => {
            if (dlg.open) {
                buildToc()
                syncActive()
            }
        }
        new MutationObserver(onOpen).observe(dlg, {
            attributes: true,
            attributeFilter: ['open'],
        })

        // Theme picker: chip click → update --webtui-theme + persist.
        const themeChips = dlg.querySelectorAll<HTMLElement>(
            '.shn-theme-chip[data-theme-option]',
        )
        let pinnedUntilPicked = true
        const colorSchemeQuery = window.matchMedia(
            '(prefers-color-scheme: dark)',
        )
        const resolveTheme = (theme: string) =>
            theme === 'auto'
                ? colorSchemeQuery.matches
                    ? 'custom-dark'
                    : 'custom-light'
                : theme
        const setTheme = (theme: string) => {
            // Apply the resolved theme to the DOM; remember literal
            // choice (incl. 'auto') in storage so the chip shows the
            // right selection and live-follows OS preference changes.
            document.documentElement.setAttribute(
                'data-webtui-theme',
                resolveTheme(theme),
            )
            localStorage.setItem('webtui-theme', theme)
            themeChips.forEach((btn) => {
                const v = btn.getAttribute('data-theme-option')
                btn.setAttribute('aria-selected', String(v === theme))
            })
        }
        themeChips.forEach((btn) => {
            btn.addEventListener('click', () => {
                const v = btn.getAttribute('data-theme-option')
                pinnedUntilPicked = false
                if (v) setTheme(v)
            })
        })
        colorSchemeQuery.addEventListener('change', () => {
            // A deck pinned to a theme does not follow the OS.
            if (
                localStorage.getItem('webtui-theme') === 'auto' &&
                !document.documentElement.dataset.deckTheme
            ) {
                setTheme('auto')
            }
        })

        // Font picker: chip click → update --mono-font + persist.
        const fontChips = dlg.querySelectorAll<HTMLElement>(
            '.shn-font-chip[data-font-option]',
        )
        const setFont = (font: string) => {
            document.documentElement.setAttribute('data-mono-font', font)
            // A pick is explicit: clear the fallback mark so a template
            // theme's default body font stops applying (Layout.astro).
            document.documentElement.removeAttribute('data-font-default')
            localStorage.setItem('mono-font', font)
            fontChips.forEach((btn) => {
                const v = btn.getAttribute('data-font-option')
                btn.setAttribute('aria-selected', String(v === font))
            })
        }
        fontChips.forEach((btn) => {
            btn.addEventListener('click', () => {
                const v = btn.getAttribute('data-font-option')
                if (v) setFont(v)
            })
        })

        // Code font picker: the second, independent axis (see
        // Filter.astro). Sets data-code-font + persists 'code-font'.
        const codeFontChips = dlg.querySelectorAll<HTMLElement>(
            '.shn-code-font-chip[data-code-font-option]',
        )
        const setCodeFont = (font: string) => {
            document.documentElement.setAttribute('data-code-font', font)
            localStorage.setItem('code-font', font)
            codeFontChips.forEach((btn) => {
                const v = btn.getAttribute('data-code-font-option')
                btn.setAttribute('aria-selected', String(v === font))
            })
        }
        codeFontChips.forEach((btn) => {
            btn.addEventListener('click', () => {
                const v = btn.getAttribute('data-code-font-option')
                if (v) setCodeFont(v)
            })
        })

        // Mark the currently-active chip on open. Prefer the literal
        // stored value (so 'auto' shows as selected) and fall back to
        // the resolved attribute when no choice is saved.
        const syncActive = () => {
            // A pinned deck renders its own theme whatever is stored, so
            // mark that one until the viewer picks another this session.
            const curTheme =
                (pinnedUntilPicked &&
                    document.documentElement.dataset.deckTheme) ||
                localStorage.getItem('webtui-theme') ||
                document.documentElement.getAttribute('data-webtui-theme') ||
                ''
            themeChips.forEach((btn) => {
                const v = btn.getAttribute('data-theme-option')
                btn.setAttribute('aria-selected', String(v === curTheme))
            })
            // With no stored body font, a branded theme's default font
            // (the [data-font-default] mark; themes/doe.css, alcf.css)
            // is what renders — mark no chip rather than the fallback.
            const themeDefaultActive =
                document.documentElement.hasAttribute('data-font-default') &&
                ['doe', 'alcf'].includes(curTheme)
            const curFont =
                localStorage.getItem('mono-font') ??
                (themeDefaultActive
                    ? ''
                    : (document.documentElement.getAttribute(
                          'data-mono-font',
                      ) ?? 'miosevka-qp'))
            fontChips.forEach((btn) => {
                const v = btn.getAttribute('data-font-option')
                btn.setAttribute('aria-selected', String(v === curFont))
            })
            const curCodeFont =
                document.documentElement.getAttribute('data-code-font') ??
                'miosevka-term'
            codeFontChips.forEach((btn) => {
                const v = btn.getAttribute('data-code-font-option')
                btn.setAttribute('aria-selected', String(v === curCodeFont))
            })
        }
    }
</script>
