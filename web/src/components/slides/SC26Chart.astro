---
interface Props {
    kind: 'loss' | 'loss-zoom' | 'mds-loss' | 'optimizer-loss' | 'optimizer-grad' | 'hellaswag-history' | 'hellaswag' | 'arc_easy' | 'arc_challenge' | 'winogrande'
    fallback?: string
    label: string
    compact?: boolean
}
const { kind, fallback, label, compact = false } = Astro.props
---

<div class:list={['sc26-chart', { compact }]} data-sc26-chart={kind}>
    {fallback && <img src={fallback} alt={label} />}
    <div class="canvas-frame" hidden>
        <canvas role="img" aria-label={label}></canvas>
    </div>
</div>

<style>
    .sc26-chart { width: 100%; min-width: 0; }
    .sc26-chart > img { display: block; width: 100%; max-height: 61vh; object-fit: contain; }
    .compact > img { max-height: 28vh; }
    .canvas-frame { position: relative; height: clamp(200px, 56vh, 680px); min-width: 0; }
    /* Portrait phones (e.g. 402x874 iPhone, ratio < 0.9): the fixed
       clamp() height left ~55% of the slide empty. Let the frame grow to
       fill whatever vertical room the flex column has left after the
       heading/caption, keeping a floor so it never collapses. Only in
       portrait \u2014 desktop keeps its authored height. */
    @media (orientation: portrait) and (max-aspect-ratio: 9/10) {
        /* Compact panels live in a 2-up grid; leave them at their compact
           height so the grid doesn't overflow the slide. */
        .sc26-chart:not(.compact) { display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; }
        .sc26-chart:not(.compact) .canvas-frame { height: auto; flex: 1 1 0; min-height: var(--sc26-frame-min, clamp(260px, 52vh, 62vh)); }
    }
    @media (max-width: 700px) {
        .canvas-frame { height: clamp(180px, 46vh, 420px); }
        .canvas-frame :global(canvas) { max-width: 100%; }
    }
    .compact .canvas-frame { height: clamp(150px, 32vh, 380px); }
    .sc26-chart[data-ready] > img { display: none; }
    @media print {
        .sc26-chart[data-ready] > img { display: block; }
        .sc26-chart .canvas-frame { display: none; }
    }
</style>

<script>
    import './sc26-charts'
</script>
