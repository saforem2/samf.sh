---
interface Props {
    kind: 'loss' | 'loss-zoom' | 'mds-loss' | 'optimizer-loss' | 'optimizer-grad' | 'hellaswag-history' | 'hellaswag' | 'arc_easy' | 'arc_challenge' | 'winogrande'
    fallback?: string
    label: string
    compact?: boolean
}
const { kind, fallback, label, compact = false } = Astro.props
---

<div class:list={['sc26-chart', { compact }]} data-sc26-chart={kind}>
    {fallback && <img src={fallback} alt={label} />}
    <div class="canvas-frame" hidden>
        <canvas role="img" aria-label={label}></canvas>
    </div>
</div>

<style>
    .sc26-chart { width: 100%; min-width: 0; }
    .sc26-chart > img { display: block; width: 100%; max-height: 61vh; object-fit: contain; }
    .compact > img { max-height: 28vh; }
    .canvas-frame { position: relative; height: clamp(245px, 56vh, 680px); }
    .compact .canvas-frame { height: clamp(150px, 32vh, 380px); }
    .sc26-chart[data-ready] > img { display: none; }
    @media print {
        .sc26-chart[data-ready] > img { display: block; }
        .sc26-chart .canvas-frame { display: none; }
    }
</style>

<script>
    import './sc26-charts'
</script>
