<div class="retry-illustration" data-training-replay>
    <div class="command-bar">
        <span aria-hidden="true">$</span>
        <code>ezpz launch --auto-retry</code>
    </div>
    <div class="illustration-body">
        <div class="diagram-column">
            <figure class="training-figure">
                <canvas
                    width="960"
                    height="520"
                    data-training-canvas
                    role="img"
                    aria-label="Illustration of eight training hosts, a gradient collective, a checkpoint, and a spare host."
                    >Eight training hosts exchange gradients. After a stall, a
                    spare replaces one host and the trainer reloads a
                    checkpoint.</canvas
                >
                <figcaption class="diagram-key">
                    <span class="key-shards" aria-hidden="true">
                        <i style="--c: var(--red)"></i><i
                            style="--c: var(--orange)"></i><i
                            style="--c: var(--yellow)"></i><i
                            style="--c: var(--green)"></i><i
                            style="--c: var(--teal)"></i><i
                            style="--c: var(--blue)"></i><i
                            style="--c: var(--purple)"></i><i
                            style="--c: var(--pink)"></i>
                    </span>
                    <span>Batch shards 0–7</span>
                    <span><i class="key-recovery"></i>Checkpoint / spare</span>
                </figcaption>
            </figure>
        </div>
        <aside class="retry-story">
            <div class="story-content" aria-live="polite" aria-atomic="true">
                <span class="story-label" data-kicker>Training</span>
                <h3 data-title>One step, eight hosts</h3>
                <p data-detail
                    >Each host processes a shard. Gradients synchronize before
                    the step can finish.</p
                >
                <p class="story-note" data-note
                    >The completed step is saved to a checkpoint.</p
                >
            </div>
            <p class="story-footnote"
                >Illustrative run · 30 minutes compressed</p
            >
        </aside>
    </div>
    <div class="event-bar">
        <div class="event-trace">
            <strong>Example attempt</strong>
            <span data-event>step 3003 · distributing batch shards</span>
        </div>
        <div class="replay-controls" data-controls hidden>
            <button type="button" data-previous aria-label="Previous scene"
                >←</button
            >
            <button type="button" data-play>Play</button>
            <button type="button" data-next aria-label="Next scene">→</button>
            <input
                type="range"
                data-seek
                min="0"
                max="1000"
                step="1"
                value="0"
                aria-label="Seek through the retry animation"
                aria-valuetext="Training step"
            />
            <span data-progress aria-hidden="true">1 / 13</span>
        </div>
    </div>
</div>

<script>
    import { initTrainingReplay } from './auto-retry-flow'

    for (const root of document.querySelectorAll<HTMLElement>(
        '[data-training-replay]',
    )) {
        initTrainingReplay(root)
    }
</script>

