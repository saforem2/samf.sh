---
/**
 * Presentation wrapper. Owns navigation state (current slide,
 * fragments), keyboard handling, URL-fragment sync, speaker-window
 * popup, overview mode, and the bottom status bar.
 */
import SlideHelpDialog from '@/components/slides/SlideHelpDialog.astro'

interface Props {
    title?: string
    deckTheme?: string
}
const { deckTheme } = Astro.props
const doe = deckTheme === 'doe'
const alcf = deckTheme === 'alcf'
const pytorch = deckTheme === 'pytorch'
// A branded deck renders both footers; slides.css shows the one that
// matches the live theme, so switching themes in the picker swaps the
// branding too. The pin only chooses the opening theme.
const branded = doe || alcf
const url = Astro.url.pathname
const canonical = `samf.sh${url}`
---

<main is-="presentation" data-mode="deck" data-deck-theme={deckTheme}>
    <div is-="slides">
        <slot />
    </div>
    {
        !pytorch && (
            <>
                <img
                    src="/anl-logos/anl-color-light.svg"
                    alt=""
                    aria-hidden="true"
                    class="deck-corner-logo deck-corner-logo-light"
                />
                <img
                    src="/anl-logos/anl-color-dark.svg"
                    alt=""
                    aria-hidden="true"
                    class="deck-corner-logo deck-corner-logo-dark"
                />
            </>
        )
    }
    {
        branded && (
            <div class="doe-footer" aria-hidden="true">
                <img
                    src="/doe-template/genesis-on-light.png"
                    alt=""
                    class="doe-footer-genesis"
                    width="706"
                    height="96"
                />
                <img
                    src="/doe-template/doe-on-light.png"
                    alt=""
                    class="doe-footer-doe"
                    width="1712"
                    height="96"
                />
            </div>
        )
    }
    {
        pytorch && (
            <div class="pytorch-footer" aria-hidden="true">
                <img
                    src="/anl-logos/anl-alcf-lockup-light.svg"
                    alt=""
                    class="pytorch-footer-anl"
                    width="196"
                    height="30"
                    loading="eager"
                />
                <img
                    src="/anl-logos/anl-alcf-lockup-dark.svg"
                    alt=""
                    class="pytorch-footer-anl-dark"
                    width="196"
                    height="30"
                    loading="eager"
                />
                <img
                    src="/pytorch-template/pytorchcon-na26-black.svg"
                    alt=""
                    class="pytorch-footer-lockup"
                    width="414"
                    height="218"
                    loading="eager"
                />
                <img
                    src="/pytorch-template/pytorchcon-na26-white.svg"
                    alt=""
                    class="pytorch-footer-lockup-dark"
                    width="414"
                    height="218"
                    loading="eager"
                />
            </div>
        )
    }
    {
        branded && (
            <div class="alcf-footer" aria-hidden="true">
                <span>
                    <img
                        src="/alcf-template/doe-lockup.png"
                        alt=""
                        class="alcf-footer-doe"
                        width="1100"
                        height="116"
                    />
                    <img
                        src="/alcf-template/doe-lockup-on-dark.png"
                        alt=""
                        class="alcf-footer-doe-dark"
                        width="714"
                        height="73"
                    />
                </span>
                <span>
                    <img
                        src="/alcf-template/argonne-alcf-lockup.png"
                        alt=""
                        class="alcf-footer-anl"
                        width="2005"
                        height="256"
                    />
                    <img
                        src="/alcf-template/argonne-alcf-lockup-on-dark.png"
                        alt=""
                        class="alcf-footer-anl-dark"
                        width="1946"
                        height="249"
                    />
                </span>
            </div>
        )
    }
    <a class="deck-slide-number" id="deck-slide-number" href="#1"
        ><span id="deck-slide-number-text">1</span></a
    >
    <div is-="slide-status">
        <button
            type="button"
            id="ss-help-btn"
            class="ss-menu"
            aria-label="Show keybinds and navigation">&#xf0c9;</button
        >
        <div class="ss-center">
            <a class="ss-link" href={url}>{canonical}</a>
            <div class="ss-mobile-nav" aria-label="Slide navigation">
                <button type="button" id="ss-prev" aria-label="Previous slide">
                    <span aria-hidden="true">←</span>
                </button>
                <button type="button" id="ss-next" aria-label="Next slide">
                    <span aria-hidden="true">→</span>
                </button>
            </div>
        </div>
        <a id="ss-pos-link" class="ss-pos" href="#1">
            <span id="ss-current">1</span>
        </a>
    </div>
    <SlideHelpDialog />
</main>

<style is:global>
    @import '@/styles/slides.css';
</style>

<script>
    // Tiny presentation runtime. Tracks the current slide index, mirrors
    // it to the URL hash (#3 = 4th slide), responds to keyboard nav,
    // and broadcasts the index to a speaker-window popup over a
    // BroadcastChannel so the popup stays in sync with the main deck.
    const deck = document.querySelector(
        '[is-~="presentation"]',
    ) as HTMLElement | null
    if (deck) {
        const slides = Array.from(
            deck.querySelectorAll<HTMLElement>('[is-~="slide"]'),
        )
        const total = slides.length

        // Print-only deep link on every slide, so a PDF export points each
        // page back at the live deck. A real <a> (not ::after) stays
        // clickable in Chromium's PDF output. The title slide carries its
        // own QR + URL, so it is skipped.
        const webPath = location.pathname.replace(/\/$/, '')
        slides.forEach((slide, i) => {
            if (slide.id === 'title-slide' || slide.id === 'cover') return
            const link = document.createElement('a')
            link.className = 'slide-web-link'
            link.href = `https://samf.sh${webPath}/#${i + 1}`
            link.textContent = `Web version ↗ samf.sh${webPath}#${i + 1}`
            slide.append(link)
        })

        const currentEl = document.getElementById('ss-current')
        const posLinkEl = document.getElementById('ss-pos-link')
        const prevButtonEl = document.getElementById(
            'ss-prev',
        ) as HTMLButtonElement | null
        const nextButtonEl = document.getElementById(
            'ss-next',
        ) as HTMLButtonElement | null
        const deckNumEl = document.getElementById('deck-slide-number')
        const deckNumTextEl = document.getElementById('deck-slide-number-text')
        // Tag each slide with its 1-based index for the overview-mode
        // corner badge (CSS ::after reads data-slide-index via attr()).
        slides.forEach((s, i) => {
            s.dataset.slideIndex = String(i + 1)
        })

        // Dense tables remain semantic tables for assistive technology and
        // desktop. Add header labels to their cells so mobile CSS can present
        // each row as a readable card without losing column context.
        if (deck.dataset.deckTheme === 'pytorch') {
            slides.forEach((slide) => {
                if (slide.id === 'frame') return // already has authored cards
                slide
                    .querySelectorAll<HTMLTableElement>('table')
                    .forEach((table) => {
                        const header = table.querySelector('thead tr')
                        const headers = Array.from(
                            header?.querySelectorAll<HTMLElement>('th, td') ??
                                [],
                        ).map((cell) => cell.innerText.trim())
                        const rows = Array.from(
                            table.querySelectorAll('tbody tr'),
                        )
                        const columnCount = Math.max(
                            0,
                            ...rows.map(
                                (row) => row.querySelectorAll('th, td').length,
                            ),
                        )
                        const dense =
                            slide.id === 'why-fork-broke' ||
                            columnCount >= 3 ||
                            rows.length >= 4 ||
                            table.innerText.length >= 320
                        if (!dense) return
                        table.dataset.mobileCards = ''
                        rows.forEach((row) => {
                            row.querySelectorAll<HTMLElement>('th, td').forEach(
                                (cell, index) => {
                                    if (index === 0) {
                                        cell.dataset.mobileTitle = ''
                                        return
                                    }
                                    cell.dataset.mobileLabel =
                                        headers[index] || `Detail ${index + 1}`
                                },
                            )
                        })
                    })
            })
        }

        const channel = new BroadcastChannel('slides-sync')
        const isSpeaker =
            document.body.dataset.speakerWindow === 'true' ||
            new URLSearchParams(location.search).has('speaker')
        if (isSpeaker) document.body.dataset.speakerWindow = 'true'

        const indexFromHash = () => {
            const hash = location.hash.slice(1)
            const i = /^\d+$/.test(hash)
                ? Number(hash) - 1
                : slides.findIndex((slide) => slide.id === hash)
            return Math.max(0, Math.min(total - 1, i))
        }

        let current = indexFromHash()
        let fragmentIndex = 0

        const fragmentsFor = (i: number) =>
            Array.from(slides[i].querySelectorAll<HTMLElement>('.fragment'))

        // Screen fit (PyTorch deck): on shorter landscape screens (e.g.
        // 1440x900) dense slides ran under the footer logos or off the
        // bottom. Scale the current slide's font size down (min 0.6) until
        // its content clears the logo band. Phones, portrait screens,
        // and short phone-width landscape screens scroll instead.
        const screenFitDeck = deck.dataset.deckTheme === 'pytorch'
        const clearScreenFit = (inner: HTMLElement) => {
            inner.style.removeProperty('font-size')
            delete inner.dataset.screenFit
        }
        const fitScreenSlide = (slide: HTMLElement | undefined) => {
            if (
                !screenFitDeck ||
                !slide ||
                slide.id === 'title-slide' ||
                slide.id === 'cover'
            )
                return
            const inner = slide.querySelector<HTMLElement>('.slide-inner')
            if (!inner) return
            // Scale the slide's font size, not CSS zoom: text and tables
            // shrink, diagrams keep their own size, and mermaid labels
            // (foreignObject) are never measured or drawn under a zoom.
            clearScreenFit(inner)
            const base = parseFloat(getComputedStyle(inner).fontSize)
            const setFit = (f: number) => {
                if (f >= 1) return clearScreenFit(inner)
                inner.style.setProperty(
                    'font-size',
                    `${(base * f).toFixed(2)}px`,
                    'important',
                )
                inner.dataset.screenFit = f.toFixed(3)
            }
            // Wait for diagrams to draw (mermaid:rendered refits later).
            const pendingDiagram = Array.from(
                inner.querySelectorAll<HTMLElement>('.mermaid'),
            ).some((m) => m.offsetParent !== null && !m.querySelector('svg'))
            if (pendingDiagram) return
            const reflow =
                window.matchMedia('print').matches ||
                window.matchMedia(
                    '(max-width: 768px), (orientation: portrait), (max-width: 1100px) and (max-height: 500px)',
                )
                    .matches
            if (reflow) return
            const logos = Array.from(
                document.querySelectorAll<HTMLElement>('.pytorch-footer img'),
            )
                .map((img) => img.getBoundingClientRect())
                .filter((r) => r.height > 0)
            // Content must stay inside the slide, and above a logo only
            // where it sits horizontally over that logo (a centered QR code
            // can drop below the corner logos).
            const fits = () => {
                const innerRect = inner.getBoundingClientRect()
                return Array.from(inner.querySelectorAll('*'))
                    .filter(
                        (el) =>
                            el.tagName === 'SUMMARY' ||
                            !el.closest('details:not([open])'),
                    )
                    .map((el) => el.getBoundingClientRect())
                    .filter((r) => r.height > 0)
                    .every((r) => {
                        if (r.bottom > innerRect.bottom + 1) return false
                        return logos.every(
                            (l) =>
                                r.right <= l.left ||
                                r.left >= l.right ||
                                r.bottom <= l.top - 8,
                        )
                    })
            }
            if (fits()) return
            let lo = 0.6
            let hi = 1
            for (let i = 0; i < 7; i++) {
                const mid = (lo + hi) / 2
                setFit(mid)
                if (fits()) lo = mid
                else hi = mid
            }
            setFit(lo)
        }

        const render = (i: number, opts?: { broadcast?: boolean }) => {
            current = Math.max(0, Math.min(total - 1, i))
            fragmentIndex = 0
            slides.forEach((s, idx) => {
                if (idx === current) s.setAttribute('data-current', '')
                else s.removeAttribute('data-current')
                s.querySelectorAll('.fragment').forEach((f) =>
                    f.removeAttribute('data-visible'),
                )
                s.querySelectorAll<HTMLVideoElement>(
                    'video[data-autoplay]',
                ).forEach((video) => {
                    if (idx === current) {
                        void video.play().catch(() => {})
                    } else {
                        video.pause()
                    }
                })
            })
            if (currentEl) currentEl.textContent = String(current + 1)
            const expected = `#${current + 1}`
            if (posLinkEl) posLinkEl.setAttribute('href', expected)
            if (prevButtonEl) {
                prevButtonEl.disabled = current === 0
                prevButtonEl.setAttribute(
                    'aria-label',
                    `Previous slide${current === 0 ? ' (first slide)' : `, ${current} of ${total}`}`,
                )
            }
            if (nextButtonEl) {
                nextButtonEl.disabled = current === total - 1
                nextButtonEl.setAttribute(
                    'aria-label',
                    `Next slide${current === total - 1 ? ' (last slide)' : `, ${current + 2} of ${total}`}`,
                )
            }
            if (deckNumTextEl)
                deckNumTextEl.textContent = `${current + 1} / ${slides.length}`
            if (deckNumEl) deckNumEl.setAttribute('href', expected)
            if (location.hash !== expected) {
                history.replaceState(null, '', expected)
            }
            fitScreenSlide(slides[current])
            if (opts?.broadcast !== false) {
                channel.postMessage({ type: 'goto', index: current })
            }
        }

        const advance = (delta: number) => {
            const frags = fragmentsFor(current)
            if (delta > 0 && fragmentIndex < frags.length) {
                frags[fragmentIndex].setAttribute('data-visible', '')
                fragmentIndex++
                return
            }
            if (delta < 0 && fragmentIndex > 0) {
                fragmentIndex--
                frags[fragmentIndex].removeAttribute('data-visible')
                return
            }
            render(current + delta)
        }

        const isTyping = () => {
            const a = document.activeElement
            if (!a) return false
            const tag = a.tagName
            return (
                tag === 'INPUT' ||
                tag === 'TEXTAREA' ||
                tag === 'VIDEO' ||
                tag === 'AUDIO' ||
                (a as HTMLElement).isContentEditable
            )
        }

        const setMode = (mode: 'deck' | 'overview') => {
            deck.dataset.mode = mode
            if (mode === 'overview') updateOverviewScale()
        }

        // In overview mode the .slide-inner is rendered at 1280x720 and
        // transform-scaled to fit the tile width. Compute the scale once
        // per resize so each tile fits its current grid cell.
        const updateOverviewScale = () => {
            slides.forEach((s) => {
                const tileWidth = s.getBoundingClientRect().width
                const scale = tileWidth / 1280
                s.style.setProperty('--ov-scale', String(scale))
            })
        }
        window.addEventListener('resize', () => {
            if (deck.dataset.mode === 'overview') updateOverviewScale()
            fitScreenSlide(slides[current])
        })
        // Mermaid diagrams and webfonts change heights after first paint.
        window.addEventListener('load', () =>
            setTimeout(() => fitScreenSlide(slides[current]), 1500),
        )
        // mermaid-render.ts: drop every screen fit before it measures, then
        // refit the current slide once the diagrams are drawn.
        window.addEventListener('mermaid:render-start', () =>
            slides.forEach((s) => {
                const inner = s.querySelector<HTMLElement>('.slide-inner')
                if (inner) clearScreenFit(inner)
            }),
        )
        window.addEventListener('mermaid:rendered', () =>
            fitScreenSlide(slides[current]),
        )

        const openSpeakerWindow = () => {
            const url = new URL(location.href)
            url.searchParams.set('speaker', '1')
            window.open(
                url.toString(),
                'slides-speaker',
                'width=600,height=800',
            )
        }

        const anyDialogOpen = () => !!document.querySelector('dialog[open]')

        window.addEventListener('keydown', (e) => {
            if (isTyping()) return
            // Defer to any open <dialog> — Esc closes it natively; other
            // keys may be used inside it (TOC navigation, theme select).
            if (anyDialogOpen()) return
            switch (e.key) {
                case 'j':
                case 'ArrowRight':
                case ' ':
                    e.preventDefault()
                    advance(1)
                    break
                case 'k':
                case 'ArrowLeft':
                    e.preventDefault()
                    advance(-1)
                    break
                case 'g':
                    e.preventDefault()
                    render(0)
                    break
                case 'G':
                    e.preventDefault()
                    render(total - 1)
                    break
                case '.':
                    // Ctrl+. opens the speaker-notes popup. Avoids the
                    // global vim `s`-key sidebar focus on doc pages, and
                    // Ctrl+. is not reserved by any major browser.
                    if (!e.ctrlKey) break
                    e.preventDefault()
                    if (!isSpeaker) openSpeakerWindow()
                    break
                case 'Escape':
                    e.preventDefault()
                    setMode(
                        deck.dataset.mode === 'overview' ? 'deck' : 'overview',
                    )
                    break
                case 'f':
                    e.preventDefault()
                    if (!document.fullscreenElement) deck.requestFullscreen()
                    else document.exitFullscreen()
                    break
                case '?':
                case ':':
                case 'm':
                    e.preventDefault()
                    openHelp()
                    break
                case 'p':
                    if (e.ctrlKey || e.metaKey) return
                    e.preventDefault()
                    enterPrintMode()
                    break
            }
        })

        // Print-PDF mode: lay every slide out flat (one per page) and
        // pop the browser's print dialog. ?print-pdf or `p` triggers it.
        // Fit-to-page for print: the print rules clip any slide whose
        // content is taller than the sheet, and fragment-heavy slides
        // sum every step in print, so a dense slide can run past the
        // page edge and lose its tail. Measure each slide as laid out
        // for print and scale its type down just enough, via the
        // --print-fit multiplier in the print font-size rule; slides
        // that fit keep 1 and print unchanged. A few passes: the first
        // shrink reflows text, the rest trim what is left.
        const fitPrintSlides = () => {
            document
                .querySelectorAll<HTMLElement>('[is-~="slide"]')
                .forEach((slide) => {
                    const inner =
                        slide.querySelector<HTMLElement>('.slide-inner')
                    if (!inner) return
                    inner.style.removeProperty('--print-fit')
                    delete inner.dataset.printGrow
                    for (let pass = 0; pass < 3; pass++) {
                        const avail = inner.clientHeight
                        const needed = inner.scrollHeight
                        if (needed <= avail + 1) break
                        const current =
                            parseFloat(
                                inner.style.getPropertyValue('--print-fit'),
                            ) || 1
                        const fit = Math.max(
                            0.55,
                            current * ((avail - 2) / needed) * 0.995,
                        )
                        inner.style.setProperty('--print-fit', fit.toFixed(3))
                    }
                    if (
                        growPrint &&
                        !['cover', 'title-slide'].includes(slide.id) &&
                        !inner.style.getPropertyValue('--print-fit')
                    )
                        growPrintSlide(inner)
                })
        }
        // Sparse slides print as a few small lines in the middle of the
        // page. On the PyTorch deck, top-align the content (data-print-grow,
        // slides.css) and scale text up (max 2.4x) until it would reach the
        // footer logo band or overflow sideways.
        const growPrint = deck.dataset.deckTheme === 'pytorch'
        const PRINT_FOOTER_RESERVE = 72 // px: logo band at the page bottom
        const contentBottom = (inner: HTMLElement) => {
            const top = inner.getBoundingClientRect().top
            // All descendants, not just children: a figure's <img> can
            // overflow its own box. Skip collapsed <details> bodies, which
            // can still report a box below the page.
            const bottoms = Array.from(inner.querySelectorAll('*'))
                .filter(
                    (el) =>
                        el.tagName === 'SUMMARY' ||
                        !el.closest('details:not([open])'),
                )
                .map((el) => el.getBoundingClientRect())
                .filter((r) => r.height > 0)
                .map((r) => r.bottom - top)
            return bottoms.length ? Math.max(...bottoms) : 0
        }
        const growPrintSlide = (inner: HTMLElement) => {
            const fits = () =>
                inner.scrollHeight <= inner.clientHeight + 1 &&
                inner.scrollWidth <= inner.clientWidth + 1 &&
                contentBottom(inner) <=
                    inner.clientHeight - PRINT_FOOTER_RESERVE
            inner.dataset.printGrow = ''
            if (!fits()) {
                delete inner.dataset.printGrow
                return
            }
            let lo = 1
            let hi = 2.4
            for (let i = 0; i < 7; i++) {
                const mid = (lo + hi) / 2
                inner.style.setProperty('--print-fit', mid.toFixed(3))
                if (fits()) lo = mid
                else hi = mid
            }
            inner.style.setProperty('--print-fit', lo.toFixed(3))
        }
        const clearPrintFit = () => {
            document
                .querySelectorAll<HTMLElement>('.slide-inner')
                .forEach((inner) => {
                    inner.style.removeProperty('--print-fit')
                    delete inner.dataset.printGrow
                })
        }
        window.addEventListener('beforeprint', fitPrintSlides)
        window.addEventListener('afterprint', clearPrintFit)

        const enterPrintMode = () => {
            document.body.classList.add('slides-print-mode')
            fitPrintSlides()
            // Wait one frame so layout applies before opening the dialog
            requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                    window.print()
                    // Clean up after the print dialog closes
                    const cleanup = () => {
                        clearPrintFit()
                        document.body.classList.remove('slides-print-mode')
                        window.removeEventListener('afterprint', cleanup)
                    }
                    window.addEventListener('afterprint', cleanup)
                })
            })
        }
        if (new URLSearchParams(location.search).has('print-pdf')) {
            window.addEventListener('load', () => enterPrintMode())
        }

        const openHelp = () => {
            const dlg = document.getElementById(
                'slide-help-dialog',
            ) as HTMLDialogElement | null
            if (dlg && !dlg.open) dlg.showModal()
        }

        document
            .getElementById('ss-help-btn')
            ?.addEventListener('click', openHelp)
        prevButtonEl?.addEventListener('click', () => advance(-1))
        nextButtonEl?.addEventListener('click', () => advance(1))

        // Click-to-zoom on any image inside a slide.
        const zoomDlg = document.createElement('dialog')
        zoomDlg.className = 'slide-zoom-dialog'
        zoomDlg.innerHTML = '<img />'
        document.body.appendChild(zoomDlg)
        zoomDlg.addEventListener('click', () => zoomDlg.close())
        deck.addEventListener('click', (e) => {
            const t = e.target as HTMLElement
            if (t.tagName === 'IMG' && t.closest('[is-~="slide"]')) {
                const img = zoomDlg.querySelector('img') as HTMLImageElement
                img.src = (t as HTMLImageElement).src
                img.alt = (t as HTMLImageElement).alt
                zoomDlg.showModal()
            }
        })

        // Tap zones for phones/VNC where swipe is awkward: tap the outer
        // 20% strips to navigate. Narrower than before to avoid stealing
        // clicks on links/images/mermaid in the center.
        const handleTap = (e: MouseEvent) => {
            if (deck.dataset.mode === 'overview') return
            const t = e.target as HTMLElement | null
            if (
                t?.closest(
                    'a, button, summary, input, textarea, img, .footnote-popover, .mermaid',
                )
            )
                return
            const w = window.innerWidth
            const x = (e as MouseEvent).clientX
            if (x < w * 0.2) {
                e.preventDefault()
                advance(-1)
            } else if (x > w * 0.8) {
                e.preventDefault()
                advance(1)
            }
        }
        deck.addEventListener('click', handleTap)

        // Click a slide in overview to jump to it
        slides.forEach((s, idx) => {
            s.addEventListener('click', () => {
                if (deck.dataset.mode === 'overview') {
                    render(idx)
                    setMode('deck')
                }
            })
        })

        // Touch / swipe navigation: phones have no keyboard. Horizontal
        // swipes advance/retreat slides unless they start inside a native
        // horizontal scroller, which must keep the gesture for its content.
        // All touch listeners stay passive so browser scrolling and
        // pinch-zoom remain native.
        const startsInHorizontalScroller = (target: Element | null) => {
            let node = target
            while (node && node !== deck) {
                if (node instanceof HTMLElement) {
                    const overflowX = getComputedStyle(node).overflowX
                    if (
                        ['auto', 'scroll', 'overlay'].includes(overflowX) &&
                        node.scrollWidth > node.clientWidth + 1
                    ) {
                        return true
                    }
                }
                node = node.parentElement
            }
            return false
        }
        let touchStartX = 0
        let touchStartY = 0
        let touchActive = false
        // Once we observe enough vertical movement to commit to a
        // scroll, lock this gesture out of the swipe handler. Prevents
        // accidental slide changes when the user scrolls a long slide
        // and lifts their finger with a small horizontal component.
        let verticalLock = false
        const SWIPE_MIN = 50 // px
        const SWIPE_RATIO = 1.5 // |dx| must be at least this × |dy|
        // If vertical movement exceeds this before any horizontal
        // intent is clear, treat the gesture as a scroll and ignore it.
        const VERT_LOCK = 12 // px
        deck.addEventListener(
            'touchstart',
            (e) => {
                if (e.touches.length !== 1) return // ignore multi-touch (pinch)
                if (anyDialogOpen()) return
                if (deck.dataset.mode === 'overview') return
                // Don't even start tracking if the touch began on an
                // interactive element — tap targets get to be tap
                // targets. (Previously we only filtered on touchend,
                // which still meant the gesture competed with the tap.)
                const target = e.target as HTMLElement | null
                if (
                    target?.closest(
                        'a, button, summary, input, textarea, img, .footnote-popover',
                    ) ||
                    startsInHorizontalScroller(target)
                ) {
                    touchActive = false
                    return
                }
                touchStartX = e.touches[0].clientX
                touchStartY = e.touches[0].clientY
                touchActive = true
                verticalLock = false
            },
            { passive: true },
        )
        deck.addEventListener(
            'touchmove',
            (e) => {
                if (!touchActive || verticalLock) return
                const t = e.touches[0]
                if (!t) return
                const dx = t.clientX - touchStartX
                const dy = t.clientY - touchStartY
                // If vertical motion clearly dominates before we hit
                // the swipe threshold, abandon this gesture so a brief
                // horizontal jitter at the end of the scroll doesn't
                // fire a slide change.
                if (Math.abs(dy) > VERT_LOCK && Math.abs(dy) > Math.abs(dx)) {
                    verticalLock = true
                }
            },
            { passive: true },
        )
        deck.addEventListener(
            'touchend',
            (e) => {
                if (!touchActive) return
                touchActive = false
                if (verticalLock) return
                const t = e.changedTouches[0]
                if (!t) return
                const dx = t.clientX - touchStartX
                const dy = t.clientY - touchStartY
                // Reject if it wasn't a horizontal swipe
                if (Math.abs(dx) < SWIPE_MIN) return
                if (Math.abs(dx) < SWIPE_RATIO * Math.abs(dy)) return
                // Right swipe → previous; left swipe → next. Matches
                // iOS/Android book-page convention.
                advance(dx < 0 ? 1 : -1)
            },
            { passive: true },
        )
        // Cancel — fires when the system (e.g. notification, browser
        // gesture) takes over the touch. Treat as no-swipe.
        deck.addEventListener(
            'touchcancel',
            () => {
                touchActive = false
                verticalLock = false
            },
            { passive: true },
        )

        // Hash changes from external nav (e.g. clicking a deep link).
        // Named slide IDs (for example #links) work alongside #N. Ignore
        // footnote backrefs and other anchors within the active slide.
        window.addEventListener('hashchange', () => {
            const hash = location.hash.slice(1)
            if (/^\d+$/.test(hash) || slides.some((slide) => slide.id === hash))
                render(indexFromHash())
        })

        // Speaker popup receives index changes from the main window
        if (isSpeaker) {
            channel.addEventListener('message', (e) => {
                if (e.data?.type === 'goto')
                    render(e.data.index, { broadcast: false })
            })
        }

        render(current, { broadcast: false })

        // Populate the Footnotes slide with content cloned from the
        // GFM-generated <section data-footnotes>. The source <section>
        // stays hidden (slides.css); the cloned <ol> lives inside the
        // #footnotes-target div on the dedicated Footnotes slide.
        const fnSection = document.querySelector<HTMLElement>(
            'section[data-footnotes], section.footnotes',
        )
        const fnTarget = document.getElementById('footnotes-target')
        if (fnSection && fnTarget) {
            const fnList = fnSection.querySelector('ol')
            if (fnList) {
                fnTarget.appendChild(fnList.cloneNode(true))
            }
        }

        // Wire up backref (`↩`) clicks on the cloned <ol>. The native
        // href="#user-content-fnref-N" would normally either (a) slam
        // hashchange → render(0), now neutered above, or (b) try to
        // scroll to a hidden in-doc target. Neither lands on the
        // slide the user actually wants. Intercept and navigate to
        // the slide containing the original [^N] reference, then
        // scroll the popover into view inside it.
        if (fnTarget) {
            fnTarget.addEventListener('click', (e) => {
                const a = (e.target as HTMLElement | null)?.closest(
                    'a[data-footnote-backref]',
                ) as HTMLAnchorElement | null
                if (!a) return
                const href = a.getAttribute('href') || ''
                const refId = href.startsWith('#') ? href.slice(1) : href
                if (!refId) return
                // After popover-build, the original <sup> is gone but
                // its cloned inner <a id="user-content-fnref-N"> lives
                // inside the popover trigger on the referencing slide.
                const target = document.getElementById(refId)
                if (!target) return
                const targetSlide =
                    target.closest<HTMLElement>('[is-~="slide"]')
                if (!targetSlide) return
                e.preventDefault()
                const idx = slides.findIndex((s) => s === targetSlide)
                if (idx < 0) return
                render(idx)
                requestAnimationFrame(() => {
                    target.scrollIntoView({
                        behavior: window.matchMedia(
                            '(prefers-reduced-motion: reduce)',
                        ).matches
                            ? 'auto'
                            : 'smooth',
                        block: 'center',
                    })
                })
            })
        }

        // Footnote hover/click popover (mirrors Doc.astro behavior).
        // Source `<section data-footnotes>` is hidden via slides.css;
        // the inline `[^N]` superscript becomes a hover popover whose
        // content is cloned from the matching footnote list-item.
        // The trigger is *also* a real anchor link that jumps to the
        // matching <li> inside the Footnotes slide on click — so users
        // who want to see all footnotes in context can click through.
        const footnoteRefs = deck.querySelectorAll<HTMLAnchorElement>(
            'a[data-footnote-ref]',
        )

        // Print-only footnotes: popovers do nothing on paper, so list each
        // slide's footnotes at the foot of its content. Built before the
        // popover pass below replaces the <sup> refs.
        slides.forEach((slide) => {
            const inner = slide.querySelector('.slide-inner')
            const refs = slide.querySelectorAll<HTMLAnchorElement>(
                'a[data-footnote-ref]',
            )
            if (!inner || refs.length === 0) return
            const list = document.createElement('ol')
            list.className = 'slide-print-footnotes'
            const seen = new Set<string>()
            refs.forEach((ref) => {
                const id = ref.getAttribute('href')?.replace('#', '')
                if (!id || seen.has(id)) return
                seen.add(id)
                const li = document.getElementById(id)
                if (!li) return
                const item = li.cloneNode(true) as HTMLElement
                item.removeAttribute('id')
                item.querySelectorAll('a[data-footnote-backref]').forEach((a) =>
                    a.remove(),
                )
                item.querySelectorAll('p').forEach((p) => {
                    while (p.firstChild)
                        p.parentNode!.insertBefore(p.firstChild, p)
                    p.remove()
                })
                item.setAttribute('value', ref.textContent?.trim() || '')
                list.append(item)
            })
            if (list.childElementCount) inner.append(list)
        })

        for (const ref of footnoteRefs) {
            const id = ref.getAttribute('href')?.replace('#', '')
            if (!id) continue
            const li = document.getElementById(id)
            if (!li) continue
            const clone = li.cloneNode(true) as HTMLElement
            clone
                .querySelectorAll('a[data-footnote-backref]')
                .forEach((a) => a.remove())
            const sup = ref.parentElement
            if (!sup || sup.tagName !== 'SUP') continue
            const parent = sup.parentElement
            if (!parent) continue
            // Use <span> instead of <details> so the popover never
            // forces a line break — <details> has block-ish flow even
            // with display:inline in some renderers.
            const dlg = document.createElement('span')
            dlg.classList.add('footnote-popover')
            dlg.setAttribute('tabindex', '0')
            // Trigger doubles as a clickable link to the footnote on
            // the Footnotes slide. The footnote-ref's href already
            // points to "#user-content-fn-N" — that ID exists inside
            // the cloned <ol> we appended to #footnotes-target. We
            // intercept the click to jump to the footnotes slide
            // first, then scroll into view.
            const trigger = document.createElement('a')
            trigger.classList.add('footnote-popover-trigger')
            trigger.setAttribute('href', `#${id}`)
            // Clone the <sup>, then unwrap any inner <a> (the original GFM
            // footnote ref). Leaving it produces nested anchors (outer
            // trigger + inner ref), which both pick up the page's `a:hover`
            // background — two overlapping rectangles where one should be.
            const supClone = sup.cloneNode(true) as HTMLElement
            supClone.querySelectorAll('a').forEach((innerAnchor) => {
                while (innerAnchor.firstChild) {
                    innerAnchor.parentNode!.insertBefore(
                        innerAnchor.firstChild,
                        innerAnchor,
                    )
                }
                innerAnchor.remove()
            })
            trigger.appendChild(supClone)
            trigger.addEventListener('click', (e) => {
                e.preventDefault()
                const fnSlide = document.getElementById('footnotes')
                if (!fnSlide) return
                const fnSlideIdx = slides.findIndex((s) => s === fnSlide)
                if (fnSlideIdx >= 0) {
                    render(fnSlideIdx)
                    // Scroll the target footnote into view after the
                    // slide change finishes.
                    requestAnimationFrame(() => {
                        const target = document.getElementById(id)
                        target?.scrollIntoView({
                            behavior: window.matchMedia(
                                '(prefers-reduced-motion: reduce)',
                            ).matches
                                ? 'auto'
                                : 'smooth',
                            block: 'center',
                        })
                    })
                }
            })
            const content = document.createElement('span')
            content.classList.add('footnote-popover-content')
            const tmp = clone.cloneNode(true) as HTMLElement
            tmp.querySelectorAll('p').forEach((p) => {
                while (p.firstChild) p.parentNode!.insertBefore(p.firstChild, p)
                p.remove()
            })
            content.innerHTML = tmp.innerHTML.trim()
            dlg.appendChild(trigger)
            dlg.appendChild(content)
            parent.insertBefore(dlg, sup)
            sup.remove()
            const setOpen = (v: boolean) => {
                if (v) dlg.setAttribute('data-open', '')
                else dlg.removeAttribute('data-open')
            }
            const reposition = () => {
                const r = dlg.getBoundingClientRect()
                const w = content.offsetWidth
                let left = r.left
                const maxLeft = window.innerWidth - w - 8
                if (left > maxLeft) left = Math.max(8, maxLeft)
                dlg.style.setProperty('--popover-left', `${left}px`)

                // Vertical: this used to always open downward from the
                // trigger, so a long footnote near the bottom of a slide ran
                // straight off the screen with its tail unreachable. Give it
                // the larger of the two gaps, cap its height to that gap, and
                // let the CSS scroll what does not fit.
                const PAD = 8
                const below = window.innerHeight - r.bottom - PAD
                const above = r.top - PAD
                // Natural height, not offsetHeight: that is already capped by
                // the previous --popover-max-h, so a footnote that had been
                // squeezed would be placed by its squeezed size.
                const h =
                    content.scrollHeight +
                    (content.offsetHeight - content.clientHeight)
                if (h <= below || below >= above) {
                    dlg.style.setProperty('--popover-top', `${r.bottom}px`)
                    dlg.style.setProperty('--popover-max-h', `${below}px`)
                } else {
                    // open upward, bottom-aligned to just above the trigger
                    const boxH = Math.min(h, above)
                    dlg.style.setProperty(
                        '--popover-top',
                        `${Math.max(PAD, r.top - boxH)}px`,
                    )
                    dlg.style.setProperty('--popover-max-h', `${above}px`)
                }
            }
            dlg.addEventListener('mouseenter', () => {
                setOpen(true)
                requestAnimationFrame(reposition)
            })
            dlg.addEventListener('mouseleave', () => setOpen(false))
            dlg.addEventListener('focusin', () => {
                setOpen(true)
                requestAnimationFrame(reposition)
            })
            dlg.addEventListener('focusout', (e) => {
                const next = (e as FocusEvent).relatedTarget as Node | null
                if (!next || !dlg.contains(next)) setOpen(false)
            })
            // `dlg` is a <span> (see comment above on the deliberate
            // switch from <details>), so `.open` is always undefined —
            // use the data-open attribute that setOpen() actually sets.
            const isOpen = () => dlg.hasAttribute('data-open')
            window.addEventListener(
                'scroll',
                () => {
                    if (isOpen()) reposition()
                },
                true,
            )
            window.addEventListener('resize', () => {
                if (isOpen()) reposition()
            })
        }
    }
</script>
