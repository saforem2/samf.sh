---
import Navbar from '../../NavbarMinimal.astro'
import Widgets from '../widgets/Widgets.astro'
import Filter from '../../Filter.astro'

interface Props {
    variant: number
    home?: boolean
}

const { variant, home = false } = Astro.props

const variants = [
    {
        label: 'Hide Widgets on Mobile',
        desc: 'Hides the background widget grid on screens ≤ 480px',
    },
    {
        label: 'Calendar Replaces FileTree',
        desc: 'Swaps the file tree widget for a mini calendar',
    },
    {
        label: '2-Column Grid',
        desc: 'Condenses to 2 columns with Calendar in place of FileTree',
    },
    {
        label: 'Higher Opacity (0.4)',
        desc: 'Bumps background widget grid opacity from 0.3 → 0.4',
    },
    {
        label: 'Tighter Bio Text',
        desc: 'Merges bio paragraphs into one block, removes spacers',
    },
    {
        label: 'Glass Card',
        desc: 'Semi-transparent card with backdrop blur — widgets bleed through',
    },
    {
        label: 'Nord Theme',
        desc: 'Same layout rendered with the Nord color palette',
    },
    {
        label: 'Bento Grid',
        desc: 'Intro top-left, clock/calendar sidebar, full-width player at bottom',
    },
    {
        label: 'Banner Layout',
        desc: 'Full-width intro banner on top, widgets arranged in 3 columns below',
    },
    {
        label: 'Bottom Contrib',
        desc: '2-column layout with contribution graph spanning the full bottom row',
    },
    {
        label: '2x2 Dashboard',
        desc: 'Clock + intro top, 2x2 widget grid lower-left, player spanning right',
    },
    {
        label: 'Minimal 2x2',
        desc: 'Clock + intro top row, player + recent posts bottom row',
    },
    {
        label: '40/60 Split',
        desc: '4-column grid: clock+calendar and player left, intro and posts+talks right',
    },
    {
        label: '60/40 Split',
        desc: 'Swapped: intro and posts+talks left, clock+calendar and player right',
    },
    {
        label: 'Dashboard',
        desc: '5-panel bento: intro + now playing top, work + posts + talks bottom',
    },
    {
        label: 'Highlights & Awards',
        desc: 'Dashboard with career highlights and award badges in the intro',
    },
    {
        label: 'Shrink to Fit',
        desc: 'Dashboard with auto-sized top row — no whitespace padding',
    },
    {
        label: 'Embedded Tech Stack',
        desc: 'Dashboard with inline tech stack icons in the intro',
    },
    {
        label: 'Professional Stats',
        desc: 'Dashboard with compact publication/award/talk stats in the intro',
    },
    {
        label: 'About Badge',
        desc: 'Dashboard with [about] badge header in the intro, matching work/posts/talks style',
    },
    {
        label: 'Name in Navbar',
        desc: 'Dashboard with Sam Foreman moved to navbar, [about] badge in intro',
    },
]

const current = variants[variant - 1]
const total = variants.length
---

<main
    class="intro"
    id="main-content"
    tabindex="-1"
    {...variant === 7 ? { 'data-webtui-theme': 'nord' } : {}}>
    {variant >= 8 && <Navbar />}
    <Widgets {variant} {home} />
    {
        variant < 8 && (
            <column id="content" class:list={[{ glass: variant === 6 }]}>
                <Navbar />
                <column id="main" box-="square">
                    <row class="variant-header">
                        <span
                            is-="badge"
                            variant-="green"
                            style="--badge-text: var(--background0)">
                            v{variant}/{total}
                        </span>
                        <span class="variant-label">{current.label}</span>
                    </row>
                    <h1>
                        <span is-="badge" variant-="green">
                            &#xf4b5; Sam Foreman
                        </span>
                    </h1>
                    <span id="tagline">
                        Computational Scientist · Argonne National Laboratory
                    </span>
                    <column>
                        {variant === 5 ? (
                            <p>
                                I'm a Computational Scientist in the{' '}
                                <a
                                    href="https://www.alcf.anl.gov/about/people/group/506"
                                    target="_blank">
                                    AI / ML Group
                                </a>{' '}
                                at the{' '}
                                <a
                                    href="https://www.alcf.anl.gov/"
                                    target="_blank">
                                    Argonne Leadership Computing Facility
                                </a>
                                . My work focuses on large-scale distributed
                                training of foundation models for scientific
                                applications. I co-lead the Models &amp;
                                Pre-Training team for the{' '}
                                <a
                                    href="https://auroragpt.anl.gov"
                                    target="_blank">
                                    AuroraGPT
                                </a>{' '}
                                project.
                            </p>
                        ) : (
                            <>
                                <p>
                                    I'm a Computational Scientist in the{' '}
                                    <a
                                        href="https://www.alcf.anl.gov/about/people/group/506"
                                        target="_blank">
                                        AI / ML Group
                                    </a>{' '}
                                    at the{' '}
                                    <a
                                        href="https://www.alcf.anl.gov/"
                                        target="_blank">
                                        Argonne Leadership Computing Facility
                                    </a>
                                    .
                                </p>
                                &nbsp;
                                <br />
                                <p>
                                    My work focuses on large-scale distributed
                                    training of foundation models for scientific
                                    applications. I co-lead the Models &amp;
                                    Pre-Training team for the{' '}
                                    <a
                                        href="https://auroragpt.anl.gov"
                                        target="_blank">
                                        AuroraGPT
                                    </a>{' '}
                                    project.
                                </p>
                                &nbsp;
                                <br />
                            </>
                        )}
                        <row id="social-links">
                            <a
                                href="https://github.com/saforem2"
                                target="_blank"
                                title="GitHub">
                                &#xe65b;
                            </a>
                            <a
                                href="https://bsky.app/profile/samforeman.bsky.social"
                                target="_blank"
                                title="Bluesky">
                                &#xe28e;
                            </a>
                            <a
                                href="https://twitter.com/saforem2"
                                target="_blank"
                                title="Twitter">
                                &#xeb72;
                            </a>
                            <a
                                href="https://scholar.google.com/citations?user=vV_1zDwAAAAJ&hl=en"
                                target="_blank"
                                title="Google Scholar">
                                &#xf19d;
                            </a>
                            <a
                                href="https://www.linkedin.com/in/samforem2"
                                target="_blank"
                                title="LinkedIn">
                                &#xe820;
                            </a>
                            <a href="mailto:sf@omg.lol" title="Email">
                                &#xf0e0;
                            </a>
                        </row>
                        <div is-="separator" />
                        <nav class="variant-nav">
                            {variant > 1 ? (
                                <a href={`/showcase/v${variant - 1}`}>← Prev</a>
                            ) : (
                                <span class="nav-disabled">← Prev</span>
                            )}
                            <a href="/showcase" class="nav-center">
                                All options
                            </a>
                            {variant < total ? (
                                <a href={`/showcase/v${variant + 1}`}>Next →</a>
                            ) : (
                                <span class="nav-disabled">Next →</span>
                            )}
                        </nav>
                    </column>
                </column>
            </column>
        )
    }

    {
        variant >= 8 && (
            <>
                <Filter />
                <div id="vim-statusline">
                    <a
                        class="vsl-site"
                        href="https://github.com/saforem2/samf.sh"
                        target="_blank"
                        title="Source repository on GitHub">
                        &#xea84; samf.sh
                    </a>
                    <span class="vsl-file">/</span>
                    <span class="vsl-spacer" />
                    <span class="vsl-keys">
                        <span id="vsl-last-key" />
                    </span>
                    <span class="vsl-clock">
                        <span id="vsl-clock-date" />
                        <span class="vsl-clock-sep">·</span>
                        <span id="vsl-clock-time" />
                    </span>
                    <span class="vsl-pos">All</span>
                    <span class="vsl-loc">1:1</span>
                </div>
            </>
        )
    }

    <script>
        import { isUserTyping } from '@/utils/vim'

        const clockDateEl = document.getElementById('vsl-clock-date')
        const clockTimeEl = document.getElementById('vsl-clock-time')
        const lastKeyEl = document.getElementById('vsl-last-key')

        // Live clock — date and time in separate spans (matches the Doc-layout
        // statusline so the home bar renders identically).
        if (clockDateEl && clockTimeEl) {
            const pad = (n: number) => String(n).padStart(2, '0')
            const tick = () => {
                const d = new Date()
                clockDateEl.textContent = `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`
                clockTimeEl.textContent = `${pad(d.getHours())}:${pad(d.getMinutes())}`
            }
            tick()
            setInterval(tick, 10_000)
        }

        if (lastKeyEl) {
            let timer: ReturnType<typeof setTimeout> | null = null
            window.addEventListener('keydown', (e) => {
                if (isUserTyping()) return
                if (e.key.length === 1) {
                    lastKeyEl.textContent = e.key
                    if (timer) clearTimeout(timer)
                    timer = setTimeout(() => {
                        lastKeyEl.textContent = ''
                    }, 2000)
                }
            })
        }
    </script>

    <script>
        import {
            applyVimNavigation,
            isUserTyping,
            vimFocusElement,
        } from '@/utils/vim'
        const grid = document.getElementById('widgets-grid')
        if (grid && grid.classList.contains('intro-in-grid')) {
            applyVimNavigation(
                grid,
                '[tabindex="0"], a[href], button:not([disabled])',
            )
            // Start with About highlighted without moving keyboard focus.
            // Retire this initial marker when another widget is used; vim
            // navigation only tracks markers it sets itself.
            const intro = document.getElementById('intro-widget')
            if (intro) {
                intro.setAttribute('data-vim-focused', 'true')
                const clearInitialHighlight = (event: Event) => {
                    if (!(event.target instanceof Element)) return
                    const widget = event.target.closest(
                        '#widgets-grid > [tabindex="0"]',
                    )
                    if (!widget || widget === intro) return
                    intro.removeAttribute('data-vim-focused')
                    grid.removeEventListener(
                        'pointerover',
                        clearInitialHighlight,
                    )
                    grid.removeEventListener('focusin', clearInitialHighlight)
                }
                grid.addEventListener('pointerover', clearInitialHighlight)
                grid.addEventListener('focusin', clearInitialHighlight)
            }

            const shortcuts: Record<string, string> = {
                a: '#intro-widget',
                w: '.work-widget',
                p: '.posts-widget',
                t: '.talks-widget',
                l: '#stats-widget',
                m: '.iw-nav-home',
            }
            // Mobile/tablet scroll-highlight is handled by markActiveWidget()
            // in Widgets.astro (data-scroll-active, <=1024px). It drives both
            // the frame shadow and the content-opacity brightening, and clears
            // any stale data-vim-focused as you scroll — so a single widget is
            // ever lit. (A separate ratio-based observer used to live here for
            // <=768px, but running two highlighters left the frame and content
            // out of sync in the 769-1024 band; markActiveWidget subsumes it.)

            grid.addEventListener('keydown', (e) => {
                if (isUserTyping()) return
                const selector = shortcuts[e.key]
                if (!selector) return
                const target = grid.querySelector(
                    selector,
                ) as HTMLElement | null
                if (target) {
                    e.preventDefault()
                    vimFocusElement(target)
                }
            })
        }
    </script>

    <style is:global>
        /* The landing only needs the vim-statusline rules from the doc layout,
           NOT all of Doc.css (toc/reader/post-meta/prose it never renders).
           Import just the shared statusline partial — unlayered, since the
           landing has no competing layer(doc) and nothing layered targets
           .vsl-*. This keeps ~40KB of doc CSS off the landing's chunk. */
        @import '@/styles/statusline.css';
    </style>
    <style>
        .intro {
            position: relative;
            background-color: var(--background0);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;

            h1::before {
                content: '';
                margin-inline-start: -1ch;
            }
            h2::before {
                content: '';
                margin-inline-start: -1ch;
            }

            #content {
                position: absolute;
                background-color: var(--background1);
                border: 1pt solid var(--background2);
                max-width: min(80%, 80ch);
                width: round(calc(100% - 2ch), 1ch);

                &.glass {
                    background-color: oklch(
                        from var(--background1) l c h / 0.75
                    );
                    backdrop-filter: blur(6px) saturate(1.2);
                }

                nav {
                    padding: 2ch 1ch;
                }

                #main {
                    padding: 1lh 2ch;
                    gap: 1lh;
                    --box-border-color: var(--foreground2);

                    a {
                        color: var(--foreground2);

                        &:focus,
                        &:hover {
                            color: var(--blue);
                            background-color: oklch(
                                from var(--blue)
                                    calc(l * var(--oklch-scale, 0.85)) c h / 0.1
                            );
                            text-decoration: none;
                        }
                    }

                    h1 {
                        color: var(--foreground0);
                        display: inline-flex;
                    }
                }
            }
        }

        #tagline {
            color: var(--foreground2);
            margin-block-start: -0.5lh;
        }

        .variant-header {
            align-items: baseline;
            gap: 1ch;
        }

        .variant-label {
            color: var(--foreground1);
            font-weight: 600;
        }

        #social-links {
            display: flex;
            flex-wrap: wrap;
            gap: 2ch;

            a {
                color: var(--foreground2);
                text-decoration: none !important;
                padding-inline: 1ch;
                background-color: oklch(
                    from var(--foreground0) calc(l * var(--oklch-scale, 0.85)) c
                        h / 0.1
                );

                &:focus,
                &:hover {
                    color: var(--blue);
                    text-decoration: none;
                }
            }
        }

        @media (max-width: 50ch) {
            .intro {
                #content,
                #main {
                    padding: 1lh 1ch;
                }
            }
        }

        [is-='separator'] {
            --separator-color: var(--foreground2);
        }

        .variant-nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            padding: 0 !important;

            a {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 0.5ch;
                padding: 0 1ch;
                color: var(--foreground1);
                text-decoration: none;
                background-color: oklch(
                    from var(--foreground0) calc(l * var(--oklch-scale, 0.85)) c
                        h / 0.1
                );

                &:focus,
                &:hover {
                    background-color: oklch(
                        from var(--blue) calc(l * var(--oklch-scale, 0.85)) c
                            h / 0.1
                    );
                    color: var(--blue);
                    text-decoration: none;
                }
            }
        }

        .nav-center {
            color: var(--foreground2) !important;
        }

        .nav-disabled {
            color: var(--foreground2);
            padding: 0 1ch;
            opacity: 0.3;
        }

        /* Dim unfocused widgets, highlight focused */
        :global(#widgets-grid.intro-in-grid [tabindex='0']) {
            opacity: 0.4;
            transition: opacity 0.15s;
        }

        /* Brighten the active widget's content. Must cover the SAME set of
           states as the frame-shadow rule in Widgets.astro (:hover,
           :focus-within/:focus, data-scroll-active, data-vim-focused) so a
           widget's border and its contents always light up together. */
        :global(#widgets-grid.intro-in-grid [tabindex='0']:hover),
        :global(#widgets-grid.intro-in-grid [tabindex='0']:focus),
        :global(
            #widgets-grid.intro-in-grid [tabindex='0'][data-vim-focused='true']
        ),
        :global(
            #widgets-grid.intro-in-grid
                [tabindex='0'][data-scroll-active='true']
        ),
        :global(#widgets-grid.intro-in-grid [tabindex='0']:has(:focus)) {
            opacity: 1;
        }

        /* Widget focus styles for vim navigation */
        :global(#widgets-grid.intro-in-grid [tabindex='0']:focus-visible),
        :global(
            #widgets-grid.intro-in-grid
                [tabindex='0'][data-vim-focused='true']:focus
        ),
        :global(#widgets-grid.intro-in-grid [tabindex='0']:has(:focus)) {
            --box-border-color: var(--foreground0);
            outline: none;
            z-index: 1;
        }

        :global(
            #widgets-grid.intro-in-grid a[href][data-vim-focused='true']:focus
        ) {
            background-color: oklch(
                from var(--blue) calc(l * var(--oklch-scale, 0.85)) c h / 0.15
            );
            color: var(--blue);
            outline: none;
            text-decoration: none;
        }

        /* Vim navigation container — fixed top-right */
        /* Statusline — position only, colors from Doc.css */
        #vim-statusline {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            z-index: 100;
        }

        /* Responsive widget grid — min-width override */
        :global(#widgets-grid.intro-in-grid) {
            min-width: 0;
        }

        /* Allow vertical overflow when grid content exceeds viewport */
        .intro:has(:global(.intro-in-grid)) {
            overflow: visible;
            overflow-x: clip;

            @media (max-width: 1024px) {
                justify-content: flex-start;
            }
        }
    </style>
</main>
