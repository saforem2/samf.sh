---
interface Props {
    showHL?: boolean
}

const { showHL = false } = Astro.props as Props
---

<row gap-="1" align-="center" cap-="round" id="vim-navigation">
    <span class="vim-icon" variant-="background2"> </span>
    {
        showHL && (
            <button size-="sm" variant-="background1" id="btn-h">
                h
            </button>
        )
    }
    <button size-="sm" variant-="background1" id="btn-j">j</button>
    <button size-="sm" variant-="background1" id="btn-k">k</button>
    {
        showHL && (
            <button size-="sm" variant-="background1" id="btn-l">
                l
            </button>
        )
    }
    <button size-="sm" variant-="background1" id="btn-question">?</button>
</row>

<style>
    #vim-navigation {
        padding: 0 0.5ch;
        gap: 0;
        background-color: var(--background3);
        box-shadow: 2px 2px 0 0 var(--foreground0);
        position: relative;
        z-index: 10;

        .vim-icon {
            margin-right: 0.5ch;
            color: var(--background0);
            margin-left: -0.5ch;
            padding-left: 0.5ch;
            padding-right: 0.5ch;
            background-color: var(--blue);
        }

        button[size-='sm'] {
            padding: 0 0.5ch;
            border: none;
            background: none;
        }
        #btn-question {
            padding: 0 0.5ch;
        }
    }

    @media (max-width: 768px) {
        #vim-navigation {
            display: none;
        }
    }
</style>

<script>
    import {
        isUserTyping,
        applyVimNavigation,
        vimFocusElement,
    } from '@/utils/vim'

    const content = document.querySelector('main') as HTMLElement
    const vimQuery =
        '[tabindex="0"], a[href], summary, button:not(#btn-j):not(#btn-k):not(#btn-h):not(#btn-l):not(#btn-question)'
    const buttonH = document.querySelector('#btn-h') as HTMLButtonElement
    const buttonJ = document.querySelector('#btn-j') as HTMLButtonElement
    const buttonK = document.querySelector('#btn-k') as HTMLButtonElement
    const buttonL = document.querySelector('#btn-l') as HTMLButtonElement
    const buttonQuestion = document.querySelector(
        '#btn-question',
    ) as HTMLButtonElement

    // Apply vim-style j/k navigation to cycle through focusable links in main.
    // Skip when Doc.astro manages the page (it applies its own handler with
    // a richer query that includes [tabindex="0"] content elements).
    if (content && !content.id) {
        applyVimNavigation(content, vimQuery)
    }

    // Bootstrap: when j/k is pressed and focus is outside <main>,
    // focus the first visible tabbable element inside <main> so
    // the container-scoped applyVimNavigation can take over.
    // Skip when Doc.astro manages the page (it has its own bootstrap).
    const isDocManaged = content?.id === 'main-content'
    if (!isDocManaged) {
        window.addEventListener('keydown', (e) => {
            if (e.defaultPrevented || isUserTyping()) return
            if (e.ctrlKey || e.metaKey || e.altKey || e.shiftKey) return
            // j/k only -- the arrows belong to the browser so they scroll.
            if (e.key !== 'j' && e.key !== 'k') return
            if (!content) return

            const active = document.activeElement
            if (active && content.contains(active)) {
                // Focus is already inside <main>; let applyVimNavigation handle it
                // UNLESS the active element is not in the query set (e.g. header
                // with tabindex="-1"), in which case the container handler will
                // handle it via the activeIndex === -1 path. We still need to
                // make sure the event reaches <main>. If activeElement is inside
                // <main>, the event WILL bubble there, so nothing to do.
                return
            }

            // Focus is outside <main> (body, nav button, etc.)
            // Find the first visible tabbable element in the current viewport
            const elements = Array.from(
                content.querySelectorAll(vimQuery) as NodeListOf<HTMLElement>,
            ).filter((el) => {
                const rect = el.getBoundingClientRect()
                return (
                    rect.width > 0 &&
                    rect.height > 0 &&
                    rect.bottom > 0 &&
                    rect.top < window.innerHeight
                )
            })

            const target = elements[0]
            if (target) {
                e.preventDefault()
                vimFocusElement(target)
            }
        })
    }

    buttonQuestion.addEventListener('click', () => {
        window.dispatchEvent(
            new KeyboardEvent('keydown', {
                key: '?',
                bubbles: true,
                cancelable: true,
            }),
        )
    })

    // Visual feedback on keydown
    window.addEventListener('keydown', (event) => {
        if (isUserTyping()) return

        if (event.key === 'h' || event.key === 'ArrowLeft') {
            buttonH?.setAttribute('variant-', 'foreground0')
        } else if (event.key === 'l' || event.key === 'ArrowRight') {
            buttonL?.setAttribute('variant-', 'foreground0')
        } else if (event.key === 'j') {
            buttonJ.setAttribute('variant-', 'foreground0')
        } else if (event.key === 'k') {
            buttonK.setAttribute('variant-', 'foreground0')
        }
    })

    // Reset visual feedback on keyup (j/k handled by applyVimNavigation)
    window.addEventListener('keyup', (event) => {
        if (isUserTyping()) return

        if (event.key === 'h' || event.key === 'ArrowLeft') {
            buttonH?.setAttribute('variant-', 'background1')
            buttonH?.click()
        } else if (event.key === 'l' || event.key === 'ArrowRight') {
            buttonL?.setAttribute('variant-', 'background1')
            buttonL?.click()
        } else if (event.key === 'j') {
            buttonJ.setAttribute('variant-', 'background1')
        } else if (event.key === 'k') {
            buttonK.setAttribute('variant-', 'background1')
        }
    })
</script>
