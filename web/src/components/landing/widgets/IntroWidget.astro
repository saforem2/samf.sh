---
interface Props {
    variant: number
    total: number
    home?: boolean
}

const { variant, total, home = false } = Astro.props
---

<column box-="square" class="widget" pad-="2 1" id="intro-widget" tabindex="0">
    {
        !home && (
            <row class="iw-variant-header">
                <span
                    is-="badge"
                    variant-="green"
                    style="--badge-text: var(--background0)">
                    v{variant}/{total}
                </span>
                <span class="iw-variant-label">Intro as Widget</span>
            </row>
        )
    }
    {
        (variant === 20 || variant === 21) && (
            <div class="iw-title-row">
                <span is-="badge" class="iw-about-title">
                    &#xf2bd; Sam Foreman
                </span>
                {home && (
                    <a href="/about" class="iw-title-about">
                        [a]bout &rarr;
                    </a>
                )}
            </div>
        )
    }
    {
        variant !== 21 && (
            <h1>
                <span is-="badge" variant-="green">
                    &#xf4b5; Sam Foreman
                </span>
            </h1>
        )
    }
    <span class="iw-tagline">
        Computational Scientist · <a href="https://anl.gov"
            >Argonne National Laboratory</a
        >
        <a href="https://alcf.anl.gov">(ALCF)</a>
    </span>
    <div class="iw-about">
        <p>
            I'm a Computational Scientist in the{' '}
            <a
                href="https://www.alcf.anl.gov/about/people/group/506"
                target="_blank">
                AI / ML Group
            </a>{' '}
            at the{' '}
            <a href="https://www.alcf.anl.gov/" target="_blank"> ALCF</a>, where
            I work on training large models for scientific applications.
        </p>
        <p>
            Generally, I am interested in developing novel algorithms and
            techniques to enable the training of large language models on
            scientific data, and in applying these models to accelerate
            scientific discovery across a wide range of domains.
        </p>
        <details is-="accordion" class="callout callout-tip" data-callout="tip">
            <summary>Recent Projects</summary>
            <p>
                Some recent projects include AERIS, a billion-parameter
                diffusion model for global weather forecasting that was a
                finalist for the 2025 ACM Gordon Bell Prize for Climate
                Modeling; MProt-DPO, a large language model for protein design
                that was a finalist for the 2024 Gordon Bell Prize; and GenSLMs,
                a family of large language models for genomics that won the 2023
                ACM Gordon Bell Special Prize for High Performance
                Computing-Based COVID-19 Research.
            </p>
        </details>
        <!-- <p> -->
        <!--     My work at ALCF spans a variety of projects in scientific machine -->
        <!--     learning, high-performance computing, and large language models, and -->
        <!--     I am the co-lead of the Models &amp; Pre-Training team for the <a -->
        <!--         href="https://auroragpt.anl.gov" -->
        <!--         target="_blank">AuroraGPT</a -->
        <!--     > project. -->
        <!-- </p> -->
    </div>
    <div class="iw-social-wrap">
        <row class="iw-social-links">
            <a href="/" title="Home" size-="small">&#xef85;</a>
            <button
                type="button"
                class="iw-social-cmd-btn"
                title="Open command menu (?)"
                size-="small"
                aria-label="Open command menu"
                data-iw-cmd>?</button
            >
            <a
                href="https://github.com/saforem2"
                target="_blank"
                title="GitHub"
                size-="small">&#xe65b;</a
            >
            <a
                href="https://twitter.com/saforem2"
                target="_blank"
                title="Twitter"
                size-="small">&#xeb72;</a
            >
            <a
                href="https://scholar.google.com/citations?user=vV_1zDwAAAAJ&hl=en"
                target="_blank"
                title="Google Scholar"
                size-="small">&#xf19d;</a
            >
            <a
                href="https://www.linkedin.com/in/samforem2"
                target="_blank"
                title="LinkedIn"
                size-="small">&#xe820;</a
            >
            <a href="mailto:sf@omg.lol" title="Email" size-="small">&#xf0e0;</a>
            <a href="/rss.xml" target="_blank" title="RSS" size-="small"
                >&#xf09e;</a
            >
            <button
                type="button"
                class="iw-social-search-btn"
                title="Search"
                size-="small"
                aria-label="Open search"
                data-iw-search>&#xf002;</button
            >
        </row>
    </div>
    {
        variant === 16 && (
            <column class="iw-highlights" gap-="0">
                <div
                    is-="separator"
                    style="--separator-color: var(--background2)"
                />
                <a
                    href="https://www.biorxiv.org/content/10.1101/2022.10.10.511571v1.abstract"
                    target="_blank"
                    class="iw-hl-item">
                    <span class="iw-hl-icon" style="color: var(--yellow)">
                        🏆
                    </span>
                    <span>ACM Gordon Bell Special Prize — GenSLMs (2023)</span>
                </a>
                <a
                    href="https://arxiv.org/abs/2509.13523"
                    target="_blank"
                    class="iw-hl-item">
                    <span class="iw-hl-icon" style="color: var(--green)">
                        ✨
                    </span>
                    <span>Gordon Bell Finalist — AERIS (2025)</span>
                </a>
                <a
                    href="https://doi.org/10.1109/SC41406.2024.00013"
                    target="_blank"
                    class="iw-hl-item">
                    <span class="iw-hl-icon" style="color: var(--pink)">
                        🌟
                    </span>
                    <span>Gordon Bell Finalist — MProt-DPO (2024)</span>
                </a>
                <a
                    href="https://auroragpt.anl.gov"
                    target="_blank"
                    class="iw-hl-item">
                    <span class="iw-hl-icon">🤖</span>
                    <span>AuroraGPT — Co-lead, Models & Pre-Training</span>
                </a>
            </column>
        )
    }
    {
        variant === 18 && (
            <column class="iw-tech" gap-="0">
                <div
                    is-="separator"
                    style="--separator-color: var(--background2)"
                />
                <row class="iw-tech-row">
                    <span style="color: var(--orange)">&#xe6b2;</span>
                    <span style="color: var(--yellow)">&#xf48a;</span>
                    <span style="color: var(--foreground1)">&#xe76f;</span>
                    <span style="color: var(--blue)">&#xe628;</span>
                    <span style="color: var(--sapphire, var(--blue))">
                        &#xe749;
                    </span>
                    <span style="color: var(--green)">&#xf698;</span>
                    <span style="color: var(--purple, var(--mauve))">
                        &#xf489;
                    </span>
                    <span style="color: var(--teal)">&#xf61f;</span>
                    <span style="color: var(--green)">&#xf233;</span>
                </row>
                <span class="iw-tech-label">
                    Astro · MDX · Bun · TypeScript · CSS · KaTeX · Shiki ·
                    Mermaid · Netlify
                </span>
            </column>
        )
    }
    {
        variant === 19 && (
            <column class="iw-stats-section" gap-="0">
                <div
                    is-="separator"
                    style="--separator-color: var(--background2)"
                />
                <row class="iw-stats-row">
                    <span is-="badge" variant-="green" class="iw-stat">
                        24 publications
                    </span>
                    <span is-="badge" variant-="yellow" class="iw-stat">
                        3 Gordon Bell awards
                    </span>
                    <span is-="badge" variant-="blue" class="iw-stat">
                        50+ talks
                    </span>
                </row>
            </column>
        )
    }
    {
        !home && (
            <>
                <div is-="separator" />
                <nav class="iw-nav">
                    {variant > 1 ? (
                        <a href={`/showcase/v${variant - 1}`}>&larr; Prev</a>
                    ) : (
                        <span class="iw-nav-disabled">&larr; Prev</span>
                    )}
                    <a href="/showcase" class="iw-nav-center">
                        All options
                    </a>
                    {variant < total ? (
                        <a href={`/showcase/v${variant + 1}`}>Next &rarr;</a>
                    ) : (
                        <span class="iw-nav-disabled">Next &rarr;</span>
                    )}
                </nav>
            </>
        )
    }
</column>

<style>
    #intro-widget {
        pointer-events: auto;
        gap: 0.5lh;

        h1 {
            display: inline-flex;
        }

        h1::before {
            content: '';
            margin-inline-start: -1ch;
        }

        a {
            color: var(--foreground2);
            text-decoration-color: var(--background3);

            &:focus,
            &:hover {
                color: var(--blue);
                background-color: oklch(
                    from var(--blue) calc(l * var(--oklch-scale, 0.85)) c h /
                        0.1
                );
                text-decoration: none;
            }
        }
    }

    /* ── Title row: avatar name + right-justified [a]bout CTA ────────────
       The "Sam Foreman" title badge and the [a]bout link share one line,
       with [a]bout pushed to the far right (margin-left:auto). */
    .iw-title-row {
        display: flex;
        align-items: center;
        gap: 1ch;
    }
    .iw-title-row .iw-about-title {
        /* Stretch the title band across the row (up to the [a]bout CTA),
           so its tinted background spans the available width instead of
           hugging just the name. */
        flex: 1 1 auto;
    }
    .iw-title-about {
        margin-left: auto;
        flex: 0 0 auto;
        box-sizing: border-box;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 1lh;
        padding: 0 1ch;
        line-height: 1lh;
        text-decoration: none !important;
        font-weight: bold;
        white-space: nowrap;
        background-color: color-mix(
            in srgb,
            var(--background0),
            var(--foreground0) 5%
        );
        border: 1px solid
            color-mix(in srgb, var(--background0), var(--foreground0) 18%);
        color: var(--foreground1);
        /* Subtle resting drop-shadow so the CTA reads as a raised "click me"
           chip; hover deepens it to the accent color. */
        box-shadow: 2px 2px 0 0
            color-mix(in srgb, var(--background0), var(--foreground0) 18%);
        --chip-accent: var(--url, var(--blue));
        transition:
            background-color 0.1s linear,
            color 0.1s linear,
            border-color 0.1s linear,
            transform 0.1s ease-out,
            box-shadow 0.1s ease-out;
    }
    /* !important on the hover background: the chip is an <a>, so the base
       layer's `body a:hover` relative-color rule otherwise repaints it a
       10%-opacity tint. Same cascade quirk (and fix) as the .iw-social-links
       chips below. */
    .iw-title-about:hover,
    .iw-title-about:focus-visible,
    .iw-title-about[data-vim-focused='true'] {
        transform: translate(-1px, -1px);
        box-shadow: 2px 2px 0 0 var(--chip-accent);
        background-color: color-mix(
            in srgb,
            var(--background0),
            var(--chip-accent) 18%
        ) !important;
        border-color: var(--chip-accent);
        color: var(--chip-accent) !important;
    }
    .iw-title-about:active {
        transform: translate(0, 0);
        box-shadow: 1px 1px 0 0 var(--chip-accent);
    }

    .iw-tagline {
        color: var(--foreground2);
        /* border-bottom: 1pt solid var(--background2); */
        /* border-bottom-width: clamp(1px, 0.1vw, 2px); */
    }

    .iw-variant-header {
        align-items: baseline;
        gap: 1ch;
    }

    .iw-variant-label {
        color: var(--foreground1);
        font-weight: 600;
    }

    .iw-about > p {
        margin-block-start: 0;
    }
    .iw-about {
        overflow-x: hidden;
        overflow-y: auto;
        border-left: 2pt solid var(--background2);
        padding-left: 1ch;
        p {
            color: var(--foreground1);
            margin-block: 0.5lh;
        }
    }

    /* Wrap: icon row + [a]bout CTA. On wide containers they sit
       side-by-side (about pinned right); on narrow (mobile) the
       about chip drops to its own row, full-width. */
    .iw-social-wrap {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5lh 1ch;
        margin-top: auto;
    }
    /* [a]bout → CTA chip. Same keycap-chip language as the icon row,
       with a wider tap target and the accent blue palette. */
    .iw-social-wrap > .iw-nav-home {
        margin-left: auto;
        text-decoration: none !important;
        box-sizing: border-box;
        padding: 0 1ch;
        line-height: 1lh;
        height: 1lh;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background-color: color-mix(
            in srgb,
            var(--background0),
            var(--foreground0) 5%
        );
        border: 1px solid
            color-mix(in srgb, var(--background0), var(--foreground0) 18%);
        color: var(--foreground1);
        font-weight: bold;
        /* A subtle resting drop-shadow so the CTA reads as a raised,
           "click me" chip that stands out from the flat icon-button row
           without recoloring it. The hover below deepens the lift. */
        box-shadow: 2px 2px 0 0
            color-mix(in srgb, var(--background0), var(--foreground0) 18%);
        /* Track the prose link color (blue) instead of --accent
           (pink): the link's anchor text inherits color: var(--url)
           from the body link rule, so a pink shadow + blue text +
           grey border read as a mismatched chip. Pinning the accent
           to --url keeps the shadow, border, and hover-text in sync
           with the visible link color. */
        --chip-accent: var(--url, var(--blue));
        transition:
            background-color 0.1s linear,
            color 0.1s linear,
            border-color 0.1s linear,
            transform 0.1s ease-out,
            box-shadow 0.1s ease-out;

        &:hover,
        &:focus-visible,
        &[data-vim-focused='true'] {
            transform: translate(-1px, -1px);
            box-shadow: 2px 2px 0 0 var(--chip-accent);
            background-color: color-mix(
                in srgb,
                var(--background0),
                var(--chip-accent) 18%
            );
            border-color: var(--chip-accent);
            color: var(--chip-accent);
        }
        &:active {
            transform: translate(0, 0);
            box-shadow: 1px 1px 0 0 var(--chip-accent);
        }
    }
    @media (max-width: 480px) {
        .iw-social-wrap > .iw-nav-home {
            margin-left: 0;
            width: 100%;
        }
    }

    .iw-social-links {
        display: flex;
        flex-wrap: nowrap;
        /* Tighter gap — chips read as a key row instead of a sparse
           list. Matches the .flex-container.icon-flex pattern on
           /about/. */
        gap: 0.5ch;
        flex: 1 1 auto;
        min-width: 0;

        a,
        button {
            text-decoration: none !important;
            box-sizing: border-box;
            padding: 0 0.5ch;
            line-height: 1lh;
            height: 1lh;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 0;
            flex: 1 1 0;
            /* Keycap chip — opaque color-mix bg + hairline border, no
               radius. Matches .flex-container.icon-flex on /about/. */
            background-color: color-mix(
                in srgb,
                var(--background0),
                var(--foreground0) 5%
            );
            border: 1px solid
                color-mix(in srgb, var(--background0), var(--foreground0) 18%);
            color: var(--foreground1);
            /* Per-platform hover rules below override --chip-accent so
               the shared lift+shadow declaration resolves to the right
               hue without duplicating box-shadow lines. */
            --chip-accent: var(--foreground2);
            transition:
                background-color 0.1s linear,
                color 0.1s linear,
                border-color 0.1s linear,
                transform 0.1s ease-out,
                box-shadow 0.1s ease-out;
        }

        a:hover,
        a:focus-visible,
        a[data-vim-focused='true'],
        button:hover,
        button:focus-visible,
        button[data-vim-focused='true'] {
            transform: translate(-1px, -1px);
            box-shadow: 2px 2px 0 0 var(--chip-accent);
        }

        a:active,
        button:active {
            transform: translate(0, 0);
            box-shadow: 1px 1px 0 0 var(--chip-accent);
        }
    }

    /* Per-button accent: each social link gets a brand-family color on
       hover / focus / vim-focus. The vim cursor reads
       getComputedStyle(focused).color as its background, so making each
       link paint in its accent color here is what drives the cursor's
       per-button color match (purple on github, sky on bluesky, etc.).
       Kept OUTSIDE the .iw-social-links {} nesting block because
       Lightning CSS's nesting parser silently drops attribute+
       pseudo-class compound selectors when they're nested without an
       explicit `&` — using top-level descendant selectors gets them
       into the build reliably.
       `!important` because there's an upstream `body a` rule in the
       base layer using relative-color syntax that — even though it
       SHOULD lose to a higher-specificity unlayered rule — appears
       to silently invalidate the entire color cascade for these
       anchors. !important sidesteps the cascade mystery entirely. */
    .iw-social-links a[href='/']:hover,
    .iw-social-links a[href='/']:focus-visible,
    .iw-social-links a[href='/'][data-vim-focused='true'] {
        --chip-accent: var(--accent, var(--blue));
        background-color: color-mix(
            in srgb,
            var(--background0),
            var(--accent, var(--blue)) 18%
        ) !important;
        border-color: var(--accent, var(--blue)) !important;
        color: var(--accent, var(--blue)) !important;
    }
    .iw-social-links a[href*='github']:hover,
    .iw-social-links a[href*='github']:focus-visible,
    .iw-social-links a[href*='github'][data-vim-focused='true'] {
        --chip-accent: #6e5494;
        background-color: color-mix(
            in srgb,
            var(--background0),
            #6e5494 18%
        ) !important;
        border-color: #6e5494 !important;
        color: #6e5494 !important;
    }
    .iw-social-links a[href*='bsky']:hover,
    .iw-social-links a[href*='bsky']:focus-visible,
    .iw-social-links a[href*='bsky'][data-vim-focused='true'] {
        --chip-accent: #0085ff;
        background-color: color-mix(
            in srgb,
            var(--background0),
            #0085ff 18%
        ) !important;
        border-color: #0085ff !important;
        color: #0085ff !important;
    }
    .iw-social-links a[href*='twitter']:hover,
    .iw-social-links a[href*='twitter']:focus-visible,
    .iw-social-links a[href*='twitter'][data-vim-focused='true'] {
        --chip-accent: #1da1f2;
        background-color: color-mix(
            in srgb,
            var(--background0),
            #1da1f2 18%
        ) !important;
        border-color: #1da1f2 !important;
        color: #1da1f2 !important;
    }
    .iw-social-links a[href*='scholar.google']:hover,
    .iw-social-links a[href*='scholar.google']:focus-visible,
    .iw-social-links a[href*='scholar.google'][data-vim-focused='true'] {
        --chip-accent: #4285f4;
        background-color: color-mix(
            in srgb,
            var(--background0),
            #4285f4 18%
        ) !important;
        border-color: #4285f4 !important;
        color: #4285f4 !important;
    }
    .iw-social-links a[href*='linkedin']:hover,
    .iw-social-links a[href*='linkedin']:focus-visible,
    .iw-social-links a[href*='linkedin'][data-vim-focused='true'] {
        --chip-accent: #0077b5;
        background-color: color-mix(
            in srgb,
            var(--background0),
            #0077b5 18%
        ) !important;
        border-color: #0077b5 !important;
        color: #0077b5 !important;
    }
    .iw-social-links a[href^='mailto']:hover,
    .iw-social-links a[href^='mailto']:focus-visible,
    .iw-social-links a[href^='mailto'][data-vim-focused='true'] {
        --chip-accent: #ea4335;
        background-color: color-mix(
            in srgb,
            var(--background0),
            #ea4335 18%
        ) !important;
        border-color: #ea4335 !important;
        color: #ea4335 !important;
    }
    .iw-social-links a[href='/rss.xml']:hover,
    .iw-social-links a[href='/rss.xml']:focus-visible,
    .iw-social-links a[href='/rss.xml'][data-vim-focused='true'] {
        --chip-accent: var(--orange);
        background-color: color-mix(
            in srgb,
            var(--background0),
            var(--orange) 18%
        ) !important;
        border-color: var(--orange) !important;
        color: var(--orange) !important;
    }
    .iw-social-links button.iw-social-search-btn,
    .iw-social-links button.iw-social-cmd-btn {
        cursor: pointer;
        font-family: var(--font-family);
        font-size: inherit;
        /* webtui's <button> defaults otherwise win and paint the glyph
           darker than the surrounding <a> icon chips. Pin to --foreground2
           so these buttons (the `?` command + search) match the icon links'
           at-rest color exactly. */
        color: var(--foreground2) !important;
    }
    .iw-social-links button.iw-social-search-btn:hover,
    .iw-social-links button.iw-social-search-btn:focus-visible,
    .iw-social-links button.iw-social-search-btn[data-vim-focused='true'] {
        --chip-accent: var(--green);
        background-color: color-mix(
            in srgb,
            var(--background0),
            var(--green) 18%
        ) !important;
        border-color: var(--green) !important;
        color: var(--green) !important;
    }
    .iw-social-links button.iw-social-cmd-btn:hover,
    .iw-social-links button.iw-social-cmd-btn:focus-visible,
    .iw-social-links button.iw-social-cmd-btn[data-vim-focused='true'] {
        --chip-accent: var(--yellow);
        background-color: color-mix(
            in srgb,
            var(--background0),
            var(--yellow) 18%
        ) !important;
        border-color: var(--yellow) !important;
        color: var(--yellow) !important;
    }

    [is-='separator'] {
        --separator-color: var(--foreground2);
    }

    .iw-nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;

        a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5ch;
            padding: 0 1ch;
            color: var(--foreground1);
            text-decoration: none;
            background-color: oklch(
                from var(--foreground0) calc(l * var(--oklch-scale, 0.85)) c h /
                    0.1
            );

            &:focus,
            &:hover {
                background-color: oklch(
                    from var(--blue) calc(l * var(--oklch-scale, 0.85)) c h /
                        0.1
                );
                color: var(--blue);
                text-decoration: none;
            }
        }
    }

    .iw-nav-center {
        color: var(--foreground2) !important;
    }

    .iw-nav-disabled {
        color: var(--foreground2);
        padding: 0 1ch;
        opacity: 0.3;
    }

    .iw-highlights {
        gap: 0;
    }

    .iw-hl-item {
        display: flex;
        align-items: baseline;
        gap: 1ch;
        line-height: normal;
        text-decoration: none;
        color: var(--foreground1);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;

        &:hover {
            color: var(--blue);
        }
    }

    .iw-hl-icon {
        flex-shrink: 0;
        width: 2ch;
        text-align: center;
    }

    .iw-tech {
        gap: 0.5lh;
    }

    .iw-tech-row {
