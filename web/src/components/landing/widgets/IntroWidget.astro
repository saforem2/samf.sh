<script>
    // Wire the merged search chip in iw-social-links to open the
    // existing #search-dialog mounted by NavbarMinimal → Filter.
    document.querySelectorAll('[data-iw-search]').forEach((btn) => {
        btn.addEventListener('click', () => {
            const dialog = document.getElementById(
                'search-dialog',
            ) as HTMLDialogElement | null
            dialog?.showModal()
        })
    })

    // Wire the command-menu chip (the lightning bolt mirror of the
    // sidebar's #command-button-sidebar) to open #command-dialog.
    document.querySelectorAll('[data-iw-cmd]').forEach((btn) => {
        btn.addEventListener('click', () => {
            const dialog = document.getElementById(
                'command-dialog',
            ) as HTMLDialogElement | null
            dialog?.showModal()
        })
    })
</script>
