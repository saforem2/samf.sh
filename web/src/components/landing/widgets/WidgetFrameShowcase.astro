---
import Widgets from './Widgets.astro'

/**
 * Non-destructive showcase for the "label in the border" widget style.
 * Used ONLY by src/pages/showcase/widgets-labels.astro — nothing on the
 * real homepage imports this, so the current inside-box badges stay default.
 *
 * Structure per widget: a .widget-frame wrapper draws the box, a
 * .widget-frame-label badge sits IN the top edge (translate -50%),
 * and the inner .widget (the real box-="square" element) no longer
 * paints its own frame — the wrapper owns it.
 *
 * The badge masks the border behind it the same way pre.astro-code's
 * language chip does: layered background = tint + page surface.
 */
interface Props {
    framed?: boolean
}
const { framed = true } = Astro.props
---

<div class:list={[{ framed }, 'wbl-root']} data-wbl-root>
    <Widgets variant={21} home />
</div>

<style>
    /* ---------- Showcase chrome (not the trick itself) ---------- */
    .wbl-root {
        /* Reuse the home grid stacking/sizing without leaking to the
           page-level #widgets-grid rules — scoped to this container. */
        display: flex;
        flex-direction: column;
        gap: 1ch;
        max-width: 100%;
        overflow: visible;
    }
    /* Fallback idle shadow so the flat-bordered cards don't read as
       inset: a faint 1px offset even before interaction. */
    .wbl-root.framed :global(#widgets-grid > [tabindex='0']) {
        box-shadow: 1px 1px 0 0
            color-mix(
                in srgb,
                var(--wbl-border, var(--background2)) 65%,
                transparent
            );
    }
    /* Hide the real navbar inside the showcase; the page has its own. */
    .wbl-root :global(#widgets-grid) {
        position: static !important;
        transform: none !important;
        max-width: 100% !important;
        width: 100% !important;
        height: auto !important;
        min-height: 0 !important;
        max-height: none !important;
        opacity: 1 !important;
        pointer-events: auto !important;
    }

    /* ---------- The actual "label in the border" technique ---------- */
    /* Each widget card keeps its default WebTUI border -- the framed pane
       only moves badge placement. */
    .wbl-root.framed :global(#widgets-grid > [tabindex='0']) {
        position: relative;
        overflow: visible !important;
        --code-mask-under: var(--background0);
        --code-mask-bg: transparent;
        padding: 1.2lh 1.5ch 1lh 1.5ch !important;
        opacity: 1;
        transition:
            opacity 150ms linear,
            border-color 120ms ease-out,
            box-shadow 120ms ease-out;
    }
    /* The home grid and each widget set overflow:hidden on the card
       itself (Widgets.astro #widgets-grid.home-grid > * and
       .work-widget/.posts-widget/etc). That clips the badge's 0.5lh
       overhang outside the top edge — neutralize it in framed mode. */
    .wbl-root.framed :global(#widgets-grid.home-grid > [tabindex='0']),
    .wbl-root.framed :global(.work-widget),
    .wbl-root.framed :global(.posts-widget),
    .wbl-root.framed :global(.talks-widget),
    .wbl-root.framed :global(#intro-widget),
    .wbl-root.framed :global(#stats-widget) {
        overflow: visible !important;
    }
    /* Grid and pane parents must also allow the overhang; otherwise
       the card's top row gets clipped by the grid container. */
    .wbl-root.framed :global(#widgets-grid) {
        overflow: visible !important;
        overflow-y: visible !important;
        padding-top: 0.6lh;
        gap: 1.8ch 1ch;
    }
    /* Kill the WebTUI box frame inside framed mode; wrapper draws it. */
    .wbl-root.framed :global(#widgets-grid > [tabindex='0']::before),
    .wbl-root.framed :global(#widgets-grid > [tabindex='0']::after) {
        display: none !important;
    }
    /* Wrapper's own border — mirrors box.css but as a real border on the
       element, so z-index layering with the badge is predictable. */
    .wbl-root.framed :global(#widgets-grid > [tabindex='0']) {
        border: 1px solid var(--wbl-border);
        border-radius: 2px;
        padding: 1.2lh 1.5ch 1lh 1.5ch !important;
        opacity: 1;
        transition:
            opacity 150ms linear,
            border-color 120ms ease-out,
            box-shadow 120ms ease-out;
    }
    /* Preserve the homepage's ::before active shadow (Widgets.astro) even
       inside the showcase pane. Without this the mobile scroll-active /
       focus-within glow is absent in the Proposed column. */
    .wbl-root.framed
        :global(
            #widgets-grid
                > [tabindex='0']:is(
                    :hover,
                    :focus-within,
                    [data-scroll-active='true'],
                    [data-vim-focused='true']
                )::before
        ) {
        border-color: var(--wbl-accent, var(--foreground0)) !important;
        box-shadow: 2px 2px 0 0
            color-mix(
                in srgb,
                var(--wbl-accent, var(--foreground0)) 55%,
                rgba(0, 0, 0, 0.55)
            ) !important;
    }
    /* Dim cycle — mirrors Intro.astro: untouched until someone j/k's into the
       grid; once any card has data-vim-focused, the rest dim until you hover
       or vim-select one — frame + content brighten together. Also include
       data-scroll-active so mobile snap (which has no hover) dims off-screen
       cards the same way the homepage does. */
    .wbl-root.framed
        :global(#widgets-grid:has([data-vim-focused='true']) > [tabindex='0']),
    .wbl-root.framed
        :global(
            #widgets-grid:has([data-scroll-active='true']) > [tabindex='0']
        ),
    .wbl-root.framed
        :global(#widgets-grid[data-wbl-hover='true'] > [tabindex='0']) {
        opacity: 0.35;
    }
    .wbl-root.framed
        :global(
            #widgets-grid
                > [tabindex='0']:is(
                    :hover,
                    :focus,
                    :focus-within,
                    [data-vim-focused='true'],
                    [data-scroll-active='true'],
                    :has(:focus)
                )
        ) {
        opacity: 1;
        border-color: var(--wbl-accent, var(--foreground0));
        box-shadow: 2px 2px 0 0 var(--wbl-accent, rgba(0, 0, 0, 0.55));
    }
    /* Per-widget accent tints for the border (subtle, not competing). */
    .wbl-root.framed :global(#intro-widget) {
        --wbl-border: color-mix(in srgb, var(--foreground2) 55%, transparent);
        --wbl-accent: var(--foreground2);
    }
    .wbl-root.framed :global(.work-widget) {
        --wbl-border: color-mix(
            in srgb,
            var(--purple, var(--mauve, #9a76ce)) 45%,
            var(--background2)
        );
        --wbl-accent: var(--purple, var(--mauve, #9a76ce));
    }
    .wbl-root.framed :global(.posts-widget) {
        --wbl-border: color-mix(in srgb, var(--green) 45%, var(--background2));
        --wbl-accent: var(--green);
    }
    .wbl-root.framed :global(.talks-widget) {
        --wbl-border: color-mix(in srgb, var(--blue) 45%, var(--background2));
        --wbl-accent: var(--blue);
    }
    .wbl-root.framed :global(#stats-widget) {
        --wbl-border: color-mix(in srgb, var(--red) 45%, var(--background2));
        --wbl-accent: var(--red);
    }
    .wbl-root.framed :global(#clock-widget),
    .wbl-root.framed :global(.cal-widget) {
        --wbl-border: color-mix(
            in srgb,
            var(--foreground2) 45%,
            var(--background2)
        );
        --wbl-accent: var(--foreground2);
    }

    /* The badge itself — absolutely positioned so it breaks out of flow.
       It reuses is-="badge" styling (so variant-/cap- still work) but is
       placed by us, not by the widget's inner markup. We hide the widget's
       original inline badge in framed mode and paint this replacement.
       Approach: generate the label with CSS from a data attribute injected
       by the script below, so zero widget markup has to change. */
    /* Hide original inside badges in framed mode — the border chips
       replace them. CSS fallback so there's no flash of duplicate even
       before the JS hide runs. JS also hides matching `src` inline. */
    .wbl-root.framed :global(.ww-title),
    .wbl-root.framed :global(.pw-title),
    .wbl-root.framed :global(.tw-title),
    .wbl-root.framed :global(.ip-title),
    .wbl-root.framed :global(.iw-about-title),
    .wbl-root.framed :global(#intro-widget h1 [is-='badge']) {
        display: none !important;
    }
    /* Promote [a]bout → from inline CTA to a second border chip on the
       intro card (top-right) so the Sam Foreman chip owns the top-left
       and the about affordance mirrors it. Hidden from the title row so
       it doesn't leave dead space, then re-injected as a positioned clone. */
    .wbl-root.framed :global(#intro-widget .iw-title-row) {
        display: none !important;
    }
    .wbl-root.framed :global(#intro-widget .iw-title-about) {
        display: none !important;
    }
    .wbl-root.framed :global(.wbl-about-chip) {
        position: absolute;
        top: 0;
        right: 1.2ch;
        translate: 0 -50%;
        z-index: 3;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 1lh;
        line-height: 1lh;
        padding: 0 1ch;
        font-weight: 700;
        white-space: nowrap;
        text-decoration: none !important;
        background-color: color-mix(
            in srgb,
            var(--background0),
            var(--foreground0) 5%
        );
        background-image:
            linear-gradient(
                var(--code-mask-bg, transparent),
                var(--code-mask-bg, transparent)
            ),
            var(--code-mask-under, var(--background0));
        border: 1px solid
            color-mix(in srgb, var(--background0), var(--foreground0) 18%);
        color: var(--foreground1);
        border-radius: 0;
        box-shadow: 2px 2px 0 0
            color-mix(in srgb, var(--foreground0) 18%, transparent);
        --chip-accent: var(--url, var(--blue));
        transition:
            background-color 0.1s linear,
            color 0.1s linear,
            border-color 0.1s linear,
            transform 0.1s ease-out,
            box-shadow 0.1s ease-out;
    }
    .wbl-root.framed :global(.wbl-about-chip:hover),
    .wbl-root.framed :global(.wbl-about-chip:focus-visible),
    .wbl-root.framed :global(.wbl-about-chip[data-vim-focused='true']) {
        transform: translate(-1px, -1px);
        box-shadow: 2px 2px 0 0 var(--chip-accent);
        background-color: color-mix(
            in srgb,
            var(--background0),
            var(--chip-accent) 18%
        ) !important;
        border-color: var(--chip-accent);
        color: var(--chip-accent) !important;
    }
    .wbl-root.framed :global(.wbl-about-chip:active) {
        transform: translate(0, 0);
        box-shadow: 1px 1px 0 0 var(--chip-accent);
    }
    /* JS adds .wbl-frame-badge to each widget card; CSS does the rest. */
    .wbl-root.framed :global(.wbl-frame-badge) {
        position: absolute;
        top: 0;
        left: 1.2ch;
        translate: 0 -50%;
        z-index: 2;
        display: inline-flex;
        align-items: center;
        gap: 0;
        height: 1lh;
        line-height: 1lh;
        padding: 0 0.7ch;
        font-weight: 600;
        white-space: nowrap;
        user-select: none;
        pointer-events: auto;
        text-decoration: none;
        /* Match the original inside-badge formula so colors don't shift:
           text = var(--wbl-accent), bg = 0.1 opacity with --oklch-scale.
           Background still layers over var(--code-mask-under) to hide the
           border line behind the chip, like pre.astro-code::after. */
        background:
            linear-gradient(
                oklch(
                    from var(--wbl-accent) calc(l * var(--oklch-scale, 0.85)) c
                        h / 0.1
                ),
                oklch(
                    from var(--wbl-accent) calc(l * var(--oklch-scale, 0.85)) c
                        h / 0.1
                )
            ),
            linear-gradient(
                var(--code-mask-bg, transparent),
                var(--code-mask-bg, transparent)
            ),
            var(--code-mask-under, var(--background0));
        color: var(--wbl-accent);
        border: 1px solid
            color-mix(in srgb, var(--background0), var(--foreground0) 18%);
        border-radius: 0;
        /* Idle shadow in chip color (tinted), hover goes solid via rule below */
        box-shadow: 2px 2px 0 0
            color-mix(in srgb, var(--wbl-accent) 55%, transparent);
        transition:
            background-color 0.1s linear,
            color 0.1s linear,
            border-color 0.1s linear,
            transform 0.1s ease-out,
            box-shadow 0.1s ease-out;
    }
    /* Restore the colored [brackets] that global.css renders on <u>
       inside .widget-link — they were suppressed by the previous rule's
       inline override; re-enable only inside the chip so the badge reads
       `[w]ork` / `[p]osts` as before. The `p osts` gap was the missing
       bracket content leaving an empty inline box. */
    .wbl-root.framed :global(.wbl-frame-badge u::before) {
        content: '[';
        color: var(--wbl-accent);
    }
    .wbl-root.framed :global(.wbl-frame-badge u::after) {
        content: ']';
        color: var(--wbl-accent);
    }
    .wbl-root.framed :global(.wbl-frame-badge u) {
        text-decoration: none !important;
    }

    /* All chips on the left now — the About exception is no longer needed,
       but keep the selector as a no-op so future right-align experiments
       have a hook. */
    .wbl-root.framed :global(#intro-widget .wbl-frame-badge) {
        left: 1.2ch;
        right: auto;
    }

    /* Showcase-only grid swap: [w]ork ↔ [l]ast.fm (work bottom-left →
       top-right, last.fm top-right → bottom-left). Keeps 10-col math
       intact — just exchange their grid-column/row. */
    .wbl-root.framed :global(#widgets-grid.intro-v21 .work-widget) {
        grid-column: 6 / 11 !important;
        grid-row: 2 !important;
    }
    .wbl-root.framed :global(#widgets-grid.intro-v21 #stats-widget) {
        grid-column: 1 / 5 !important;
        grid-row: 3 !important;
    }
    /* Lift the badge when its card is hovered/focused — same as the about button */
    .wbl-root.framed
        :global(
            [tabindex='0']:is(:hover, :focus-within, [data-vim-focused='true'])
                .wbl-frame-badge
        ) {
        transform: translate(-1px, -1px);
        box-shadow: 2px 2px 0 0 var(--wbl-accent);
        border-color: var(--wbl-accent);
    }
    .wbl-root.framed
        :global(
            [tabindex='0']:is(:hover, :focus-within, [data-vim-focused='true'])
                .wbl-frame-badge:active
        ) {
        transform: translate(0, 0);
        box-shadow: 1px 1px 0 0 var(--wbl-accent);
    }

    /* Non-framed mode: leave everything alone — the page renders both
       side-by-side via two instances, one framed, one not. */
    .wbl-root:not(.framed) :global(.wbl-frame-badge) {
        display: none !important;
    }
    .wbl-root:not(.framed) :global(.wbl-about-chip) {
        display: none !important;
    }

    /* Last.fm in the mirrored clone: the clone renames every id inside
       #stats-widget to data-wbl-id to avoid duplicate-id collisions, so
       Player.astro's scoped #playing/#progress/#stats-widget styles (which
       are keyed to [data-astro-cid-…]) don't reach it. Re-host them here
       on data-wbl-id — mirrors Player.astro verbatim so Current == Proposed
       across all four reported regressions: sparklines, track name, paused
       vs live state, and duration color/icon. */
    .wbl-root.framed :global([data-wbl-id='stats-widget']) {
        grid-column: 2 / 4;
        grid-row: 1 / 3;
        min-height: 0;
    }
    .wbl-root.framed :global([data-wbl-id='playing']) {
        --box-border-color: var(--background2);
        color: var(--widget-accent, var(--accent));
        line-height: 1.2;
        gap: 0;
        padding-inline: 0.6ch;
    }
    .wbl-root.framed :global([data-wbl-id='playing'] .np-icon) {
        display: inline-flex;
        align-items: flex-end;
        justify-content: center;
        width: 2.4ch;
        height: 1lh;
        margin-right: 1ch;
        flex-shrink: 0;
        vertical-align: middle;
    }
    .wbl-root.framed :global([data-wbl-id='playing'] .np-pause) {
        line-height: 1lh;
        color: var(--foreground2);
    }
    .wbl-root.framed :global([data-wbl-id='playing'] .np-eq) {
        display: none;
        align-items: flex-end;
        gap: 0.26ch;
        height: 1lh;
    }
    .wbl-root.framed :global([data-wbl-id='playing'] .np-eq i) {
        display: block;
        width: 0.5ch;
        border-radius: 0;
        background: var(--widget-accent, var(--red));
        height: 18%;
        transform-origin: bottom center;
    }
    .wbl-root.framed
        :global([data-wbl-id='playing'][data-live='true'] .np-pause) {
        display: none !important;
    }
    .wbl-root.framed :global([data-wbl-id='playing'][data-live='true'] .np-eq) {
        display: inline-flex !important;
    }
    .wbl-root.framed
        :global([data-wbl-id='playing'][data-live='true'] .np-eq i) {
        animation: eq-bounce 650ms ease-in-out infinite alternate;
    }
    .wbl-root.framed
        :global(
            [data-wbl-id='playing'][data-live='true'] .np-eq i:nth-child(1)
        ) {
        animation-duration: 420ms;
        animation-delay: -80ms;
    }
    .wbl-root.framed
        :global(
            [data-wbl-id='playing'][data-live='true'] .np-eq i:nth-child(2)
        ) {
        animation-duration: 560ms;
        animation-delay: -160ms;
    }
    .wbl-root.framed
        :global(
            [data-wbl-id='playing'][data-live='true'] .np-eq i:nth-child(3)
        ) {
        animation-duration: 380ms;
        animation-delay: -40ms;
    }
    .wbl-root.framed
        :global(
            [data-wbl-id='playing'][data-live='true'] .np-eq i:nth-child(4)
        ) {
        animation-duration: 610ms;
        animation-delay: -190ms;
    }
    @media (prefers-reduced-motion: reduce) {
        .wbl-root.framed
            :global([data-wbl-id='playing'][data-live='true'] .np-eq i) {
            animation: none !important;
            height: 55% !important;
        }
    }
    .wbl-root.framed :global([data-wbl-id='progress-bar']) {
        color: var(--blue);
        margin-top: 0.25lh;
        --progress-h: 2px;
        padding-inline: 0.5ch;
        display: flex;
        align-items: center;
    }
    .wbl-root.framed :global([data-wbl-id='progress']) {
        --separator-color: var(--green);
        --separator-width: var(--progress-h, 2px);
        width: 0;
        display: inline-flex;
        position: relative;
        height: 1lh;
        background-image: linear-gradient(
            0deg,
            transparent 0,
            transparent calc(0.5lh - var(--separator-width) / 2),
            var(--separator-color) calc(0.5lh - var(--separator-width) / 2),
            var(--separator-color) calc(0.5lh + var(--separator-width) / 2),
            transparent calc(0.5lh + var(--separator-width) / 2),
            transparent
        );
    }
    .wbl-root.framed :global([data-wbl-id='progress-gutter']) {
        --separator-color: var(--background2);
        --separator-width: var(--progress-h, 2px);
        flex-grow: 1;
        display: inline-flex;
        height: 1lh;
        background-image: linear-gradient(
            0deg,
            transparent 0,
            transparent calc(0.5lh - var(--separator-width) / 2),
            var(--separator-color) calc(0.5lh - var(--separator-width) / 2),
            var(--separator-color) calc(0.5lh + var(--separator-width) / 2),
            transparent calc(0.5lh + var(--separator-width) / 2),
            transparent
        );
    }
    .wbl-root.framed
        :global(
            [data-wbl-id='playing'][data-live='true'] [data-wbl-id='progress']
        ) {
        --separator-color: var(--green);
        --separator-width: 3px;
        filter: drop-shadow(0 0 2px var(--green));
        overflow: visible;
    }
    .wbl-root.framed
        :global(
            [data-wbl-id='playing'][data-live='true']
                [data-wbl-id='progress']::after
        ) {
        content: '';
        position: absolute;
        top: 50%;
        left: 100%;
        translate: -50% -50%;
        width: 1.05ch;
        height: 1.05ch;
        border-radius: 999px;
        background: var(--green);
        box-shadow: 0 0 3px var(--green);
        animation: live-dot-pulse 900ms ease-in-out infinite alternate;
        pointer-events: none;
    }

    @keyframes live-dot-pulse {
        0% {
            opacity: 0.85;
            scale: 0.92;
        }
        100% {
            opacity: 1;
            scale: 1.02;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .wbl-root.framed
            :global(
                [data-wbl-id='playing'][data-live='true']
                    [data-wbl-id='progress']::after
            ) {
            animation: none;
        }
    }
    /* Now-playing text + duration inherit from [data-wbl-id='playing']'s
       --accent (pink/mauve) just like Player.astro's #playing — without this
       the duration falls back to the widget/frame foreground (black). */
    .wbl-root.framed :global([data-wbl-id='track-title']),
    .wbl-root.framed :global([data-wbl-id='track-duration']) {
        color: inherit;
    }
    /* History table in the showcase clone: scoped Player styles on #stats-widget
       don't reach [data-wbl-id=*] (cid mismatch), so re-host the grid vars + header. */
    .wbl-root.framed :global([data-wbl-id='stats-widget']) {
        --history-grid: 2.4ch 1.4fr 1fr 1.05fr;
    }
    .wbl-root.framed :global([data-wbl-id='stats-widget'] .history-head) {
        display: grid;
        grid-template-columns: var(--history-grid);
        gap: 1ch;
        align-items: center;
        justify-items: start;
        padding: 0 1ch;
        font-size: 0.72em;
        letter-spacing: 0.06em;
        color: var(--foreground2);
        opacity: 0.55;
        text-transform: uppercase;
        min-width: 0;
        border-bottom: 1px solid
            color-mix(in srgb, var(--foreground2) 12%, transparent);
        padding-bottom: 0.4lh;
        margin-bottom: 0.15lh;
    }

    @media (prefers-reduced-motion: reduce) {
        .wbl-root.framed :global(.wbl-frame-badge) {
            transition: none;
        }
    }
</style>

<script>
    // Inject one .wbl-frame-badge per widget card, deriving the label from
    // the card's existing inline badge so no markup has to be duplicated.
    // Runs once, idempotent (re-entry skips cards that already have one).
    const mountFrameBadges = (root: Element) => {
        const grid = root.querySelector('#widgets-grid')
        if (!grid) return
        const cards = grid.querySelectorAll<HTMLElement>(
            ':scope > [tabindex="0"]',
        )
        for (const card of cards) {
            if (card.querySelector(':scope > .wbl-frame-badge')) continue
            // Find the card's semantic title — whichever badge it uses.
            const src =
                card.querySelector<HTMLElement>(
                    '.ww-title, .pw-title, .tw-title, .ip-title, .iw-about-title, h1 [is-="badge"]',
                ) ?? card.querySelector<HTMLElement>('[is-="badge"]')
            const label = (src?.textContent ?? '').trim().replace(/\s+/g, ' ')
            if (!label) continue
            const badge = document.createElement('a')
            badge.className = 'wbl-frame-badge'
            // Preserve the original link target if there is one.
            const link = src?.querySelector<HTMLAnchorElement>('a[href]')
            if (link?.href) {
                badge.href = link.href
                if (link.target) badge.target = link.target
                if (link.rel) badge.rel = link.rel
            } else {
                badge.href = '#'
                badge.addEventListener('click', (e) => e.preventDefault())
                badge.style.cursor = 'default'
            }
            // Reconstruct badge content preserving <u> hints without
            // nesting <a> inside <a>. The badge itself is the link (href above),
            // so unwrap any inner <a> and keep surrounding text + markup.
            // Join as ONE word (no space) so the flex `gap: 0` doesn't split
            // `[w] ork` — the gap is icon↔text only, the bracket is inline.
            const hasInnerAnchor = !!src?.querySelector('a[href]')
            if (src && hasInnerAnchor) {
                let html = ''
                src.childNodes.forEach((n) => {
                    if (
                        n.nodeType === Node.ELEMENT_NODE &&
                        (n as Element).tagName === 'A'
                    ) {
                        html += (n as HTMLElement).innerHTML.trim()
                    } else if (n.nodeType === Node.ELEMENT_NODE) {
                        html += (n as HTMLElement).outerHTML
                    } else if (n.nodeType === Node.TEXT_NODE) {
                        const t = (n.textContent ?? '').replace(/\s+/g, '')
                        if (t) html += t
                    }
                })
                // collapse any whitespace the source left between the <u> letter and rest
                html = html.replace(/<\/u>\s+/g, '</u>')
                badge.innerHTML = html.trim()
                if (!badge.innerHTML)
                    badge.textContent = label.replace(/\s+/g, ' ').trim()
            } else if (src?.querySelector('u')) {
                badge.innerHTML = src.innerHTML.replace(/<\/u>\s+/g, '</u>')
            } else if (label) {
                // Keep single spaces (e.g. "Sam Foreman"); \s+→'' collapsed it to "SamForeman"
                badge.textContent = label.replace(/\s+/g, ' ').trim()
            } else if (src) {
                // Fallback: reconstruct from childNodes so the icon entity keeps its gap
                let html = ''
                src.childNodes.forEach((n) => {
                    if (n.nodeType === Node.ELEMENT_NODE)
                        html += (n as HTMLElement).outerHTML
                    else if (n.nodeType === Node.TEXT_NODE) {
                        const t = (n.textContent ?? '').replace(/\s+/g, ' ')
                        if (t.trim()) html += t
                    }
                })
                badge.innerHTML = html.trim() || label
            }
            // Hide the original inline badge in framed mode — the
            // border chip replaces it. Inline style so non-JS still sees it.
            if (src) {
                ;(src as HTMLElement).style.display = 'none'
            }
            // Insert as first child so absolute positioning is relative
            // to the card (which is position:relative).
            card.prepend(badge)

            // Intro widget: mirror the [a]bout → CTA as a second border chip
            // on the top-right. The title row + CTA are CSS-hidden; we clone
            // the CTA here so it reads as a border action (same hover as before).
            if (
                card.id === 'intro-widget' &&
                !card.querySelector(':scope > .wbl-about-chip')
            ) {
                const cta =
                    card.querySelector<HTMLAnchorElement>('.iw-title-about')
                if (cta?.href) {
                    const chip = document.createElement('a')
                    chip.className = 'wbl-about-chip'
                    chip.href = cta.getAttribute('href') ?? '/about'
                    // Preserve the bracketed label without double-encoding the arrow.
                    chip.textContent = (cta.textContent ?? '[a]bout →')
                        .trim()
                        .replace(/\s+/g, ' ')
                    card.prepend(chip)
                }
            }
        }
    }

    // Mirror the homepage's hover→dim behavior for the showcase, where the
    // global vim nav never touches the proposed pane's duplicate #widgets-grid.
    // We don't need full j/k — just "hovering one dims the others" so the
    // frame pop has something to contrast against. Skip when keyboard nav is
    // already driving it (data-vim-focused present).
    const wireHoverDim = (root: Element) => {
        const grid = root.querySelector<HTMLElement>('#widgets-grid')
        if (!grid) return
        if (grid.dataset.wblHoverDim === 'true') return
        grid.dataset.wblHoverDim = 'true'
        const cards = Array.from(
            grid.querySelectorAll<HTMLElement>(':scope > [tabindex="0"]'),
        )
        const update = () => {
            // cede to keyboard nav when it's active anywhere in this grid
            const vimActive = grid.querySelector('[data-vim-focused="true"]')
            if (vimActive) {
                grid.removeAttribute('data-wbl-hover')
                return
            }
            const hovered = cards.find((c) => c.matches(':hover'))
            if (hovered) grid.setAttribute('data-wbl-hover', 'true')
            else grid.removeAttribute('data-wbl-hover')
        }
        grid.addEventListener('mouseenter', update, true)
        grid.addEventListener('mouseleave', update, true)
        grid.addEventListener('mousemove', update)
    }

    // Second Player instance in the showcase has duplicate ids (e.g.
    // track-title, up-next) — getElementById only hits the first pane.
    // After the canonical Player script runs, mirror its data into the
    // duplicate so the proposed pane shows the same track/history. Use
    // MutationObserver rather than polling — cheap, event-driven.
    const mirrorLastfmDuplicate = () => {
        const frames = document.querySelectorAll<HTMLElement>(
            '[data-wbl-root].framed',
        )
        for (const frame of frames) {
            const dup = frame.querySelector<HTMLElement>('#stats-widget')
            if (!dup || dup.dataset.wblMirrored === 'true') continue
            const master =
                document.querySelector<HTMLElement>(
                    '[data-wbl-root]:not(.framed) #stats-widget',
                ) ?? document.getElementById('stats-widget')
            if (!master || master === dup) continue
            // Deduplicate ids inside the duplicate so future getElementByIds stay with master
            for (const el of dup.querySelectorAll<HTMLElement>('[id]')) {
                el.dataset.origId = el.id
                el.removeAttribute('id')
                // keep the CSS hooks (they target #playing etc only via Player.astro's scoped id)
                // re-add as data attrs for any style fallbacks
                el.setAttribute(`data-wbl-id`, el.dataset.origId ?? '')
            }
            const syncNowPlaying = () => {
                const srcPlaying = master.querySelector<HTMLElement>('#playing')
                const dstPlaying = dup.querySelector<HTMLElement>(
                    '[data-wbl-id="playing"]',
                )
                if (srcPlaying && dstPlaying) {
                    dstPlaying.dataset.live = srcPlaying.dataset.live ?? 'false'
                    dstPlaying.style.cssText = srcPlaying.style.cssText
                }
                for (const id of [
                    'track-title',
                    'track-artist',
                    'track-album',
                    'track-duration',
                ]) {
                    const src = master.querySelector(`#${id}`)
                    const dst = dup.querySelector(`[data-wbl-id="${id}"]`)
                    if (src && dst)
                        dst.innerHTML = (src as HTMLElement).innerHTML
                }
                // progress bar width + --progress-head + data-live state
                const srcProg = master.querySelector<HTMLElement>('#progress')
                const dstProg = dup.querySelector<HTMLElement>(
                    '[data-wbl-id="progress"]',
                )
                if (srcProg && dstProg)
                    (dstProg as HTMLElement).style.width = (
                        srcProg as HTMLElement
                    ).style.width
                // history list — clone live (source already populated via Last.fm)
                const srcUp = master.querySelector<HTMLElement>('#up-next')
                const dstUp = dup.querySelector<HTMLElement>(
                    '[data-wbl-id="up-next"]',
                )
                if (srcUp && dstUp) {
                    if (srcUp.children.length === 0) return false // not yet loaded
                    // Avoid churning if already in sync
                    if (
                        dstUp.children.length !== srcUp.children.length ||
                        dstUp.innerHTML !== srcUp.innerHTML
                    ) {
                        dstUp.innerHTML = srcUp.innerHTML
                    }
                }
                return true
            }
            // Always keep the progress + metadata in sync (bar ticks 2×/s,
            // now-playing text/attrs update on each fetch). History only needs
            // the first paint; skip it once it's cloned.
            let historyCloned = false
            const syncLoop = () => {
                const ok = syncNowPlaying()
                if (ok && !historyCloned) historyCloned = true
            }
            syncNowPlaying()
            // No attributeFilter — track-title/artist/album text changes come in as
            // characterData/textContent mutations; filtering to data-live/style/class
            // silenced them, which caused the track name + state regressions.
            const obs = new MutationObserver(syncLoop)
            obs.observe(master, {
                childList: true,
                subtree: true,
                characterData: true,
                attributes: true,
            })
            const int = setInterval(syncLoop, 350)
            dup.addEventListener(
                'DOMNodeRemoved',
                () => {
                    obs.disconnect()
                    clearInterval(int)
                },
                { once: true },
            )
            // Also re-bind if the showcase is re-inited (e.g. HMR)
            dup.dataset.wblMirrored = 'true'
        }
    }

    const init = () => {
        document
            .querySelectorAll<HTMLElement>('[data-wbl-root].framed')
            .forEach((root) => {
                mountFrameBadges(root)
                wireHoverDim(root)
            })
        // Delay mirror so the master Player fetch has had a chance to start
        requestAnimationFrame(() =>
            requestAnimationFrame(mirrorLastfmDuplicate),
        )
        if (document.readyState !== 'complete') {
            window.addEventListener('load', mirrorLastfmDuplicate, {
                once: true,
            })
        }
        setTimeout(mirrorLastfmDuplicate, 1200)
        setTimeout(mirrorLastfmDuplicate, 3500)
    }
    if (document.readyState === 'loading')
        document.addEventListener('DOMContentLoaded', init)
    else init()
</script>
