---
import { getCollection } from 'astro:content'

const docs = await getCollection('docs')
const talks = docs
    .filter((doc) => doc.id.startsWith('talks/'))
    .filter((doc) => !doc.id.endsWith('talks'))
    .filter((doc) => doc.data.date)
    .sort((a, b) => {
        const da = a.data.date ? new Date(a.data.date).getTime() : 0
        const db = b.data.date ? new Date(b.data.date).getTime() : 0
        return db - da
    })
    .slice(0, 20)

function formatDate(date: Date): string {
    const y = String(date.getFullYear()).slice(-2)
    const m = String(date.getMonth() + 1).padStart(2, '0')
    return `${y}/${m}`
}
---

<column
    box-="square"
    pad-="2 1"
    gap-="0"
    class="talks-widget"
    tabindex="-1"
    data-widget-card>
    <span is-="badge" variant-="orange" class="tw-title"
        >&#xf19d; <a href="/talks" class="widget-link"><u>t</u>alks</a></span
    >
    <column gap-="0" class="tw-list">
        {
            talks.map((talk) => (
                <a href={`/${talk.id}`} class="tw-item">
                    <span class="tw-date">
                        {talk.data.date
                            ? formatDate(new Date(talk.data.date))
                            : ''}
                    </span>
                    <span class="tw-name">{talk.data.title}</span>
                </a>
            ))
        }
    </column>
</column>

<style>
    .talks-widget {
        --widget-accent: var(--blue);
        gap: 1lh;
        overflow: hidden;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }

    .tw-title {
        background-image: none;
        --badge-text: none;
        --badge-color: none;
        --color: var(--widget-accent);
        color: var(--color);
        background-color: oklch(
            from var(--color) calc(l * var(--oklch-scale, 0.85)) c h / 0.1
        );
        a {
            color: var(--color);
            font-weight: bold;
        }
    }

    .tw-list {
        gap: 0;
        /* Rows need breathing room on touch: the 0.25lh pitch read as
           cramped on phones. 0.45lh lands near 28px, short of the last.fm
           list's 32px but comfortable to tap. */
        row-gap: 0.65lh;
        flex: 1;
        overflow-x: hidden;
        overflow-y: auto;
        min-height: 0;
        scrollbar-width: thin;
        scrollbar-color: var(--foreground2) transparent;
        scrollbar-gutter: stable;
        margin-block-start: -0.5lh;
    }

    .tw-item {
        display: flex;
        gap: 1ch;
        align-items: baseline;
        text-decoration: none;
        color: var(--foreground1);
        white-space: nowrap;
        min-width: 0;
        flex-shrink: 0;
        padding: 0 0.5ch;
        margin-inline: -0.5ch;
        border-radius: 2px;

        &:hover {
            color: var(--background0);
            background: var(--widget-accent) !important;
            .tw-date {
                color: color-mix(
                    in srgb,
                    var(--background0) 65%,
                    var(--widget-accent)
                );
            }
        }

        &:nth-child(even) {
            background: color-mix(in srgb, var(--foreground0) 4%, transparent);
        }
    }

    /* On touch pointers the flush one-line rows (~19-22px) fall under the
       WCAG 24px tap-target minimum. Grow them only for coarse pointers so
       desktop keeps its dense TUI listing; center the content in the taller
       box. lh keeps the target scaling with the font. */
    @media (pointer: coarse) {
        .tw-item {
            min-height: 2lh;
            padding-block: 0.22lh;
            align-items: center;
        }
    }

    .tw-date {
        color: var(--foreground2);
        flex-shrink: 0;
        width: 5ch;
    }

    .tw-name {
        min-width: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>
