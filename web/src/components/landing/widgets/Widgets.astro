---
import Clock from './Clock.astro'
import Player from './Player.astro'
import FileTree from './FileTree.astro'
import Calendar from './Calendar.astro'
import ContributionGraph from './ContributionGraph.astro'
import GitLog from './GitLog.astro'

import Sparkline from './Sparkline.astro'
import PostsWidget from './PostsWidget.astro'
import TalksWidget from './TalksWidget.astro'
import IntroWidget from './IntroWidget.astro'
import WorkWidget from './WorkWidget.astro'
import '@webtui/css/components/radio.css'
import './widget-frame.css'

interface Props {
    variant: number
    home?: boolean
}

const { variant, home = false } = Astro.props
const useCalendar = variant === 2 || variant === 3
const isIntroWidget = variant >= 8 && variant <= 21
const cols = variant === 3 ? 2 : 3
const gridCols = isIntroWidget
    ? {
          8: '1fr 1fr auto',
          9: 'repeat(3, 1fr)',
          10: 'auto 1fr',
          11: 'repeat(3, 1fr)',
          12: '1fr 1fr',
          13: '2fr 2fr 3fr 3fr',
          14: '3fr 3fr 2fr 2fr',
          15: 'repeat(10, 1fr)',
          16: 'repeat(10, 1fr)',
          17: 'repeat(10, 1fr)',
          18: 'repeat(10, 1fr)',
          19: 'repeat(10, 1fr)',
          20: 'repeat(10, 1fr)',
          21: 'repeat(10, 1fr)',
      }[variant]
    : `repeat(${cols}, 1fr)`
const opacity = variant === 4 ? 0.4 : isIntroWidget ? 1 : 0.3
const hideOnMobile = variant === 1
const total = 21
const layoutClass = isIntroWidget ? `intro-v${variant}` : ''
---

<div
    id="widgets-grid"
    class:list={[
        {
            'hide-mobile': hideOnMobile,
            'intro-in-grid': isIntroWidget,
            'home-grid': home,
        },
        layoutClass,
    ]}
    style={`grid-template-columns: ${gridCols}; opacity: ${opacity};`}>
    {/* Navbar moved to Intro.astro top-level */}
    {
        home && variant >= 15 ? (
            <>
                <IntroWidget {variant} {total} {home} />
                <Player />
                <WorkWidget />
                <PostsWidget />
                <TalksWidget />
            </>
        ) : home ? (
            <>
                <IntroWidget {variant} {total} {home} />
                <PostsWidget />
                <TalksWidget />
                <Clock />
                <Calendar />
                <Player />
            </>
        ) : (
            <>
                <Clock />
                <Player />
                {isIntroWidget ? (
                    <>
                        <Calendar />
                        <GitLog />
                        <IntroWidget {variant} {total} {home} />
                        <ContributionGraph />
                        {variant === 11 && <Sparkline />}
                        {variant >= 12 && variant <= 14 && <PostsWidget />}
                        {(variant === 13 || variant === 14) && <TalksWidget />}
                        {variant >= 15 && variant <= 21 && <WorkWidget />}
                        {variant >= 15 && variant <= 21 && <PostsWidget />}
                        {variant >= 15 && variant <= 21 && <TalksWidget />}
                    </>
                ) : useCalendar ? (
                    <Calendar />
                ) : (
                    <FileTree />
                )}
            </>
        )
    }
</div>

<style is:global>
    #widgets-grid {
        position: absolute;
        top: 50vh;
        left: 50%;
        transform: translate(round(-50%, 1ch), round(-50%, 1lh));
        display: grid;
        max-width: 150ch;
        max-height: 90vh;
        min-width: min(80ch, 100%);
        min-height: 32lh;
        width: round(80vw, 1ch);
        height: round(calc(100vh - 2lh), 1lh);
        grid-auto-rows: minmax(8lh, 12lh);
        grid-column-gap: 1ch;
        pointer-events: none;
    }

    #widgets-grid.hide-mobile {
        @media (max-width: 480px) {
            display: none;
        }
    }

    /* Shared styles for all intro-in-grid variants */
    #widgets-grid.intro-in-grid {
        pointer-events: auto;
        height: auto;
        min-height: auto;
        max-height: none;
        grid-auto-rows: auto;
    }

    /* Home page: tight content-height grid — each card clips its own
       scrolling list.
       NB: this block is `is:global`, so every selector is ALREADY global —
       wrapping in `:global(...)` here emits the pseudo literally into the
       output, which the browser then drops as invalid. Use plain selectors. */
    #widgets-grid.home-grid > * {
        overflow: hidden;
        min-height: 0;
    }

    /* Hover / focus / scroll-active: the SAME hard-offset drop-shadow the
       callouts and collapsed-heading chips use (2px 2px 0 0 near-black,
       theme-invariant). The cards use WebTUI box-="square", whose visible
       border is an INSET ::before (0.5ch/0.5lh in from the element edge), so
       the shadow is drawn on that ::before — anchored to the frame the user
       actually sees — instead of on the element edge, where it floated
       detached. The site-wide tactile-lift (global.css `#main-content
       [box-~='square']:is(:hover,:focus-within)` -> element box-shadow +
       translate) out-specifies any grid-level selector, so suppress its
       detached element shadow + translate with !important. */
    #widgets-grid > [tabindex='0'] {
        transition: color 100ms linear;
    }
    #widgets-grid > [tabindex='0']::before {
        transition:
            box-shadow 120ms ease-out,
            border-color 120ms ease-out;
    }
    /* Active = hovered, focused, or flagged by either mobile highlighter
       (data-scroll-active from markActiveWidget below, data-vim-focused from
       the scroll observer / vim nav). All four must drive BOTH the frame
       shadow here AND the content brightening (opacity rule in Intro.astro),
       so a widget's border and its contents light up together — otherwise a
       scrolled-in card gets the frame but its text stays dim. */
    #widgets-grid > [tabindex='0']:hover,
    #widgets-grid > [tabindex='0']:focus-within,
    #widgets-grid > [tabindex='0'][data-scroll-active='true'],
    #widgets-grid > [tabindex='0'][data-vim-focused='true'] {
        box-shadow: none !important;
        transform: none !important;
    }
    #widgets-grid > [tabindex='0']:hover::before,
    #widgets-grid > [tabindex='0']:focus-within::before,
    #widgets-grid > [tabindex='0'][data-scroll-active='true']::before,
    #widgets-grid > [tabindex='0'][data-vim-focused='true']::before {
        border-color: var(--foreground0);
        box-shadow: 2px 2px 0 0 color-mix(in srgb, var(--widget-accent, var(--foreground0)) 55%, rgba(0,0,0,0.55));
    }
    #widgets-grid > [tabindex='0'][data-scroll-active='true'],
    #widgets-grid > [tabindex='0'][data-vim-focused='true'] {
        color: var(--foreground0);
    }

    #grid-navbar {
        grid-column: 1 / -1;
    }

    /* Home page: stack to flex column earlier at intermediate sizes */
    @media (max-width: 1024px) {
        #widgets-grid.home-grid:not(
                .intro-v15,
                .intro-v16,
                .intro-v17,
                .intro-v18,
                .intro-v19,
                .intro-v20,
                .intro-v21
            ) {
            display: flex !important;
            flex-direction: column;
            position: static;
            transform: none;
            width: auto;
            max-width: round(calc(100vw - 2.5ch), 1ch);
            max-height: none;
            min-width: 0;
            min-height: 0;
            height: auto;
            margin-inline: auto;
            padding-inline: 0.5ch;
            padding-block-end: 2lh;
            padding-block-start: 0.6lh;
            box-sizing: border-box;
            gap: 1.4ch;
        }

        #widgets-grid.home-grid:not(
                .intro-v15,
                .intro-v16,
                .intro-v17,
                .intro-v18,
                .intro-v19,
                .intro-v20,
                .intro-v21
            )
            > :global(*) {
            flex-shrink: 0;
            min-height: auto !important;
            height: auto !important;
        }
        /* Un-capped widgets (intro/clock/cal) expand naturally */
        #widgets-grid.home-grid:not(
                .intro-v15,
                .intro-v16,
                .intro-v17,
                .intro-v18,
                .intro-v19,
                .intro-v20,
                .intro-v21
            )
            :global(#intro-widget),
        #widgets-grid.home-grid:not(
                .intro-v15,
                .intro-v16,
                .intro-v17,
                .intro-v18,
                .intro-v19,
                .intro-v20,
                .intro-v21
            )
            :global(#clock-widget),
        #widgets-grid.home-grid:not(
                .intro-v15,
                .intro-v16,
                .intro-v17,
                .intro-v18,
                .intro-v19,
                .intro-v20,
                .intro-v21
            )
            :global(.cal-widget) {
            max-height: none !important;
            overflow: visible !important;
        }
        /* Re-cap bounded list panels to ~half viewport so a 22-item list
           can't push siblings offscreen when the grid has no row-height. */
        #widgets-grid.home-grid:not(
                .intro-v15,
                .intro-v16,
                .intro-v17,
                .intro-v18,
                .intro-v19,
                .intro-v20,
                .intro-v21
            )
            :global(#stats-widget),
        #widgets-grid.home-grid:not(
                .intro-v15,
                .intro-v16,
                .intro-v17,
                .intro-v18,
                .intro-v19,
                .intro-v20,
                .intro-v21
            )
            :global(.posts-widget),
        #widgets-grid.home-grid:not(
                .intro-v15,
                .intro-v16,
                .intro-v17,
                .intro-v18,
                .intro-v19,
                .intro-v20,
                .intro-v21
            )
            :global(.talks-widget) {
            max-height: min(55dvh, 42lh) !important;
            max-height: min(55vh, 42lh) !important;
            overflow: hidden !important;
            display: flex !important;
            flex-direction: column !important;
        }
        #widgets-grid.home-grid:not(
                .intro-v15,
                .intro-v16,
                .intro-v17,
                .intro-v18,
                .intro-v19,
                .intro-v20,
                .intro-v21
            )
            :global(.pw-list),
        #widgets-grid.home-grid:not(
                .intro-v15,
                .intro-v16,
                .intro-v17,
                .intro-v18,
                .intro-v19,
                .intro-v20,
                .intro-v21
            )
            :global(.tw-list),
        #widgets-grid.home-grid:not(
                .intro-v15,
                .intro-v16,
                .intro-v17,
                .intro-v18,
                .intro-v19,
                .intro-v20,
                .intro-v21
            )
            :global(#up-next) {
            overflow-y: auto !important;
            flex: 1 1 auto !important;
            min-height: 0 !important;
        }
        #widgets-grid.home-grid:not(
                .intro-v15,
                .intro-v16,
                .intro-v17,
                .intro-v18,
                .intro-v19,
                .intro-v20,
                .intro-v21
            )
            :global(.history-section) {
            overflow: hidden !important;
            display: flex !important;
            flex-direction: column !important;
            flex: 1 1 auto !important;
            min-height: 0 !important;
        }

    }

    /* Tablet + mobile: simple flex column */
    @media (max-width: 1024px) {
        #widgets-grid.intro-in-grid {
            display: flex !important;
            flex-direction: column;
            position: static;
            transform: none;
            width: auto;
            max-width: round(95vw, 1ch);
            max-height: none;
            min-width: 0;
            min-height: 0;
            height: auto;
            margin-inline: auto;
            padding-block-end: 1lh;
            padding-block-start: 1ch;
            gap: 1ch;
        }

        /* Prevent flex children from shrinking */
        #widgets-grid.intro-in-grid > * {
            flex-shrink: 0;
        }

        /* Reorder: intro first, content next, decorative last */
        #widgets-grid.intro-in-grid #intro-widget {
            order: 1;
        }
        #widgets-grid.intro-in-grid .posts-widget {
            order: 2;
        }
        #widgets-grid.intro-in-grid .talks-widget {
            order: 3;
        }
        #widgets-grid.intro-in-grid .gitlog-widget {
            order: 4;
        }
        #widgets-grid.intro-in-grid #clock-widget {
            order: 5;
        }
        #widgets-grid.intro-in-grid .cal-widget {
            order: 6;
        }
        #widgets-grid.intro-in-grid .contrib-widget {
            order: 7;
        }
        #widgets-grid.intro-in-grid .spark-widget {
            order: 8;
        }
        #widgets-grid.intro-in-grid .work-widget {
            order: 9;
        }
        #widgets-grid.intro-in-grid #stats-widget {
            order: 10;
        }
    }

    /* v8: Bento — intro top-left, small widgets right */
    #widgets-grid.intro-v8 {
        #intro-widget {
            grid-column: 1 / 3;
            grid-row: 2;
        }
        #clock-widget {
            grid-column: 3;
            grid-row: 2;
        }
        .gitlog-widget {
            grid-column: 1;
            grid-row: 3;
        }
        .contrib-widget {
            grid-column: 2;
            grid-row: 3;
        }
        .cal-widget {
            grid-column: 3;
            grid-row: 3;
        }
        #stats-widget {
            grid-column: 1 / 4;
            grid-row: 4;
        }
    }

    /* v9: Banner — clock top-left, intro top-right spanning 2 */
    #widgets-grid.intro-v9 {
        #clock-widget {
            grid-column: 1;
            grid-row: 2;
        }
        #intro-widget {
            grid-column: 2 / 4;
            grid-row: 2;
        }
        .cal-widget {
            grid-column: 1;
            grid-row: 3;
        }
        .contrib-widget {
            grid-column: 2;
            grid-row: 3;
        }
        #stats-widget {
            grid-column: 3;
            grid-row: 3 / 5;
        }
        .gitlog-widget {
            grid-column: 1 / 3;
            grid-row: 4;
        }
    }

    /* v10: 2-col — contrib full-width at bottom */
    #widgets-grid.intro-v10 {
        #clock-widget {
            grid-column: 1;
            grid-row: 2;
        }
        #intro-widget {
            grid-column: 2;
            grid-row: 2;
        }
        .cal-widget {
            grid-column: 1;
            grid-row: 3;
        }
        #stats-widget {
            grid-column: 2;
            grid-row: 3;
        }
        .gitlog-widget {
            grid-column: 1 / 3;
            grid-row: 4;
        }
        .contrib-widget {
            grid-column: 1 / 3;
            grid-row: 5;
        }
    }

    /* v11: 2x2 lower-left grid with sparkline */
    #widgets-grid.intro-v11 {
        #clock-widget {
            grid-column: 1;
            grid-row: 2;
        }
        #intro-widget {
            grid-column: 2 / 4;
            grid-row: 2;
        }
        .cal-widget {
            grid-column: 1;
            grid-row: 3;
        }
        .spark-widget {
            grid-column: 2;
            grid-row: 3;
        }
        .gitlog-widget {
            grid-column: 1;
            grid-row: 4;
        }
        .contrib-widget {
            grid-column: 2;
            grid-row: 4;
        }
        #stats-widget {
            grid-column: 3;
            grid-row: 3 / 5;
        }
    }

    /* v12: 2x2 minimal — clock+cal, intro, player, posts */
    #widgets-grid.intro-v12 {
        #clock-widget {
            grid-column: 1;
            grid-row: 2;
        }
        .cal-widget {
            display: none;
        }
        #intro-widget {
            grid-column: 2;
            grid-row: 2;
        }
        #stats-widget {
            grid-column: 1;
            grid-row: 3;
        }
        .posts-widget {
            grid-column: 2;
            grid-row: 3;
        }
        .gitlog-widget,
        .contrib-widget {
            display: none;
        }
    }

    /* Shared: cap player height in v13/v14 to match posts/talks */
    #widgets-grid.intro-v13 #stats-widget,
    #widgets-grid.intro-v14 #stats-widget {
        max-height: round(22lh, 1lh);
        overflow: hidden;
    }

    /* v13: 4-col 40/60 split — clock+cal | intro, player | posts+talks */
    #widgets-grid.intro-v13 {
        #clock-widget {
            grid-column: 1;
            grid-row: 2;
        }
        .cal-widget {
            grid-column: 2;
            grid-row: 2;
        }
        #intro-widget {
            grid-column: 3 / 5;
            grid-row: 2;
        }
        #stats-widget {
            grid-column: 1 / 3;
            grid-row: 3;
        }
        .posts-widget {
            grid-column: 3;
            grid-row: 3;
        }
        .talks-widget {
            grid-column: 4;
            grid-row: 3;
        }

        .gitlog-widget,
        .contrib-widget {
            display: none;
        }
    }

    /* v14: swapped 40/60 — intro+posts/talks left, clock+cal+player right */
    #widgets-grid.intro-v14 {
        #intro-widget {
            grid-column: 1 / 3;
            grid-row: 2;
        }
        #clock-widget {
            grid-column: 3;
            grid-row: 2;
        }
        .cal-widget {
            grid-column: 4;
            grid-row: 2;
        }
        .posts-widget {
            grid-column: 1;
            grid-row: 3;
        }
        .talks-widget {
            grid-column: 2;
            grid-row: 3;
        }
        #stats-widget {
            grid-column: 3 / 5;
            grid-row: 3;
        }
        .gitlog-widget,
        .contrib-widget {
            display: none;
        }
    }

    /* v15–v19: Dashboard — intro+player top, work+posts+talks bottom */
    #widgets-grid.intro-v15,
    #widgets-grid.intro-v16,
    #widgets-grid.intro-v17,
    #widgets-grid.intro-v18,
    #widgets-grid.intro-v19,
    #widgets-grid.intro-v20,
    #widgets-grid.intro-v21 {
        grid-template-columns: repeat(10, 1fr);
        grid-template-rows: auto auto minmax(12lh, 1fr);
        max-height: round(90vh, 1lh);
        height: auto;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--foreground2) transparent;
        top: 50vh;
        transform: translate(round(-50%, 1ch), round(-50%, 1lh));

        #intro-widget {
            grid-column: 1 / 6;
            grid-row: 2;
            max-height: 15lh;
        }
        #stats-widget {
            grid-column: 6 / 11;
            grid-row: 2;
            max-height: 15lh;
        }
        .work-widget {
            grid-column: 1 / 5;
            grid-row: 3;
            max-height: 15lh;
        }
        .posts-widget {
            grid-column: 5 / 8;
            grid-row: 3;
            max-height: 15lh;
        }
        .talks-widget {
            grid-column: 8 / 11;
            grid-row: 3;
            max-height: 15lh;
        }

        .cal-widget,
        #clock-widget,
        .gitlog-widget,
        .contrib-widget {
            display: none;
        }

        @media (max-width: 1024px) {
            display: flex !important;
            flex-direction: column;
            position: static;
            transform: none;
            width: auto;
            max-width: round(95vw, 1ch);
            max-height: none;
            min-width: 0;
            min-height: 0;
            height: auto;
            margin-inline: auto;
            padding-block: 1lh;
            gap: 1ch;

            #intro-widget,
            #stats-widget,
            .work-widget,
            .posts-widget,
            .talks-widget {
                grid-column: auto;
                grid-row: auto;
                max-height: none;
                flex-shrink: 0;
                /* Snap each widget into focus as the user scrolls
                   (restores the older multi-section home behavior).
                   scroll-snap-type is set on <html> below — putting
                   it on the grid wouldn't fire because the grid
                   isn't the scrolling element here, the page is.
                   scroll-snap-stop: always so a fast swipe past the
                   intro doesn't skip clear over the tall lastfm
                   widget — the browser is forced to land on each
                   widget in sequence. */
                scroll-snap-align: start;
                scroll-snap-stop: always;
                scroll-margin-block-start: 1lh;
            }

            /* Single-column order: intro, then work / posts / talks, with the
               last.fm (#stats-widget) player moved to the END — on desktop it
               sits top-right next to the intro, but stacked it's a tall, busy
               track list, so it reads better after the content sections than
               wedged between intro and work. */
            #intro-widget {
                order: 1;
            }
            .work-widget {
                order: 2;
            }
            .posts-widget {
                order: 3;
            }
            .talks-widget {
                order: 4;
            }
            #stats-widget {
                order: 5;
            }
        }
    }

    /* v17: Shrink to fit — remove max-height caps */
    #widgets-grid.intro-v17 {
        #intro-widget,
        #stats-widget {
            max-height: none;
        }
    }

    /* Home page grid placement — overrides v14 (not v15) */
    #widgets-grid.home-grid:not(
            .intro-v15,
            .intro-v16,
            .intro-v17,
            .intro-v18,
            .intro-v19,
            .intro-v20,
            .intro-v21
        ) {
        grid-template-columns: 3fr 3fr 2fr 2fr;
        grid-template-rows: auto auto 20lh;

        #intro-widget {
            grid-column: 1 / 3;
            grid-row: 2;
        }
        #clock-widget {
            grid-column: 3;
            grid-row: 2;
            max-height: 15lh;
            overflow: hidden;
        }
        .cal-widget {
            grid-column: 4;
            grid-row: 2;
            max-height: 15lh;
            overflow: auto;
            display: table;
            text-align: center;
        }
        .posts-widget {
            grid-column: 1;
            grid-row: 3;
            max-height: 20lh;
        }
        .talks-widget {
            grid-column: 2;
            grid-row: 3;
            max-height: 20lh;
        }
        #stats-widget {
            grid-column: 3 / 5;
            grid-row: 3;
            max-height: 20lh;
        }
    }

    /* Mobile snap-scroll for the home page (v21). Apply to <html>
       because the page is what actually scrolls — putting it on the
       grid doesn't fire since the grid isn't the scroll container in
       mobile mode. Scoped to pages that render the v21 grid via :has()
       so it doesn't leak to other landing variants. */
    @media (max-width: 1024px) {
        html:has(#widgets-grid.intro-v21) {
            scroll-snap-type: y proximity;
        }
    }
</style>

<script>
    /* Mark the most-visible v21 widget as data-scroll-active. Active =
       the widget whose visual CENTER is closest to a focus line at
       33% of the viewport height (a third down from the top).
       Why "center to focus line" and not "max overlap with a band":
       overlap-based heuristics inherently favor tall widgets (lastfm,
       work) — when scrolling between two short neighbors of a giant,
       the giant's overlap-with-band stays larger than either short
       widget's, so the short one never wins focus.
       Closest-center fixes that: tall widgets only win while their
       midline is actually near the focus point. */
    /* data-scroll-active is a MOBILE-only signal. The v21 grid only stacks
       and scrolls at <=1024px; on desktop it fits in the viewport and never
       scrolls, so markActiveWidget would mark the top widget once on load and
       leave it stuck active forever (the intro-widget kept a permanent hover
       shadow). Match the same 1024px breakpoint the stacked layout + snap
       use, so on desktop the shadow is driven purely by :hover/:focus-within. */
    const mobileScroll = window.matchMedia('(max-width: 1024px)')

    function markActiveWidget() {
        const grid = document.querySelector(
            '#widgets-grid.intro-v21',
        ) as HTMLElement | null
        if (!grid) return
        const widgets = Array.from(
            grid.querySelectorAll<HTMLElement>(':scope > [tabindex="0"]'),
        )
        if (!widgets.length) return

        // Desktop: no scrolling layout — clear any active flag and let hover /
        // focus-within own the selected-widget shadow.
        if (!mobileScroll.matches) {
            for (const w of widgets) {
                if (w.getAttribute('data-scroll-active') === 'true') {
                    w.setAttribute('data-scroll-active', 'false')
                }
            }
            return
        }

        const focusY = window.innerHeight * 0.33
        let best: HTMLElement | null = null
        let bestDist = Infinity
        for (const w of widgets) {
            const r = w.getBoundingClientRect()
            // Only consider widgets that actually intersect the
            // viewport at all — fully-offscreen widgets shouldn't
            // compete for focus.
            if (r.bottom < 0 || r.top > window.innerHeight) continue
            const center = (r.top + r.bottom) / 2
            const dist = Math.abs(center - focusY)
            if (dist < bestDist) {
                bestDist = dist
                best = w
            }
        }
        if (!best) best = widgets[0] ?? null

        for (const w of widgets) {
            const active = w === best
            const cur = w.getAttribute('data-scroll-active') === 'true'
            if (cur !== active) {
                w.setAttribute('data-scroll-active', String(active))
            }
            // Scroll position is the sole highlight authority on mobile/tablet.
            // Clear any stale data-vim-focused (set by the load-time
            // vimFocusElement(intro) or keyboard nav) on non-active widgets so
            // scrolling doesn't leave two widgets lit at once. The actually
            // keyboard-focused widget still lights via :focus-within/:focus.
            if (!active && w.getAttribute('data-vim-focused') === 'true') {
                w.removeAttribute('data-vim-focused')
            }
        }
    }

    let raf = 0
    function onScroll() {
        if (raf) return
        raf = requestAnimationFrame(() => {
            raf = 0
            markActiveWidget()
        })
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', markActiveWidget)
    } else {
        markActiveWidget()
    }
    window.addEventListener('scroll', onScroll, { passive: true })
    window.addEventListener('resize', onScroll, { passive: true })
</script>
<script>
    import './widget-frame'
</script>
