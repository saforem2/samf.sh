<column
    box-="square"
    class="widget"
    id="stats-widget"
    gap-="1"
    pad-="2 1"
    tabindex="0">
    <span is-="badge" class="ip-title"
        >&#xf202; [ <a
            href="https://www.last.fm/user/saforem2/"
            target="_blank">
            l</a
        >]ast.fm
    </span>
    <column box-="round" pad-="2 1" id="playing">
        <row gap-="1">
            <span style="margin-right: 1ch;">&#xf04c;</span>
            <row self-="grow shrink !basis" style="overflow: hidden; gap: 1ch;">
                <strong class="title" id="track-title">Loading...</strong>
                <span class="album" id="track-album">
                    <span>&#xf001;</span> —
                </span>
                <span class="author" id="track-artist">
                    <span>&#xf007;</span> —
                </span>
            </row>
            <row self-="!shrink">
                <span class="duration" id="track-duration">--:--</span>
            </row>
        </row>
        <row id="progress-bar">
            <span>[</span>
            <div id="progress" is-="separator"></div>
            <div id="progress-gutter" is-="separator"></div>
            <span>]</span>
        </row>
    </column>

    <column
        id="sparkline-wrap"
        gap-="1"
        pad-="1 1"
        box-="round"
        style="display: none;">
        <row gap-="1" style="justify-content: space-between; align-items: baseline;">
            <span class="sparkline-title">7d scrobbles</span>
            <span id="sparkline-total" class="sparkline-total"></span>
        </row>
        <div id="sparkline" role="img" aria-label="Scrobbles in the last 7 days"></div>
        <div id="sparkline-tip" class="sparkline-tip" aria-live="polite"></div>
        <svg
            id="sparkline-svg"
            viewBox="0 0 140 28"
            preserveAspectRatio="none"
            aria-hidden="true"
            style="display: none;"></svg>
    </column>

    <column pad-="1 0" self-="grow" class="history-section">
        <!-- <column> -->
        <!--     <div is-="separator" style="--separator-color: var(--background2)"> -->
        <!--     </div> -->
        <!-- </column> -->
        <column id="up-next"></column>
    </column>
</column>

<script type="module">
    const lastfmData = {
        baseURL:
            'https://ws.audioscrobbler.com/2.0/?method=user.getrecenttracks&user=',
        user: 'saforem2',
        apiKey: '1dbc15037c1fe71ce06acbb3f73adc75',
        additional: '&format=json&limit=10',
    }

    const trackTitle = document.getElementById('track-title')
    const trackAlbum = document.getElementById('track-album')
    const trackArtist = document.getElementById('track-artist')
    const trackDuration = document.getElementById('track-duration')
    const upNext = document.getElementById('up-next')
    const sparkWrap = document.getElementById('sparkline-wrap')
    const sparkEl = document.getElementById('sparkline')
    const sparkTotal = document.getElementById('sparkline-total')
    const sparkTip = document.getElementById('sparkline-tip')
    const sparkSvg = document.getElementById('sparkline-svg')

    const clearUpNext = () => {
        if (!upNext) return
        while (upNext.firstChild) {
            upNext.removeChild(upNext.firstChild)
        }
    }

    const makeSeparator = () => {
        const column = document.createElement('column')
        column.setAttribute('pad-', '1 0')
        const divider = document.createElement('div')
        divider.setAttribute('is-', 'separator')
        divider.style.setProperty('--separator-color', 'var(--background1)')
        column.appendChild(divider)
        return column
    }

    const makeRow = ({ name, album, artist }) => {
        const row = document.createElement('row')
        row.className = 'song'

        const icon = document.createElement('span')
        icon.innerHTML = '&#xf04b;'
        row.appendChild(icon)

        const details = document.createElement('row')
        details.setAttribute('self-', 'grow')
        details.style.overflow = 'hidden'
        details.style.gap = '1ch'

        const title = document.createElement('strong')
        title.className = 'title'
        title.textContent = name ?? 'Unknown'

        const albumEl = document.createElement('span')
        albumEl.className = 'album'
        albumEl.innerHTML = `<span>&#xf001;</span> ${album ?? 'Unknown'}`

        const artistEl = document.createElement('span')
        artistEl.className = 'author'
        artistEl.innerHTML = `<span>&#xf007;</span> ${artist ?? 'Unknown'}`

        details.appendChild(title)
        details.appendChild(albumEl)
        details.appendChild(artistEl)
        row.appendChild(details)

        const durationRow = document.createElement('row')
        durationRow.setAttribute('self-', '!shrink')
        const duration = document.createElement('span')
        duration.className = 'duration'
        duration.textContent = ' '
        durationRow.appendChild(duration)
        row.appendChild(durationRow)

        return row
    }

    const updateNowPlaying = (track) => {
        if (trackTitle) trackTitle.textContent = track?.name ?? 'Silence!'
        if (trackAlbum) {
            const album = track?.album?.['#text'] || 'Unknown'
            trackAlbum.innerHTML = `<span>&#xf001;</span> ${album}`
        }
        if (trackArtist) {
            const artist = track?.artist?.['#text'] || 'Sam Foreman'
            trackArtist.innerHTML = `<span>&#xf007;</span> ${artist}`
        }
        if (trackDuration) trackDuration.textContent = ' '
    }

    const setLastFM = async () => {
        try {
            const url =
                lastfmData.baseURL +
                lastfmData.user +
                '&api_key=' +
                lastfmData.apiKey +
                lastfmData.additional

            const resp = await fetch(url)
            if (!resp.ok) throw new Error('lastfm fetch failed')
            const data = await resp.json()
            const tracks = data?.recenttracks?.track ?? []
            const [current, ...rest] = tracks

            updateNowPlaying(current)

            clearUpNext()
            if (upNext && rest.length > 0) {
                rest.forEach((track, index) => {
                    upNext.appendChild(
                        makeRow({
                            name: track?.name,
                            album: track?.album?.['#text'],
                            artist: track?.artist?.['#text'],
                        }),
                    )
                    if (index < rest.length - 1) {
                        upNext.appendChild(makeSeparator())
                    }
                })
            }
        } catch {
            updateNowPlaying(null)
            clearUpNext()
        }
    }

    // --- 7-day scrobble sparkline ---

    /** Build 7 buckets ending today, local calendar days. */
    function buildDayBuckets() {
        const buckets = []
        const now = new Date()
        // normalize to local midnight today
        const todayMidnight = new Date(now.getFullYear(), now.getMonth(), now.getDate())
        for (let i = 6; i >= 0; i--) {
            const d = new Date(todayMidnight)
            d.setDate(todayMidnight.getDate() - i)
            const next = new Date(d)
            next.setDate(d.getDate() + 1)
            buckets.push({
                date: d,
                nextDate: next,
                from: Math.floor(d.getTime() / 1000),
                to: Math.floor(next.getTime() / 1000),
                count: 0,
                label: d.toLocaleDateString('en-US', { weekday: 'short' }),
                dateStr: d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }),
                iso: d.toISOString().slice(0, 10),
            })
        }
        return buckets
    }

    function showSparkTip(text) {
        if (!sparkTip) return
        sparkTip.textContent = text
        sparkTip.dataset.visible = 'true'
    }

    function hideSparkTip() {
        if (!sparkTip) return
        sparkTip.textContent = ''
        sparkTip.dataset.visible = 'false'
    }

    function renderSparkline(buckets) {
        if (!sparkEl || !sparkWrap || !sparkTotal || !sparkSvg) return
        const max = Math.max(1, ...buckets.map((b) => b.count))
        const total = buckets.reduce((s, b) => s + b.count, 0)

        // Build bar row (WebTUI-style, keyboard navigable)
        sparkEl.innerHTML = ''
        const row = document.createElement('div')
        row.className = 'sparkline-row'

        buckets.forEach((b) => {
            const btn = document.createElement('button')
            btn.type = 'button'
            btn.className = 'sparkline-bar-btn'
            const isToday = b.iso === new Date().toISOString().slice(0, 10)
            if (isToday) btn.dataset.today = 'true'
            btn.setAttribute(
                'aria-label',
                `${b.label} ${b.dateStr}: ${b.count} scrobble${b.count === 1 ? '' : 's'}`,
            )

            const col = document.createElement('span')
            col.className = 'sparkline-col'

            const bar = document.createElement('span')
            bar.className = 'sparkline-bar'
            const h = b.count === 0 ? 0.18 : 0.35 + (b.count / max) * 2.6
            bar.style.height = `${h}lh`
            if (b.count === 0) bar.dataset.empty = 'true'

            const val = document.createElement('span')
            val.className = 'sparkline-val'
            val.textContent = b.count === 0 ? '·' : String(b.count)

            const lbl = document.createElement('span')
            lbl.className = 'sparkline-lbl'
            lbl.textContent = b.label.slice(0, 2)

            col.append(bar, val, lbl)
            btn.appendChild(col)

            const tipText = `${b.label} ${b.dateStr} — ${b.count} scrobble${b.count === 1 ? '' : 's'}`
            btn.addEventListener('mouseenter', () => showSparkTip(tipText))
            btn.addEventListener('focus', () => showSparkTip(tipText))
            btn.addEventListener('mouseleave', hideSparkTip)
            btn.addEventListener('blur', hideSparkTip)

            row.appendChild(btn)
        })

        sparkEl.appendChild(row)
        sparkTotal.textContent = `${total} in 7d`
        sparkWrap.style.display = ''

        // Tiny SVG polyline overlay for the trend (purely decorative)
        const w = 140
        const h = 28
        const pad = 2
        const pts = buckets.map((b, i) => {
            const x = pad + (i / Math.max(1, buckets.length - 1)) * (w - pad * 2)
            const y = h - pad - (b.count / max) * (h - pad * 2)
            return `${x},${y}`
        })
        sparkSvg.innerHTML = ''
        if (pts.length > 1) {
            const pl = document.createElementNS('http://www.w3.org/2000/svg', 'polyline')
            pl.setAttribute('points', pts.join(' '))
            pl.setAttribute('fill', 'none')
            pl.setAttribute('stroke', 'var(--red)')
            pl.setAttribute('stroke-width', '1.2')
            pl.setAttribute('stroke-linecap', 'round')
            pl.setAttribute('stroke-linejoin', 'round')
            pl.setAttribute('opacity', '0.9')
            sparkSvg.appendChild(pl)
            // dots
            buckets.forEach((b, i) => {
                const dot = document.createElementNS('http://www.w3.org/2000/svg', 'circle')
                const x = pad + (i / Math.max(1, buckets.length - 1)) * (w - pad * 2)
                const y = h - pad - (b.count / max) * (h - pad * 2)
                dot.setAttribute('cx', String(x))
                dot.setAttribute('cy', String(y))
                dot.setAttribute('r', b.count === 0 ? '1.2' : '2')
                dot.setAttribute('fill', 'var(--red)')
                sparkSvg.appendChild(dot)
            })
            sparkSvg.style.display = 'block'
        }
    }

    async function fetchSparkline() {
        if (!sparkWrap || !sparkEl) return
        try {
            const buckets = buildDayBuckets()
            const from = buckets[0].from
            const to = Math.floor(Date.now() / 1000)
            // Last.fm caps page size; 200 is enough for a week's scrobbles for most users.
            // If the window truncates, the counts still degrade gracefully (capped at 200).
            const url =
                `https://ws.audioscrobbler.com/2.0/?method=user.getrecenttracks` +
                `&user=${encodeURIComponent(lastfmData.user)}` +
                `&api_key=${encodeURIComponent(lastfmData.apiKey)}` +
                `&format=json&limit=200&from=${from}&to=${to}`

            const resp = await fetch(url)
            if (!resp.ok) throw new Error('sparkline fetch failed')
            const data = await resp.json()
            const tracks = data?.recenttracks?.track ?? []
            const list = Array.isArray(tracks) ? tracks : tracks ? [tracks] : []

            for (const t of list) {
                const uts = t?.date?.uts ? Number(t.date.uts) : null
                if (!uts) continue // skip now-playing entry (no date)
                for (const b of buckets) {
                    if (uts >= b.from && uts < b.to) {
                        b.count++
                        break
                    }
                }
            }

            renderSparkline(buckets)
        } catch {
            // Silent degrade — leave the widget without the sparkline row.
            if (sparkWrap) sparkWrap.style.display = 'none'
        }
    }

    // Defer the first last.fm fetch off the initial critical path — it's a
    // third-party request (ws.audioscrobbler.com) that Lighthouse flags as the
    // max critical-path latency (~474ms). The widget already shows "Loading..."
    // in static HTML, so nothing above the fold waits on it. rIC's 2nd arg
    // must be an options object ({ timeout }), NOT a bare number (a bare number
    // throws and silently kills the callback); mirror Layout.astro's
    // scheduleIdle helper. The periodic refresh still starts once the first
    // fetch has been scheduled.
    const scheduleIdle = (fn) => {
        if (window.requestIdleCallback) {
            window.requestIdleCallback(fn, { timeout: 3000 })
        } else {
            window.setTimeout(fn, 1)
        }
    }
    scheduleIdle(() => {
        setLastFM()
        fetchSparkline()
        setInterval(setLastFM, 10 * 5000)
        setInterval(fetchSparkline, 60 * 5000)
    })
</script>

<style>
    #progress-bar {
        color: var(--blue);
        #progress {
            --separator-color: var(--green);
            width: 15ch;
        }

        #progress-gutter {
            --separator-color: var(--background2);
            flex-grow: 1;
        }
    }

    #stats-widget {
        grid-column: 2 / 4;
        grid-row: 1 / 3;
        min-height: 0;
    }

    .history-section {
        overflow: hidden;
        min-height: 0;
        line-height: 1;
    }

    #up-next {
        overflow-y: auto;
        min-height: 0;
        scrollbar-width: thin;
        scrollbar-color: var(--foreground2) transparent;
    }

    #playing {
        --box-border-color: var(--background2);
        color: var(--accent);
        line-height: 1.3;
    }

    #sparkline-wrap {
        --box-border-color: var(--background2);
    }

    .sparkline-title {
        color: var(--foreground2);
        font-size: 0.85em;
        letter-spacing: 0.04em;
    }

    .sparkline-total {
        color: var(--foreground2);
        font-size: 0.85em;
    }

    #sparkline {
        width: 100%;
    }

    .sparkline-row {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 0;
        width: 100%;
    }

    .sparkline-bar-btn {
        flex: 1;
        display: flex;
        justify-content: center;
        appearance: none;
        background: transparent;
        border: none;
        padding: 0;
        margin: 0;
        cursor: pointer;
        color: inherit;
        font: inherit;

        &:hover .sparkline-bar,
        &:focus-visible .sparkline-bar {
            background-color: var(--red);
            filter: brightness(1.15);
        }

        &:focus-visible {
            outline: 1px solid var(--foreground2);
            outline-offset: 1px;
        }

        &[data-today='true'] .sparkline-lbl {
            color: var(--foreground0);
            font-weight: 600;
        }
    }

    .sparkline-col {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0;
        width: 100%;
        padding-inline: 0.25ch;
    }

    .sparkline-bar {
        width: 100%;
        max-width: 3ch;
        background-color: var(--red);
        opacity: 0.95;
        border-radius: 1px;
        min-height: 0.15lh;
        transition:
            background-color 120ms ease,
            filter 120ms ease,
            height 240ms ease;
    }

    .sparkline-bar[data-empty='true'] {
        background-color: var(--background2);
        opacity: 1;
    }

    .sparkline-val {
        color: var(--foreground2);
        font-size: 0.75em;
        line-height: 1;
        margin-top: 0.2lh;
    }

    .sparkline-lbl {
        color: var(--foreground2);
        font-size: 0.7em;
        line-height: 1;
        margin-top: 0.1lh;
    }

    .sparkline-tip {
        color: var(--foreground1);
        font-size: 0.8em;
        min-height: 1lh;
        text-align: center;
        opacity: 0;
        transition: opacity 120ms ease;
    }

    .sparkline-tip[data-visible='true'] {
        opacity: 1;
    }

    #sparkline-svg {
        width: 100%;
        height: 28px;
        margin-top: 0.15lh;
        opacity: 0.9;
    }

    .lastfm-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5ch;
        padding: 0 1ch;
        background-color: oklch(from var(--red) l c h / 0.15);
        color: var(--red);
        text-decoration: none;
        font-weight: 600;

        &:hover {
            background-color: oklch(from var(--red) l c h / 0.25);
            text-decoration: none;
        }
    }

    .ip-title {
        background-image: none;
        --badge-text: none;
        --badge-color: none;
        --color: var(--red);
        color: var(--color);
        background-color: oklch(
            from var(--color) calc(l * var(--oklch-scale, 0.85)) c h / 0.1
        );
        a {
            color: var(--color);
            font-weight: bold;
        }
    }

    :global(.song) {
        gap: 1ch;
        padding-left: 1ch;
        padding-right: 1ch;
        color: var(--foreground1);
    }

    :global(.author),
    :global(.album),
    :global(.title) {
        flex: 1 1 0;
        min-width: 0;
        text-overflow: ellipsis;
        white-space: nowrap;
        overflow: hidden;

        :global(span) {
            color: var(--pink);
        }
    }

    :global(.author),
    :global(.album) {
        color: var(--foreground2);
    }
</style>
