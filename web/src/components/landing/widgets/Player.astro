<column
    box-="square"
    class="widget"
    id="stats-widget"
    gap-="1"
    pad-="2 1"
    tabindex="0">
    <span is-="badge" class="ip-title"
        >&#xf202; [ <a
            href="https://www.last.fm/user/saforem2/"
            target="_blank">
            l</a
        >]ast.fm
    </span>
    <column box-="round" pad-="1 1" id="playing">
        <row gap-="1" style="align-items: center;">
            <span class="np-icon" aria-hidden="true"><span class="np-pause">&#xf04c;</span><span class="np-eq"><i></i><i></i><i></i><i></i></span></span>
            <row self-="grow shrink !basis" style="overflow: hidden; gap: 1ch;">
                <strong class="title" id="track-title">Loading...</strong>
                <span class="album" id="track-album">
                    <span>&#xf001;</span> —
                </span>
                <span class="author" id="track-artist">
                    <span>&#xf007;</span> —
                </span>
            </row>
            <row self-="!shrink">
                <span class="duration" id="track-duration">--:--</span>
            </row>
        </row>
        <row id="progress-bar">
            <span>[</span>
            <div id="progress" is-="separator"></div>
            <div id="progress-gutter" is-="separator"></div>
            <span>]</span>
        </row>
    </column>

    <column pad-="1 0" self-="grow" class="history-section">
        <!-- <column> -->
        <!--     <div is-="separator" style="--separator-color: var(--background2)"> -->
        <!--     </div> -->
        <!-- </column> -->
        <column id="up-next"></column>
    </column>
</column>

<script type="module">
    const lastfmData = {
        baseURL:
            'https://ws.audioscrobbler.com/2.0/?method=user.getrecenttracks&user=',
        user: 'saforem2',
        apiKey: '1dbc15037c1fe71ce06acbb3f73adc75',
        additional: '&format=json&limit=10',
    }

    const trackTitle = document.getElementById('track-title')
    const trackAlbum = document.getElementById('track-album')
    const trackArtist = document.getElementById('track-artist')
    const trackDuration = document.getElementById('track-duration')
    const upNext = document.getElementById('up-next')
    const playingEl = document.getElementById('playing')

    const clearUpNext = () => {
        if (!upNext) return
        while (upNext.firstChild) {
            upNext.removeChild(upNext.firstChild)
        }
    }

    const makeSeparator = () => {
        const column = document.createElement('column')
        column.setAttribute('pad-', '1 0')
        const divider = document.createElement('div')
        divider.setAttribute('is-', 'separator')
        divider.style.setProperty('--separator-color', 'var(--background1)')
        column.appendChild(divider)
        return column
    }

    const makeRow = ({ name, album, artist, url }) => {
        const link = url || null
        const row = link
            ? document.createElement('a')
            : document.createElement('row')
        row.className = 'song'
        if (link) {
            row.href = link
            row.target = '_blank'
            row.rel = 'noopener noreferrer'
        }

        const icon = document.createElement('span')
        icon.innerHTML = '&#xf04b;'
        row.appendChild(icon)

        const details = document.createElement('row')
        details.setAttribute('self-', 'grow')
        details.style.overflow = 'hidden'
        details.style.gap = '1ch'

        const title = document.createElement('strong')
        title.className = 'title'
        title.textContent = name ?? 'Unknown'

        const albumEl = document.createElement('span')
        albumEl.className = 'album'
        albumEl.innerHTML = `<span>&#xf001;</span> ${album ?? 'Unknown'}`

        const artistEl = document.createElement('span')
        artistEl.className = 'author'
        artistEl.innerHTML = `<span>&#xf007;</span> ${artist ?? 'Unknown'}`

        details.appendChild(title)
        details.appendChild(albumEl)
        details.appendChild(artistEl)
        row.appendChild(details)

        const durationRow = document.createElement('row')
        durationRow.setAttribute('self-', '!shrink')
        const duration = document.createElement('span')
        duration.className = 'duration'
        duration.textContent = ' '
        durationRow.appendChild(duration)
        row.appendChild(durationRow)

        return row
    }

    const setLive = (isLive) => {
        if (!playingEl) return
        playingEl.dataset.live = isLive ? 'true' : 'false'
    }

    const updateNowPlaying = (track) => {
        const isLive = Boolean(track?.['@attr']?.nowplaying === 'true')
        const nowUrl = track?.url || null
        if (trackTitle) {
            if (nowUrl) {
                trackTitle.innerHTML =
                    `<a href="${nowUrl}" target="_blank" rel="noopener noreferrer" class="np-link">${track?.name ?? 'Silence!'}</a>`
            } else {
                trackTitle.textContent = track?.name ?? 'Silence!'
            }
        }
        if (trackAlbum) {
            const album = track?.album?.['#text'] || 'Unknown'
            trackAlbum.innerHTML = `<span>&#xf001;</span> ${album}`
        }
        if (trackArtist) {
            const artist = track?.artist?.['#text'] || 'Sam Foreman'
            trackArtist.innerHTML = `<span>&#xf007;</span> ${artist}`
        }
        if (trackDuration) trackDuration.textContent = ' '
        setLive(isLive)
    }

    const setLastFM = async () => {
        try {
            const url =
                lastfmData.baseURL +
                lastfmData.user +
                '&api_key=' +
                lastfmData.apiKey +
                lastfmData.additional

            const resp = await fetch(url)
            if (!resp.ok) throw new Error('lastfm fetch failed')
            const data = await resp.json()
            const tracks = data?.recenttracks?.track ?? []
            const [current, ...rest] = tracks

            updateNowPlaying(current)

            clearUpNext()
            if (upNext && rest.length > 0) {
                rest.forEach((track, index) => {
                    upNext.appendChild(
                        makeRow({
                            name: track?.name,
                            album: track?.album?.['#text'],
                            artist: track?.artist?.['#text'],
                            url: track?.url,
                        }),
                    )
                    if (index < rest.length - 1) {
                        upNext.appendChild(makeSeparator())
                    }
                })
            }
        } catch {
            updateNowPlaying(null)
            clearUpNext()
        }
    }

    // Defer the first last.fm fetch off the initial critical path — it's a
    // third-party request (ws.audioscrobbler.com) that Lighthouse flags as the
    // max critical-path latency (~474ms). The widget already shows "Loading..."
    // in static HTML, so nothing above the fold waits on it. rIC's 2nd arg
    // must be an options object ({ timeout }), NOT a bare number (a bare number
    // throws and silently kills the callback); mirror Layout.astro's
    // scheduleIdle helper. The periodic refresh still starts once the first
    // fetch has been scheduled.
    const scheduleIdle = (fn) => {
        if (window.requestIdleCallback) {
            window.requestIdleCallback(fn, { timeout: 3000 })
        } else {
            window.setTimeout(fn, 1)
        }
    }
    scheduleIdle(() => {
        setLastFM()
        setInterval(setLastFM, 10 * 5000)
    })
</script>

<style>
    #progress-bar {
        color: var(--blue);
        margin-top: 0.15lh;
        #progress {
            --separator-color: var(--green);
            width: 15ch;
        }

        #progress-gutter {
            --separator-color: var(--background2);
            flex-grow: 1;
        }
    }

    /* Now-playing indicator: pause icon normally, tiny sparkline when live.
       Swapped via data-live on #playing — no layout shift (same box). */
    .np-icon {
        display: inline-flex;
        align-items: flex-end;
        justify-content: center;
        width: 2.4ch;
        height: 1lh;
        margin-right: 1ch;
        flex-shrink: 0;
        vertical-align: middle;
    }

    .np-pause {
        line-height: 1lh;
    }

    .np-eq {
        display: none;
        align-items: flex-end;
        gap: 0.22ch;
        height: 0.9lh;

        i {
            display: block;
            width: 0.38ch;
            border-radius: 999px;
            background: var(--red);
            height: 22%;
            transform-origin: bottom center;
        }
    }

    #playing[data-live='true'] .np-pause {
        display: none;
    }

    #playing[data-live='true'] .np-eq {
        display: inline-flex;
    }

    #playing[data-live='true'] .np-eq i {
        animation: eq-bounce 650ms ease-in-out infinite alternate;
    }

    #playing[data-live='true'] .np-eq i:nth-child(1) {
        animation-duration: 420ms;
        animation-delay: -80ms;
    }
    #playing[data-live='true'] .np-eq i:nth-child(2) {
        animation-duration: 560ms;
        animation-delay: -160ms;
    }
    #playing[data-live='true'] .np-eq i:nth-child(3) {
        animation-duration: 380ms;
        animation-delay: -40ms;
    }
    #playing[data-live='true'] .np-eq i:nth-child(4) {
        animation-duration: 610ms;
        animation-delay: -190ms;
    }

    @keyframes eq-bounce {
        0% { height: 18%; opacity: 0.85; }
        100% { height: 92%; opacity: 1; }
    }

    @media (prefers-reduced-motion: reduce) {
        #playing[data-live='true'] .np-eq i {
            animation: none !important;
            height: 55% !important;
        }
    }

    #stats-widget {
        grid-column: 2 / 4;
        grid-row: 1 / 3;
        min-height: 0;
    }

    .history-section {
        overflow: hidden;
        min-height: 0;
        line-height: 1;
    }

    #up-next {
        overflow-y: auto;
        min-height: 0;
        scrollbar-width: thin;
        scrollbar-color: var(--foreground2) transparent;
    }

    #playing {
        --box-border-color: var(--background2);
        color: var(--accent);
        line-height: 1.3;
    }

    .lastfm-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5ch;
        padding: 0 1ch;
        background-color: oklch(from var(--red) l c h / 0.15);
        color: var(--red);
        text-decoration: none;
        font-weight: 600;

        &:hover {
            background-color: oklch(from var(--red) l c h / 0.25);
            text-decoration: none;
        }
    }

    .ip-title {
        background-image: none;
        --badge-text: none;
        --badge-color: none;
        --color: var(--red);
        color: var(--color);
        background-color: oklch(
            from var(--color) calc(l * var(--oklch-scale, 0.85)) c h / 0.1
        );
        a {
            color: var(--color);
            font-weight: bold;
        }
    }

    :global(.song) {
        gap: 1ch;
        padding-left: 1ch;
        padding-right: 1ch;
        color: var(--foreground1);
        text-decoration: none;
    }

    :global(a.song:hover) {
        color: var(--accent);
    }

    :global(.np-link) {
        color: inherit;
        text-decoration: none;
    }

    :global(.np-link:hover) {
        color: var(--accent);
        text-decoration: underline;
        text-underline-offset: 2px;
    }

    :global(.author),
    :global(.album),
    :global(.title) {
        flex: 1 1 0;
        min-width: 0;
        text-overflow: ellipsis;
        white-space: nowrap;
        overflow: hidden;

        :global(span) {
            color: var(--pink);
        }
    }

    :global(.author),
    :global(.album) {
        color: var(--foreground2);
    }
</style>
