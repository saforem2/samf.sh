<column
    box-="square"
    class="widget"
    id="stats-widget"
    gap-="1"
    pad-="2 1"
    tabindex="0">
    <span is-="badge" class="ip-title"
        >&#xf202; [ <a
            href="https://www.last.fm/user/saforem2/"
            target="_blank">
            l</a
        >]ast.fm
    </span>
    <column box-="round" pad-="1" id="playing">
        <row gap-="1" style="align-items: center;">
            <span class="np-icon" aria-hidden="true"
                ><span class="np-pause">&#xf04c;</span><span class="np-eq"
                    ><i></i><i></i><i></i><i></i></span
                ></span
            >
            <row self-="grow shrink !basis" style="overflow: hidden; gap: 1ch;">
                <strong class="title" id="track-title">Loading...</strong>
                <span class="author" id="track-artist">
                    <span>&#xf007;</span> —
                </span>
                <span class="album" id="track-album">
                    <span>&#xf001;</span> —
                </span>
            </row>
            <row self-="!shrink">
                <span class="duration" id="track-duration">--:--</span>
            </row>
        </row>
        <row id="progress-bar">
            <span>[</span>
            <div id="progress" is-="separator"></div>
            <div id="progress-gutter" is-="separator"></div>
            <span>]</span>
        </row>
    </column>

    <column pad-="1 0" self-="grow" class="history-section">
        <column id="up-next"></column>
    </column>
</column>

<script type="module">
    const lastfmData = {
        baseURL:
            'https://ws.audioscrobbler.com/2.0/?method=user.getrecenttracks&user=',
        user: 'saforem2',
        apiKey: '1dbc15037c1fe71ce06acbb3f73adc75',
        additional: '&format=json&limit=10',
    }

    const trackTitle = document.getElementById('track-title')
    const trackAlbum = document.getElementById('track-album')
    const trackArtist = document.getElementById('track-artist')
    const trackDuration = document.getElementById('track-duration')
    const upNext = document.getElementById('up-next')
    const playingEl = document.getElementById('playing')
    const progressEl = document.getElementById('progress')

    const clearUpNext = () => {
        if (!upNext) return
        while (upNext.firstChild) {
            upNext.removeChild(upNext.firstChild)
        }
    }

    const makeSeparator = () => {
        const column = document.createElement('column')
        column.setAttribute('pad-', '1 0')
        const divider = document.createElement('div')
        divider.setAttribute('is-', 'separator')
        divider.style.setProperty('--separator-color', 'var(--background1)')
        column.appendChild(divider)
        return column
    }

    const makeRow = ({ name, album, artist, url }) => {
        const link = url || null
        const row = link
            ? document.createElement('a')
            : document.createElement('row')
        row.className = 'song'
        if (link) {
            row.href = link
            row.target = '_blank'
            row.rel = 'noopener noreferrer'
        }

        const icon = document.createElement('span')
        icon.innerHTML = '&#xf1bc;'
        row.appendChild(icon)

        const details = document.createElement('row')
        details.setAttribute('self-', 'grow shrink !basis')
        details.style.overflow = 'hidden'
        details.style.gap = '1ch'
        details.style.minWidth = '0'

        const title = document.createElement('strong')
        title.className = 'title'
        title.textContent = name ?? 'Unknown'

        const albumEl = document.createElement('span')
        albumEl.className = 'album'
        albumEl.innerHTML = `<span>&#xf001;</span> ${album ?? 'Unknown'}`

        const artistEl = document.createElement('span')
        artistEl.className = 'author'
        artistEl.innerHTML = `<span>&#xf007;</span> ${artist ?? 'Unknown'}`

        details.appendChild(title)
        details.appendChild(artistEl)
        details.appendChild(albumEl)
        row.appendChild(details)

        const durationRow = document.createElement('row')
        durationRow.setAttribute('self-', '!shrink')
        const duration = document.createElement('span')
        duration.className = 'duration'
        duration.textContent = ' '
        durationRow.appendChild(duration)
        row.appendChild(durationRow)

        return row
    }

    let progressTimer = null
    let startedAt = 0
    let trackMs = 0

    const fmt = (ms) => {
        const s = Math.max(0, Math.floor(ms / 1000))
        return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`
    }

    const setProgress = (pct) => {
        if (!progressEl) return
        const w = Math.max(0, Math.min(100, pct))
        // Keep a minimum visible slug when live so 0:01 isn't a single pixel
        const isLiveNow = playingEl?.dataset.live === 'true'
        const ch = (w / 100) * 15
        const visible = isLiveNow && w > 0 && w < 8 ? Math.max(ch, 1.1) : ch
        progressEl.style.width = `${visible}ch`
    }

    const startProgress = (durationMs) => {
        stopProgress()
        if (!durationMs || durationMs <= 0) return
        trackMs = durationMs
        startedAt = Date.now()
        setProgress(0)
        if (playingEl) {
            playingEl.style.setProperty('--progress-head', '0ch')
        }
        progressTimer = setInterval(() => {
            const elapsed = Date.now() - startedAt
            const pct = (elapsed / trackMs) * 100
            if (pct >= 100) {
                setProgress(100)
                if (playingEl)
                    playingEl.style.setProperty('--progress-head', '15ch')
                stopProgress()
                return
            }
            setProgress(pct)
            if (playingEl) {
                playingEl.style.setProperty(
                    '--progress-head',
                    `${(pct / 100) * 15}ch`,
                )
            }
            if (trackDuration) {
                trackDuration.textContent = `${fmt(elapsed)} / ${fmt(trackMs)}`
            }
        }, 500)
    }

    const stopProgress = () => {
        if (progressTimer) clearInterval(progressTimer)
        progressTimer = null
    }

    const fetchDuration = async (artist, track) => {
        if (!artist || !track) return 0
        try {
            const u = `https://ws.audioscrobbler.com/2.0/?method=track.getInfo&artist=${encodeURIComponent(artist)}&track=${encodeURIComponent(track)}&user=${lastfmData.user}&api_key=${lastfmData.apiKey}&format=json`
            const r = await fetch(u)
            if (!r.ok) return 0
            const j = await r.json()
            return Number(j?.track?.duration) || 0
        } catch {
            return 0
        }
    }

    const setLive = (isLive) => {
        if (!playingEl) return
        playingEl.dataset.live = isLive ? 'true' : 'false'
    }

    const updateNowPlaying = async (track) => {
        const isLive = Boolean(track?.['@attr']?.nowplaying === 'true')
        const nowUrl = track?.url || null
        if (trackTitle) {
            if (nowUrl) {
                trackTitle.innerHTML = `<a href="${nowUrl}" target="_blank" rel="noopener noreferrer" class="np-link">${track?.name ?? 'Silence!'}</a>`
            } else {
                trackTitle.textContent = track?.name ?? 'Silence!'
            }
        }
        if (trackAlbum) {
            const album = track?.album?.['#text'] || 'Unknown'
            trackAlbum.innerHTML = `<span>&#xf001;</span> ${album}`
        }
        if (trackArtist) {
            const artist = track?.artist?.['#text'] || 'Sam Foreman'
            trackArtist.innerHTML = `<span>&#xf007;</span> ${artist}`
        }
        setLive(isLive)
        if (isLive) {
            const artist = track?.artist?.['#text'] || ''
            const name = track?.name || ''
            const d = await fetchDuration(artist, name)
            if (d > 0) {
                if (trackDuration) {
                    trackDuration.textContent = `0:00 / ${fmt(d)}`
                }
                startProgress(d)
            } else {
                if (trackDuration) trackDuration.textContent = 'LIVE'
                stopProgress()
                setProgress(15)
                if (playingEl)
                    playingEl.style.setProperty('--progress-head', '15ch')
            }
        } else {
            if (trackDuration) trackDuration.textContent = ''
            stopProgress()
            setProgress(0)
            if (playingEl) playingEl.style.removeProperty('--progress-head')
        }
    }

    const setLastFM = async () => {
        try {
            const url =
                lastfmData.baseURL +
                lastfmData.user +
                '&api_key=' +
                lastfmData.apiKey +
                lastfmData.additional

            const resp = await fetch(url)
            if (!resp.ok) throw new Error('lastfm fetch failed')
            const data = await resp.json()
            const tracks = data?.recenttracks?.track ?? []
            const [current, ...rest] = tracks

            // Render history before awaiting now-playing (which may fetch track duration)
            clearUpNext()
            if (upNext && rest.length > 0) {
                rest.forEach((track, index) => {
                    upNext.appendChild(
                        makeRow({
                            name: track?.name,
                            album: track?.album?.['#text'],
                            artist: track?.artist?.['#text'],
                            url: track?.url,
                        }),
                    )
                    if (index < rest.length - 1) {
                        upNext.appendChild(makeSeparator())
                    }
                })
            }

            await updateNowPlaying(current)
        } catch {
            clearUpNext()
            try {
                await updateNowPlaying(null)
            } catch {
                /* ignore */
            }
        }
    }

    const scheduleIdle = (fn) => {
        if (window.requestIdleCallback) {
            window.requestIdleCallback(fn, { timeout: 3000 })
        } else {
            window.setTimeout(fn, 1)
        }
    }
    scheduleIdle(() => {
        setLastFM()
        setInterval(setLastFM, 10 * 5000)
    })
</script>

<style>
    #progress-bar {
        color: var(--blue);
        margin-top: 0.25lh;
        --progress-h: 2px;
        /* Inset content off the rounded border — brackets + track don't kiss the edge (Image #14) */
        padding-inline: 0.5ch;
        #progress {
            --separator-color: var(--green);
            --separator-width: var(--progress-h);
            width: 15ch;
        }

        #progress-gutter {
            --separator-color: var(--background2);
            --separator-width: var(--progress-h);
            flex-grow: 1;
        }
    }

    /* Live: ticker is the accent — thick green bar + pulsing dot on the head.
       Paused: guttered empty trough (existing colors, 0 width) reads as idle. */
    #playing[data-live='true'] #progress-bar #progress {
        --separator-color: var(--green);
        --separator-width: 3px;
        filter: drop-shadow(0 0 2px var(--green));
        /* Anchor the live dot so ::after can ride the fill edge */
        position: relative;
        overflow: visible;
    }

    #playing[data-live='true'] #progress::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 100%;
        /* Straddle the fill edge; clamp so the dot never sits outside the 15ch + gutter track */
        translate: -50% -50%;
        width: 1.05ch;
        height: 1.05ch;
        border-radius: 999px;
        background: var(--green);
        box-shadow: 0 0 3px var(--green);
        animation: live-dot-pulse 900ms ease-in-out infinite alternate;
        pointer-events: none;
    }

    @keyframes live-dot-pulse {
        0% {
            opacity: 0.85;
            scale: 0.92;
        }
        100% {
            opacity: 1;
            scale: 1.02;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        #playing[data-live='true'] #progress-bar::after {
            animation: none;
        }
    }

    .np-icon {
        display: inline-flex;
        align-items: flex-end;
        justify-content: center;
        width: 2.4ch;
        height: 1lh;
        margin-right: 1ch;
        flex-shrink: 0;
        vertical-align: middle;
    }

    .np-pause {
        line-height: 1lh;
        color: var(--foreground2);
    }

    .np-eq {
        display: none;
        align-items: flex-end;
        gap: 0.26ch;
        height: 1lh;

        i {
            display: block;
            width: 0.5ch;
            border-radius: 0;
            background: var(--accent);
            height: 18%;
            transform-origin: bottom center;
        }
    }

    #playing[data-live='true'] .np-pause {
        display: none;
    }

    #playing[data-live='true'] .np-eq {
        display: inline-flex;
    }

    #playing[data-live='true'] .np-eq i {
        animation: eq-bounce 650ms ease-in-out infinite alternate;
    }

    #playing[data-live='true'] .np-eq i:nth-child(1) {
        animation-duration: 420ms;
        animation-delay: -80ms;
    }

    #playing[data-live='true'] .np-eq i:nth-child(2) {
        animation-duration: 560ms;
        animation-delay: -160ms;
    }

    #playing[data-live='true'] .np-eq i:nth-child(3) {
        animation-duration: 380ms;
        animation-delay: -40ms;
    }

    #playing[data-live='true'] .np-eq i:nth-child(4) {
        animation-duration: 610ms;
        animation-delay: -190ms;
    }

    @keyframes eq-bounce {
        0% {
            height: 18%;
            opacity: 0.85;
        }
        100% {
            height: 92%;
            opacity: 1;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        #playing[data-live='true'] .np-eq i {
            animation: none !important;
            height: 55% !important;
        }
    }

    #stats-widget {
        grid-column: 2 / 4;
        grid-row: 1 / 3;
        min-height: 0;
    }

    .history-section {
        overflow: hidden;
        min-height: 0;
        line-height: 1;
    }

    #up-next {
        overflow-y: auto;
        min-height: 0;
        scrollbar-width: thin;
        scrollbar-color: var(--foreground2) transparent;
    }

    #playing {
        --box-border-color: var(--background2);
        color: var(--accent);
        line-height: 1.2;
        gap: 0;
        /* Keep the "now playing" row + progress off the rounded border */
        padding-inline: 0.6ch;
    }

    .lastfm-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5ch;
        padding: 0 1ch;
        background-color: oklch(from var(--red) l c h / 0.15);
        color: var(--red);
        text-decoration: none;
        font-weight: 600;

        &:hover {
            background-color: oklch(from var(--red) l c h / 0.25);
            text-decoration: none;
        }
    }

    .ip-title {
        background-image: none;
        --badge-text: none;
        --badge-color: none;
        --color: var(--red);
        color: var(--color);
        background-color: oklch(
            from var(--color) calc(l * var(--oklch-scale, 0.85)) c h / 0.1
        );
        a {
            color: var(--color);
            font-weight: bold;
        }
    }

    :global(.song) {
        display: flex;
        gap: 1ch;
        padding-left: 1ch;
        padding-right: 1ch;
        color: var(--foreground1);
        text-decoration: none;
        align-items: center;
        min-width: 0;
    }

    :global(a.song:hover) {
        color: var(--accent);
    }

    :global(.np-link) {
        color: inherit;
        text-decoration: none;
    }

    :global(.np-link:hover) {
        color: var(--accent);
        text-decoration: underline;
        text-underline-offset: 2px;
    }

    :global(.title) {
        flex: 0 1 auto;
        min-width: 0;
        text-overflow: ellipsis;
        white-space: nowrap;
        overflow: hidden;

        :global(span) {
            color: var(--pink);
        }
    }

    :global(.author) {
        flex: 0 0 auto;
        min-width: 0;
        max-width: 14ch;
        text-overflow: ellipsis;
        white-space: nowrap;
        overflow: hidden;
        color: var(--foreground2);

        :global(span) {
            color: var(--pink);
        }
    }

    :global(.album) {
        flex: 1 1 0;
        min-width: 0;
        text-overflow: ellipsis;
        white-space: nowrap;
        overflow: hidden;
        color: var(--foreground2);

        :global(span) {
            color: var(--pink);
        }
    }
</style>
