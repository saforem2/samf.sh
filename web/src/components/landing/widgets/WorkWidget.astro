            target="_blank"
            class="widget-link"><u>w</u>ork</a
        ></span
    >
    <column gap-="0" class="ww-list">
        {
            works.map((w) => (
                <a href={w.href} target="_blank" class="ww-item">
                    <span class="ww-year">{w.year}</span>
                    <span class="ww-name">
                        {w.title}
                        {w.badge && <span class="ww-badge">{w.badge}</span>}
                    </span>
                </a>
            ))
        }
    </column>
</column>

<style>
    .work-widget {
        gap: 1lh;
        overflow: hidden;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }

    .ww-title {
        background-image: none;
        --badge-text: none;
        --badge-color: none;
        /* line-height: 1.5; */

        --color: var(--green);
        color: var(--color);
        background-color: oklch(
            from var(--color) calc(l * var(--oklch-scale, 0.85)) c h / 0.1
        );
        a {
            color: var(--color);
            font-weight: bold;
        }
    }

    .ww-list {
        gap: 0;
        /* Rows sat flush (19px pitch) against the last.fm list's 32px, which
           reads noticeably airier. The box height is fixed and already
           scrolls, so gap trades visible rows for breathing room: matching
           32px outright would drop 11.5 visible rows to 6.8. 0.25lh lands at
           23.8px and keeps 9.2. */
        row-gap: 0.25lh;
        flex: 1;
        overflow-y: auto;
        min-height: 0;
        scrollbar-width: thin;
        scrollbar-color: var(--foreground2) transparent;
        margin-block-start: -0.5lh;
    }

    .ww-item {
        display: flex;
        gap: 1ch;
        align-items: baseline;
        text-decoration: none;
        color: var(--foreground1);
        white-space: nowrap;
        flex-shrink: 0;

        &:hover {
            color: var(--blue);
        }
    }

    /* On touch pointers the flush one-line rows (~19-22px) fall under the
       WCAG 24px tap-target minimum. Grow them only for coarse pointers so
       desktop keeps its dense TUI listing; center the content in the taller
       box. lh keeps the target scaling with the font. */
    @media (pointer: coarse) {
        .ww-item {
            min-height: 1.3lh;
            align-items: center;
        }
    }

    .ww-year {
        color: var(--foreground2);
        flex-shrink: 0;
        width: 4ch;
    }

    .ww-name {
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .ww-badge {
        color: var(--yellow);
        margin-left: 1ch;
        font-size: 0.85em;
    }
</style>
