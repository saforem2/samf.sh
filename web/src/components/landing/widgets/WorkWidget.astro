---

<column
    box-="square"
    pad-="2 1"
    gap-="0"
    class="work-widget"
    tabindex="0"
    data-random-accent={String(randomAccent)}
    data-accent-pool={accentPool?.join(',') ?? undefined}>
    <span is-="badge" variant-="green" class="ww-title"
        >&#xf0b1; <a
            href="https://scholar.google.com/citations?user=vV_1zDwAAAAJ"
            target="_blank"
            class="widget-link"><u>w</u>ork</a
        ></span
    >
    <column gap-="0" class="ww-list">
        {
            works.map((w) => (
                <a href={w.href} target="_blank" class="ww-item">
                    <span class="ww-year">{w.year}</span>
                    <span class="ww-name">
                        {w.title}
                        {w.badge && <span class="ww-badge">{w.badge}</span>}
                    </span>
                </a>
            ))
        }
    </column>
</column>

<style>
    .work-widget {
        --widget-accent: var(--purple, var(--mauve, #9a76ce));
        gap: 1lh;
        overflow: hidden;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }

    .ww-title {
        background-image: none;
        --badge-text: none;
        --badge-color: none;
        --color: var(--widget-accent);
        color: var(--color);
        background-color: oklch(
            from var(--color) calc(l * var(--oklch-scale, 0.85)) c h / 0.1
        );
        a {
            color: var(--color);
            font-weight: bold;
        }
    }

    .ww-list {
        gap: 0;
        /* Rows sat flush (19px pitch) against the last.fm list's 32px, which
           reads noticeably airier. The box height is fixed and already
           scrolls, so gap trades visible rows for breathing room: matching
           32px outright would drop 11.5 visible rows to 6.8. 0.25lh lands at
           23.8px and keeps 9.2. */
        row-gap: 0.25lh;
        flex: 1;
        overflow-x: hidden;
        overflow-y: auto;
        min-height: 0;
        scrollbar-width: thin;
        scrollbar-color: var(--foreground2) transparent;
        scrollbar-gutter: stable;
        margin-block-start: -0.5lh;
    }

    /* Re-cap on small screens: parent widget switches from bounded grid row
       (20lh) to flex column with no height — without a cap the 22-item list
       runs tall enough to push siblings offscreen. */
    @media (max-width: 1024px) {
        :global(
            #widgets-grid.home-grid:not(.intro-v15):not(.intro-v16):not(
                    .intro-v17
                ):not(.intro-v18):not(.intro-v19):not(.intro-v20):not(
                    .intro-v21
                )
                .work-widget
        ),
        :global(#widgets-grid.intro-in-grid .work-widget) {
            max-height: min(55vh, 42lh) !important;
            max-height: min(55dvh, 42lh) !important;
            overflow: hidden !important;
            display: flex !important;
            flex-direction: column !important;
        }
        :global(
            #widgets-grid.home-grid:not(.intro-v15):not(.intro-v16):not(
                    .intro-v17
                ):not(.intro-v18):not(.intro-v19):not(.intro-v20):not(
                    .intro-v21
                )
                .work-widget
                .ww-list
        ),
        :global(#widgets-grid.intro-in-grid .work-widget .ww-list) {
            overflow-y: auto !important;
            flex: 1 1 auto !important;
            min-height: 0 !important;
        }
    }

    .ww-item {
        display: flex;
        gap: 1ch;
        align-items: baseline;
        text-decoration: none;
        color: var(--foreground1);
        white-space: nowrap;
        min-width: 0;
        flex-shrink: 0;
        padding: 0 0.5ch;
        margin-inline: -0.5ch;
        border-radius: 2px;

        &:hover {
            color: var(--background0);
            background: var(--widget-accent) !important;
            .ww-year {
                color: color-mix(
                    in srgb,
                    var(--background0) 65%,
                    var(--widget-accent)
                );
            }
            .ww-badge {
                color: var(--background0);
                opacity: 0.9;
            }
        }

        &:nth-child(even) {
            background: color-mix(in srgb, var(--foreground0) 4%, transparent);
        }
    }

    /* On touch pointers the flush one-line rows (~19-22px) fall under the
       WCAG 24px tap-target minimum. Grow them only for coarse pointers so
       desktop keeps its dense TUI listing; center the content in the taller
       box. lh keeps the target scaling with the font. */
    @media (pointer: coarse) {
        .ww-item {
            min-height: 1.3lh;
            align-items: center;
        }
    }

    .ww-year {
        color: var(--foreground2);
        flex-shrink: 0;
        width: 4ch;
    }

    .ww-name {
        min-width: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .ww-badge {
        color: var(--yellow);
        margin-left: 1ch;
        font-size: 0.85em;
    }
</style>

<script>
    import { initWidgetAccentShuffle } from './shuffle-accents'
    initWidgetAccentShuffle()
</script>
