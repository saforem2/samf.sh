---
import { docPages } from '@/utils/content'
import type { MarkdownHeading } from 'astro'

// MarkdownHeading.text preserves inline markup from the source — a
// heading like `### \`<style>\` tag` lands here with the literal
// `<style>` substring intact. That string then flowed into
// data-value="…" below as `<style> tag`; the browser parser saw
// the literal `<style>` and opened a real <style> element inside
// the attribute, eating everything through the next </style> as
// CSS. The visible result on pages that render Filter (e.g.
// /posts/) is "no styles applied" for the entire downstream tree.
//
// Earlier this used `.replace(/<\/?[a-zA-Z][^>]*>/g, '')` to strip
// the tag entirely, but that nuked legitimate doc headings that
// reference HTML element names in code spans (e.g. the webtui
// typography page has `### \`<h1>\`-\`<h6>\``, `### \`<blockquote>\``,
// `### \`<p>\``, etc.) — each one would collapse to either an empty
// string or just `-` in the command-palette label, making them
// indistinguishable and unfindable. Swap the brackets for the
// Unicode single-angle quotes U+2039 / U+203A instead — visually
// near-identical, never parses as HTML, and the heading stays
// searchable as "‹h1›-‹h6›" / "‹blockquote›" / "‹p›".
const safenAngleBrackets = (s: string) =>
    s.replace(/</g, '‹').replace(/>/g, '›')

const docHeadings = docPages
    .map((page) => ({
        headings:
            (page.rendered?.metadata?.headings as
                | Array<MarkdownHeading>
                | undefined) ?? [],
        title: page.data.title,
        id: page.id,
    }))
    .reduce(
        (prev, curr) => {
            const headings: Array<[string, string | MarkdownHeading]> = [
                [curr.id, curr.title],
            ]

            for (const heading of curr.headings) {
                headings.push([curr.id, heading])
            }

            return prev.concat(headings)
        },
        [] as Array<[string, string | MarkdownHeading]>,
    )

const themeOptions = {
    auto: 'Auto (system)',
    'custom-light': 'Light',
    'custom-dark': 'Dark',
    catppuccin: 'Catppuccin Mocha',
    'catppuccin-latte': 'Catppuccin Latte',
}

// Body font: all 5 (incl. the quasi-proportional QP).
const bodyFontOptions = {
    iosevka: 'Iosevka',
    'victor-mono': 'Victor Mono',
    'miosevka-term': 'mIosevka-Term',
    'miosevka-qp': 'mIosevka-QP',
    system: 'System',
}
// Code font: true-monospace only — no QP (it breaks ASCII / column alignment).
const codeFontOptions = {
    iosevka: 'Iosevka',
    'victor-mono': 'Victor Mono',
    'miosevka-term': 'mIosevka-Term',
    system: 'System',
}
---

<dialog id="command-dialog" size-="small" position-="center" container-="fill">
    <div box-="square" shear-="top" id="command-content">
        <row align-="between">
            <span is-="badge" variant-="green">&#xf120; Command</span>
            <button id="command-close-btn" variant-="foreground0" size-="small"
                >x</button
            >
        </row>
        <p class="command-tagline">
            Sam Foreman's personal site. Vim-style keybinds for navigation;
            theme + font pickers below.
        </p>
        <div id="command-sections">
            <section class="command-section command-section-theme">
                <span is-="badge" class="command-section-title cmd-title-green"
                    >&#xf1fc; <u>T</u>heme</span
                >
                <row class="command-theme-buttons" gap-="0">
                    {
                        Object.entries(themeOptions).map(([key, value]) => (
                            <button
                                data-theme-dropdown="true"
                                data-theme-option={key}
                                aria-selected="false"
                                class="command-theme-chip">
                                {value}
                            </button>
                        ))
                    }
                </row>
            </section>
            <section class="command-section command-section-font">
                <span is-="badge" class="command-section-title cmd-title-blue"
                    >&#xf031; Font</span
                >
                <span is-="badge" class="keybind-group-title font-row-label"
                    >Body</span
                >
                <row class="command-theme-buttons" gap-="0">
                    {
                        Object.entries(bodyFontOptions).map(([key, value]) => (
                            <button
                                data-body-font-option={key}
                                aria-selected="false"
                                class="command-theme-chip command-font-chip">
                                {value}
                            </button>
                        ))
                    }
                </row>
                <span is-="badge" class="keybind-group-title font-row-label"
                    >Code</span
                >
                <row class="command-theme-buttons" gap-="0">
                    {
                        Object.entries(codeFontOptions).map(([key, value]) => (
                            <button
                                data-code-font-option={key}
                                aria-selected="false"
                                class="command-theme-chip command-font-chip">
                                {value}
                            </button>
                        ))
                    }
                </row>
            </section>
            <section class="command-section command-section-reader">
                <span is-="badge" class="command-section-title cmd-title-green"
                    >&#xf02d; <u>R</u>eader</span
                >
                <row class="command-theme-buttons" gap-="0">
                    <button
                        data-reader-toggle="true"
                        class="command-theme-chip">
                        Toggle reader view
                    </button>
                </row>
            </section>
            <section class="command-section command-section-keys">
                <span is-="badge" class="command-section-title cmd-title-orange"
                    >&#xf11c; <u>K</u>eybinds</span
                >
                <div class="keybind-columns">
                    <div class="keybind-group">
                        <span is-="badge" class="keybind-group-title"
                            >Navigation</span
                        >
                        <div class="keybind-grid" role="list">
                            <code role="listitem">j / ↓</code>
                            <span>Next item</span>
                            <code role="listitem">k / ↑</code>
                            <span>Previous item</span>
                            <code role="listitem">g</code>
                            <span>First item in region</span>
                            <code role="listitem">G</code>
                            <span>Last item in region</span>
                            <code role="listitem">zz</code>
                            <span>Center focused item</span>
                            <code role="listitem">h / l</code>
                            <span>Sidebar / main content</span>
                            <code role="listitem">] / [</code>
                            <span>Next/previous heading</span>
                            <code role="listitem">{'}'} / {'{'}</code>
                            <span>Next/previous block</span>
                            <code role="listitem">d / u</code>
                            <span>Half-page down/up</span>
                        </div>
                    </div>

                    <div class="keybind-group">
                        <span is-="badge" class="keybind-group-title"
                            >Layout</span
                        >
                        <div class="keybind-grid" role="list">
                            <code role="listitem">&lt;zh&gt;</code>
                            <span>Toggle sidebar</span>
                            <code role="listitem">&lt;zr&gt;</code>
                            <span>Toggle reader view</span>
                            <code role="listitem">&lt;zj&gt; / &lt;zk&gt;</code>
                            <span>Focus main / actions</span>
                            <code role="listitem"
                                >&#x21E7;C / &#x21E7;E &nbsp;·&nbsp; &lt;zM&gt;
                                / &lt;zR&gt;</code
                            >
                            <span>Collapse / expand all sections</span>
                        </div>
                    </div>

                    <div class="keybind-group">
                        <span is-="badge" class="keybind-group-title"
                            >Dialogs</span
                        >
                        <div class="keybind-grid" role="list">
                            <code role="listitem">&#x2303;P / :</code>
                            <span>Command palette</span>
                            <code role="listitem">&#x2303;X</code>
                            <span>Theme picker</span>
                            <code role="listitem">/</code>
                            <span>Search</span>
                            <code role="listitem">?</code>
                            <span>Show keybinds</span>
                            <code role="listitem">&#x2303;N / &#x2303;P</code>
                            <span>Next/prev search result</span>
                            <code role="listitem">Esc</code>
                            <span>Close dialog / exit reader</span>
                        </div>
                    </div>

                    <div class="keybind-group">
                        <span is-="badge" class="keybind-group-title"
                            >History</span
                        >
                        <div class="keybind-grid" role="list">
                            <code role="listitem">n</code>
                            <span>Next document</span>
                            <code role="listitem">b</code>
                            <span>Previous document</span>
                            <code role="listitem">&#x2303;O</code>
                            <span>History back</span>
                            <code role="listitem">&#x2303;I</code>
                            <span>History forward</span>
                        </div>
                    </div>

                    <div class="keybind-group">
                        <span is-="badge" class="keybind-group-title"
                            >Sections</span
                        >
                        <div class="keybind-grid" role="list">
                            <code role="listitem">a</code>
                            <span>about</span>
                            <code role="listitem">p</code>
                            <span>posts</span>
                            <code role="listitem">t</code>
                            <span>talks</span>
                            <code role="listitem">m</code>
                            <span>more</span>
                            <code role="listitem">s</code>
                            <span>style</span>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</dialog>

<dialog id="search-dialog" size-="small" position-="center" container-="fill">
    <div box-="square" shear-="top" id="search-content">
        <row align-="between">
            <span is-="badge" variant-="background0">&#xea6d; Search</span>
            <button id="close-btn" variant-="foreground0" size-="small"
                >x</button
            >
        </row>
        <column box-="square">
            <input id="search-input" placeholder="Filter" autofocus />
        </column>

        <div id="search-results">
            <div id="search-results-container">
                {
                    docHeadings.map(([id, header], i) => {
                        const headerTextRaw =
                            typeof header === 'string' ? header : header.text
                        // Substitute angle brackets before the
                        // string lands in the page — without it a
                        // heading like `### \`<style>\` tag` opens a
                        // rogue <style> element inside data-value=…
                        // and eats half the doc tree (browser
                        // attribute parser still treats < as a real
                        // tag start in some contexts).
                        const headerText = safenAngleBrackets(headerTextRaw)

                        return (
                            <a
                                class:list={[
                                    'search-result',
                                    i === 0 ? 'active' : '',
                                ]}
                                tabindex="0"
                                href={`/${id}${typeof header === 'string' ? '' : `#${header.slug}`}`}
                                data-value={`${id}: ${headerText}`}>
                                {id}:{' '}
                                {typeof header === 'string'
                                    ? ''
                                    : '#'.repeat(header.depth)}
                                {headerText}
                            </a>
                        )
                    })
                }
            </div>
        </div>
    </div>
</dialog>

<dialog id="theme-dialog" size-="small" position-="center" container-="fill">
    <div box-="square" shear-="top" id="theme-content">
        <row align-="between">
            <span is-="badge" variant-="background0">&#xf1fc; Theme</span>
            <button id="theme-close-btn" variant-="foreground0" size-="small"
                >x</button
            >
        </row>
        <row id="theme-meta" align-="between" gap-="1">
            <span is-="badge" variant-="background1"
                >Current: <span id="theme-current-value">Light</span></span
            >
            <span is-="badge" variant-="background1">j/k or ↑/↓ + Enter</span>
        </row>
        <div id="theme-options">
            {
                Object.entries(themeOptions).map(([key, value]) => (
                    <button
                        class="theme-option"
                        data-theme-option={key}
                        aria-selected="false"
                        variant-="background1">
                        {value}
                    </button>
                ))
            }
        </div>
    </div>
</dialog>

<style>
    #command-dialog,
    #search-dialog,
    #theme-dialog {
        position: fixed;

        &::backdrop {
            backdrop-filter: blur(8px) grayscale(60%);
            background-color: color-mix(
                in oklch,
                var(--background0) 70%,
                transparent
            );
        }
    }

    #command-dialog {
        --dialog-offset-x: 1ch;
        --dialog-offset-y: 1lh;
        --dialog-max-width: calc(100vw - 2ch);
        --dialog-max-height: min(80vh, 50lh);
    }

    @media (min-width: 576px) {
        #command-dialog {
            --dialog-offset-x: 2ch;
            --dialog-offset-y: 2lh;
            --dialog-max-width: min(92vw, 80ch);
        }
    }

    @media (min-width: 768px) {
        #command-dialog {
            --dialog-max-width: min(90vw, 96ch);
        }
    }

    @media (min-width: 1024px) {
        #command-dialog {
            --dialog-max-width: min(88vw, 112ch);
        }
    }

    @media (min-width: 1280px) {
        #command-dialog {
            --dialog-max-width: min(86vw, 128ch);
        }
    }

    #search-dialog {
        width: min(92vw, 112ch);
        height: min(88vh, 58lh);
    }

    #theme-dialog {
        width: min(86vw, 80ch);
        height: min(82vh, 46lh);
    }

    #command-content,
    #search-content,
    #theme-content {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
    }

    .command-tagline {
        margin: 0;
        padding: 0 1ch;
        color: var(--foreground2);
        font-size: 0.9em;
    }

    #command-sections {
        display: flex;
        flex-direction: column;
        gap: 1lh;
        overflow-y: auto;
        padding: 0 1ch 1ch;
    }

    .command-section {
        display: flex;
        flex-direction: column;
        flex: 0 0 auto;
        gap: 0.5lh;
        margin-block: 0.5lh;
    }

    /* Accent-tinted section titles matching the home-widget aesthetic. */
    .command-section-title {
        background-image: none;
        --badge-text: none;
        --badge-color: none;
        --color: var(--accent, var(--blue));
        color: var(--color);
        background-color: oklch(
            from var(--color) calc(l * var(--oklch-scale, 0.85)) c h / 0.1
        );
        font-weight: bold;
        u {
            text-decoration: underline;
        }
    }
    .cmd-title-green {
        --color: var(--green);
    }
    .cmd-title-orange {
        --color: var(--orange);
    }
    .cmd-title-blue {
        --color: var(--blue);
    }

    .keybind-grid {
        display: grid;
        grid-template-columns: minmax(5ch, max-content) minmax(0, 1fr);
        column-gap: 1ch;
        row-gap: 0.25lh;
        align-items: baseline;
    }

    /* Styled-key look. */
    .keybind-grid > code {
        display: inline-block;
        color: var(--foreground0);
        background-color: var(--background2);
        border: 1px solid var(--foreground2);
        border-radius: 3px;
        padding: 0 0.5ch;
        font-family: var(--font-family);
        font-size: 0.9em;
        text-align: center;
        white-space: nowrap;
        justify-self: end;
    }

    .keybind-grid > span {
        color: var(--foreground2);
    }

    .keybind-columns {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1ch 2ch;
    }

    .keybind-group {
        display: flex;
        flex-direction: column;
        gap: 0.25lh;
    }

    .keybind-group-title {
        background-image: none;
        --badge-text: none;
        --badge-color: none;
        background-color: transparent;
        color: var(--foreground1);
        font-weight: bold;
        padding-inline: 0;
        border-bottom: 1px solid var(--background2);
    }

    @media (min-width: 768px) {
        .keybind-columns {
            grid-template-columns: 1fr 1fr;
        }
    }

    /* 1lh chips instead of fat buttons. */
    .command-theme-buttons {
        flex-wrap: wrap;
        gap: 0;
    }

    .command-theme-chip {
        all: unset;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        height: 1lh;
        padding: 0 1ch;
        color: var(--foreground2);
        border: 1px solid var(--background2);
        border-right-width: 0;
        background-color: var(--background0);
        transition:
            background-color 100ms linear,
            color 100ms linear;
    }

    .command-theme-chip:last-of-type {
        border-right-width: 1px;
    }

    .command-theme-chip:hover,
    .command-theme-chip:focus-visible {
        color: var(--foreground0);
        background-color: oklch(
            from var(--blue) calc(l * var(--oklch-scale, 0.85)) c h / 0.1
        );
    }

    .command-theme-chip[aria-selected='true'] {
        color: var(--foreground0);
        background-color: oklch(
            from var(--green) calc(l * var(--oklch-scale, 0.85)) c h / 0.15
        );
        font-weight: bold;
    }
    /* Font picker: match the blue accent used by the section title above. */
    .command-font-chip[aria-selected='true'] {
        background-color: oklch(
            from var(--blue) calc(l * var(--oklch-scale, 0.85)) c h / 0.15
        );
    }

    #search-results {
        flex-grow: 1;
        overflow: hidden;
        position: relative;

        #search-results-container {
            position: absolute;
            inset: 0;
            overflow-y: auto;
            padding-left: 1ch;
            padding-right: 1ch;
            display: flex;
            flex-direction: column;

            .search-result {
                text-decoration: none;
                color: var(--foreground1);

                &.hidden {
                    display: none;
                }

                &:focus,
                &:hover,
                &.active {
                    background-color: var(--background1);
                }
            }
        }
    }

    #search-input {
        background-color: var(--background0);
    }

    #theme-options {
        flex-grow: 1;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 0.5lh;
        padding: 1ch;
    }

    #theme-meta {
        padding-inline: 1ch;
    }

    .theme-option {
        display: flex;
        justify-content: flex-start;
        background-image: none;
        /* background-color: oklch( */
        /*     from var(--background1) calc(l * var(--oklch-scale, 0.85)) c h / 1 */
        /* ); */
    }

    .theme-option:focus-visible {
        outline: 1px solid var(--foreground0);
        outline-offset: -1px;
        background-color: var(--background2);
    }

    .theme-option[aria-selected='true'] {
        background-color: var(--background3);
        color: var(--foreground0);
        font-weight: var(--font-weight-bold);
        background-image: none;
    }

    &::highlight(search) {
        background-color: var(--background2);
        color: var(--foreground0);
    }
</style>

<script>
    import { isUserTyping, paginateElements } from '@/utils/vim'

    const commandDialog = document.getElementById(
        'command-dialog',
    ) as HTMLDialogElement
    const searchInput = document.getElementById(
        'search-input',
    ) as HTMLInputElement
    const searchDialog = document.getElementById(
        'search-dialog',
    ) as HTMLDialogElement
    const themeDialog = document.getElementById(
        'theme-dialog',
    ) as HTMLDialogElement
    const themeCurrentValue = document.getElementById(
        'theme-current-value',
    ) as HTMLElement | null
    const focusableLinks = document.querySelectorAll('.search-result')
    const themeLabels: Record<string, string> = {
        auto: 'Auto (system)',
        'custom-light': 'Light',
        'custom-dark': 'Dark',
        catppuccin: 'Catppuccin Mocha',
        'catppuccin-latte': 'Catppuccin Latte',
    }

    let activeLink: HTMLAnchorElement | null =
        (focusableLinks[0] as HTMLAnchorElement | null) ?? null

    const treeWalker = document.createTreeWalker(
        document.getElementById('search-results-container') as HTMLElement,
        NodeFilter.SHOW_TEXT,
    )
    const allTextNodes: Array<Text> = []
    let currentNode = treeWalker.nextNode()
    while (currentNode) {
        allTextNodes.push(currentNode as Text)
        currentNode = treeWalker.nextNode()
    }

    const isPrimaryModifier = (event: KeyboardEvent) =>
        (event.ctrlKey || event.metaKey) && !event.altKey && !event.shiftKey

    const updateThemeCurrentValue = () => {
        if (!themeCurrentValue) return

        // When the user picked "auto", localStorage holds 'auto' but the
        // DOM attribute is the resolved system theme (custom-light /
        // custom-dark). Surface the stored choice so the picker label
        // reads "Auto (system)" instead of jumping between Light/Dark
        // every time the OS preference flips.
        const storedTheme = localStorage.getItem('webtui-theme')
        const activeTheme =
            storedTheme ||
            document.documentElement.getAttribute('data-webtui-theme') ||
            'custom-light'
        const label = themeLabels[activeTheme] ?? activeTheme
        themeCurrentValue.textContent = label
    }

    const getThemeButtons = () =>
        Array.from(
            document.querySelectorAll(
                '[data-theme-option]',
            ) as NodeListOf<HTMLButtonElement>,
        )

    const focusThemeButton = (button: HTMLButtonElement | undefined) => {
        if (!button) return
        button.focus()
        button.scrollIntoView({ block: 'nearest', inline: 'nearest' })
    }

    const focusActiveThemeOption = () => {
        const themeButtons = getThemeButtons()
        const selectedThemeButton = themeButtons.find(
            (button) => button.getAttribute('aria-selected') === 'true',
        )
        const target = selectedThemeButton ?? themeButtons[0]
        focusThemeButton(target)
    }

    window.addEventListener('keydown', (e) => {
        if (isUserTyping()) return

        if ((e.key === 'p' && isPrimaryModifier(e)) || e.key === ':') {
            e.preventDefault()
            e.stopImmediatePropagation()
            commandDialog.showModal()
            return
        }

        if (e.key === 'x' && isPrimaryModifier(e)) {
            e.preventDefault()
            e.stopImmediatePropagation()
            themeDialog.showModal()
            requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                    updateThemeCurrentValue()
                    focusActiveThemeOption()
                })
            })
            return
        }

        if (e.key === '/') {
            e.preventDefault()
            searchDialog.showModal()
            return
        }

        if (e.key === '?') {
            e.preventDefault()
            commandDialog.showModal()
        }
    })

    themeDialog.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' || (e.key === 'c' && isPrimaryModifier(e))) {
            e.preventDefault()
            themeDialog.close()
            return
        }

        const themeButtons = getThemeButtons()
        if (themeButtons.length === 0) return

        const activeElement = document.activeElement as HTMLElement | null
        const currentIndex = themeButtons.findIndex(
            (button) => button === activeElement,
        )
        const index = currentIndex === -1 ? 0 : currentIndex

        if (e.key === 'j' || e.key === 'ArrowDown') {
            e.preventDefault()
            e.stopPropagation()
            const nextIndex = (index + 1) % themeButtons.length
            focusThemeButton(themeButtons[nextIndex])
            return
        }

        if (e.key === 'k' || e.key === 'ArrowUp') {
            e.preventDefault()
            e.stopPropagation()
            const prevIndex =
                (index - 1 + themeButtons.length) % themeButtons.length
            focusThemeButton(themeButtons[prevIndex])
            return
        }

        if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault()
            e.stopPropagation()
            themeButtons[index]?.click()
        }
    })

    new MutationObserver(() => {
        if (themeDialog.open) {
            updateThemeCurrentValue()
            requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                    focusActiveThemeOption()
                })
            })
        }
    }).observe(themeDialog, {
        attributes: true,
        attributeFilter: ['open'],
    })

    new MutationObserver(() => {
        updateThemeCurrentValue()
    }).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-webtui-theme'],
    })

    updateThemeCurrentValue()

    searchInput.addEventListener('input', () => {
        const value = searchInput.value.trim()

        const focusableLinks = document.querySelectorAll('.search-result')

        focusableLinks.forEach((element) => {
            element.classList.remove('hidden')

            if (
                element
                    .getAttribute('data-value')
                    ?.toLowerCase()
                    .includes(value.toLowerCase())
            )
                return

            element.classList.add('hidden')
        })

        const visibleLinks = document.querySelectorAll(
            '.search-result:not(.hidden)',
        )

        if (visibleLinks.length > 0) {
            activeLink = visibleLinks[0] as HTMLAnchorElement
        } else {
            activeLink = null
        }

        CSS.highlights.clear()

        if (!value) return

        const ranges = allTextNodes
            .map((el) => {
                return { el, text: el.textContent?.toLowerCase() }
            })
            .map(({ text, el }) => {
                const indices = []
                let startPos = 0

                if (!text) return []
                while (startPos < text.length) {
                    const index = text.indexOf(value, startPos)
                    if (index === -1) break
                    indices.push(index)
                    startPos = index + value.length
                }

                // Create a range object for each instance of
                // str we found in the text node.
                return indices.map((index) => {
                    const range = new Range()
                    range.setStart(el, index)
                    range.setEnd(el, index + value.length)
                    return range
                })
            })

        // Create a Highlight object for the ranges.
        const searchResultsHighlight = new Highlight(...ranges.flat())

        // Register the Highlight object in the registry.
        CSS.highlights.set('search', searchResultsHighlight)
    })

    searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' || (e.key === 'c' && e.ctrlKey)) {
            e.preventDefault()
            searchDialog.close()
            return
        }

        if (!activeLink) return

        const visibleLinks = document.querySelectorAll(
            '.search-result[tabindex]:not(.hidden)',
        ) as NodeListOf<HTMLAnchorElement>

        const { prev, next } = paginateElements(activeLink, visibleLinks)

        if ((e.key === 'n' && e.ctrlKey) || e.key === 'ArrowDown') {
            e.preventDefault()

            visibleLinks.forEach((link) => {
                link.classList.remove('active')
            })
            next.scrollIntoView({ block: 'nearest', inline: 'nearest' })
            next.classList.add('active')
        }

        if ((e.key === 'p' && e.ctrlKey) || e.key === 'ArrowUp') {
            e.preventDefault()

            visibleLinks.forEach((link) => {
                link.classList.remove('active')
            })
            prev.scrollIntoView({ block: 'nearest', inline: 'nearest' })
            prev.classList.add('active')
        }

        if (e.key === 'Enter') {
            e.preventDefault()

            activeLink?.click()
        }
    })

    document.querySelectorAll('.search-result:not(.hidden)').forEach((link) => {
        link.addEventListener('click', () => {
            searchDialog.close()
        })
    })

    document.getElementById('close-btn')?.addEventListener('click', () => {
        searchDialog.close()
    })

    document
        .getElementById('theme-close-btn')
        ?.addEventListener('click', () => {
            themeDialog.close()
        })

    document
        .getElementById('command-close-btn')
        ?.addEventListener('click', () => {
            commandDialog.close()
        })

    searchDialog.addEventListener('click', (e) => {
        if (e.target === searchDialog) searchDialog.close()
    })

    commandDialog.addEventListener('click', (e) => {
        if (e.target === commandDialog) commandDialog.close()
    })

    themeDialog.addEventListener('click', (e) => {
        if (e.target === themeDialog) themeDialog.close()
    })

    document.querySelectorAll('[data-theme-option]').forEach((button) => {
        button.addEventListener('click', () => {
            themeDialog.close()
        })
    })

    // ── Font pickers (two independent axes) ───────────────────────────
    // Body font → data-mono-font + localStorage 'mono-font' (default qp).
    // Code font → data-code-font + localStorage 'code-font'  (default term).
    // Delegated click so we catch chips from any container (this dialog,
    // SlideHelpDialog, etc.). Lives in Filter.astro so it ships on every
    // page that uses the command dialog (Doc layout etc.).
    const setFontAxis = (
        attr: string,
        storageKey: string,
        optionAttr: string,
        font: string,
    ) => {
        document.documentElement.setAttribute(attr, font)
        document
            .querySelectorAll<HTMLElement>(`[${optionAttr}]`)
            .forEach((btn) => {
                const v = btn.getAttribute(optionAttr)
                btn.setAttribute('aria-selected', String(v === font))
                btn.setAttribute('data-active', String(v === font))
            })
        localStorage.setItem(storageKey, font)
    }
    const setBodyFont = (font: string) =>
        setFontAxis(
            'data-mono-font',
            'mono-font',
            'data-body-font-option',
            font,
        )
    const setCodeFont = (font: string) =>
        setFontAxis(
            'data-code-font',
            'code-font',
            'data-code-font-option',
            font,
        )

    setBodyFont(localStorage.getItem('mono-font') ?? 'miosevka-qp')
    setCodeFont(localStorage.getItem('code-font') ?? 'miosevka-term')

    document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement
        const bodyBtn = target?.closest?.(
            '[data-body-font-option]',
        ) as HTMLElement | null
        if (bodyBtn) {
            const v = bodyBtn.getAttribute('data-body-font-option')
            if (v) setBodyFont(v)
            return
        }
        const codeBtn = target?.closest?.(
            '[data-code-font-option]',
        ) as HTMLElement | null
        if (codeBtn) {
            const v = codeBtn.getAttribute('data-code-font-option')
            if (v) setCodeFont(v)
        }
    })

    // ── Reader view chip ──────────────────────────────────────────────
    // Delegated click; the actual toggle lives in Doc.astro
    // (window.toggleReader). Closes the command dialog on activation,
    // matching theme/font chips.
    document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement)?.closest?.(
            '[data-reader-toggle]',
        ) as HTMLElement | null
        if (!btn) return
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const fn = (window as any).toggleReader
        if (typeof fn === 'function') fn()
        commandDialog.close()
    })
</script>
