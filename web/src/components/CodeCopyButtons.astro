---
/**
 * Injects a copy button into every `pre.astro-code` on the page.
 *
 * The visible affordance is the language badge itself (`pre.astro-code::after`
 * in global.css), which swaps to a copy glyph on hover. A pseudo-element
 * cannot receive clicks, so this real button sits over it to supply the
 * cursor, the click target and the accessible name.
 *
 * Extracted from Doc.astro so SlideLayout can use it too. Nothing here is
 * Doc-specific: it keys only off `pre.astro-code`, which shiki emits
 * everywhere. Slides opt out of the line-number gutter but keep the badge, so
 * the `.code-line-link` strip below is a no-op there rather than wrong.
 */
---

<script>
    const codeBlocks = document.querySelectorAll('pre.astro-code')
    for (const block of codeBlocks) {
        // Skip a block that already has one: both Doc.astro and SlideLayout
        // could in principle mount this, and a double-injected button would
        // stack two click targets in the same corner.
        if (block.querySelector(':scope > .code-copy-btn')) continue

        // Unlabeled blocks get no button. global.css suppresses the badge
        // (::after) on `text` / `plaintext`, and the badge is what the copy
        // glyph cross-fades WITH -- so a button here paints nothing at any
        // point, while still being tab-focusable and announcing itself as
        // "copy" to a screen reader. That is a control a keyboard user can
        // reach and a pointer user cannot see. Matching the CSS and skipping
        // them keeps the affordance and the control in the same place.
        const lang = (block as HTMLElement).dataset.language
        if (lang === 'text' || lang === 'plaintext') continue

        block.style.position = 'relative'

        const button = document.createElement('button')
        button.className = 'code-copy-btn'
        button.textContent = 'copy'
        let resetTimer: ReturnType<typeof setTimeout> | undefined
        button.addEventListener('click', async () => {
            const code = block.querySelector('code')
            if (!code) return
            let ok = true
            try {
                // Copy the code WITHOUT the line-number anchors. They are real
                // elements inside each line now, so innerText picks them up
                // and every copied block came out as "1# Kick the tires...".
                const clone = code.cloneNode(true) as HTMLElement
                for (const n of clone.querySelectorAll('.code-line-link')) {
                    n.remove()
                }
                await navigator.clipboard.writeText(clone.innerText)
                button.textContent = 'copied!'
            } catch {
                ok = false
                button.textContent = 'failed'
            }
            // The <pre> carries the state; global.css swaps the badge glyph
            // to a check / x and plays the pop keyframe off these classes.
            // Both are removed first so a rapid second click restarts the
            // animation instead of being swallowed (a class that is already
            // present doesn't re-trigger @keyframes).
            block.classList.remove('is-copied', 'is-copy-failed')
            void block.offsetWidth // force reflow so the re-add animates
            block.classList.add(ok ? 'is-copied' : 'is-copy-failed')
            clearTimeout(resetTimer)
            resetTimer = setTimeout(() => {
                button.textContent = 'copy'
                block.classList.remove('is-copied', 'is-copy-failed')
            }, 1200)
        })
        block.appendChild(button)
    }
</script>
