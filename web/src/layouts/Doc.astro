    .image-modal-caption {
        position: absolute;
        bottom: 0.5lh;
        left: 2ch;
        right: 2ch;
        text-align: center;
        font-size: 0.85em;
        color: var(--foreground2);
        pointer-events: none;
    }
</style>

<script>
    /* Wire click-to-zoom on every <img> inside #main-content (except the
       opt-out list mirrored from the CSS above). */
    function setupImageZoom() {
        const main = document.getElementById('main-content')
        if (!main) return

        const isExcluded = (img: HTMLImageElement) =>
            img.closest(
                '.no-zoom, [data-no-zoom], .icon, [is~="icon"], .mermaid, .keybind, .mermaid-modal, .image-modal',
            ) !== null

        const open = (img: HTMLImageElement) => {
            document.querySelector('.image-modal')?.remove()

            const modal = document.createElement('div')
            modal.className = 'image-modal'
            modal.setAttribute('role', 'dialog')
            modal.setAttribute('aria-modal', 'true')
            modal.setAttribute('aria-label', img.alt || 'Expanded image')
            modal.tabIndex = -1

            const inner = document.createElement('div')
            inner.className = 'image-modal-inner'

            const closeBtn = document.createElement('button')
            closeBtn.type = 'button'
            closeBtn.className = 'image-modal-close'
            closeBtn.setAttribute('aria-label', 'Close')
            closeBtn.title = 'Close (Esc)'

            const big = document.createElement('img')
            // Pick the source URL the page actually resolved at click
            // time. `currentSrc` is the right answer for <img>, BUT
            // when the <img> is inside a <picture> with a matching
            // <source media="...">, some browsers still report the
            // bare `src` attribute and we end up showing the desktop
            // variant in a modal launched from the mobile variant.
            // Resolve it ourselves: clone the parent <picture> if
            // present, append a temporary <img> with the same loading
            // pipeline, and read its currentSrc. Falls back to the
            // simple currentSrc/src on bare <img>.
            const resolveModalSrc = () => {
                const picture = img.closest('picture')
                if (!picture) return img.currentSrc || img.src
                for (const source of picture.querySelectorAll('source')) {
                    const media = source.getAttribute('media')
                    if (media && !window.matchMedia(media).matches) continue
                    const srcset = source.getAttribute('srcset')
                    if (!srcset) continue
                    // Pick the first candidate (we don't author multi-density
                    // srcsets on these slides; each <source> has one URL).
                    const first = srcset.split(',')[0].trim().split(/\s+/)[0]
                    if (first) return first
                }
                return img.currentSrc || img.src
            }
            big.src = resolveModalSrc()
            big.alt = img.alt
            // Don't copy srcset/sizes onto the modal img — it's
            // outside a <picture>, and a srcset would re-trigger source
            // selection at the modal's viewport size.
            if (img.sizes) big.sizes = img.sizes

            inner.append(closeBtn, big)
            if (img.alt) {
                const caption = document.createElement('div')
                caption.className = 'image-modal-caption'
                caption.textContent = img.alt
                inner.appendChild(caption)
            }
            modal.appendChild(inner)
            document.body.appendChild(modal)

            const previousFocus = document.activeElement as HTMLElement | null
            const prevOverflow = document.body.style.overflow
            document.body.style.overflow = 'hidden'

            const close = () => {
                modal.remove()
                document.body.style.overflow = prevOverflow
                document.removeEventListener('keydown', onKey)
                previousFocus?.focus?.()
            }

            const onKey = (event: KeyboardEvent) => {
                if (event.key === 'Escape') {
                    event.preventDefault()
                    close()
                }
            }

            closeBtn.addEventListener('click', close)
            modal.addEventListener('click', (event) => {
                if (event.target === modal) close()
            })
            document.addEventListener('keydown', onKey)
            modal.focus()
        }

        // Single delegated listener — survives MDX updates and avoids per-img bookkeeping.
        main.addEventListener('click', (e) => {
            const target = e.target
            if (!(target instanceof HTMLImageElement)) return
            if (isExcluded(target)) return
            // Don't hijack image-link clicks (let the link navigate).
            if (target.closest('a[href]')) return
            e.preventDefault()
            open(target)
        })
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupImageZoom)
    } else {
        setupImageZoom()
    }

    /* Wrap every <table> in #main-content with a horizontal-scroll container
       so wide tables (e.g. ones with monospaced code in cells) get a
       scrollbar instead of overflowing the column. */
    function setupTableScroll() {
        const main = document.getElementById('main-content')
        if (!main) return
        const tables = main.querySelectorAll('table')
        for (const table of tables) {
            if (table.parentElement?.classList.contains('table-scroll-wrapper'))
                continue
            const wrap = document.createElement('div')
            wrap.className = 'table-scroll-wrapper'
            table.parentNode?.insertBefore(wrap, table)
            wrap.appendChild(table)
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupTableScroll)
    } else {
        setupTableScroll()
    }
</script>

<!-- Lazy-mount slide-deck iframes on click.
     The /about/ page has ~35 reveal.js / slides.com iframes for the
     talks-by-year section. Loading 35 full webapps simultaneously
     crashes mobile Safari/Chrome (per-page resource budget blown).
     Replace each one with a click-through placeholder; the iframe
     only attaches when the user actually wants it, and detaches when
     the surrounding <details> closes so memory drops back. -->
<script>
    function setupSlideDeckLazyMount() {
        const iframes =
            document.querySelectorAll<HTMLIFrameElement>('iframe.slide-deck')
        if (iframes.length === 0) return

        for (const iframe of iframes) {
            const src = iframe.getAttribute('src')
            const title = iframe.getAttribute('title') || 'slides'
            const style = iframe.getAttribute('style') || ''
            if (!src) continue

            // Build placeholder
            const placeholder = document.createElement('button')
            placeholder.type = 'button'
            placeholder.className = 'slide-deck-placeholder'
            placeholder.setAttribute('aria-label', `Load slides: ${title}`)
            placeholder.setAttribute('style', style)
            placeholder.innerHTML = `<span class="slide-deck-placeholder-inner">&#xe628; ${title}<br><small>tap to load</small></span>`

            // Stash the iframe attrs we'll restore on click
            placeholder.dataset.src = src
            placeholder.dataset.title = title

            const onClick = () => {
                const live = document.createElement('iframe')
                for (const attr of iframe.attributes) {
                    live.setAttribute(attr.name, attr.value)
                }
                placeholder.replaceWith(live)
                // When the surrounding <details> closes, swap the
                // iframe back to a placeholder so memory drops.
                const details = live.closest('details')
                if (details) {
                    const onToggle = () => {
                        if (!details.open && live.isConnected) {
                            details.removeEventListener('toggle', onToggle)
                            // Re-run setup on the swapped placeholder
                            const newPlaceholder = placeholder.cloneNode(
                                true,
                            ) as HTMLButtonElement
                            newPlaceholder.addEventListener('click', onClick, {
                                once: true,
                            })
                            live.replaceWith(newPlaceholder)
                        }
                    }
                    details.addEventListener('toggle', onToggle)
                }
            }
            placeholder.addEventListener('click', onClick, { once: true })

            iframe.replaceWith(placeholder)
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupSlideDeckLazyMount)
    } else {
        setupSlideDeckLazyMount()
    }
</script>

<!-- Reader View -->
<script>
    const readerRoot = document.documentElement
    const readerBtn = document.querySelector('.reader-toggle')

    const syncReaderButton = () => {
        if (!(readerBtn instanceof HTMLElement)) return
        const on = readerRoot.hasAttribute('data-reader')
        readerBtn.setAttribute('aria-pressed', String(on))
    }

    // Exposed on window so the command-palette chip (Filter.astro) and
    // the zr chord (Sidebar-Toggle script) can call the same toggle.
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    ;(window as any).toggleReader = (force?: boolean) => {
        const next =
            force === undefined
                ? !readerRoot.hasAttribute('data-reader')
                : force
        if (next) {
            readerRoot.setAttribute('data-reader', '')
        } else {
            readerRoot.removeAttribute('data-reader')
        }
        syncReaderButton()
    }

    readerBtn?.addEventListener('click', () => {
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        ;(window as any).toggleReader()
    })

    // Reader control cluster: width stepper (− / +) + exit button.
    // Column width is a continuous value in `ch`, driven by the
    // `--reader-width` custom property on #doc-article (the CSS falls back to
    // 90ch when unset). The − / + buttons step it by READER_WIDTH_STEP within
    // [READER_WIDTH_MIN, READER_WIDTH_MAX]; the chosen width persists in
    // localStorage so it carries across pages and reloads.
    const READER_WIDTH_MIN = 56
    const READER_WIDTH_MAX = 128
    const READER_WIDTH_STEP = 8
    const READER_WIDTH_DEFAULT = 90
    const READER_WIDTH_KEY = 'reader-width-ch'
    const docArticle = document.getElementById('doc-article')
    const readerControls = document.getElementById('reader-controls')

    const clampReaderWidth = (n: number) =>
        Math.min(READER_WIDTH_MAX, Math.max(READER_WIDTH_MIN, n))

    const readReaderWidth = () => {
        const stored = Number(localStorage.getItem(READER_WIDTH_KEY))
        return Number.isFinite(stored) && stored > 0
            ? clampReaderWidth(stored)
            : READER_WIDTH_DEFAULT
    }

    const applyReaderWidth = (ch: number) => {
        const w = clampReaderWidth(ch)
        docArticle?.style.setProperty('--reader-width', `${w}ch`)
        localStorage.setItem(READER_WIDTH_KEY, String(w))
        // Disable the buttons at the range ends so it's clear there's no
        // further travel.
        readerControls
            ?.querySelector('[data-reader-width-step="-1"]')
            ?.toggleAttribute('disabled', w <= READER_WIDTH_MIN)
        readerControls
            ?.querySelector('[data-reader-width-step="1"]')
            ?.toggleAttribute('disabled', w >= READER_WIDTH_MAX)
    }

    // Apply the persisted width up front so the column is right on first paint
    // of reader view (the value is harmless outside reader view — the CSS only
    // consumes --reader-width under html[data-reader]).
    applyReaderWidth(readReaderWidth())

    readerControls?.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement)?.closest('button')
        if (!(btn instanceof HTMLElement)) return
        if (btn.classList.contains('reader-exit')) {
            // eslint-disable-next-line @typescript-eslint/no-explicit-any
            ;(window as any).toggleReader(false)
            return
        }
        const step = btn.getAttribute('data-reader-width-step')
        if (step) {
            applyReaderWidth(
                readReaderWidth() + Number(step) * READER_WIDTH_STEP,
            )
        }
    })
</script>

