<!-- Register custom elements used by MDX-imported components (Astro
     doesn't hoist <script> tags from components imported in MDX) -->
<script>
    import { paginateElements } from '@/utils/vim'

    if (!customElements.get('tabs-component')) {
        class Tabs extends HTMLElement {
            connectedCallback() {
                const items = Array.from(
                    this.querySelectorAll(
                        '#tabs-list > button',
                    ) as NodeListOf<HTMLButtonElement>,
                )
                if (items.length === 0) return
                if (!this.hasAttribute('data-tab'))
                    this.setAttribute(
                        'data-tab',
                        items[0].getAttribute('data-value')!,
                    )
                for (const item of items) this.initializeTab(item)
            }

            initializeTab(item: HTMLElement) {
                const activeVariant =
                    this.getAttribute('data-active-variant') ?? 'default'
                const secondaryVariant =
                    this.getAttribute('data-secondary-variant') ?? 'background1'
                const items = this.querySelectorAll(
                    '#tabs-list > button',
                ) as NodeListOf<HTMLButtonElement>
                const value =
                    this.getAttribute('data-tab') ??
                    items[0].getAttribute('data-value')

                const setCurrentTab = () => {
                    items.forEach((i) => {
                        i.setAttribute('aria-selected', 'false')
                        i.setAttribute('variant-', secondaryVariant)
                    })
                    this.setAttribute(
                        'data-tab',
                        item.getAttribute('data-value') as string,
                    )
                    item.setAttribute('variant-', activeVariant)
                    item.setAttribute('aria-selected', 'true')
                }

                const isSelected = value === item.getAttribute('data-value')
                item.setAttribute(
                    'aria-selected',
                    isSelected ? 'true' : 'false',
                )
                item.setAttribute(
                    'variant-',
                    isSelected ? activeVariant : secondaryVariant,
                )
                item.setAttribute('tabindex', '0')
                item.setAttribute('role', 'tab')
                item.addEventListener('click', setCurrentTab)
                item.addEventListener('focus', setCurrentTab)
                item.addEventListener('keydown', (e) => {
                    const { next, prev } = paginateElements(
                        document.activeElement as HTMLElement,
                        items,
                    )
                    if (e.key === 'ArrowLeft' || e.key === 'h') prev.focus()
                    if (e.key === 'ArrowRight' || e.key === 'l') next.focus()
                })
            }
        }
        customElements.define('tabs-component', Tabs)
    }

    if (!customElements.get('doc-example')) {
        class Example extends HTMLElement {
            connectedCallback() {
                const iframe = this.querySelector(
                    '#preview',
                ) as HTMLIFrameElement
                if (!iframe) return
                const html = document.querySelector('html') as HTMLElement
                const initialTheme = this.getAttribute('data-initial-theme')

                // The preview follows the reader's active page theme by
                // default. Picking from this example's own dropdown is a
                // sticky LOCAL override: once set, this preview stops
                // following the page.
                let overridden = false
                const pageTheme = () =>
                    html.getAttribute('data-webtui-theme') ??
                    initialTheme ??
                    'custom-light'

                // The srcdoc bakes in data-initial-theme, so wait until
                // that document has actually parsed before overriding it
                // with the page theme. `load` covers the parse-later case;
                // the immediate call covers the already-parsed race (load
                // fired before this deferred module ran). updateIframeTheme
                // is idempotent.
                const applyInitial = () => this.updateIframeTheme(pageTheme())
                const srcdocReady = () =>
                    !!iframe.contentDocument?.documentElement?.hasAttribute(
                        'data-webtui-theme',
                    )
                iframe.addEventListener('load', applyInitial)
                if (srcdocReady()) applyInitial()

                const themeDropdown = this.querySelector(
                    '#theme-dropdown',
                ) as HTMLElement

                // Dropdown pick → local override for THIS example only.
                new MutationObserver(() => {
                    overridden = true
                    const value = themeDropdown.getAttribute(
                        'data-value',
                    ) as string
                    this.updateIframeTheme(value)
                }).observe(themeDropdown, {
                    attributes: true,
                    attributeFilter: ['data-value'],
                })

                // Page theme change → follow it, unless locally overridden.
                new MutationObserver(() => {
                    if (!overridden) this.updateIframeTheme(pageTheme())
                }).observe(html, {
                    attributes: true,
                    attributeFilter: ['data-webtui-theme'],
                })
            }

            updateIframeTheme(theme: string) {
                const iframe = this.querySelector(
                    '#preview',
                ) as HTMLIFrameElement
                const previewHtml =
                    iframe.contentDocument?.querySelector('html')
                if (!previewHtml) return
                previewHtml.setAttribute('data-webtui-theme', theme)
            }
        }
        customElements.define('doc-example', Example)
    }

    if (!customElements.get('select-dropdown')) {
        class Dropdown extends HTMLElement {
            connectedCallback() {
                // eslint-disable-next-line @typescript-eslint/no-this-alias
                const self = this
                const items = Array.from(
                    self.querySelectorAll(
                        '#options > button',
                    ) as NodeListOf<HTMLButtonElement>,
                )

                const trigger = self.querySelector('summary')!
                const details = self.querySelector('details')!

                items.forEach((item) => {
                    item.setAttribute('tabindex', '0')

                    item.addEventListener('click', () => {
                        items.forEach((i) => {
                            i.setAttribute('aria-selected', 'false')
                            i.setAttribute('variant-', 'background1')
                        })
                        item.setAttribute('variant-', 'default')
                        item.setAttribute('aria-selected', 'true')
                        self.setAttribute(
                            'data-value',
                            item.getAttribute('data-value')!,
                        )
                        trigger.click()
                    })
                })

                details.addEventListener('toggle', () => {
                    if (!details.open) return
                    const dataValue = self.getAttribute('data-value')
                    const activeItem = items.find(
                        (i) => i.getAttribute('data-value') === dataValue,
                    )
                    if (activeItem) activeItem.focus()
                })

                self.addEventListener('keydown', (e) => {
                    if (!details.open) return
                    const { next, prev } = paginateElements(
                        document.activeElement as HTMLElement,
                        items,
                    )
                    if (e.key === 'ArrowDown' || e.key === 'j') {
                        e.preventDefault()
                        e.stopPropagation()
                        next.focus()
                    }
                    if (e.key === 'ArrowUp' || e.key === 'k') {
                        e.preventDefault()
                        e.stopPropagation()
                        prev.focus()
                    }
                })
            }
        }
        customElements.define('select-dropdown', Dropdown)
    }
</script>

