---
import Sidebar from '@/components/SidebarFileTree.astro'
import Filter from '@/components/Filter.astro'
import Layout from '@/layouts/Layout.astro'
import { makeSidebarOrderedPages } from '@/utils/content'
import { compareUrlPaths, splitPathChunks } from '@/utils/url'
import { getReadingTime } from '@/utils/readingTime'
import ShareButtons from '@/components/ShareButtons.astro'
import CiteThis from '@/components/CiteThis.astro'
import {
    citationKeyBase,
    resolveCitationKey,
    type CitationKind,
} from '@/utils/citation'
import { getCollection } from 'astro:content'
import { execSync } from 'node:child_process'
// KaTeX CSS via frontmatter import so Vite processes its relative
// `url(fonts/KaTeX_*)` refs (hash into /_astro/, copy the fonts). An `@import`
// in the <style> block below is passed through untouched -> fonts 404, math
// renders in fallback faces. The .katex-mathml display:none rule still ships.
import 'katex/dist/katex.min.css'

// Prefer Netlify's BRANCH env var so preview deploys point at the
// preview's source branch instead of the build host's checked-out
// ref. (Netlify also exposes HEAD, but that's the commit SHA, not a
// branch name.) Falls back to git rev-parse for local `astro build`.
let currentBranch = process.env.BRANCH ?? ''
if (!currentBranch) {
    try {
        const out = execSync('git rev-parse --abbrev-ref HEAD', {
            encoding: 'utf8',
        }).trim()
        if (out && out !== 'HEAD') currentBranch = out
    } catch {}
}
if (!currentBranch) currentBranch = 'main'

type DocHeading = {
    depth: number
    text: string
    slug: string
}

type TocLine = DocHeading & {
    treePrefix: string
}

const { frontmatter, headings } = Astro.props as {
    frontmatter: { title: string; date?: string; description?: string }
    headings: DocHeading[]
}

const sortedPages = makeSidebarOrderedPages()
const pageIndex = sortedPages.findIndex((page) =>
    compareUrlPaths(page.id, Astro.url.pathname),
)
const nextDoc =
    pageIndex === sortedPages.length - 1
        ? undefined
        : sortedPages.at(pageIndex + 1)
const prevDoc = pageIndex === 0 ? undefined : sortedPages.at(pageIndex - 1)

const allTocHeadings: DocHeading[] = [
    { depth: 1, text: frontmatter.title, slug: 'toc-page-title' },
    ...headings.filter((heading) => heading.depth >= 2),
]

// Mirror the runtime collapse-by-default predicate (see the collapsible-
// headings script near the bottom of this file): year-ending sections
// (e.g. "📆 2025") plus a short allowlist of exact section labels are
// wrapped in a <details> that starts CLOSED. A heading nested inside such
// a section is hidden until the reader expands it, so listing it in the
// sidebar TOC advertises a link to content they can't see. Strip those
// descendants from the outline. The section heading ITSELF stays (it's the
// always-visible accordion summary); only its collapsed children are cut.
const COLLAPSE_EXACT = new Set([
    'music',
    'projects',
    'more',
    'detailed list',
    'by year',
])
const startsCollapsedSection = (text: string) => {
    const bare = text
        .replace(
            /^[\p{Emoji_Presentation}\p{Extended_Pictographic}️‍]+\s*/gu,
            '',
        )
        .trim()
        .toLowerCase()
    return /\b(19|20)\d{2}\s*$/.test(text) || COLLAPSE_EXACT.has(bare)
}
// Walk in document order tracking the depth of the nearest enclosing
// collapsed section (Infinity = none). A heading deeper than that is a
// hidden descendant; a heading at or above it closes the section.
let collapsedAt = Infinity
const hiddenHeadings = new Set<DocHeading>()
for (const heading of allTocHeadings) {
    if (heading.depth <= collapsedAt) collapsedAt = Infinity
    if (heading.depth > collapsedAt) hiddenHeadings.add(heading)
    if (heading.depth < collapsedAt && startsCollapsedSection(heading.text)) {
        collapsedAt = heading.depth
    }
}
const tocHeadings: DocHeading[] = allTocHeadings.filter(
    (heading) => !hiddenHeadings.has(heading),
)

const hasSiblingAfter = (items: DocHeading[], index: number) => {
    const currentDepth = items[index].depth

    for (let nextIndex = index + 1; nextIndex < items.length; nextIndex += 1) {
        const nextDepth = items[nextIndex].depth

        if (nextDepth === currentDepth) return true
        if (nextDepth < currentDepth) return false
    }

    return false
}

const ancestorHasSibling = new Map<number, boolean>()
const tocLines: TocLine[] = tocHeadings.map((heading, index) => {
    const isLastSibling = !hasSiblingAfter(tocHeadings, index)

    let ancestorPrefix = ''
    for (let level = 2; level < heading.depth; level += 1) {
        ancestorPrefix += ancestorHasSibling.get(level) ? '│  ' : '   '
    }

    const branchPrefix =
        heading.depth === 1 ? '' : isLastSibling ? '└─ ' : '├─ '

    ancestorHasSibling.set(heading.depth, !isLastSibling)

    return {
        ...heading,
        treePrefix: `${ancestorPrefix}${branchPrefix}`,
    }
})

const rawBody = await Astro.slots.render('default')
const readingTime = getReadingTime(rawBody.replace(/<[^>]*>/g, ''))

// Find related posts (same parent directory).
// Normalize a trailing slash before the startsWith checks so the
// bare collection-index path ('/posts', '/talks') matches the same
// branch as nested entries ('/posts/foo/'). Production normalizes
// to '/posts/' via Netlify; Astro dev sometimes serves '/posts'
// unredirected, which previously fell through and hid the
// Related-posts block.
const currentPath = Astro.url.pathname.endsWith('/')
    ? Astro.url.pathname
    : `${Astro.url.pathname}/`
const isPost = currentPath.startsWith('/posts/')
const isTalk = currentPath.startsWith('/talks/')
const isAbout = currentPath === '/about/'
// Action buttons (reader / github source / raw / copy / share) appear on
// every Doc-layout page EXCEPT the /about/ landing page (slide decks use a
// different layout and never reach here). Share buttons in particular only
// make sense off the about page.
const showActions = !isAbout

// Derive category from URL path (e.g. /posts/auroragpt/foo → "auroragpt")
const pathSegments = currentPath.split('/').filter(Boolean)
const category =
    pathSegments.length >= 3 && isNaN(Number(pathSegments[1]))
        ? pathSegments[1]
        : null

// Source file path for GitHub links
import { stat } from 'node:fs/promises'
import { join } from 'node:path'
import { getLastModified } from '@/utils/lastModified'

const sourceFile = sortedPages.find((p) => compareUrlPaths(p.id, currentPath))
const sourceId = sourceFile?.id ?? ''
// The collection id strips index.md(x) — reconstruct the full file path.
// For dir-style pages (id is just the dir, e.g. "posts/2026/04/27"),
// probe the filesystem for .mdx first then .md so GitHub/raw links
// resolve to the real file (a hardcoded .mdx fallback used to 404 for
// the 3 .md posts in the repo).
//
// Resolve against process.cwd() (the `web/` workspace dir — astro runs
// dev AND build from there) rather than `import.meta.url`: at build time
// this module is bundled, so import.meta.url points into a temp/.astro
// location and the old `../pages/...` relative stat always missed —
// which is why the source/raw GitHub buttons silently vanished in
// production while working in dev. cwd is stable in both.
const pagesDir = join(process.cwd(), 'src', 'pages')
async function resolveSourceFile(id: string): Promise<string | null> {
    if (!id) return null
    if (id.endsWith('.md') || id.endsWith('.mdx')) {
        return `web/src/pages/${id}`
    }
    // Two on-disk shapes: dir-style `id/index.{mdx,md}` (posts, talks) and
    // flat `id.{mdx,md}` (webtui docs like webtui/start/intro.md). Probe both.
    const candidates = [
        ['mdx', `${id}/index.mdx`],
        ['md', `${id}/index.md`],
        ['mdx', `${id}.mdx`],
        ['md', `${id}.md`],
    ] as const
    for (const [, rel] of candidates) {
        try {
            await stat(join(pagesDir, rel))
            return `web/src/pages/${rel}`
        } catch {
            // try next candidate
        }
    }
    return null
}
const sourceFilePath = await resolveSourceFile(sourceId)
const githubBase = 'https://github.com/saforem2/samf.sh'
const githubRawBase = 'https://raw.githubusercontent.com/saforem2/samf.sh'

// Statusline path breadcrumbs. Each URL segment becomes its own crumb linking
// to its cumulative site path — but only when that path is a real route. The
// collection ids (index-stripped, slash-joined, e.g. "posts/2026/05/01") are
// exactly a cumulative segment list joined by "/", so a Set of ids is the
// route-existence oracle. Many intermediate paths don't exist as pages
// (/posts/2026/, most /posts/YYYY/MM/), so those crumbs render as plain text.
const routeIds = new Set(sortedPages.map((p) => p.id))
const crumbSegments = splitPathChunks(Astro.url.pathname)
const breadcrumbs = crumbSegments.map((seg, i) => {
    const id = crumbSegments.slice(0, i + 1).join('/')
    return {
        seg,
        href: routeIds.has(id) ? `/${id}/` : null,
    }
})

// Last-modified date: frontmatter `date-modified` override -> git
// committer date -> filesystem mtime (see utils/lastModified). Robust to
// git checkouts rewriting mtime, and to shallow clones (skips git, uses
// mtime, rather than emitting a fabricated boundary-commit date).
let fileModifiedDate: Date | null = null
if (sourceFilePath) {
    try {
        // sourceFilePath is repo-relative ("web/src/pages/..."); strip the
        // leading "web/" to get the workspace-relative path, then make it
        // absolute so the git pathspec resolves independent of cwd.
        const absPath = join(
            process.cwd(),
            sourceFilePath.replace(/^web\//, ''),
        )
        const override = (frontmatter as Record<string, unknown>)?.[
            'date-modified'
        ]
        fileModifiedDate = getLastModified(
            absPath,
            override as string | undefined,
        ).date
    } catch {
        // Resolution failed entirely, skip (badge just won't render).
    }
}

// Parse a date value into a Date, anchoring bare `YYYY-MM-DD` frontmatter
// strings at LOCAL noon. A date-only string parses as UTC midnight, which
// rolls back a calendar day when formatted in a behind-UTC build zone (e.g.
// `2024-06-17` renders "Jun 16" in Chicago). Noon keeps the intended day in
// any zone. Mirrors the same fix in utils/lastModified.ts.
function parseDocDate(d: string | Date): Date {
    if (d instanceof Date) return d
    const s = String(d).trim()
    return /^\d{4}-\d{2}-\d{2}$/.test(s)
        ? new Date(`${s}T12:00:00`)
        : new Date(s)
}

// Format date helper
function formatDate(d: string | Date): string {
    return parseDocDate(d).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
    })
}

function formatDateShort(d: string | Date): string {
    const dt = parseDocDate(d)
    const mm = String(dt.getMonth() + 1).padStart(2, '0')
    const dd = String(dt.getDate()).padStart(2, '0')
    const yy = String(dt.getFullYear()).slice(-2)
    return `${mm}/${dd}/${yy}`
}
let relatedPosts: Array<{ title: string; date: Date; href: string }> = []

if (isPost) {
    const allDocs = await getCollection('docs')
    const pathParts = currentPath.split('/').filter(Boolean)
    const parentDir =
        pathParts.length >= 3
            ? pathParts.slice(0, pathParts.length - 1).join('/')
            : 'posts'

    relatedPosts = allDocs
        .filter((doc) => {
            const docPath = doc.id.replace(/\/index\.(mdx?|md)$/, '')
            return (
                docPath.startsWith(parentDir) &&
                `/${docPath}` !== currentPath.replace(/\/$/, '') &&
                doc.data.title &&
                doc.data.date &&
                !doc.data.draft &&
                !doc.id.endsWith(`${parentDir}/index.mdx`)
            )
        })
        .map((doc) => ({
            title: doc.data.title,
            date: new Date(doc.data.date!),
            href: `/${doc.id.replace(/\/index\.(mdx?|md)$/, '/')}`,
        }))
        .sort((a, b) => b.date.getTime() - a.date.getTime())
        .slice(0, 3)
}

// ---------------------------------------------------------------------------
// "Cite this post/talk" block.
//
// Only pages that are a real dated work get one: 58 of the 70 posts+talks.
// The rest are section index pages (/posts/, /posts/2025/, ...) with no date,
// plus 4 slide decks that render through SlideLayout instead of this layout.
//
// The key needs to know about EVERY citable page, not just this one, because
// a few pages share a base key (the same talk given three times, two "Building
// PyTorch from Source" posts, and one post/talk pair with identical titles).
// resolveCitationKey appends MMDD to each member of a colliding group, so we
// collect all bases first.
// ---------------------------------------------------------------------------
const citationDate = frontmatter.date ? parseDocDate(frontmatter.date) : null
const isCitable = (isPost || isTalk) && !!citationDate && !!frontmatter.title

let citationKey = ''
if (isCitable) {
    const allDocs = await getCollection('docs')
    const bases: string[] = []
    for (const doc of allDocs) {
        const id = doc.id.replace(/\/index\.(mdx?|md)$/, '')
        if (!/^(posts|talks)\//.test(id)) continue
        // Slide decks render through SlideLayout and never emit a Cite
        // block, so they are not citable pages and must not count toward a
        // collision. Leaving them in gave two keys a disambiguating MMDD
        // suffix against a phantom they never actually collided with.
        if (doc.data.layout?.includes('SlideLayout')) continue
        const d = doc.data.date ? parseDocDate(doc.data.date) : null
        if (!d || !doc.data.title) continue
        bases.push(
            citationKeyBase({
                title: doc.data.title,
                date: d,
                pathname: `/${id}/`,
                kind: id.startsWith('talks/') ? 'talk' : 'post',
            }),
        )
    }
    citationKey = resolveCitationKey(
        {
            title: frontmatter.title,
            date: citationDate!,
            pathname: currentPath,
            kind: isTalk ? 'talk' : 'post',
        },
        bases,
    )
}

const articleSchema =
    isPost && frontmatter.date
        ? JSON.stringify({
              '@context': 'https://schema.org',
              '@type': 'Article',
              headline: frontmatter.title,
              datePublished: new Date(frontmatter.date).toISOString(),
              author: {
                  '@type': 'Person',
                  name: 'Sam Foreman',
                  url: 'https://samf.sh',
              },
              description: frontmatter.description ?? '',
          })
        : null
---

<!--
  Doc.css is pulled in via @import (not a frontmatter `import './Doc.css'`)
  on purpose: it must load HERE in the cascade, before the inline <style>
  blocks further down that override the same selectors (.heading-collapse,
  .footnote-popover). A frontmatter import would reorder it and flip those
  overrides.

  Vite used to not reliably HMR an @import-ed CSS file: edits to Doc.css
  would show up neither on save nor on hard reload, because the stale copy
  sat in Vite's module transform rather than the browser. That no longer
  reproduces — re-tested on Astro 5.18.0 with four consecutive edits, each
  live in about three seconds. If it ever regresses, the workaround was to
  touch this file so the block is reprocessed, or restart the dev server.
-->
<style is:global>
    /* KaTeX CSS is imported from frontmatter (above) so Vite copies its fonts;
       statusline + Doc.css stay here. */
    @import '@/styles/statusline.css';
    @import './Doc.css';
</style>

<Layout
    ogSlug={Astro.url.pathname.replace(/^\//, '').replace(/\/$/, '')}
    title={frontmatter.title ? `${frontmatter.title} — Sam Foreman` : undefined}
    description={frontmatter.description}
    ogType={isPost ? 'article' : 'website'}
    publishedTime={isPost && frontmatter.date
        ? new Date(frontmatter.date).toISOString()
        : undefined}>
    {
        articleSchema && (
            <script type="application/ld+json" set:html={articleSchema} />
        )
    }
    <column self-="grow">
        <Filter />
        <row self-="grow" gap-="0" id="doc-columns">
            <div id="sidebar-container" class="mobile-hidden">
                <Sidebar {tocLines} />
            </div>
            <div id="sidebar-resizer" aria-hidden="true"></div>
            <article id="doc-article" box-="square" shear-="top">
                <div id="reader-controls">
                    <button
                        type="button"
                        class="reader-ctrl reader-width"
                        data-reader-width-step="-1"
                        title="Narrower column"
                        aria-label="Narrower column">&#xf068;</button
                    >
                    <button
                        type="button"
                        class="reader-ctrl reader-width"
                        data-reader-width-step="1"
                        title="Wider column"
                        aria-label="Wider column">&#xf067;</button
                    >
                    <button
                        type="button"
                        class="reader-ctrl reader-exit"
                        title="Exit reader view (Esc / zr)"
                        aria-label="Exit reader view">&#xf00d;</button
                    >
                </div>
                <header>
                    <div is-="badge" variant-="background0">
                        <h1>{frontmatter.title}</h1>
                    </div>
                </header>
                <row gap-="1" self-="grow">
                    <div id="scroll-progress" aria-hidden="true"></div>
                    <div id="scroll-container">
                        <!-- tabindex="-1": makes the skip-link target
                             programmatically focusable (a bare <main> is not,
                             which Lighthouse flags as "no skip link target")
                             without adding it to the Tab order. -->
                        <main id="main-content" tabindex="-1">
                            <span
                                id="toc-page-title"
                                aria-hidden="true"
                                tabindex="-1"></span>
                            {
                                (() => {
                                    const hasMeta =
                                        frontmatter.date || isPost || isTalk
                                    // Skip the whole block when it would hold
                                    // nothing (no meta row AND no action row,
                                    // e.g. /about) — otherwise the empty div
                                    // still claims its 2ch top margin as a
                                    // phantom gap. Meta-less docs that DO show
                                    // actions (webtui) keep the block.
                                    if (!hasMeta && !showActions) return null
                                    return (
                                        <div
                                            class="post-meta"
                                            class:list={{
                                                'post-meta-empty': !hasMeta,
                                            }}>
                                            {hasMeta && (
                                                <div class="post-meta-row">
                                                    <span
                                                        is-="badge"
                                                        variant-="background1"
                                                        class="post-meta-item post-meta-author"
                                                        tabindex="0">
                                                        Sam Foreman
                                                    </span>
                                                    {frontmatter.date && (
                                                        <span
                                                            is-="badge"
                                                            variant-="background1"
                                                            class="post-meta-item post-meta-date"
                                                            tabindex="0">
                                                            <span class="date-long">
                                                                {formatDate(
                                                                    frontmatter.date,
                                                                )}
                                                            </span>
                                                            <span class="date-short">
                                                                {formatDateShort(
                                                                    frontmatter.date,
                                                                )}
                                                            </span>
                                                        </span>
                                                    )}
                                                    {fileModifiedDate &&
                                                        frontmatter.date &&
                                                        formatDate(
                                                            fileModifiedDate,
                                                        ) !==
                                                            formatDate(
                                                                frontmatter.date,
                                                            ) && (
                                                            <span
                                                                is-="badge"
                                                                variant-="background1"
                                                                class="post-meta-item post-meta-updated"
                                                                tabindex="0">
                                                                updated:{' '}
                                                                <span class="date-long">
                                                                    {formatDate(
                                                                        fileModifiedDate,
                                                                    )}
                                                                </span>
                                                                <span class="date-short">
                                                                    {formatDateShort(
                                                                        fileModifiedDate,
                                                                    )}
                                                                </span>
                                                            </span>
                                                        )}
                                                    {frontmatter.date && (
                                                        <span
                                                            is-="badge"
                                                            variant-="background1"
                                                            class="post-meta-item post-meta-reading"
                                                            tabindex="0">
                                                            {readingTime}
                                                        </span>
                                                    )}
                                                    {category && (
                                                        <a
                                                            href={`/posts/${category}/`}
                                                            is-="badge"
                                                            variant-="background1"
                                                            class="post-meta-tag"
                                                            tabindex="0">
                                                            {category}
                                                        </a>
                                                    )}
                                                </div>
                                            )}
                                            {showActions && (
                                                <div class="post-meta-row post-meta-actions">
                                                    <button
                                                        type="button"
                                                        class="reader-toggle"
                                                        is-="badge"
                                                        size-="small"
                                                        aria-pressed="false"
                                                        title="Toggle reader view (zr)"
                                                        aria-label="Toggle reader view">
                                                        &#xf1ea;
                                                    </button>
                                                    {sourceFilePath && (
                                                        <span class="post-meta-links">
                                                            <a
                                                                href={`${githubBase}/blob/${currentBranch}/${sourceFilePath}`}
                                                                target="_blank"
                                                                rel="noopener noreferrer"
                                                                is-="badge"
                                                                class="post-meta-source"
                                                                title="View source on GitHub"
                                                                aria-label="View source on GitHub"
                                                                tabindex="0">
                                                                &#xe65b;
                                                            </a>
                                                            <a
                                                                href={`${githubRawBase}/${currentBranch}/${sourceFilePath}`}
                                                                target="_blank"
                                                                rel="noopener noreferrer"
                                                                is-="badge"
                                                                class="post-meta-raw"
                                                                title="View raw source"
                                                                aria-label="View raw source"
                                                                tabindex="0">
                                                                &#xf0224;
                                                            </a>
                                                        </span>
                                                    )}
                                                    <ShareButtons
                                                        title={
                                                            frontmatter.title
                                                        }
                                                        url={`https://samf.sh${Astro.url.pathname}`}
                                                    />
                                                </div>
                                            )}
                                        </div>
                                    )
                                })()
                            }
                            {
                                frontmatter.description && (
                                    <blockquote
                                        class="post-description"
                                        set:html={frontmatter.description.replace(
                                            /`([^`]+)`/g,
                                            '<code>$1</code>',
                                        )}
                                    />
                                )
                            }
                            <slot />
                            {
                                isCitable && (
                                    <CiteThis
                                        title={frontmatter.title}
                                        date={citationDate!}
                                        pathname={currentPath}
                                        kind={
                                            (isTalk
                                                ? 'talk'
                                                : 'post') as CitationKind
                                        }
                                        citationKey={citationKey}
                                    />
                                )
                            }
                            {
                                relatedPosts.length > 0 && (
                                    <aside style="margin-top: 2lh; border-top: 1px solid var(--foreground2); padding-top: 1lh;">
                                        <h3>Related posts</h3>
                                        <ul style="list-style: none; padding: 0;">
                                            {relatedPosts.map((post) => (
                                                <li>
                                                    <a href={post.href}>
                                                        {post.title}
                                                    </a>
                                                    <span style="opacity: 0.6; font-size: 0.85em;">
                                                        {' '}
                                                        —{' '}
                                                        {post.date.toLocaleDateString(
                                                            'en-US',
                                                            {
                                                                year: 'numeric',
                                                                month: 'short',
                                                                day: 'numeric',
                                                            },
                                                        )}
                                                    </span>
                                                </li>
                                            ))}
                                        </ul>
                                    </aside>
                                )
                            }
                            <div id="doc-pagination">
                                {
                                    prevDoc && (
                                        <a
                                            href={`/${prevDoc.id}`}
                                            class="prev"
                                            box-="square"
                                            shear-="top"
                                            tabindex="0">
                                            <div is-="typography-block">
                                                <span
                                                    is-="badge"
                                                    variant-="background1">
                                                    <row gap-="1">
                                                        <span>←</span>
                                                        <span>
                                                            [<b>b</b>]ack
                                                        </span>
                                                    </row>
                                                </span>
                                            </div>
                                            <span pad-="1 0">
                                                {prevDoc.id.split('/')[0]}/
                                                {prevDoc.data.title}
                                            </span>
                                        </a>
                                    )
                                }
                                {
                                    nextDoc && (
                                        <a
                                            href={`/${nextDoc.id}`}
                                            class="next"
                                            box-="square"
                                            shear-="top"
                                            tabindex="0">
                                            <row
                                                align-="start end"
                                                is-="typography-block">
                                                <span
                                                    is-="badge"
                                                    variant-="background1">
                                                    <row gap-="1">
                                                        <span>
                                                            [<b>n</b>]ext
                                                        </span>
                                                        <span>→</span>
                                                    </row>
                                                </span>
                                            </row>
                                            <span pad-="1 0">
                                                {nextDoc.id.split('/')[0]}/
                                                {nextDoc.data.title}
                                            </span>
                                        </a>
                                    )
                                }
                            </div>
                        </main>
                    </div>
                </row>
            </article>
        </row>
        <div id="vim-statusline">
            <!-- <span class="vsl-vim-icon">&#xe62b; </span> -->
            <a
                class="vsl-site"
                href={githubBase}
                target="_blank"
                title="Source repository on GitHub">
                &#xea84; samf.sh
            </a>
            {
                /* Path as clickable breadcrumbs. Each segment links to its
               cumulative SITE path when that page exists (see `breadcrumbs`
               in the frontmatter); segments with no route render as plain
               text. The leading "/" per crumb keeps it reading as one
               contiguous path. Root ("/") shows a single non-link slash. */
            }
            <span class="vsl-file">
                {
                    breadcrumbs.length === 0 ? (
                        <span class="vsl-crumb">/</span>
                    ) : (
                        breadcrumbs.map(({ seg, href }) => (
                            <>
                                <span class="vsl-crumb-sep">/</span>
                                {href ? (
                                    <a
                                        class="vsl-crumb"
                                        href={href}
                                        title={`Go to ${href}`}>
                                        {seg}
                                    </a>
                                ) : (
                                    <span class="vsl-crumb">{seg}</span>
                                )}
                            </>
                        ))
                    )
                }
            </span>
            <span class="vsl-spacer"></span>
            <span class="vsl-keys">
                <span id="vsl-last-key"></span>
            </span>
            <span class="vsl-clock">
                <span id="vsl-clock-date"></span>
                <span class="vsl-clock-sep">·</span>
                <span id="vsl-clock-time"></span>
            </span>
            <span class="vsl-pos">Top</span>
            <span class="vsl-loc">1:1</span>
        </div>
        <div id="mobile-nav">
            <button size-="small" variant-="background1" id="menu-button">
                &#xeb86; Menu
            </button>
            <button size-="small" id="docs-button">&#xf15b; Docs</button>
        </div>
    </column>
</Layout>

<!-- Vim Navigation -->
<script>
    import {
        applyVimNavigation,
        isUserTyping,
        vimFocusElement,
    } from '@/utils/vim'
    /* Side-effect import. The runtime no-ops if no .scaling-chart-mount
       elements exist; on pages that DO mount a chart, the uPlot library
       is dynamically imported from inside that runtime so other doc
       pages pay nothing beyond the small selector check. */
    import '@/utils/scaling-chart'

    const mainItemQuery = '[tabindex="0"], a[href], summary'
    const queryString = `#main-content ${mainItemQuery}`
    const navbarQueryString =
        'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'

    const vimTabbableElements: NodeListOf<HTMLElement> =
        document.querySelectorAll(queryString)

    let currentElement: HTMLElement | null = null

    const findFirstFocusableElement = () =>
        Array.from(vimTabbableElements).find((el) => {
            const rect = el.getBoundingClientRect()

            return rect.top >= 0 && rect.bottom <= window.innerHeight
        })

    const mainContent = document.getElementById('main-content') as HTMLElement

    // The element that actually scrolls the document body. Normally this is
    // #main-content (overflow-y:auto). BUT in reader view the figure-breakout
    // CSS sets overflow-x:visible on #main-content, which forces overflow-y to
    // compute to visible too, so #main-content stops scrolling and its parent
    // #scroll-container becomes the scroller. Anything that reads scrollTop /
    // calls scrollBy / listens for 'scroll' must target whichever element is
    // really scrolling, or it silently no-ops in reader view (the d/u keybind
    // + scrollspy regression). Resolve it live each call so it tracks the mode.
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    ;(window as any).getDocScroller = () => {
        const sc = document.getElementById('scroll-container')
        const mc = document.getElementById('main-content')
        // Prefer whichever has real vertical overflow AND a non-visible
        // overflow-y (i.e. is an actual scroll box).
        for (const el of [mc, sc]) {
            if (!el) continue
            const oy = getComputedStyle(el).overflowY
            if (
                (oy === 'auto' || oy === 'scroll') &&
                el.scrollHeight > el.clientHeight + 2
            )
                return el
        }
        return mc || sc
    }

    const navbar = document.getElementById('top-navbar') as HTMLElement | null
    const sidebar = document.getElementById('sidebar') as HTMLElement | null
    const tocSidebar = document.getElementById(
        'toc-sidebar',
    ) as HTMLElement | null
    // Navbar was removed; the equivalent action surface is the row of
    // sidebar action buttons (Home / Theme / GitHub / RSS / Search) at the
    // top of the left sidebar. Keep the helper name so existing call sites
    // and keybind labels still work.
    const getNavbarTarget = () => {
        const actions = document.getElementById('sidebar-actions')
        return actions?.querySelector(
            'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
        )
    }
    const getSidebarTarget = () =>
        sidebar?.querySelector('a.active') ||
        sidebar?.querySelector('details summary') ||
        sidebar?.querySelector('a')
    const getTocTarget = () =>
        tocSidebar?.querySelector('a.active') || tocSidebar?.querySelector('a')

    const isFocusableElement = (element: Element) =>
        element.matches(
            'a[href], button, input, textarea, select, summary, [tabindex]:not([tabindex="-1"])',
        )

    const isVimVisible = (candidate: HTMLElement) => {
        if (candidate.hidden) return false

        const closedDetails = candidate.closest('details:not([open])')
        if (closedDetails instanceof HTMLDetailsElement) {
            const summary = closedDetails.querySelector('summary')

            if (
                !(summary instanceof HTMLElement) ||
                (summary !== candidate && !summary.contains(candidate))
            ) {
                return false
            }
        }

        const style = window.getComputedStyle(candidate)
        if (style.display === 'none' || style.visibility === 'hidden') {
            return false
        }

        return candidate.getClientRects().length > 0
    }

    const getVisibleMainElements = () =>
        Array.from(
            mainContent.querySelectorAll(
                mainItemQuery,
            ) as NodeListOf<HTMLElement>,
        ).filter(isVimVisible)

    const getNavbarElements = () =>
        navbar
            ? Array.from(
                  navbar.querySelectorAll(
                      navbarQueryString,
                  ) as NodeListOf<HTMLElement>,
              )
            : []

    const isLastNavbarElement = (activeElement: HTMLElement) => {
        const visibleNavbarElements = getNavbarElements().filter(isVimVisible)
        return (
            visibleNavbarElements.length > 0 &&
            activeElement === visibleNavbarElements.at(-1)
        )
    }

    const isPlainPrevKey = (event: KeyboardEvent) =>
        (event.key === 'k' || event.key === 'ArrowUp') &&
        !event.ctrlKey &&
        !event.metaKey &&
        !event.altKey

    const isPlainNextKey = (event: KeyboardEvent) =>
        (event.key === 'j' || event.key === 'ArrowDown') &&
        !event.ctrlKey &&
        !event.metaKey &&
        !event.altKey

    const applyMainContentTabIndex = () => {
        // List containers are navigated via their <li> children,
        // so skip them to avoid a parent-child focus trap.
        const isListContainer = (el: Element) =>
            el.tagName === 'UL' || el.tagName === 'OL'

        // Code blocks are navigated via their individual span.line children,
        // so skip the <pre> wrapper and make each line focusable instead.
        const isCodeBlock = (el: Element) =>
            el.tagName === 'PRE' && el.classList.contains('astro-code')

        // Collapsible heading wrappers — don't make the <details> itself
        // focusable, but recurse into its children (skip the <summary>
        // since it's already focusable).
        const isHeadingCollapse = (el: Element) =>
            el.tagName === 'DETAILS' &&
            el.classList.contains('heading-collapse')

        const processChildren = (container: Element) => {
            Array.from(container.children).forEach((child) => {
                if (!(child instanceof HTMLElement)) return
                if (child.tagName === 'SUMMARY') return
                if (isFocusableElement(child)) return
                if (isListContainer(child)) return
                if (isHeadingCollapse(child)) {
                    processChildren(child)
                    return
                }
                if (isCodeBlock(child)) {
                    child.removeAttribute('tabindex')
                    child.querySelectorAll('span.line').forEach((line) => {
                        if (line instanceof HTMLElement) {
                            line.setAttribute('tabindex', '0')
                        }
                    })
                    return
                }
                if (child.hasAttribute('tabindex')) return
                child.setAttribute('tabindex', '0')
            })
        }

        processChildren(mainContent)

        const listItems = Array.from(mainContent.querySelectorAll('li'))
        listItems.forEach((item) => {
            if (!(item instanceof HTMLElement)) return
            if (isFocusableElement(item)) return
            if (item.hasAttribute('tabindex')) return
            item.setAttribute('tabindex', '0')
        })
    }

    applyMainContentTabIndex()

    // Re-apply after collapsible headings restructure the DOM
    window.addEventListener('headings-collapsed', applyMainContentTabIndex)

    mainContent.addEventListener(
        'keydown',
        (e) => {
            if (e.defaultPrevented || isUserTyping() || !isPlainPrevKey(e)) {
                return
            }

            const activeElement = document.activeElement
            if (!(activeElement instanceof HTMLElement)) return
            if (!mainContent.contains(activeElement)) return

            const visibleMainElements = getVisibleMainElements()
            if (visibleMainElements.length === 0) return
            if (activeElement !== visibleMainElements[0]) return

            const navbarTarget = getNavbarTarget()
            if (!(navbarTarget instanceof HTMLElement)) return

            e.preventDefault()
            e.stopPropagation()
            vimFocusElement(navbarTarget)
        },
        true,
    )

    navbar?.addEventListener(
        'keydown',
        (e) => {
            if (e.defaultPrevented || isUserTyping() || !isPlainNextKey(e)) {
                return
            }

            const activeElement = document.activeElement
            if (!(activeElement instanceof HTMLElement)) return
            if (!navbar.contains(activeElement)) return

            if (!isLastNavbarElement(activeElement)) return

            const elementToFocus =
                getVisibleMainElements()[0] ??
                findFirstFocusableElement() ??
                currentElement ??
                null

            if (!(elementToFocus instanceof HTMLElement)) return

            e.preventDefault()
            e.stopPropagation()
            vimFocusElement(elementToFocus)
        },
        true,
    )

    // Shared via window so the sidebar-toggle script can access z-chord state
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    const w = window as any
    w.__pendingZAt = 0
    w.__keyZSpans = document.querySelectorAll(
        '#sidebar-toggle .key-z, #toc-toggle .key-z',
    )
    w.__setKeyActive = (el: Element | null, active: boolean) => {
        if (!el) return
        if (active) {
            el.setAttribute('data-active', 'true')
        } else {
            el.removeAttribute('data-active')
        }
    }

    window.addEventListener('keydown', (e) => {
        if (e.defaultPrevented) return

        const hasOpenDialog =
            document.querySelector('dialog[open]') instanceof HTMLDialogElement
        if (hasOpenDialog) return

        // Don't navigate if the user is typing
        if (isUserTyping()) {
            return
        }

        // Bootstrap focus into main content when j/k is pressed with nothing focused
        const activeElement = document.activeElement
        const isUnfocused =
            !activeElement ||
            activeElement === document.body ||
            activeElement === document.documentElement

        if (
            isUnfocused &&
            !e.ctrlKey &&
            !e.metaKey &&
            !e.altKey &&
            !e.shiftKey
        ) {
            if (e.key === 'j' || e.key === 'ArrowDown') {
                e.preventDefault()
                const firstEl =
                    getVisibleMainElements()[0] ?? findFirstFocusableElement()
                if (firstEl) vimFocusElement(firstEl)
                return
            }
            if (e.key === 'k' || e.key === 'ArrowUp') {
                e.preventDefault()
                const elements = getVisibleMainElements()
                const lastEl = elements[elements.length - 1]
                if (lastEl) vimFocusElement(lastEl)
                return
            }
        }

        // ] / [ — jump to and focus next / previous heading
        if (
            (e.key === ']' || e.key === '[') &&
            !e.ctrlKey &&
            !e.metaKey &&
            !e.altKey &&
            !e.shiftKey
        ) {
            e.preventDefault()
            const scroller = document.getElementById('scroll-container')
            if (!scroller) return

            const headings = Array.from(
                document.querySelectorAll(
                    '#main-content h1[id], #main-content h2[id], #main-content h3[id], #main-content h4[id], #main-content h5[id], #main-content h6[id]',
                ),
            ).map((h) => {
                // If heading is inside a summary (collapsible), target the summary
                const summary = h.closest('summary')
                return (summary ?? h) as HTMLElement
            })
            if (headings.length === 0) return

            const scrollerTop = scroller.getBoundingClientRect().top
            const positions = headings.map(
                (h) => h.getBoundingClientRect().top - scrollerTop,
            )

            const focused = document.activeElement as HTMLElement | null
            const focusRect = focused?.getBoundingClientRect()

            if (e.key === ']') {
                // Find the first heading below the focused element's bottom
                const threshold = focusRect ? focusRect.bottom - scrollerTop : 2
                const idx = positions.findIndex((p) => p > threshold)
                if (idx !== -1) {
                    scroller.scrollTop += positions[idx]
                    headings[idx].focus({ preventScroll: true })
                }
            } else {
                // Find the last heading above the focused element's top
                const threshold = focusRect
                    ? focusRect.top - scrollerTop
                    : scroller.clientHeight
                for (let i = positions.length - 1; i >= 0; i--) {
                    if (positions[i] < threshold - 2) {
                        scroller.scrollTop += positions[i]
                        headings[i].focus({ preventScroll: true })
                        break
                    }
                }
            }
            return
        }

        // } / { — jump to next / previous top-level block
        if (
            (e.key === '}' || e.key === '{') &&
            !e.ctrlKey &&
            !e.metaKey &&
            !e.altKey
        ) {
            e.preventDefault()
            const active = document.activeElement as HTMLElement | null
            if (!active || !mainContent.contains(active)) return

            // Walk up to the direct child of #main-content
            let ancestor: HTMLElement = active
            while (
                ancestor.parentElement &&
                ancestor.parentElement !== mainContent
            ) {
                ancestor = ancestor.parentElement as HTMLElement
            }

            const children = Array.from(mainContent.children) as HTMLElement[]
            const idx = children.indexOf(ancestor)
            if (idx === -1) return

            if (e.key === '}') {
                for (let i = idx + 1; i < children.length; i++) {
                    const child = children[i]
                    if (child.matches(mainItemQuery)) {
                        vimFocusElement(child)
                        return
                    }
                    const desc = child.querySelector(
                        mainItemQuery,
                    ) as HTMLElement | null
                    if (desc) {
                        vimFocusElement(desc)
                        return
                    }
                }
            } else {
                for (let i = idx - 1; i >= 0; i--) {
                    const child = children[i]
                    if (child.matches(mainItemQuery)) {
                        vimFocusElement(child)
                        return
                    }
                    const desc = child.querySelector(
                        mainItemQuery,
                    ) as HTMLElement | null
                    if (desc) {
                        vimFocusElement(desc)
                        return
                    }
                }
            }
            return
        }

        // ctrl-o -> "navigate out"
        if (e.key === 'o' && e.ctrlKey) {
            e.preventDefault()
            window.history.back()
        }

        // ctrl-i -> "navigate in"
        if (e.key === 'i' && e.ctrlKey) {
            e.preventDefault()
            window.history.forward()
        }

        // d / u (or ctrl-d / ctrl-u) — half-page scroll with focus follow.
        // Plain d/u matches less(1) and the vim default; ctrl-d/ctrl-u is
        // mostly intercepted by the browser (bookmark / address-bar focus)
        // but kept for muscle memory when it makes it through. Smooth-scroll
        // a half page; don't steal focus mid-animation (vimFocusElement
        // calls .focus() which forces an instant jump and cancels the smooth
        // scroll). Focus the first newly-visible element after the animation
        // settles instead.
        if (
            (e.key === 'd' || e.key === 'u') &&
            !e.metaKey &&
            !e.altKey &&
            !e.shiftKey
        ) {
            e.preventDefault()
            // Use the live scroller (reader view scrolls #scroll-container,
            // normal view scrolls #main-content).
            // eslint-disable-next-line @typescript-eslint/no-explicit-any
            const scroller = (window as any).getDocScroller?.() ?? mainContent
            if (!scroller) return
            const halfPage = scroller.clientHeight / 2
            const reduceMotion = window.matchMedia(
                '(prefers-reduced-motion: reduce)',
            ).matches
            scroller.scrollBy({
                top: e.key === 'd' ? halfPage : -halfPage,
                behavior: reduceMotion ? 'auto' : 'smooth',
            })
            // No focus-follow here: calling .focus() mid-animation scrolls the
            // target back into view and cancels the smooth scroll (and made
            // rapid u after d jump the wrong way). d/u is pure viewport
            // scrolling; j/k remain for element-by-element focus navigation.
            return
        }

        // Esc — exit reader view first if active, else unfocus.
        if (
            e.key === 'Escape' &&
            !e.ctrlKey &&
            !e.metaKey &&
            !e.altKey &&
            !e.shiftKey
        ) {
            if (document.documentElement.hasAttribute('data-reader')) {
                e.preventDefault()
                // eslint-disable-next-line @typescript-eslint/no-explicit-any
                ;(window as any).toggleReader(false)
                return
            }
            const active = document.activeElement
            if (
                active instanceof HTMLElement &&
                active !== document.body &&
                active !== document.documentElement
            ) {
                e.preventDefault()
                active.blur()
                return
            }
        }

        // Skip all plain keys when z-chord is pending — the sidebar-toggle script handles it
        {
            // eslint-disable-next-line @typescript-eslint/no-explicit-any
            const pz = (window as any).__pendingZAt
            if (
                pz &&
                Date.now() - pz <= 700 &&
                !e.ctrlKey &&
                !e.metaKey &&
                !e.altKey &&
                !e.shiftKey
            ) {
                return
            }
        }

        // Shift+H/J/K/L region-focus bindings removed alongside the Ctrl
        // equivalents: shifted letters are awkward to reach, the TOC target
        // no longer exists, and the z-chords cover the same moves. Plain
        // h / l (below) still hop between sidebar and main.

        if (e.key === 'h' && !e.ctrlKey && !e.metaKey && !e.altKey) {
            const activeElement = document.activeElement

            if (activeElement && mainContent.contains(activeElement)) {
                e.preventDefault()
                const target = getSidebarTarget()
                if (target instanceof HTMLElement) {
                    vimFocusElement(target)
                }
                return
            }

            if (activeElement && tocSidebar?.contains(activeElement)) {
                e.preventDefault()
                const elementToFocus =
                    currentElement ?? findFirstFocusableElement() ?? null

                if (elementToFocus) {
                    vimFocusElement(elementToFocus)
                }
                return
            }
        }

        if (e.key === 'l' && !e.ctrlKey && !e.metaKey && !e.altKey) {
            const activeElement = document.activeElement

            if (activeElement && sidebar?.contains(activeElement)) {
                e.preventDefault()
                const elementToFocus =
                    currentElement ?? findFirstFocusableElement() ?? null

                if (elementToFocus) {
                    vimFocusElement(elementToFocus)
                }
                return
            }

            if (activeElement && mainContent.contains(activeElement)) {
                const target = getTocTarget()
                if (target instanceof HTMLElement) {
                    e.preventDefault()
                    vimFocusElement(target)
                }
            }
        }

        const nextHref = document.querySelector('.next')?.getAttribute('href')
        const prevHref = document.querySelector('.prev')?.getAttribute('href')

        if (
            e.key === 'n' &&
            !e.ctrlKey &&
            !e.metaKey &&
            !e.altKey &&
            nextHref
        ) {
            e.preventDefault()
            window.location.href = nextHref
        }

        if (
            e.key === 'b' &&
            !e.ctrlKey &&
            !e.metaKey &&
            !e.altKey &&
            prevHref
        ) {
            e.preventDefault()
            window.location.href = prevHref
        }
    })

    // Make each line inside a code block individually navigable so
    // j/k step through lines instead of skipping the whole block. The
    // pre itself stops being a vim target (its tabindex is removed)
    // because focusing the pre would otherwise compete with focusing
    // its first line.
    mainContent
        .querySelectorAll<HTMLPreElement>('pre[tabindex="0"]')
        .forEach((pre) => {
            const lines = pre.querySelectorAll<HTMLElement>('.line')
            if (lines.length === 0) return
            pre.removeAttribute('tabindex')
            lines.forEach((line) => line.setAttribute('tabindex', '0'))
        })

    // Same idea for tables: hand the tabindex from the table down to each
    // row so j/k steps through rows individually.
    mainContent
        .querySelectorAll<HTMLTableElement>('table[tabindex="0"]')
        .forEach((table) => {
            const rows = table.querySelectorAll<HTMLElement>('tr')
            if (rows.length === 0) return
            table.removeAttribute('tabindex')
            rows.forEach((row) => row.setAttribute('tabindex', '0'))
        })

    applyVimNavigation(mainContent, queryString, (element) => {
        currentElement = element
    })

    if (navbar) {
        applyVimNavigation(navbar, navbarQueryString)
    }

    if (tocSidebar) {
        applyVimNavigation(tocSidebar, 'a[href]')
    }
</script>

<!-- Heading Anchor Links -->
<script>
    const headingContainer = document.getElementById('main-content')

    if (headingContainer) {
        const headingNodes = headingContainer.querySelectorAll(
            'h1[id], h2[id], h3[id], h4[id], h5[id], h6[id]',
        )

        headingNodes.forEach((heading) => {
            if (!(heading instanceof HTMLElement)) return
            if (heading.querySelector(':scope > a.heading-anchor')) return

            const slug = heading.id
            if (!slug) return

            const level = parseInt(heading.tagName[1], 10)
            const anchor = document.createElement('a')
            anchor.className = 'heading-anchor'
            anchor.href = `#${slug}`
            anchor.setAttribute(
                'aria-label',
                `Link to section ${heading.textContent ?? ''}`,
            )
            anchor.textContent = '#'.repeat(level)
            anchor.style.marginInlineEnd = '1ch'
            heading.prepend(anchor)

            /* Click the prefix `##`/`###`/... to both navigate to the
               section (default <a href="#slug"> behavior) AND copy the
               canonical URL to the clipboard. */
            anchor.addEventListener('click', () => {
                const url = `${location.origin}${location.pathname}#${slug}`
                navigator.clipboard?.writeText(url).catch(() => {})
            })
        })
    }
</script>

<!-- TOC Active Heading -->
<script>
    const scrollContainer = document.getElementById(
        'scroll-container',
    ) as HTMLElement | null
    // The TOC now lives in the left sidebar as tree children under the active
    // page leaf (cloned from #sidebar-toc-template by SidebarFileTree's
    // script). The links carry data-heading-slug, so the scrollspy works the
    // same — it just queries the sidebar location instead of the old
    // #toc-list. The script may run before the sidebar finishes cloning, so
    // re-query lazily inside the sync if the first pass found nothing.
    let tocLinks = Array.from(
        document.querySelectorAll('#sidebar .sidebar-toc a[data-heading-slug]'),
    ) as HTMLAnchorElement[]

    if (scrollContainer) {
        const buildHeadingElements = () =>
            tocLinks
                .map((link) => {
                    const slug = link.dataset.headingSlug
                    if (!slug) return null
                    return document.getElementById(slug)
                })
                .filter(
                    (element): element is HTMLElement =>
                        element instanceof HTMLElement,
                )
        let headingElements = buildHeadingElements()

        const setActiveTocLink = (activeId: string) => {
            // Find which H2 section owns the active heading: if the active link
            // is itself a depth-2, that's the section; otherwise walk backwards
            // to the nearest preceding depth-2.
            let activeSectionIdx = -1
            const activeIdx = tocLinks.findIndex(
                (l) => l.dataset.headingSlug === activeId,
            )
            if (activeIdx !== -1) {
                for (let i = activeIdx; i >= 0; i--) {
                    if (tocLinks[i].dataset.depth === '2') {
                        activeSectionIdx = i
                        break
                    }
                }
            }

            // Toggle .active on the current heading, and .toc-section-open on
            // every depth-3+ subheading belonging to the active H2 section so
            // only that section's subheadings are revealed.
            let currentSectionIdx = -1
            tocLinks.forEach((link, i) => {
                if (link.dataset.depth === '2') currentSectionIdx = i
                link.classList.toggle(
                    'active',
                    link.dataset.headingSlug === activeId,
                )
                if (link.dataset.depth !== '2') {
                    link.classList.toggle(
                        'toc-section-open',
                        currentSectionIdx === activeSectionIdx &&
                            activeSectionIdx !== -1,
                    )
                }
            })
        }

        const syncActiveHeading = () => {
            // The sidebar clones the heading links from a <template> in its own
            // script; if that hadn't run when this listener was wired up,
            // re-query now so the scrollspy picks them up.
            if (tocLinks.length === 0) {
                tocLinks = Array.from(
                    document.querySelectorAll(
                        '#sidebar .sidebar-toc a[data-heading-slug]',
                    ),
                ) as HTMLAnchorElement[]
                if (tocLinks.length > 0)
                    headingElements = buildHeadingElements()
            }
            if (headingElements.length === 0) return

            const containerTop = scrollContainer.getBoundingClientRect().top
            let activeHeading = headingElements[0]

            for (const heading of headingElements) {
                const top = heading.getBoundingClientRect().top - containerTop
                if (top <= 24) {
                    activeHeading = heading
                } else {
                    break
                }
            }

            if (activeHeading) {
                setActiveTocLink(activeHeading.id)
                const activeLink = document.querySelector(
                    '#sidebar .sidebar-toc a.active',
                ) as HTMLAnchorElement | null
                // Keep the active TOC link in view WITHIN the sidebar's own
                // scroll box — but only when the sidebar actually is an
                // independent scroller (desktop). At <=768px the layout stacks
                // and the whole document scrolls (#main-content goes
                // overflow:visible / static), so the sidebar sits in normal
                // flow; calling scrollIntoView there walks up to the document
                // and yanks the page back as you scroll. Guard on the mobile
                // layout and skip the auto-scroll entirely.
                const mc = document.getElementById('main-content')
                const isStacked =
                    !mc || getComputedStyle(mc).overflowY === 'visible'
                if (activeLink && !isStacked) {
                    activeLink.scrollIntoView({ block: 'nearest' })
                }

                // Update the article border label with the active heading
                const titleEl = document.querySelector(
                    '#doc-article > header h1',
                ) as HTMLElement | null
                const mainEl =
                    // eslint-disable-next-line @typescript-eslint/no-explicit-any
                    (window as any).getDocScroller?.() ??
                    document.getElementById('main-content')
                if (titleEl && mainEl) {
                    if (titleEl.dataset.originalHtml === undefined) {
                        titleEl.dataset.originalHtml = titleEl.innerHTML
                    }

                    // Find the nearest heading (walk up through
                    // collapsible wrappers to find the actual heading)
                    let target: HTMLElement | null = null
                    if (/^H[1-6]$/.test(activeHeading.tagName)) {
                        target = activeHeading
                    } else {
                        const collapse =
                            activeHeading.closest?.('.heading-collapse')
                        target = collapse?.querySelector(
                            'summary :is(h1,h2,h3,h4,h5,h6)',
                        ) as HTMLElement | null
                    }

                    // Show in border when we've scrolled past the top
                    const hasScrolled = mainEl.scrollTop > 50

                    if (hasScrolled && target) {
                        const level = parseInt(target.tagName[1])
                        const prefix = '#'.repeat(level)
                        const colorVar = `var(--h${level})`
                        const clone = target.cloneNode(true) as HTMLElement
                        clone.querySelector('.heading-anchor')?.remove()
                        const text = clone.textContent?.trim() ?? ''
                        if (text) {
                            titleEl.style.setProperty('--h1-prefix', 'none')
                            titleEl.style.color = colorVar
                            titleEl.innerHTML = `<span class="heading-anchor" style="color: ${colorVar}; margin-inline-end: 1ch;">${prefix}</span>${text}`
                        }
                    } else {
                        titleEl.style.removeProperty('--h1-prefix')
                        titleEl.style.removeProperty('color')
                        titleEl.innerHTML = titleEl.dataset.originalHtml
                    }
                }
            }
        }

        // Use capture to intercept scroll events from any ancestor
        // (the actual scroller may be #scroll-container, article, or body)
        document.addEventListener('scroll', syncActiveHeading, {
            passive: true,
            capture: true,
        })
        window.addEventListener('hashchange', syncActiveHeading)
        syncActiveHeading()
    }
</script>

<!-- Sidebar Toggle -->
<script>
    import { isUserTyping, vimFocusElement } from '@/utils/vim'

    const sidebarToggle = document.getElementById(
        'sidebar-toggle',
    ) as HTMLButtonElement | null
    const tocToggle = document.getElementById(
        'toc-toggle',
    ) as HTMLButtonElement | null
    const sidebarContainer = document.getElementById(
        'sidebar-container',
    ) as HTMLDivElement | null
    const tocContainer = document.getElementById(
        'toc-container',
    ) as HTMLDivElement | null
    const navbar = document.getElementById('top-navbar') as HTMLElement | null
    const mainContent = document.getElementById(
        'main-content',
    ) as HTMLElement | null

    const setSidebarToggleLabel = (collapsed: boolean) => {
        if (!sidebarToggle) return

        // The toggle now lives in the top action row as an icon button:
        // collapse-to-left-edge glyph when open, hamburger when collapsed.
        // (Was a bottom bar with a `‹z[h]` text label.)
        sidebarToggle.innerHTML = collapsed ? '' : ''

        sidebarToggle.setAttribute(
            'aria-label',
            collapsed
                ? 'Expand left sidebar (zh)'
                : 'Collapse left sidebar (zh)',
        )
        sidebarToggle.setAttribute('aria-expanded', String(!collapsed))
    }

    const setTocToggleLabel = (collapsed: boolean) => {
        if (!tocToggle) return

        const arrow = collapsed ? '&darr;' : '&rarr;'
        tocToggle.innerHTML = `<span class="key-z">z</span>[<span class="key-l">l</span>]${arrow}`
        tocToggle.setAttribute(
            'aria-label',
            collapsed
                ? 'Expand right sidebar (zl)'
                : 'Collapse right sidebar (zl)',
        )
    }

    const refreshKeySpans = () => {
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        ;(window as any).__keyZSpans = document.querySelectorAll(
            '#sidebar-toggle .key-z, #toc-toggle .key-z',
        )
    }

    const setSidebarCollapsed = (collapsed: boolean) => {
        if (!sidebarContainer || !sidebarToggle) return

        sidebarContainer.classList.toggle('collapsed', collapsed)
        sidebarToggle.setAttribute('aria-expanded', String(!collapsed))
        localStorage.setItem('sidebar-collapsed', String(collapsed))
        setSidebarToggleLabel(collapsed)
        refreshKeySpans()
    }

    const setTocCollapsed = (collapsed: boolean) => {
        if (!tocContainer || !tocToggle) return

        tocContainer.classList.toggle('collapsed', collapsed)
        tocToggle.setAttribute('aria-expanded', String(!collapsed))
        localStorage.setItem('toc-collapsed', String(collapsed))
        setTocToggleLabel(collapsed)
        refreshKeySpans()
    }

    const isElementVisible = (element: HTMLElement) => {
        if (element.hidden) return false

        const style = window.getComputedStyle(element)
        if (style.display === 'none' || style.visibility === 'hidden') {
            return false
        }

        return element.getClientRects().length > 0
    }

    const getNavbarFocusTarget = () => {
        const actions = document.getElementById('sidebar-actions')
        return actions?.querySelector(
            'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
        )
    }

    const getMainFocusTarget = () => {
        if (!mainContent) return null

        const activeElement = document.activeElement
        if (
            activeElement instanceof HTMLElement &&
            mainContent.contains(activeElement)
        ) {
            return activeElement
        }

        const candidates = Array.from(
            mainContent.querySelectorAll(
                '[tabindex="0"], a[href], summary',
            ) as NodeListOf<HTMLElement>,
        )

        return candidates.find(isElementVisible) ?? null
    }

    if (sidebarToggle && sidebarContainer) {
        const isCollapsed = localStorage.getItem('sidebar-collapsed') === 'true'
        setSidebarCollapsed(isCollapsed)

        sidebarToggle.addEventListener('click', () => {
            setSidebarCollapsed(
                !sidebarContainer.classList.contains('collapsed'),
            )
        })
    }

    if (tocToggle && tocContainer) {
        const isCollapsed = localStorage.getItem('toc-collapsed') !== 'false'
        setTocCollapsed(isCollapsed)

        tocToggle.addEventListener('click', () => {
            setTocCollapsed(!tocContainer.classList.contains('collapsed'))
        })
    }

    if (sidebarContainer || tocContainer || navbar || mainContent) {
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const w = window as any

        window.addEventListener('keydown', (e) => {
            if (isUserTyping()) return

            const hasOpenDialog =
                document.querySelector('dialog[open]') instanceof
                HTMLDialogElement
            if (hasOpenDialog) return

            // Shift+C / Shift+E: collapse / expand all <details> in main.
            // Handled here (before the chord branches) so it works regardless
            // of any pending z-chord state.
            if (
                e.shiftKey &&
                !e.ctrlKey &&
                !e.metaKey &&
                !e.altKey &&
                (e.key === 'C' || e.key === 'E')
            ) {
                const main = document.getElementById('main-content')
                if (!main) return
                e.preventDefault()
                const all = main.querySelectorAll('details')
                if (e.key === 'C') {
                    all.forEach((d) => ((d as HTMLDetailsElement).open = false))
                } else {
                    all.forEach((d) => ((d as HTMLDetailsElement).open = true))
                }
                console.log(
                    `[keybind] Shift+${e.key}: toggled ${all.length} <details>`,
                )
                return
            }

            const isPlainKey =
                !e.ctrlKey && !e.metaKey && !e.altKey && !e.shiftKey

            if (isPlainKey) {
                const now = Date.now()

                if (e.key === 'z') {
                    if (w.__pendingZAt && now - w.__pendingZAt <= 700) {
                        w.__pendingZAt = 0
                        w.__keyZSpans?.forEach((s: Element) =>
                            w.__setKeyActive?.(s, false),
                        )
                        return
                    }

                    w.__pendingZAt = now
                    w.__keyZSpans?.forEach((s: Element) =>
                        w.__setKeyActive?.(s, true),
                    )
                    setTimeout(() => {
                        if (
                            w.__pendingZAt &&
                            Date.now() - w.__pendingZAt >= 690
                        ) {
                            w.__pendingZAt = 0
                            w.__keyZSpans?.forEach((s: Element) =>
                                w.__setKeyActive?.(s, false),
                            )
                        }
                    }, 700)
                    return
                }

                if (e.key === '[' || e.key === ']') {
                    w.__pendingZAt = 0
                    return // handled by heading-jump listener
                }

                const hasPendingZChord =
                    w.__pendingZAt > 0 && now - w.__pendingZAt <= 700
                w.__pendingZAt = 0
                w.__keyZSpans?.forEach((s: Element) =>
                    w.__setKeyActive?.(s, false),
                )

                if (hasPendingZChord) {
                    if (e.key === 'h') {
                        e.preventDefault()
                        setSidebarCollapsed(
                            !sidebarContainer?.classList.contains('collapsed'),
                        )
                        return
                    }

                    if (e.key === 'l') {
                        e.preventDefault()
                        setTocCollapsed(
                            !tocContainer?.classList.contains('collapsed'),
                        )
                        return
                    }

                    if (e.key === 'j') {
                        e.preventDefault()
                        const mainTarget = getMainFocusTarget()
                        if (mainTarget instanceof HTMLElement) {
                            vimFocusElement(mainTarget)
                        }
                        return
                    }

                    if (e.key === 'k') {
                        e.preventDefault()
                        const navbarTarget = getNavbarFocusTarget()
                        if (navbarTarget instanceof HTMLElement) {
                            vimFocusElement(navbarTarget)
                        }
                        return
                    }

                    if (e.key === 'r') {
                        e.preventDefault()
                        // eslint-disable-next-line @typescript-eslint/no-explicit-any
                        ;(window as any).toggleReader()
                        return
                    }

                    if (e.key === 'M') {
                        e.preventDefault()
                        document
                            .querySelectorAll('#main-content details[open]')
                            .forEach((d) => {
                                ;(d as HTMLDetailsElement).open = false
                            })
                        return
                    }

                    if (e.key === 'R') {
                        e.preventDefault()
                        document
                            .querySelectorAll(
                                '#main-content details:not([open])',
                            )
                            .forEach((d) => {
                                ;(d as HTMLDetailsElement).open = true
                            })
                        return
                    }
                    return
                }
            } else {
                // Allow z-chord with Shift for zM/zR (collapse/expand all)
                if (
                    e.shiftKey &&
                    !e.ctrlKey &&
                    !e.metaKey &&
                    !e.altKey &&
                    w.__pendingZAt > 0 &&
                    Date.now() - w.__pendingZAt <= 700
                ) {
                    w.__pendingZAt = 0
                    w.__keyZSpans?.forEach((s: Element) =>
                        w.__setKeyActive?.(s, false),
                    )
                    if (e.key === 'M') {
                        e.preventDefault()
                        document
                            .querySelectorAll('#main-content details[open]')
                            .forEach((d) => {
                                ;(d as HTMLDetailsElement).open = false
                            })
                        return
                    }
                    if (e.key === 'R') {
                        e.preventDefault()
                        document
                            .querySelectorAll(
                                '#main-content details:not([open])',
                            )
                            .forEach((d) => {
                                ;(d as HTMLDetailsElement).open = true
                            })
                        return
                    }
                }
                w.__pendingZAt = 0
                w.__keyZSpans?.forEach((s: Element) =>
                    w.__setKeyActive?.(s, false),
                )
            }

            // Ctrl+H/J/K/L region-focus bindings removed: Ctrl+L is the
            // browser's address bar, Ctrl+H/J/K collide with editor and OS
            // shortcuts, and the TOC they targeted no longer exists. The
            // z-chords above (zh / zj / zk / zr) cover the same navigation.
        })
    }
</script>

<!-- Sidebar Resize -->
<script>
    const sidebarContainer = document.getElementById(
        'sidebar-container',
    ) as HTMLDivElement | null
    const sidebarResizer = document.getElementById(
        'sidebar-resizer',
    ) as HTMLDivElement | null

    if (sidebarContainer && sidebarResizer) {
        const setSidebarWidth = (widthPx: number) => {
            sidebarContainer.style.setProperty(
                '--sidebar-width',
                `${widthPx}px`,
            )
        }

        const getBounds = () => {
            const styles = window.getComputedStyle(sidebarContainer)
            const minWidth = parseFloat(styles.minWidth)
            const maxWidth = parseFloat(styles.maxWidth)
            return { minWidth, maxWidth }
        }

        const storedWidth = localStorage.getItem('sidebar-width')
        if (storedWidth) {
            const widthPx = Number(storedWidth)
            if (!Number.isNaN(widthPx)) {
                setSidebarWidth(widthPx)
            }
        }

        const onMouseMove = (event: MouseEvent) => {
            const { left } = sidebarContainer.getBoundingClientRect()
            const { minWidth, maxWidth } = getBounds()
            const rawWidth = event.clientX - left
            const nextWidth = Math.min(maxWidth, Math.max(minWidth, rawWidth))
            setSidebarWidth(nextWidth)
        }

        const onMouseUp = () => {
            sidebarResizer.classList.remove('dragging')
            const styles = window.getComputedStyle(sidebarContainer)
            const widthPx = parseFloat(styles.width)
            if (!Number.isNaN(widthPx)) {
                localStorage.setItem('sidebar-width', String(widthPx))
            }
            window.removeEventListener('mousemove', onMouseMove)
            window.removeEventListener('mouseup', onMouseUp)
        }

        sidebarResizer.addEventListener('mousedown', (event) => {
            if (sidebarContainer.classList.contains('collapsed')) {
                return
            }

            event.preventDefault()
            sidebarResizer.classList.add('dragging')
            window.addEventListener('mousemove', onMouseMove)
            window.addEventListener('mouseup', onMouseUp)
        })
    }
</script>

<!-- Mobile Navigation -->
<script>
    const menuButton = document.getElementById(
        'menu-button',
    ) as HTMLButtonElement
    const docsButton = document.getElementById(
        'docs-button',
    ) as HTMLButtonElement
    const tocButton = document.getElementById(
        'toc-button',
    ) as HTMLButtonElement | null
    const sidebarContainer = document.getElementById(
        'sidebar-container',
    ) as HTMLDivElement
    const tocContainer = document.getElementById(
        'toc-container',
    ) as HTMLElement | null
    const article = document.querySelector('article') as HTMLElement

    function setMobileActive(panel: 'menu' | 'docs' | 'toc') {
        sidebarContainer.classList.toggle('mobile-hidden', panel !== 'menu')
        article.classList.toggle('mobile-hidden', panel !== 'docs')
        tocContainer?.classList.toggle('mobile-hidden', panel !== 'toc')
        tocContainer?.classList.toggle('collapsed', panel !== 'toc')
        // Active button: remove the variant- attribute entirely (don't set
        // it to empty string — webtui treats those differently and the
        // active button ends up with extra width). Inactive buttons get
        // variant-="background1" for the dimmed look.
        const setVariant = (btn: HTMLButtonElement | null, active: boolean) => {
            if (!btn) return
            if (active) btn.removeAttribute('variant-')
            else btn.setAttribute('variant-', 'background1')
        }
        setVariant(menuButton, panel === 'menu')
        setVariant(docsButton, panel === 'docs')
        setVariant(tocButton, panel === 'toc')
    }

    menuButton.addEventListener('click', () => setMobileActive('menu'))
    docsButton.addEventListener('click', () => setMobileActive('docs'))
    tocButton?.addEventListener('click', () => setMobileActive('toc'))
</script>

<script>
    const progressBar = document.getElementById('scroll-progress')

    if (progressBar) {
        // Listen at document level (capture) so we catch scroll from whichever
        // element is the live scroller — #main-content normally, but
        // #scroll-container in reader view (see getDocScroller in the first
        // script block). Binding directly to #main-content silently stopped
        // updating the bar in reader view.
        const updateProgress = () => {
            const scroller =
                // eslint-disable-next-line @typescript-eslint/no-explicit-any
                (window as any).getDocScroller?.() ??
                document.getElementById('main-content')
            if (!scroller) return
            const scrollHeight = scroller.scrollHeight - scroller.clientHeight
            const progress =
                scrollHeight > 0
                    ? Math.min(scroller.scrollTop / scrollHeight, 1)
                    : 0
            progressBar.style.transform = `scaleX(${progress})`
        }
        document.addEventListener('scroll', updateProgress, {
            passive: true,
            capture: true,
        })
        updateProgress()
    }
</script>

<!-- Code block copy buttons -->
<script>
    const codeBlocks = document.querySelectorAll('pre.astro-code')
    for (const block of codeBlocks) {
        block.style.position = 'relative'

        const button = document.createElement('button')
        button.className = 'code-copy-btn'
        button.textContent = 'copy'
        let resetTimer: ReturnType<typeof setTimeout> | undefined
        button.addEventListener('click', async () => {
            const code = block.querySelector('code')
            if (!code) return
            let ok = true
            try {
                // Copy the code WITHOUT the line-number anchors. They are real
                // elements inside each line now, so innerText picks them up
                // and every copied block came out as "1# Kick the tires...".
                const clone = code.cloneNode(true) as HTMLElement
                for (const n of clone.querySelectorAll('.code-line-link')) {
                    n.remove()
                }
                await navigator.clipboard.writeText(clone.innerText)
                button.textContent = 'copied!'
            } catch {
                ok = false
                button.textContent = 'failed'
            }
            // The <pre> carries the state; global.css swaps the badge glyph
            // to a check / x and plays the pop keyframe off these classes.
            // Both are removed first so a rapid second click restarts the
            // animation instead of being swallowed (a class that is already
            // present doesn't re-trigger @keyframes).
            block.classList.remove('is-copied', 'is-copy-failed')
            void block.offsetWidth // force reflow so the re-add animates
            block.classList.add(ok ? 'is-copied' : 'is-copy-failed')
            clearTimeout(resetTimer)
            resetTimer = setTimeout(() => {
                button.textContent = 'copy'
                block.classList.remove('is-copied', 'is-copy-failed')
            }, 1200)
        })
        block.appendChild(button)
    }
</script>

<!-- Linkable code lines.

     Each line number is a real <a href="#b<n>-L<line>">. An earlier version
     hit-tested clicks against the ::before counter box instead, which worked
     but was not a link: the browser had no "Copy Link" to offer on
     right-click, and no middle-click, no hover URL in the status bar. A real
     anchor gets all of that for free.

     The counter therefore moves off `span.line::before` and onto the anchor,
     so the number is the link rather than sitting beside it.

     Anchors are #b<n>-L<line>: a page can carry 30 code blocks (the argo post
     does), so a bare #L12 would be ambiguous. Both indices are positional and
     will drift if a post is edited, which is the accepted cost of not hand
     -naming a thousand blocks. -->
<script>
    const lineBlocks = document.querySelectorAll('pre.astro-code')
    lineBlocks.forEach((block, blockIndex) => {
        const code = block.querySelector('code')
        if (!code) return
        // Unlabeled blocks (`text` / `plaintext`, shiki's fallback for a fence
        // with no language) get no gutter. These are ASCII diagrams, terminal
        // transcripts and log excerpts rather than source you would cite a
        // line of, and a number column breaks box-drawing alignment. Matches
        // global.css, which already drops the badge and border for these.
        const lang = block.dataset.language
        if (lang === 'text' || lang === 'plaintext') return
        const lines = code.querySelectorAll('span.line')
        if (!lines.length) return
        const blockId = 'b' + (blockIndex + 1)
        block.dataset.blockId = blockId
        // Size the gutter once per block, to its widest line number, so the
        // divider does not step right when the count crosses 9 -> 10.
        block.style.setProperty(
            '--line-number-width',
            String(lines.length).length + 'ch',
        )

        lines.forEach((line, i) => {
            const id = blockId + '-L' + (i + 1)
            line.id = id
            // Skip a line that already has one (script re-entry / view swap).
            if (line.querySelector(':scope > .code-line-link')) return
            const link = document.createElement('a')
            link.className = 'code-line-link'
            link.href = '#' + id
            link.textContent = String(i + 1)
            // The number is decorative for a screen reader walking the code;
            // the accessible name says what following it does.
            link.setAttribute('aria-label', 'Link to line ' + (i + 1))
            line.prepend(link)
        })
    })

    // Highlight the linked line. Runs for both an inbound link and our own
    // clicks, since clicking an <a href="#..."> fires hashchange.
    const markTargetLine = (scroll: boolean) => {
        for (const el of document.querySelectorAll('.is-line-linked')) {
            el.classList.remove('is-line-linked')
        }
        const id = location.hash.slice(1)
        if (!/^b\d+-L\d+$/.test(id)) return
        const line = document.getElementById(id)
        if (!line) return
        line.classList.add('is-line-linked')
        if (!scroll) return
        // Scroll the PAGE, not the block: <code> is itself a scroll container,
        // so scrollIntoView on the line centres it inside the block and leaves
        // the page wherever the browser's hash jump put it (~32px, under the
        // sticky header).
        const centre = () => {
            const scroller =
                document.getElementById('main-content') ??
                document.scrollingElement
            if (!scroller) return
            scroller.scrollBy({
                top:
                    line.getBoundingClientRect().top -
                    scroller.getBoundingClientRect().top -
                    scroller.clientHeight / 2,
            })
        }
        if (document.readyState === 'complete') centre()
        else window.addEventListener('load', centre, { once: true })
    }
    // Scroll on arrival only. On our own click the line is already on screen,
    // and yanking it to centre under the cursor is disorienting.
    markTargetLine(true)
    window.addEventListener('hashchange', () => markTargetLine(false))
</script>

<!-- Vim statusline scroll position + clock -->
<script>
    const posEl = document.querySelector('.vsl-pos')
    const locEl = document.querySelector('.vsl-loc')
    const clockDateEl = document.getElementById('vsl-clock-date')
    const clockTimeEl = document.getElementById('vsl-clock-time')

    if (posEl) {
        // Read the live scroller (reader view scrolls #scroll-container) so the
        // pos % / line indicator keeps updating in both modes; listen at
        // document level (capture) to catch whichever element fires 'scroll'.
        const update = () => {
            const scroller =
                // eslint-disable-next-line @typescript-eslint/no-explicit-any
                (window as any).getDocScroller?.() ??
                document.getElementById('main-content')
            if (!scroller) return
            const scrollTop = scroller.scrollTop
            const scrollHeight = scroller.scrollHeight - scroller.clientHeight
            if (scrollHeight <= 0) {
                posEl.textContent = 'All'
            } else {
                posEl.textContent =
                    Math.round((scrollTop / scrollHeight) * 100) + '%'
            }
            // Approximate line number from scroll position
            const totalLines = Math.ceil(scroller.scrollHeight / 24)
            const currentLine = Math.max(
                1,
                Math.ceil((scrollTop / scroller.scrollHeight) * totalLines),
            )
            if (locEl) locEl.textContent = `${currentLine}:1`
        }
        document.addEventListener('scroll', update, {
            passive: true,
            capture: true,
        })
        update()
    }

    // Live clock — date and time live in separate spans so a CSS
    // separator (·) can sit between them.
    if (clockDateEl && clockTimeEl) {
        const pad = (n: number) => String(n).padStart(2, '0')
        const tick = () => {
            const d = new Date()
            clockDateEl.textContent = `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`
            clockTimeEl.textContent = `${pad(d.getHours())}:${pad(d.getMinutes())}`
        }
        tick()
        setInterval(tick, 10_000)
    }

    // Last-key indicator in the statusline — show the last pressed
    // single-char key for ~2 seconds. Helps signal which key triggered
    // a navigation when the action isn't otherwise visible.
    const lastKeyEl = document.getElementById('vsl-last-key')
    let lastKeyTimer: ReturnType<typeof setTimeout> | null = null
    window.addEventListener('keydown', (e) => {
        if (lastKeyEl && e.key.length === 1) {
            lastKeyEl.textContent = e.key
            if (lastKeyTimer) clearTimeout(lastKeyTimer)
            lastKeyTimer = setTimeout(() => {
                lastKeyEl.textContent = ''
            }, 2000)
        }
    })
</script>

<!-- Collapsible headings: wrap h2-h6 sections in <details> -->
<script>
    const mainContent = document.getElementById('main-content')
    if (mainContent) {
        // Process each heading level top-down (h2 first, then h3, etc.)
        // so parent sections are established before children are wrapped
        for (let level = 2; level <= 6; level++) {
            const tag = `H${level}`
            // Find headings at this level — search within mainContent
            // and within already-created .heading-collapse details
            const headings = Array.from(
                mainContent.querySelectorAll(
                    `:scope > ${tag}, :scope > .heading-collapse ${tag}`,
                ),
            ).filter(
                // Only direct content headings, not ones inside summary
                (h) => !h.closest('summary'),
            ) as HTMLElement[]

            for (const heading of headings) {
                const parent = heading.parentNode!
                const details = document.createElement('details')
                details.setAttribute('is-', 'accordion')
                details.classList.add('heading-collapse')
                // Collapse year-section headings (e.g. "📆 2025") and a
                // short allowlist of *exact* section labels on the about
                // page (Music / More). Strip any leading emoji-icon-+-space
                // before comparing so e.g. "📓 More" still matches "more".
                //
                // Ignore the `<a class="heading-anchor">` that rehype
                // injects (renders as a literal "##"/"###"/etc.) — its
                // textContent otherwise prefixes the heading and breaks
                // the exact-label match.
                const headingClone = heading.cloneNode(true) as HTMLElement
                for (const a of headingClone.querySelectorAll(
                    '.heading-anchor',
                )) {
                    a.remove()
                }
                const headingText = headingClone.textContent?.trim() ?? ''
                const headingBare = headingText
                    .replace(
                        /^[\p{Emoji_Presentation}\p{Extended_Pictographic}️‍]+\s*/gu,
                        '',
                    )
                    .trim()
                    .toLowerCase()
                const collapseExact = new Set([
                    'music',
                    'more',
                    'detailed list',
                    'by year',
                ])
                const collapseByDefault =
                    /\b(19|20)\d{2}\s*$/.test(headingText) ||
                    collapseExact.has(headingBare)
                details.open = !collapseByDefault
                details.dataset.headingLevel = String(level)
                const summary = document.createElement('summary')
                summary.appendChild(heading.cloneNode(true))
                details.appendChild(summary)
                parent.insertBefore(details, heading)
                heading.remove()
                // Collect siblings until next heading of same or higher level,
                // or a container that holds such a heading
                const headingSelector = Array.from(
                    { length: level },
                    (_, i) => `h${i + 1}`,
                ).join(',')
                let next = details.nextSibling
                while (next) {
                    const sibling = next
                    next = sibling.nextSibling
                    if (sibling.nodeType === 1) {
                        const el = sibling as HTMLElement
                        if (
                            /^H[1-6]$/.test(el.tagName) &&
                            parseInt(el.tagName[1]) <= level
                        ) {
                            break
                        }
                        if (el.querySelector(headingSelector)) {
                            break
                        }
                    }
                    details.appendChild(sibling)
                }
            }
        }
        // Signal vim navigation to re-apply tabindex to restructured content
        window.dispatchEvent(new Event('headings-collapsed'))
    }
</script>

<style is:global>
    .heading-collapse {
        padding: 0 !important;
        margin: 0 !important;
        border: none !important;

        &[open]::details-content {
            padding-left: 0 !important;
        }

        > summary {
            background-color: transparent !important;
            list-style: none;
            cursor: pointer;
            line-height: 1lh !important;
            min-height: 1lh;
            display: flex;
            align-items: center;
            /* Both states are full-width clickable bands spanning the prose
               measure (open + collapsed alike), so a heading reads like a
               callout band. The whole row is the toggle target; the hover
               treatment below signals that, so a click in the empty space to
               its right toggling the section is expected, not a surprise.
               (This deliberately replaces the earlier fit-content click
               target now that the band + hover make the affordance obvious.) */
            width: auto;
            max-width: var(--prose-measure);
            /* Band chrome, shared by both states: same padding as a collapsed
               callout. At rest the heading reads as plain text (no border, no
               left-bar); the full border is TRANSPARENT here and only colours
               in to the per-level accent on hover via the rule below.
               Declaring it transparent at rest (rather than only on :hover)
               reserves the 1px so the hover border adds no width and the row
               never jitters. */
            padding-block: 0.15lh !important;
            /* Hang the band 1ch to the LEFT of the prose column into
               #main-content's new 2ch gutter: margin-left:-1ch pulls the box
               out, padding-inline-start:1ch pushes the heading text back in,
               so the `##` marker + text still line up with body prose while
               the hover box/left-border sits in the gutter. */
            padding-inline-start: 1ch;
            margin-left: -1ch;
            /* Small right margin (same as the callouts) so the 2px down-right
               hover shadow renders instead of being clipped: the band spans
               the prose measure flush to #main-content's right edge, which is
               overflow-x: hidden. */
            margin-right: 4px;
            border: 1px solid transparent;
            /* Animate the hover border-color + shadow. WebTUI's accordion sets
               `transition: background-color, color, outline-color` via an
               UNLAYERED rule (:is([tabindex="0"],a[href],summary)) that beats
               this layered one regardless of specificity; !important is the
               only thing that wins across the layer boundary. Restate WebTUI's
               three properties alongside ours so its focus-outline fade still
               works for keyboard users. */
            transition:
                background-color 100ms linear,
                color 100ms linear,
                outline-color 100ms linear,
                border-color 120ms ease-out,
                box-shadow 120ms ease-out !important;

            /* (previous rule killed all ::before content here so the
               default details disclosure marker didn't ghost-render;
               with the new + / x glyph that sets content via the
               state-specific selectors below, we let those win.) */

            &::-webkit-details-marker {
                display: none;
            }

            > :is(h2, h3, h4, h5, h6) {
                display: inline;
                border: none;
                line-height: 1lh;
                margin: 0 !important;
                padding: 0 !important;
            }
        }
        /* Hover: solid per-level border + the fixed black drop-shadow the
           callouts use (theme-invariant; --foreground0 would flip to white in
           dark mode). Applies to both open and collapsed bands. */
        & > summary:hover {
            border-color: var(--callout-color, var(--foreground3));
            box-shadow: 2px 2px 0 0 rgba(0, 0, 0, 0.55);
        }

        /* When collapsed, add the collapsed-callout cues on top of the
           shared band chrome (border/padding/left-bar are on `> summary`
           above): italic heading text + a right-aligned `+` glyph. The
           trailing ellipsis fades in on hover/focus so the reader knows
           there's content tucked behind. */
        &:not([open]) > summary {
            font-style: italic;

            &::before {
                content: '+';
                color: var(--callout-color, var(--foreground3));
                /* Push the glyph to the far RIGHT of the band, matching the
                   block callouts' toggle: order:1 moves it past the heading
                   text, margin-inline-start:auto eats the free space between.
                   (Left pad, not right margin, now that it trails.) */
                order: 1;
                margin-inline-start: auto;
                padding-inline-start: 1ch;
                font-style: normal;
                font-weight: bold;
            }

            &::after {
                content: ' ...';
                color: var(--foreground2);
                opacity: 0;
                transition: opacity 100ms linear;
            }
            &:hover::after,
            &:focus-visible::after,
            &[data-vim-focused='true']::after {
                opacity: 1;
            }
        }
        /* Open band: suppress the `x` disclosure glyph. webtui's theme-custom
           accordion paints an `x` on `details[is-~='accordion'][open] >
           summary::before` by default, which our heading-collapse <details>
           inherits; explicitly suppress it. (The band chrome + right-edge
           spacing come from the shared `> summary` rule; unlike before, the
           open band now keeps the same border/padding as the collapsed one so
           both read as the same clickable band.) */
        &[open] > summary {
            &::before {
                content: none !important;
            }
        }
        /* Per-level callout-color so the `+`/`x` glyph and the left
           border track the same hue as the heading text. */
        &[data-heading-level='2'] {
            --callout-color: var(--h2, var(--orange));
        }
        &[data-heading-level='3'] {
            --callout-color: var(--h3, var(--green));
        }
        &[data-heading-level='4'] {
            --callout-color: var(--h4, var(--blue));
        }
        &[data-heading-level='5'] {
            --callout-color: var(--h5, var(--purple));
        }
        &[data-heading-level='6'] {
            --callout-color: var(--h6, var(--aqua));
        }

        /* Closed-band tint: very faint slice of the heading's accent
           color, just enough to mark the row as a discrete band. Was
           0.1 alpha which read as a glaring color block when a stack
           of years collapsed together (year list). 0.04 keeps the
           rhythm without competing with the heading text. */
        &:not([open])[data-heading-level='2'] > summary {
            background-color: oklch(
                from var(--h2, var(--orange)) l c h / 0.04
            ) !important;
        }
        &:not([open])[data-heading-level='3'] > summary {
            background-color: oklch(
                from var(--h3, var(--green)) l c h / 0.04
            ) !important;
        }
        &:not([open])[data-heading-level='4'] > summary {
            background-color: oklch(
                from var(--h4, var(--blue)) l c h / 0.04
            ) !important;
        }
        &:not([open])[data-heading-level='5'] > summary {
            background-color: oklch(
                from var(--h5, var(--purple)) l c h / 0.04
            ) !important;
        }
        &:not([open])[data-heading-level='6'] > summary {
            background-color: oklch(
                from var(--h6, var(--aqua)) l c h / 0.04
            ) !important;
        }

        /* Vim-style blank line under an open heading. The summary's
           own margin/padding is forced to 0 above, so the gap lives on
           the first content child of the open <details>. */
        &[open] > summary + * {
            margin-block-start: 1lh !important;
        }
    }

    /* The remark-generated <h2 class="sr-only">Footnotes</h2> heading
       gets a normal h2's 2lh bottom margin from the global heading rule,
       which produces an awkward gap before the footnotes list. Render it
       like other headings but with the standard 1lh bottom margin. */
    #main-content section.footnotes > h2.sr-only {
        margin-block: 1lh !important;
    }
</style>

<!-- Footnote hover tooltips -->
<script>
    const footnoteRefs = document.querySelectorAll('a[data-footnote-ref]')
    for (const ref of footnoteRefs) {
        const id = ref.getAttribute('href')?.replace('#', '')
        if (!id) continue
        const footnoteLi = document.getElementById(id)
        if (!footnoteLi) continue

        // Clone footnote content, excluding the back-reference link
        const clone = footnoteLi.cloneNode(true) as HTMLElement
        clone
            .querySelectorAll('a[data-footnote-backref]')
            .forEach((a) => a.remove())

        // Build popover: <details is-="popover"><summary>...<sup></summary><div>...</div></details>
        const sup = ref.parentElement
        if (!sup || sup.tagName !== 'SUP') continue
        const parent = sup.parentElement
        if (!parent) continue

        const details = document.createElement('details')
        details.setAttribute('is-', 'popover')
        details.setAttribute('position-', 'bottom')
        details.classList.add('footnote-popover')

        const summary = document.createElement('summary')
        summary.appendChild(sup.cloneNode(true))

        const content = document.createElement('div')
        content.classList.add('footnote-popover-content')
        content.innerHTML = clone.innerHTML

        details.appendChild(summary)
        details.appendChild(content)

        // Replace original <sup> with the popover
        parent.insertBefore(details, sup)
        sup.remove()

        // Reposition the popover content when it opens. The content is
        // position: fixed so we compute viewport coordinates here — the
        // anchor point is just below the trigger, clamped horizontally.
        const reposition = () => {
            const triggerRect = details.getBoundingClientRect()
            // Default: align left edge of popover with trigger
            let left = triggerRect.left
            // Measure the natural width of the content
            const contentWidth = content.offsetWidth
            const maxLeft = window.innerWidth - contentWidth - 8
            if (left > maxLeft) left = Math.max(8, maxLeft)
            details.style.setProperty('--popover-left', `${left}px`)
            details.style.setProperty(
                '--popover-top',
                `${triggerRect.bottom}px`,
            )
        }

        // Open/close on hover
        details.addEventListener('mouseenter', () => {
            details.open = true
            requestAnimationFrame(reposition)
        })
        details.addEventListener('mouseleave', () => {
            details.open = false
        })

        // Reposition while open if the page scrolls or resizes.
        const onScrollOrResize = () => {
            if (details.open) reposition()
        }
        window.addEventListener('scroll', onScrollOrResize, true)
        window.addEventListener('resize', onScrollOrResize)

        // Keyboard/focus accessibility
        details.addEventListener('focusin', () => {
            details.open = true
            requestAnimationFrame(reposition)
        })
        details.addEventListener('focusout', (e) => {
            const next = (e as FocusEvent).relatedTarget as Node | null
            if (!next || !details.contains(next)) {
                details.open = false
            }
        })

        // Toggle on click/tap instead of following anchor
        const summaryLink = summary.querySelector('a')
        summaryLink?.addEventListener('click', (e) => {
            e.preventDefault()
            details.open = !details.open
        })
    }
</script>

