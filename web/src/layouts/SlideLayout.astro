---
import Layout from '@/layouts/Layout.astro'
import Presentation from '@/components/slides/Presentation.astro'
import CodeCopyButtons from '@/components/CodeCopyButtons.astro'
// KaTeX CSS: import from frontmatter (NOT `@import` in a <style> block) so Vite
// processes the stylesheet's relative `url(fonts/KaTeX_*)` refs -- hashing them
// into /_astro/ and COPYING the font files into the build. An `@import` inside
// `<style is:global>` is passed through untouched, so the fonts 404 and math
// renders in fallback faces. See Doc.astro for the same fix.
import 'katex/dist/katex.min.css'

interface Props {
    frontmatter?: { title?: string; description?: string }
    title?: string
    description?: string
}
const fm = (Astro.props as Props).frontmatter ?? {}
const title = (Astro.props as Props).title ?? fm.title
const description = (Astro.props as Props).description ?? fm.description
---

<Layout {title} {description}>
    <Presentation {title}>
        <slot />
    </Presentation>
    <CodeCopyButtons />
</Layout>
