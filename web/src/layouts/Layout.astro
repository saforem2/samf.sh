---
import '@/styles/global.css'

interface Props {
    ogSlug?: string
    description?: string
    title?: string
    ogType?: 'website' | 'article'
    publishedTime?: string
    // Preload the mIosevka-Term (code) woff2. Defaults true so every doc/post
    // page (all wrap through Doc.astro) is unchanged. The landing page has no
    // code above the fold — its only Term-using elements are keybind hints in
    // the closed command palette (display:none until opened) — so it opts out
    // to keep ~109 KiB off the first-paint critical path. Term's @font-face
    // stays defined, so it still loads on demand (font-display:swap) if the
    // palette opens.
    preloadCodeFont?: boolean
}

const {
    ogSlug,
    description,
    title,
    ogType,
    publishedTime,
    preloadCodeFont = true,
} = Astro.props as Props
const pageDescription = description || "Sam Foreman's Personal Website"
const pageTitle = title || 'Sam Foreman'
const ogImage = ogSlug
    ? `https://samf.sh/og/${ogSlug}.png`
    : 'https://samf.sh/social-card.png'
// Canonical + per-page og:url, resolved against the configured site
// (https://samf.sh) so they're correct regardless of which host served
// the page (sam.onl, *.pages.dev preview builds, etc.).
const pageUrl = new URL(Astro.url.pathname, Astro.site).href
const resolvedOgType = ogType ?? 'website'

// Inline every font stylesheet's @font-face rules at build time instead of
// linking them. Each was a render-blocking <link rel=stylesheet> round-trip
// (~450ms each on Slow 4G, serialized = the bulk of the mobile render-blocking
// penalty), yet the files hold ONLY @font-face decls (a few KB total). Inlining
// removes 4 render-blocking requests with zero behaviour change: the default
// woff2 are still preloaded (below), font-display:swap still keeps text
// unblocked, and the alternate weights still fetch lazily only when an element
// resolves to that family (i.e. when the user picks it in the palette).
// Build-time node:fs read anchored on process.cwd() (= the web/ workspace),
// NOT import.meta.url (which resolves into dist/ after bundling — the
// resolveSourceFile footgun). Nerd Font's @font-face lives in global.css, so
// it is not part of this set.
import { readFileSync } from 'node:fs'
import { join } from 'node:path'
const fontFaceCss = [
    'miosevka-qp/miosevka-qp.css',
    'miosevka-term/miosevka-term.css',
    'iosevka/iosevka.css',
    'victor-mono/victor-mono.css',
]
    .map((rel) =>
        readFileSync(join(process.cwd(), 'public/fonts', rel), 'utf8'),
    )
    .join('\n')
---

<!doctype html>
<html lang="en" data-webtui-theme="custom-light">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <!-- Google Analytics.
             The dataLayer shim + gtag('config') run inline (they only
             push to an array, ~0ms), so any early events queue
             immediately. The 166 KB gtag.js fetch itself is deferred to
             window 'load' (idle-callback fallback) instead of an async
             <head> script: as an async head script it still landed
             142ms of main-thread work inside the LCP window and competed
             with first paint. Loading it after the page is interactive
             keeps analytics fully intact (gtag.js drains the queued
             dataLayer entries when it arrives) while taking it out of
             the critical render path. -->
        <script is:inline>
            // GA's reference snippet REQUIRES the Arguments object
            // (gtag.js inspects each dataLayer entry via [0]/[1] on the
            // Arguments prototype; a plain Array from rest params gets
            // silently dropped — see commit 54db951). Don't "fix" this
            // back to (...args).
            /* eslint-disable prefer-rest-params */
            window.dataLayer = window.dataLayer || []
            function gtag() {
                dataLayer.push(arguments)
            }
            gtag('js', new Date())
            gtag('config', 'G-RD883HJ1J2')
            /* eslint-enable prefer-rest-params */

            // Defer the gtag.js download until the page is loaded/idle so
            // it doesn't compete with LCP. Guarded so it only injects once.
            const loadGtag = function () {
                if (window.__gtagLoaded) return
                window.__gtagLoaded = true
                const s = document.createElement('script')
                s.async = true
                s.src =
                    'https://www.googletagmanager.com/gtag/js?id=G-RD883HJ1J2'
                document.head.appendChild(s)
            }
            // requestIdleCallback's 2nd arg is an IdleRequestOptions object
            // ({ timeout }), NOT a number — passing a bare `1` throws a
            // TypeError, which previously killed the loader before it ran
            // (gtag.js never injected, so no analytics were ever sent on
            // any browser that supports rIC). Call each API with its
            // correct signature, and always pass a timeout so a page that
            // never goes idle still loads analytics.
            const scheduleIdle = function (fn) {
                if (window.requestIdleCallback) {
                    window.requestIdleCallback(fn, { timeout: 3000 })
                } else {
                    window.setTimeout(fn, 1)
                }
            }
            if (document.readyState === 'complete') {
                // Page already loaded (e.g. bfcache restore): schedule idle.
                scheduleIdle(loadGtag)
            } else {
                window.addEventListener('load', function () {
                    scheduleIdle(loadGtag)
                })
            }
        </script>

        <script is:inline>
            // Retired themes map to their nearest survivor rather than
            // dead-ending: an unknown value would leave data-webtui-theme
            // set to a name no CSS matches, so the page renders unstyled
            // for anyone who had picked one. sam-* and nvim-* were removed
            // because Shiki emits a CSS variable per token PER THEME, and
            // those six were ~31% of all HTML on the site.
            const RETIRED = {
                light: 'custom-light',
                dark: 'custom-dark',
                'sam-light': 'custom-light',
                'sam-dark': 'custom-dark',
                'nvim-light-role': 'custom-light',
                'nvim-light-hue': 'custom-light',
                'nvim-dark-role': 'custom-dark',
                'nvim-dark-hue': 'custom-dark',
            }
            const storedTheme = localStorage.getItem('webtui-theme')
            const migratedTheme = RETIRED[storedTheme] ?? storedTheme
            const systemTheme = window.matchMedia(
                '(prefers-color-scheme: dark)',
            ).matches
                ? 'custom-dark'
                : 'custom-light'
            // "auto" follows the OS prefers-color-scheme — stored as
            // 'auto' in localStorage so the picker can show "Auto
            // (system)" as the selected entry, but the DOM attribute
            // is always the resolved theme name so existing CSS
            // selectors keep matching.
            const resolvedTheme =
                migratedTheme === 'auto'
                    ? systemTheme
                    : (migratedTheme ?? systemTheme)
            document.documentElement.setAttribute(
                'data-webtui-theme',
                resolvedTheme,
            )
            if (migratedTheme && migratedTheme !== storedTheme) {
                localStorage.setItem('webtui-theme', migratedTheme)
            }

            // Font preferences — two independent axes, set before paint to
            // avoid FOUC. Body font (default mIosevka-QP, quasi-proportional
            // for prose) via data-mono-font; code font (default mIosevka-Term,
            // mono metrics for ASCII/alignment) via data-code-font. Returning
            // visitors only have 'mono-font' stored; 'code-font' defaults to
            // term, matching the old QP-body behavior. See the two-axis CSS in
            // global.css.
            const storedBodyFont =
                localStorage.getItem('mono-font') ?? 'miosevka-qp'
            document.documentElement.setAttribute(
                'data-mono-font',
                storedBodyFont,
            )
            const storedCodeFont =
                localStorage.getItem('code-font') ?? 'miosevka-term'
            document.documentElement.setAttribute(
                'data-code-font',
                storedCodeFont,
            )
        </script>
        <meta name="generator" content={Astro.generator} />
        <title>{pageTitle}</title>

        <!-- Canonical: the site is served from samf.sh, sam.onl, and
             per-commit *.sam-onl.pages.dev; point every page at its
             canonical samf.sh URL so crawlers don't split-index it. -->
        <link rel="canonical" href={pageUrl} />

        <!-- RSS autodiscovery -->
        <link
            rel="alternate"
            type="application/rss+xml"
            title="Sam Foreman"
            href="/rss.xml"
        />

        <!-- Icon(s) -->
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link rel="apple-touch-icon" href="/logo@512.png" />

        <!-- OpenGraph / X Title -->
        <meta property="og:title" content={pageTitle} />
        <meta name="twitter:title" content={pageTitle} />

        <!-- OpenGraph / X Description -->
        <meta name="description" content={pageDescription} />
        <meta property="og:description" content={pageDescription} />
        <meta name="twitter:description" content={pageDescription} />

        <!-- OpenGraph / X Cover Image -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={ogImage} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content={ogSlug ? '1200' : '2400'} />
        <meta property="og:image:height" content={ogSlug ? '630' : '1260'} />
        <meta
            property="og:image:alt"
            content="Sam Foreman social card with terminal-style branding and AI/HPC focus"
        />
        <meta
            name="twitter:image:alt"
            content="Sam Foreman social card with terminal-style branding and AI/HPC focus"
        />

        <!-- Misc Metadata -->
        <meta property="og:type" content={resolvedOgType} />
        {
            resolvedOgType === 'article' && publishedTime && (
                <meta
                    property="article:published_time"
                    content={publishedTime}
                />
            )
        }
        <meta property="og:url" content={pageUrl} />
        <meta name="twitter:site" content="@saforem2" />
        <meta name="twitter:creator" content="@saforem2" />
        <meta name="twitter:url" content={pageUrl} />
        <meta
            name="keywords"
            content="blog,machine learning,deep learning,artificial intelligence,supercomputing,programming,technology,sam foreman"
        />
        <meta name="theme-color" content="#1c1c1c" />

        <!-- Default font: mIosevka-QP (body prose) + mIosevka-Term
             (code blocks, via the [data-mono-font='miosevka-qp']
             override in global.css). Preload the Regular weight of
             each so first paint doesn't FOUT through Iosevka or a
             system fallback. -->
        <link
            rel="preload"
            href="/fonts/miosevka-qp/MIosevkaQp-Regular.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        {
            preloadCodeFont && (
                <link
                    rel="preload"
                    href="/fonts/miosevka-term/MIosevkaTerm-Regular.woff2"
                    as="font"
                    type="font/woff2"
                    crossorigin
                />
            )
        }
        <!-- All @font-face decls (default + alternate families) inlined at
             build time from public/fonts/*.css — see fontFaceCss in the
             frontmatter. Replaces 4 render-blocking <link rel=stylesheet>
             round-trips. The actual WOFF2 weights still fetch lazily (only
             when an element resolves to a family), and the two defaults are
             preloaded above. -->
        <style is:inline set:html={fontFaceCss}></style>
        <style is:inline>
            svg[id^='mermaid-'] {
                display: block;
                width: 100%;
                max-width: 100%;
                height: auto !important;
                min-height: 0;
            }
            svg[id^='mermaid-'] foreignObject * {
                margin: 0 !important;
                padding: 0 !important;
                line-height: normal !important;
            }
            .mermaid.mermaid-interactive {
                background-color: var(--background0);
                border: 1px solid var(--background2);
                /* Breathing room above and below the figure so it doesn't
                   crowd the surrounding text. */
                margin-block: 1lh;
            }
            /* On slides the slide-inner already provides the visual
               container, and the diagram is the dominant content of
               its column — the extra border + tinted background just
               box it in unnecessarily. Strip both inside any <Slide>. */
            [is-~='slide'] .mermaid.mermaid-interactive {
                background-color: transparent;
                border: none;
                margin-block: 0;
            }
            .mermaid.mermaid-interactive:focus-visible {
                outline: 1px solid var(--blue);
                outline-offset: -1px;
            }
            .mermaid-viewport {
                position: relative;
                overflow: hidden;
                width: 100%;
            }
            .mermaid-controls {
                position: absolute;
                bottom: 0.5ch;
                right: 0.5ch;
                display: flex;
                flex-direction: column;
                gap: 0.25ch;
                padding: 0.25ch;
                background-color: var(--background1);
                border: 1px solid var(--background2);
                z-index: 1;
                user-select: none;
                opacity: 0;
                transition: opacity 0.15s ease-out;
            }
            .mermaid-viewport:hover .mermaid-controls,
            .mermaid-viewport:focus-within .mermaid-controls {
                opacity: 1;
            }
            .mermaid-pad {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                grid-template-rows: repeat(3, 1fr);
                gap: 0;
            }
            .mermaid-pad .mc-up {
                grid-column: 2;
                grid-row: 1;
            }
            .mermaid-pad .mc-left {
                grid-column: 1;
                grid-row: 2;
            }
            .mermaid-pad .mc-reset {
                grid-column: 2;
                grid-row: 2;
            }
            .mermaid-pad .mc-right {
                grid-column: 3;
                grid-row: 2;
            }
            .mermaid-pad .mc-down {
                grid-column: 2;
                grid-row: 3;
            }
            .mermaid-zoom {
                display: flex;
                gap: 0;
                justify-content: center;
            }
            .mermaid-ctrl {
                appearance: none;
                background: var(--background2);
                color: var(--foreground1);
                border: none;
                width: 1.6ch;
                height: 0.85lh;
                font-family: inherit;
                font-size: 0.7em;
                line-height: 1;
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0;
            }
            .mermaid-ctrl:hover {
                background: var(--blue);
                color: var(--background0);
            }
            .mermaid-ctrl:focus-visible {
                outline: 1px solid var(--blue);
                outline-offset: -1px;
            }
            .mermaid-ctrl.mc-reset:hover {
                background: var(--orange);
            }
            .mermaid-ctrl.mc-success {
                background: var(--green);
                color: var(--background0);
            }
            .mermaid-actions {
                position: absolute;
                top: 1ch;
                right: 1ch;
                display: flex;
                gap: 0;
                z-index: 1;
                user-select: none;
                opacity: 0;
                transition: opacity 0.15s ease-out;
            }
            .mermaid-viewport:hover .mermaid-actions,
            .mermaid-viewport:focus-within .mermaid-actions {
                opacity: 1;
            }
            .mermaid-actions .mermaid-ctrl {
                width: 3ch;
                background: var(--background1);
                border: 1px solid var(--background2);
            }
            .mermaid-actions .mermaid-ctrl + .mermaid-ctrl {
                border-left: none;
            }
            .mermaid-modal {
                position: fixed;
                inset: 0;
                background-color: oklch(from var(--background0) l c h / 0.85);
                z-index: 1000;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 2lh 2ch;
            }
            .mermaid-modal-inner {
                position: relative;
                width: 100%;
                height: 100%;
                background-color: var(--background0);
                border: 1px solid var(--background2);
                padding: 2lh 2ch 1lh;
                display: flex;
                align-items: center;
                justify-content: center;
                overflow: auto;
            }
            .mermaid-modal-inner svg {
                display: block !important;
                max-width: 100% !important;
                max-height: 100% !important;
                width: auto !important;
                height: auto !important;
            }
            /* Descender clip fix for cloned SVG in the popout.
               Same rule we apply in-deck (see #restart-cascade in
               talks/2026-06-03/index.mdx). The popout clones the
               SVG outside that scope, so we need a global rule too. */
            .mermaid-modal-inner svg g.node foreignObject {
                overflow: visible;
            }
            .mermaid-modal-inner svg g.node p {
                line-height: 1.35;
                padding-bottom: 0.1em;
            }
            /* Per-cluster text colors for restart-cascade clones.
               classDef colors get serialized into the cluster <g>
               class list (jobC/nodeC/procC/jobTxt/nodeTxt/procTxt),
               so we can match on those even after the SVG is
               cloned outside the talk's scoped <style> block. Keep
               in sync with the in-deck rules. */
            .mermaid-modal-inner svg g.node.jobTxt .nodeLabel,
            .mermaid-modal-inner svg g.node.jobTxt span,
            .mermaid-modal-inner svg g.node.jobTxt p {
                color: #118cc2 !important;
            }
            .mermaid-modal-inner svg g.node.nodeTxt .nodeLabel,
            .mermaid-modal-inner svg g.node.nodeTxt span,
            .mermaid-modal-inner svg g.node.nodeTxt p {
                color: #ee8f24 !important;
            }
            .mermaid-modal-inner svg g.node.procTxt .nodeLabel,
            .mermaid-modal-inner svg g.node.procTxt span,
            .mermaid-modal-inner svg g.node.procTxt p {
                color: #1da811 !important;
            }
            /* Cluster-title chip badges + their per-cluster bg
               tints. Same selectors as in-deck, just no
               #restart-cascade prefix since the modal is outside it. */
            .mermaid-modal-inner svg .cluster .cluster-label foreignObject {
                overflow: visible;
            }
            .mermaid-modal-inner svg .cluster .cluster-label span {
                display: inline-block;
                padding: 0 1ch;
                color: var(--foreground0, #222) !important;
                font-weight: 600;
            }
            .mermaid-modal-inner svg .cluster.jobC .cluster-label span {
                background: #118cc218;
            }
            .mermaid-modal-inner svg .cluster.nodeC .cluster-label span {
                background: #ee8f2418;
            }
            .mermaid-modal-inner svg .cluster.procC .cluster-label span {
                background: #1da81118;
            }
            .mermaid-modal-close {
                position: absolute;
                top: 1ch;
                right: 1ch;
                appearance: none;
                background: var(--background1);
                color: var(--foreground1);
                border: 1px solid var(--background2);
                width: 3ch;
                height: 1lh;
                font-family: inherit;
                font-size: 0.95em;
                line-height: 1;
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0;
            }
            .mermaid-modal-close::before {
                content: '\f00d';
            }
            .mermaid-modal-close:hover {
                background: var(--red);
                color: var(--background0);
            }
        </style>
        <script is:inline>
            const normalizeMermaidSvgSize = () => {
                const mermaidSvgs = document.querySelectorAll(
                    "svg[id^='mermaid-']",
                )

                mermaidSvgs.forEach((node) => {
                    const viewBox = node.getAttribute('viewBox')
                    if (!viewBox) return

                    const parts = viewBox
                        .trim()
                        .split(/\s+/)
                        .map((value) => Number(value))
                    if (parts.length !== 4) return

                    const width = parts[2]
                    const height = parts[3]
                    if (!Number.isFinite(width) || !Number.isFinite(height))
                        return
                    if (width <= 0 || height <= 0) return

                    // Set explicit aspect ratio and let CSS handle sizing
                    node.style.setProperty(
                        'aspect-ratio',
                        `${width} / ${height}`,
                        'important',
                    )
                    node.style.setProperty('width', '100%', 'important')
                    node.style.setProperty('max-width', '100%', 'important')
                    node.style.setProperty('height', 'auto', 'important')
                    node.style.setProperty('display', 'block', 'important')
                })
            }

            if (document.readyState === 'loading') {
                document.addEventListener(
                    'DOMContentLoaded',
                    normalizeMermaidSvgSize,
                    {
                        once: true,
                    },
                )
            } else {
                normalizeMermaidSvgSize()
            }

            window.addEventListener('load', normalizeMermaidSvgSize, {
                once: true,
            })
            setTimeout(normalizeMermaidSvgSize, 0)
            setTimeout(normalizeMermaidSvgSize, 50)
            setTimeout(normalizeMermaidSvgSize, 250)
        </script>
        <!-- <link rel="preconnect" href="https://fonts.googleapis.com" /> -->
        <!-- <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /> -->
        <!-- <link -->
        <!--     href="https://fonts.googleapis.com/css2?family=Noto+Color+Emoji&family=Roboto+Mono:ital,wght@0,100..700;1,100..700&display=swap" -->
        <!--     rel="stylesheet" -->
        <!-- /> -->
        <!-- <link -->
        <!--     href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400..600;1,400..600&display=swap" -->
        <!--     rel="stylesheet" -->
        <!-- /> -->
        <script
            type="application/ld+json"
            set:html={JSON.stringify({
                '@context': 'https://schema.org',
                '@type': 'WebSite',
                name: 'Sam Foreman',
                url: 'https://samf.sh',
                author: {
                    '@type': 'Person',
                    name: 'Sam Foreman',
                    jobTitle: 'Computational Scientist',
                    affiliation: {
                        '@type': 'Organization',
                        name: 'Argonne National Laboratory',
                    },
                    url: 'https://samf.sh',
                },
            })}
        />
    </head>
    <body>
        <!-- Skip link: first focusable element so keyboard/AT users can jump
             past the navbar + sidebar + TOC to the content (WCAG 2.4.1).
             Visually hidden until focused. Targets the main region via the
             shared selector below (works on Doc #main-content, slide <main>,
             and the landing page alike). -->
        <a href="#main-content" class="skip-link">Skip to content</a>
        <slot />
        <script type="module">
            const MAIN_FOCUS_SELECTOR = '#main-content, main, [role="main"]'

            const isNaturallyFocusable = (element) =>
                element.matches(
                    'a[href], button, input, textarea, select, summary, [tabindex]:not([tabindex="-1"])',
                )

            const focusMainRegion = () => {
                if (window.location.hash.length > 0) return
                // The skip link now serves the same "jump past nav" purpose,
                // and is the standard, user-controlled pattern. Auto-focusing
                // main on load would strand it (focus starts *inside* content,
                // so forward-Tab never reaches it). Leave focus at the top so
                // the skip link is the first Tab stop.
                if (document.querySelector('.skip-link')) return

                const mainRegion = document.querySelector(MAIN_FOCUS_SELECTOR)
                if (!(mainRegion instanceof HTMLElement)) return

                const firstMainChild = mainRegion.firstElementChild
                const target =
                    firstMainChild instanceof HTMLElement
                        ? firstMainChild
                        : mainRegion

                const activeElement = document.activeElement
                if (
                    activeElement instanceof HTMLElement &&
                    activeElement !== document.body &&
                    activeElement !== document.documentElement
                ) {
                    return
                }

                if (!isNaturallyFocusable(target)) {
                    if (mainRegion.id === 'main-content') {
                        target.setAttribute('tabindex', '0')
                    } else {
                        target.setAttribute('tabindex', '-1')
                    }
                }

                target.focus({ preventScroll: true })
            }

            focusMainRegion()

            // Skip link: focus the main region regardless of whether it's
            // literally #main-content (slides/landing use <main>). Reuses the
            // selector above so it never dead-links.
            document
                .querySelector('.skip-link')
                ?.addEventListener('click', (e) => {
                    const main = document.querySelector(MAIN_FOCUS_SELECTOR)
                    if (!(main instanceof HTMLElement)) return
                    e.preventDefault()
                    if (!isNaturallyFocusable(main))
                        main.setAttribute('tabindex', '-1')
                    main.focus()
                    main.scrollIntoView()
                })
        </script>
        <script>
            if (
                document.querySelector('.mermaid, pre[data-language="mermaid"]')
            ) {
                import('@/utils/mermaid-render').then(({ initMermaid }) =>
                    initMermaid(),
                )
            }
        </script>
        <script>
            // GFM task-list checkboxes: persist checked state per page+task.
            // The rehype plugin strips `disabled` so they're already clickable;
            // we just need to wire up storage. Key = page path + task text.
            {
                const STORAGE_KEY = 'task-checks-v1'
                const items = document.querySelectorAll(
                    'li.task-list-item > input[type="checkbox"]',
                )
                if (items.length > 0) {
                    let store = {}
                    try {
                        store =
                            JSON.parse(localStorage.getItem(STORAGE_KEY)) ?? {}
                    } catch {
                        store = {}
                    }
                    const pageKey = location.pathname.replace(/\/$/, '') || '/'
                    const pageStore = store[pageKey] ?? {}

                    // Storage key is derived from the rendered task
                    // text, truncated to 200 chars. Two known fragility
                    // modes — both intentional tradeoffs:
                    //   1. Renaming an item drops its stored state.
                    //      Acceptable: a renamed task is a new task.
                    //   2. Two items whose first 200 chars match
                    //      collide on the same key. Rare in practice;
                    //      author can disambiguate by editing the
                    //      prefix.
                    // If either becomes a problem, switch to an
                    // author-supplied `data-task-key` and key off that.
                    const taskKey = (input) => {
                        const li = input.closest('li.task-list-item')
                        return li
                            ? li.textContent.trim().slice(0, 200)
                            : input.outerHTML
                    }

                    for (const input of items) {
                        const key = taskKey(input)
                        if (key in pageStore) input.checked = !!pageStore[key]
                        input.addEventListener('change', () => {
                            const updated = JSON.parse(
                                localStorage.getItem(STORAGE_KEY) || '{}',
                            )
                            const page = updated[pageKey] ?? {}
                            page[key] = input.checked
                            updated[pageKey] = page
                            localStorage.setItem(
                                STORAGE_KEY,
                                JSON.stringify(updated),
                            )
                        })
                    }
                }
            }
        </script>
    </body>
</html>
