# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
old/*
.astro/
.opencode/
.claude/
.ccb/
.entire/
.screenshots/
.playwright-mcp/
.superpowers/

# OG image variant generation outputs (script under scripts/og-variants.ts)
og-variants/*.png

# Local debug captures
web/network-landing.txt

# Dev screenshots / scratch files committed by accident in past
/*.png
/FILE_NAME
/80b_benchmark.md
web/public/Inconsolata.zip
# Screenshots taken while working on the app itself. The /*.png rule above is
# root-anchored, so it does not reach into web/.
web/*.png

# Stale local copies of components that have tracked equivalents
# (web/src/components/SidebarFileTree.astro, web/src/utils/content.ts).
# Kept on disk as a reference; never part of the build.
ignore/

# Exported deck PDFs. Build artifacts, regenerated from the .mdx decks, and
# not served from web/public.
/*.pdf

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# Local editor / IDE metadata
.vscode/
.idx/

# Python bytecode cache (matplotlib chart scripts under scripts/)
__pycache__/
*.pyc

# Legacy Bun lockfile (use bun.lock)
bun.lockb

# Lighthouse HTML reports left in the project root by ad-hoc runs.
*.report.html

# Agent scratch: per-run todo checklists and lessons notes, not site content.
tasks/
